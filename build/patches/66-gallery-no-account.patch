+/**
+ * Open VSX serves item pages from the same host under `/vscode/item`, and the private mirrors
+ * keep that layout. A gallery shaped differently gets no item links rather than links to a 404.
+ */
+function galleryItemUrl(serviceUrl: string): string | undefined {
+	const match = /^(.*)\/vscode\/gallery\/?$/.exec(serviceUrl);
+	return match ? `${match[1]}/vscode/item` : undefined;
+}
