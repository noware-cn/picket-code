+import * as assert from 'assert';
+import * as cp from 'child_process';
+import * as fs from 'fs';
+import * as os from 'os';
+import * as path from 'path';
+import { Application, ApplicationOptions, Logger } from '../../../../automation';
+import { createApp, dumpFailureDiagnostics, installAppAfterHandler, installDiagnosticsHandler, suiteCrashPath, suiteLogsPath } from '../../utils';
+
+/**
+ * Layer 4 (UI smoke) coverage for the iCode agent-host provider, driven by the
+ * fake ACP CLI in `test/fixtures/fake-icode-acp.mjs` (see `docs/testing.md`
+ * §2 "L4 UI 冒烟").
+ *
+ * These suites deliberately do NOT use `setupAgentHostSuite`: that helper wires
+ * a mock LLM server for the Copilot-backed providers, while iCode talks ACP to
+ * a local subprocess. Pointing `PICKET_ICODE_BIN` at the fake CLI and enabling
+ * the provider via `PICKET_ICODE_AGENT_ENABLED` is the whole setup.
+ *
+ * `FAKE_ICODE_SCENARIO` is read by the subprocess, so it is fixed for the
+ * lifetime of one app launch — hence one `describe` per scenario, each with its
+ * own app (mirroring how the other Agents Window suites create one app per
+ * suite).
+ *
+ * Suite titles carry a lowercase `[icode]` token on purpose: the smoke runner
+ * maps `-f`/`-g` onto mocha's `grep` (`new RegExp` without flags, see
+ * `test/smoke/test/index.js`), which is case-sensitive and matches the full
+ * nested title — so `-f icode` only selects a title containing lowercase
+ * `icode`.
+ */
+
+// `out/areas/agentsWindow/icode.test.js` → `<vscode>/test/fixtures/…`
+const FAKE_ICODE_BIN = path.resolve(__dirname, '..', '..', '..', '..', 'fixtures', 'fake-icode-acp.mjs');
+
+const PROMPT = 'icode smoke prompt';
+
+// Text the fake CLI emits per scenario (see `test/fixtures/fake-icode-acp.mjs`).
+// `text` streams three `fake-` chunks, so the rendered bubble reads `fake-fake-fake`.
+const FAKE_TEXT = 'fake-fake-fake';
+// `text` starts an `execute` tool call as `{toolCallId: 'tc-1', kind: 'execute',
+// rawInput: {command: 'echo fake'}}` with no `title`, so the provider falls back
+// to the ACP tool call id as the display name (`icodeMapEvents.mapToolCallStart`).
+const FAKE_TOOL_CALL_ID = 'tc-1';
+// The command the `execute` tool call carries in its `rawInput`.
+const FAKE_TOOL_COMMAND = 'echo fake';
+// The command is rendered inside a code block (Monaco view lines render spaces
+// as non-breaking spaces), so match it with a whitespace-tolerant pattern
+// instead of a literal-space `includes` check.
+const FAKE_TOOL_COMMAND_PATTERN = /echo\s+fake/;
+// `ask` is answered with this chunk once the question carousel is submitted.
+const FAKE_ASK_FOLLOW_UP = 'after-answer';
+// `permission` gates an `execute` tool call with this id behind
+// `session/request_permission`, so the confirmation banner is the visible
+// evidence that the call is waiting for approval.
+const FAKE_PERMISSION_TOOL_CALL_ID = 'tc-p';
+// `diff` names this file in its `edit` tool call title, then appends a
+// `change-<n>` line to it inside the session folder.
+const FAKE_DIFF_FILE = 'probe-diff.txt';
+const FAKE_DIFF_LINE_PATTERN = /change-\d+/;
+
+// Selector for the send button in the Agents Window new-session homepage.
+// Kept in sync with `SEND_BUTTON_ENABLED` in `test/automation/src/agentsWindow.ts`
+// (without the `:not(.disabled)` filter so we can observe the disabled state).
+const AGENTS_SEND_BUTTON_SELECTOR = '.sessions-chat-widget .new-chat-widget-container .sessions-chat-send-button .monaco-button';
+
+const SESSION_TYPE = 'iCode';
+
+/**
+ * Creates a throwaway git repository to use as the session's working
+ * directory. The agent host passes the folder the Agents Window hands over to
+ * `session/new` as the chat's cwd, and its per-turn checkpoints only work
+ * inside a repository (`IcodeAgent._sendMessage`), so the diff scenario needs a
+ * real repo — which is itself part of the behaviour under test. The ACP
+ * subprocess is spawned with that same cwd, so the fake CLI's relative writes
+ * land in the session folder and the checkpoints capture them.
+ */
+function createTempGitRepo(): string {
+	const repoPath = fs.mkdtempSync(path.join(os.tmpdir(), 'vscode-icode-smoke-'));
+	const git = (args: readonly string[]) => cp.execFileSync('git', args, { cwd: repoPath, stdio: 'pipe' });
+	git(['init', '--quiet']);
+	fs.writeFileSync(path.join(repoPath, 'README.md'), '# iCode smoke workspace\n');
+	git(['add', 'README.md']);
+	// Pass the identity explicitly so the commit does not depend on (and is not
+	// blocked by) the machine's global git configuration; `--no-gpg-sign` keeps
+	// a globally configured `commit.gpgsign` from needing a passphrase.
+	git(['-c', 'user.email=smoke@example.com', '-c', 'user.name=VS Code Smoke', 'commit', '--no-gpg-sign', '--quiet', '-m', 'Initial commit']);
+	return repoPath;
+}
+
+interface IIcodeSuiteContext {
+	/** The temp git repo backing the suite; `undefined` before the app hook ran. */
+	readonly repoPath: string | undefined;
+}
+
+/**
+ * Installs the shared hooks for one iCode scenario: guards the platform, starts
+ * the app with the fake ACP CLI as `PICKET_ICODE_BIN`, pre-seeds the smoke
+ * settings into both profile roots, and opens the temp repo in the Agents
+ * Window.
+ */
+function setupIcodeSuite(logger: Logger, config: { readonly label: string; readonly scenario: string }): IIcodeSuiteContext {
+	let repoPath: string | undefined;
+
+	// Runs before the app hooks below, so an unsupported environment skips the
+	// suite without ever launching Electron.
+	before(function () {
+		// The transport spawns `PICKET_ICODE_BIN` directly and only falls back to
+		// a shell for `.cmd`/`.bat` shims, so a `.mjs` fixture cannot be started
+		// on Windows.
+		if (process.platform === 'win32') {
+			logger.log(`Skipping ${config.label}: the fake iCode ACP CLI ('test/fixtures/fake-icode-acp.mjs') cannot be spawned directly on Windows.`);
+			this.skip();
+		}
+		if (!fs.existsSync(FAKE_ICODE_BIN)) {
+			logger.log(`Skipping ${config.label}: fake iCode ACP CLI not found at ${FAKE_ICODE_BIN}.`);
+			this.skip();
+		}
+		// The session workspace is a throwaway git repository (see
+		// `createTempGitRepo`), so the suite cannot run without git on PATH.
+		try {
+			cp.execFileSync('git', ['--version'], { stdio: 'pipe' });
+		} catch {
+			logger.log(`Skipping ${config.label}: git is not available, so the temp session workspace cannot be a repository.`);
+			this.skip();
+		}
+	});
+
+	installDiagnosticsHandler(logger);
+
+	before(async function () {
+		const suiteName = this.test?.parent?.title ?? 'unknown';
+		const defaultOptions: ApplicationOptions = {
+			...this.defaultOptions,
+			logsPath: suiteLogsPath(this.defaultOptions, suiteName),
+			crashesPath: suiteCrashPath(this.defaultOptions, suiteName),
+		};
+
+		repoPath = createTempGitRepo();
+		this.app = createApp(defaultOptions, opts => ({
+			...opts,
+			// The temp repo is the session's working directory: the Agents Window
+			// hands its folder to the agent host and the ACP session is created
+			// with that cwd.
+			workspacePath: repoPath,
+			extraEnv: {
+				...(opts.extraEnv ?? {}),
+				PICKET_ICODE_BIN: FAKE_ICODE_BIN,
+				PICKET_ICODE_AGENT_ENABLED: '1',
+				FAKE_ICODE_SCENARIO: config.scenario,
+			},
+		}));
+
+		// Pre-seed settings.json on disk into BOTH the default profile and the
+		// Agents profile so Agent Host startup observes the test configuration.
+		const userDataDir = (this.app as Application).userDataPath;
+		if (userDataDir) {
+			const settings = JSON.stringify({
+				// The session folder is handed over as-is; a worktree would add a
+				// branch the per-turn checkpoint assertions do not expect and the
+				// temp repo is disposable anyway.
+				'sessions.useWorktree': false,
+				// Agent sessions run without a Copilot account in these suites.
+				'chat.allowAnonymousAccess': true,
+				// Keep the AHP transcript on disk so a failure can be diagnosed
+				// from the suite logs.
+				'chat.agentHost.ahpJsonlLoggingEnabled': true,
+			}, null, 2);
+			for (const settingsPath of [
+				path.join(userDataDir, 'User', 'settings.json'),
+				path.join(userDataDir, 'User', 'profiles', 'builtin', 'agents', 'settings.json'),
+			]) {
+				fs.mkdirSync(path.dirname(settingsPath), { recursive: true });
+				fs.writeFileSync(settingsPath, settings);
+			}
+		}
+
+		await (this.app as Application).start();
+	});
+
+	installAppAfterHandler(undefined, async () => {
+		// The app is already stopped here; drop the temp repo so repeated runs
+		// leave nothing behind.
+		if (repoPath) {
+			fs.rmSync(repoPath, { recursive: true, force: true });
+			repoPath = undefined;
+		}
+	});
+
+	before(async function () {
+		const app = this.app as Application;
+		const windowsBefore = app.code.driver.getAllWindows().length;
+		await app.workbench.agentsWindow.openCurrentFolderInAgentsWindow();
+		await app.workbench.agentsWindow.switchToAgentsWindow(windowsBefore);
+	});
+
+	return {
+		get repoPath() { return repoPath; },
+	};
+}
+
+/**
+ * Starts a fresh session with the iCode provider and submits `prompt`.
+ *
+ * Selecting a session type only preselects the provider in the new-session
+ * composer; the active session view appears once the prompt is sent, because
+ * the ACP session is created lazily per chat.
+ */
+async function submitIcodePrompt(app: Application, prompt: string): Promise<void> {
+	const agentsWindow = app.workbench.agentsWindow;
+	await agentsWindow.startNewSession();
+	await agentsWindow.waitForNewSessionView();
+	await agentsWindow.selectSessionType(SESSION_TYPE);
+	await agentsWindow.submitNewSessionPrompt(prompt);
+}
+
+/** Logs the failure diagnostics for `label` and rethrows the original error. */
+async function reportFailure(app: Application, logger: Logger, label: string, error: unknown): Promise<never> {
+	logger.log(`${label} FAILURE: ${error instanceof Error ? error.stack ?? error.message : String(error)}`);
+	await dumpFailureDiagnostics(app, logger, label, { sendButtonSelector: AGENTS_SEND_BUTTON_SELECTOR });
+	throw error;
+}
+
+export function setup(logger: Logger): void {
+
+	describe('Agents Window [icode] text scenario', () => {
+
+		setupIcodeSuite(logger, { label: 'Agents Window [icode] text scenario', scenario: 'text' });
+
+		it('offers iCode in the session-type picker and opens a session', async function () {
+			this.timeout(5 * 60 * 1000);
+			const app = this.app as Application;
+			const agentsWindow = app.workbench.agentsWindow;
+
+			try {
+				await agentsWindow.startNewSession();
+				await agentsWindow.waitForNewSessionView();
+
+				assert.ok(
+					await agentsWindow.isSessionTypeAvailable(SESSION_TYPE),
+					`The session-type picker must offer "${SESSION_TYPE}" when PICKET_ICODE_BIN points at the fake ACP CLI and PICKET_ICODE_AGENT_ENABLED=1`,
+				);
+				await agentsWindow.selectSessionType(SESSION_TYPE);
+
+				// Selecting a session type only preselects the provider; the active
+				// session view appears when the first prompt opens the ACP session.
+				await agentsWindow.submitNewSessionPrompt(PROMPT);
+				await agentsWindow.waitForActiveSessionView();
+			} catch (error) {
+				await reportFailure(app, logger, 'Agents Window [icode] text scenario', error);
+			}
+		});
+
+		it('renders the assistant text of one turn', async function () {
+			this.timeout(5 * 60 * 1000);
+			const app = this.app as Application;
+
+			try {
+				await submitIcodePrompt(app, PROMPT);
+				const response = await app.workbench.agentsWindow.waitForAssistantText(FAKE_TEXT, 120_000);
+				assert.ok(response.includes(FAKE_TEXT), `Expected the assistant response to contain "${FAKE_TEXT}" (got "${response}")`);
+			} catch (error) {
+				await reportFailure(app, logger, 'Agents Window [icode] text scenario', error);
+			}
+		});
+
+		it('renders the execute tool call with its command text', async function () {
+			this.timeout(5 * 60 * 1000);
+			const app = this.app as Application;
+			const agentsWindow = app.workbench.agentsWindow;
+
+			try {
+				await submitIcodePrompt(app, PROMPT);
+
+				// The tool call header shows the ACP tool call id, because the fake
+				// `execute` update carries no `title` and the provider falls back to
+				// the id as the display name.
+				await agentsWindow.waitForAssistantText(FAKE_TOOL_CALL_ID, 120_000);
+
+				// ACP's `rawInput.command` reaches the UI as the tool call's input.
+				// iCode does not stamp the `_meta.toolKind` rendering hint that routes
+				// a call to the terminal renderer (`stateToProgressAdapter`'s
+				// `isTerminalToolCall`), so the call renders as a generic tool part
+				// whose input lives in a collapsed code block that is only created on
+				// first expansion — expanding is what surfaces the command text.
+				await agentsWindow.expandToolCall(FAKE_TOOL_CALL_ID);
+				const response = await agentsWindow.waitForAssistantText(FAKE_TOOL_COMMAND_PATTERN, 120_000);
+				assert.ok(FAKE_TOOL_COMMAND_PATTERN.test(response), `Expected the tool call to render the command "${FAKE_TOOL_COMMAND}" (got "${response}")`);
+			} catch (error) {
+				await reportFailure(app, logger, 'Agents Window [icode] text scenario', error);
+			}
+		});
+	});
+
+	describe('Agents Window [icode] diff scenario', () => {
+
+		const context = setupIcodeSuite(logger, { label: 'Agents Window [icode] diff scenario', scenario: 'diff' });
+
+		it('reports the changed file of the turn and shows its diff', async function () {
+			this.timeout(5 * 60 * 1000);
+			const app = this.app as Application;
+			const agentsWindow = app.workbench.agentsWindow;
+
+			try {
+				const repoPath = context.repoPath;
+				assert.ok(repoPath && fs.existsSync(path.join(repoPath, '.git')), 'Expected the session workspace to be a git repository');
+
+				await submitIcodePrompt(app, PROMPT);
+
+				// The turn's changes summary must list the file the `edit` tool call
+				// wrote. The ACP subprocess runs in the session folder, so the fake
+				// CLI's `appendFileSync(join(process.cwd(), 'probe-diff.txt'))` really
+				// touches the repo the checkpoints are taken against.
+				const files = await agentsWindow.getTurnChangedFiles(120_000);
+				assert.strictEqual(files.length, 1, `Expected the turn changes summary to list one file (got ${JSON.stringify(files)})`);
+				assert.ok(files[0].includes(FAKE_DIFF_FILE), `Expected the turn changes summary to list "${FAKE_DIFF_FILE}" (got ${JSON.stringify(files)})`);
+
+				// Selecting the row opens the checkpoint diff; its modified side must
+				// show the appended line, which only holds if the checkpoint captured
+				// the real file contents rather than an empty change.
+				await agentsWindow.openTurnChangeDiff(FAKE_DIFF_FILE, 120_000);
+				const diffText = await agentsWindow.waitForDiffEditorText(FAKE_DIFF_FILE, text => FAKE_DIFF_LINE_PATTERN.test(text), 120_000);
+				assert.ok(FAKE_DIFF_LINE_PATTERN.test(diffText), `Expected the diff of "${FAKE_DIFF_FILE}" to show the appended line (got "${diffText}")`);
+			} catch (error) {
+				await reportFailure(app, logger, 'Agents Window [icode] diff scenario', error);
+			}
+		});
+	});
+
+	describe('Agents Window [icode] ask scenario', () => {
+
+		setupIcodeSuite(logger, { label: 'Agents Window [icode] ask scenario', scenario: 'ask' });
+
+		it('answers the ask_user form and keeps the turn going', async function () {
+			this.timeout(5 * 60 * 1000);
+			const app = this.app as Application;
+			const agentsWindow = app.workbench.agentsWindow;
+
+			try {
+				await submitIcodePrompt(app, PROMPT);
+
+				// The fake CLI parks the turn on `_chrys/request_input` with one
+				// question (`Q?`) and the options `A` and `B`, which the provider
+				// maps to a single-select question carousel in the response.
+				await agentsWindow.waitForQuestionCarousel(['A', 'B'], 120_000);
+				await agentsWindow.selectQuestionOption('A');
+
+				// Answering resumes the parked request, so the follow-up text can
+				// only arrive after the selection landed.
+				const response = await agentsWindow.waitForAssistantText(FAKE_ASK_FOLLOW_UP, 120_000);
+				assert.ok(response.includes(FAKE_ASK_FOLLOW_UP), `Expected the turn to continue with "${FAKE_ASK_FOLLOW_UP}" (got "${response}")`);
+			} catch (error) {
+				await reportFailure(app, logger, 'Agents Window [icode] ask scenario', error);
+			}
+		});
+	});
+
+	describe('Agents Window [icode] permission scenario', () => {
+
+		setupIcodeSuite(logger, { label: 'Agents Window [icode] permission scenario', scenario: 'permission' });
+
+		it('shows the tool confirmation and finishes after allowing it', async function () {
+			this.timeout(5 * 60 * 1000);
+			const app = this.app as Application;
+			const agentsWindow = app.workbench.agentsWindow;
+
+			try {
+				await submitIcodePrompt(app, PROMPT);
+
+				// `session/request_permission` from the fake CLI becomes a chat tool
+				// confirmation that blocks the turn. If this times out the session
+				// auto-approved the shell command, which is itself the regression
+				// this test guards against.
+				const banner = await agentsWindow.waitForToolConfirmation(120_000);
+				assert.ok(banner.includes(FAKE_PERMISSION_TOOL_CALL_ID), `Expected the confirmation to gate the tool call "${FAKE_PERMISSION_TOOL_CALL_ID}" (got "${banner}")`);
+
+				await agentsWindow.acceptToolConfirmation();
+
+				// Allowing resumes the parked request and the turn ends. The approved
+				// call's result text is deliberately not asserted: a call admitted while
+				// pending confirmation is created with
+				// `ToolInvocationPresentation.HiddenAfterComplete`
+				// (`stateToProgressAdapter.toolCallStateToInvocation`), so its output
+				// never enters the transcript. The confirmation card itself stays
+				// rendered as the record of the decision, so the contract pinned here is
+				// "the approval affordance appears, and allowing it lets the turn
+				// finish" — waiting for the card to vanish would assert a UI detail that
+				// is not what this test is about.
+				await agentsWindow.waitForActiveResponseSettled(120_000);
+			} catch (error) {
+				await reportFailure(app, logger, 'Agents Window [icode] permission scenario', error);
+			}
+		});
+	});
+
+	describe('Agents Window [icode] restore scenario', () => {
+
+		setupIcodeSuite(logger, { label: 'Agents Window [icode] restore scenario', scenario: 'restore' });
+
+		it('restores the conversation after a window reload', async function () {
+			this.timeout(8 * 60 * 1000);
+			const app = this.app as Application;
+			const agentsWindow = app.workbench.agentsWindow;
+
+			try {
+				await submitIcodePrompt(app, PROMPT);
+				await agentsWindow.waitForAssistantText(FAKE_TEXT, 120_000);
+
+				// Reload only the Agents Window and reopen the session from the
+				// list: the chat is persisted with the provider data (ACP session id
+				// + cwd), so a reload must bring the previous transcript back rather
+				// than an empty conversation.
+				//
+				// The text is the one the live turn rendered (`fake-fake-fake`), not
+				// the `history-*` transcript the `restore` scenario replays for
+				// `session/load`: the workbench rehydrates the chat from its stored
+				// transcript, which takes precedence over the provider's history
+				// backfill for a chat that already has one.
+				await app.code.reloadWindow(() => app.workbench.quickaccess.runCommand('Developer: Reload Window', { match: 'exactLabel', keepOpen: true }));
+
+				// `responseLabel` makes activation wait until the reopened session
+				// actually renders the previous assistant text.
+				await agentsWindow.activateSessionByLabel(PROMPT, FAKE_TEXT, 120_000);
+				const response = await agentsWindow.waitForAssistantText(FAKE_TEXT, 120_000);
+				assert.ok(response.includes(FAKE_TEXT), `Expected the restored session to still render "${FAKE_TEXT}" (got "${response}")`);
+			} catch (error) {
+				await reportFailure(app, logger, 'Agents Window [icode] restore scenario', error);
+			}
+		});
+	});
+}

