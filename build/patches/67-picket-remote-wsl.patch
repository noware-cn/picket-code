+'use strict';
+
+const { readFile } = require('node:fs/promises');
+const { join } = require('node:path');
+
+/**
+ * A fresh object every time, so callers cannot share one mutable catalog.
+ * @returns {ICatalog}
+ */
+function emptyCatalog() {
+	return { tag: null, flavor: 'ondemand', components: [] };
+}
+
+/**
+ * @typedef {{ id: string, kind: 'server' | 'extensions', version: string, file: string, size: number, sha256: string, embedded: boolean, embeddedPath?: string }} ICatalogComponent
+ * @typedef {{ tag: string | null, flavor: 'embedded' | 'ondemand', components: ICatalogComponent[] }} ICatalog
+ */
+
+/** @param {unknown} value @returns {value is Record<string, any>} */
+function isObject(value) {
+	return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/** @param {unknown} value @returns {value is string} */
+function nonEmpty(value) {
+	return typeof value === 'string' && value.length > 0;
+}
+
+/** @param {unknown} value @returns {value is number} */
+function positiveInteger(value) {
+	return typeof value === 'number' && Number.isInteger(value) && value > 0;
+}
+
+/**
+ * A component is usable only when every field the installer relies on is present
+ * and well formed. Anything else is dropped rather than trusted.
+ * @param {unknown} raw @returns {ICatalogComponent | undefined}
+ */
+function normalizeComponent(raw) {
+	if (!isObject(raw)) {
+		return undefined;
+	}
+	if (!nonEmpty(raw.id) || !nonEmpty(raw.version) || !nonEmpty(raw.file)) {
+		return undefined;
+	}
+	if (raw.kind !== 'server' && raw.kind !== 'extensions') {
+		return undefined;
+	}
+	if (!positiveInteger(raw.size)) {
+		return undefined;
+	}
+	if (typeof raw.sha256 !== 'string' || !/^[0-9a-f]{64}$/.test(raw.sha256)) {
+		return undefined;
+	}
+	const embedded = raw.embedded === true;
+	const embeddedPath = raw.embeddedPath;
+	if (embedded) {
+		if (!nonEmpty(embeddedPath) || embeddedPath.includes('..') || embeddedPath.startsWith('/')) {
+			return undefined;
+		}
+	}
+	return {
+		id: raw.id,
+		kind: raw.kind,
+		version: raw.version,
+		file: raw.file,
+		size: raw.size,
+		sha256: raw.sha256,
+		embedded,
+		embeddedPath: embedded ? embeddedPath : undefined
+	};
+}
+
+/**
+ * Reads `payloads/catalog.json` from the extension directory. A missing or
+ * malformed catalog is a valid state (an ondemand build with nothing installed
+ * yet), so it resolves to the empty catalog and never throws.
+ * @param {string} extensionPath
+ * @returns {Promise<ICatalog>}
+ */
+async function loadCatalog(extensionPath) {
+	let text;
+	try {
+		text = await readFile(join(extensionPath, 'payloads', 'catalog.json'), 'utf8');
+	} catch {
+		return emptyCatalog();
+	}
+	let parsed;
+	try {
+		parsed = JSON.parse(text);
+	} catch {
+		return emptyCatalog();
+	}
+	if (!isObject(parsed)) {
+		return emptyCatalog();
+	}
+	const components = Array.isArray(parsed.components)
+		? parsed.components.map(normalizeComponent).filter(Boolean)
+		: [];
+	return {
+		tag: nonEmpty(parsed.tag) ? parsed.tag : null,
+		flavor: parsed.flavor === 'embedded' ? 'embedded' : 'ondemand',
+		components
+	};
+}
+
+module.exports = { loadCatalog };
diff --git a/extensions/picket-remote-wsl/src/commands.js b/extensions/picket-remote-wsl/src/commands.js
new file mode 100644
index 00000000..23e0345a
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/commands.js
@@ -0,0 +1,367 @@
+'use strict';
+
+const { listDistros, distroHome, visibleDistros } = require('./distro.js');
+const { AUTHORITY_PREFIX, parseAuthority, parseUncPath, toPosixPath, toWindowsPath } = require('./remoteUri.js');
+const { manageDistro } = require('./manage.js');
+const { buildDiagnostics } = require('./diagnose.js');
+const { selectGallery, installVsix } = require('./marketplace.js');
+
+const LAST_DISTRO = 'picket.wsl.lastDistro';
+const SERVER_COMPONENT = 'wsl-server';
+
+/**
+ * Every command is a workflow over `host`, the narrow slice of `vscode` this
+ * module is allowed to touch, so the whole command layer runs under `node --test`
+ * with no extension host. `extension.js` supplies the real `vscode` bindings.
+ * @param {{
+ *   host: any,
+ *   runner: any,
+ *   settings: any,
+ *   catalog: any,
+ *   createComponents: (config: { distro: string, home: string, explicitPath?: string }) => any,
+ *   resolver: { stop(distro?: string): Promise<void> },
+ *   memento?: { get(key: string): any, update(key: string, value: any): any },
+ *   log?: { info(...parts: unknown[]): void, error(...parts: unknown[]): void },
+ *   listDistros?: typeof listDistros,
+ *   distroHome?: typeof distroHome,
+ *   appRoot?: string,
+ *   gallery?: { get(key: string): any, update(key: string, value: any): Promise<void> },
+ *   currentFolders?: () => readonly any[],
+ *   currentAuthority?: () => string
+ * }} options
+ */
+function createCommands(options) {
+	const { host, runner, settings, catalog, createComponents, resolver } = options;
+	const listDistrosOf = options.listDistros ?? listDistros;
+	const distroHomeOf = options.distroHome ?? distroHome;
+
+	/** @param {string} title */
+	async function pickDistro(title) {
+		let list;
+		try {
+			list = visibleDistros(await listDistrosOf(runner));
+		} catch (error) {
+			await host.showErrorMessage(`无法列出 WSL 发行版：${error.message}`);
+			return undefined;
+		}
+		if (list.length === 0) {
+			await host.showErrorMessage('没有检测到 WSL 发行版。先运行 "wsl --install" 安装一个。');
+			return undefined;
+		}
+		const preferred = String(settings.defaultDistro || options.memento?.get(LAST_DISTRO) || '').toLowerCase();
+		const ordered = [...list].sort((a, b) => Number(b.name.toLowerCase() === preferred) - Number(a.name.toLowerCase() === preferred));
+		const items = ordered.map(distro => ({
+			label: distro.name,
+			description: `WSL ${distro.version}${distro.isDefault ? ' · 默认发行版' : ''} · ${distro.state}`,
+			distro: distro.name
+		}));
+		const picked = await host.showQuickPick(items, { placeHolder: title });
+		if (!picked) {
+			return undefined;
+		}
+		const name = typeof picked === 'string' ? picked : picked.distro;
+		await options.memento?.update(LAST_DISTRO, name);
+		return name;
+	}
+
+	/** @param {any} manager */
+	async function install(manager) {
+		try {
+			await host.withProgress({ title: '正在准备 WSL 服务器组件…' }, () => manager.ensure(SERVER_COMPONENT));
+			return true;
+		} catch (error) {
+			await host.showErrorMessage(`安装 WSL 服务器组件失败：${error.message}`);
+			return false;
+		}
+	}
+
+	/**
+	 * The first-use interception. The embedded flavor is meant to be invisible:
+	 * the payload shipped with the build, so there is nothing to ask. The public
+	 * build carries only a catalog, so it asks — and "cancel" must leave the
+	 * window untouched.
+	 * @param {{ distro: string, home: string }} target
+	 * @returns {Promise<boolean>}
+	 */
+	async function ensureComponentInteractive(target) {
+		const component = (catalog?.components ?? []).find((/** @type {any} */ c) => c.id === SERVER_COMPONENT);
+		if (!component) {
+			await host.showErrorMessage('这个构建没有 WSL 服务器组件，无法在 WSL 中打开文件夹。');
+			return false;
+		}
+		const manager = createComponents({ distro: target.distro, home: target.home });
+		const current = await manager.inspect(SERVER_COMPONENT);
+		if (current.state === 'installed') {
+			return true;
+		}
+
+		if (catalog.flavor === 'embedded') {
+			return install(manager);
+		}
+
+		const choice = await host.showInformationMessage(
+			'WSL 里还没有服务器组件。从哪里获取？',
+			'自动下载',
+			'从文件安装…',
+			'取消'
+		);
+		if (choice === '自动下载') {
+			return install(manager);
+		}
+		if (choice === '从文件安装…') {
+			const picked = await host.showOpenDialog({
+				canSelectFiles: true,
+				canSelectMany: false,
+				title: '选择服务器载荷 tar.gz',
+				filters: { '服务器载荷': ['gz', 'tgz'] }
+			});
+			const file = Array.isArray(picked) ? picked[0] : picked;
+			const path = file?.fsPath ?? file?.path ?? (typeof file === 'string' ? file : '');
+			if (!path) {
+				return false;
+			}
+			return install(createComponents({ distro: target.distro, home: target.home, explicitPath: path }));
+		}
+		return false;
+	}
+
+	/**
+	 * A path the dialog hands back is Windows-shaped unless the user typed or
+	 * pasted a UNC path; `wslpath` owns the translation because only it knows
+	 * where the drives are mounted.
+	 * @param {any} chosen
+	 * @param {string} distro
+	 * @returns {Promise<string | undefined>}
+	 */
+	async function toPosix(chosen, distro) {
+		const raw = String(chosen?.fsPath ?? chosen?.path ?? '');
+		const unc = parseUncPath(raw);
+		if (unc) {
+			return unc.posixPath;
+		}
+		if (chosen?.scheme === 'vscode-remote') {
+			return chosen.path;
+		}
+		const candidate = raw.startsWith('/') ? raw : String(chosen?.path ?? raw);
+		if (candidate.startsWith('/')) {
+			return candidate;
+		}
+		try {
+			return await toPosixPath(runner, distro, candidate);
+		} catch (error) {
+			await host.showErrorMessage(`无法把 ${candidate} 转换成 WSL 路径：${error.message}`);
+			return undefined;
+		}
+	}
+
+	/** @param {string} distro @param {string} posixPath @param {string} home */
+	async function connect(distro, posixPath, home) {
+		if (!await ensureComponentInteractive({ distro, home })) {
+			return;
+		}
+		await host.openFolder(
+			host.uriFor({ scheme: 'vscode-remote', authority: `${AUTHORITY_PREFIX}+${distro}`, path: posixPath }),
+			{ forceNewWindow: true, remoteAuthority: `${AUTHORITY_PREFIX}+${distro}` }
+		);
+	}
+
+	/** @param {string} [preselected] */
+	async function openFolder(preselected) {
+		const distro = typeof preselected === 'string' && preselected.length > 0
+			? preselected
+			: await pickDistro('选择要在其中打开文件夹的发行版');
+		if (!distro) {
+			return;
+		}
+		let home;
+		try {
+			home = await distroHomeOf(runner, distro);
+		} catch (error) {
+			await host.showErrorMessage(`无法进入 ${distro}：${error.message}`);
+			return;
+		}
+		const picked = await host.showOpenDialog({
+			canSelectFiles: false,
+			canSelectFolders: true,
+			canSelectMany: false,
+			title: `在 ${distro} 中选择文件夹`,
+			defaultUri: host.uriFor({ scheme: 'vscode-remote', authority: `${AUTHORITY_PREFIX}+${distro}`, path: home })
+		});
+		const chosen = Array.isArray(picked) ? picked[0] : picked;
+		if (!chosen) {
+			return;
+		}
+		const posixPath = await toPosix(chosen, distro);
+		if (!posixPath) {
+			return;
+		}
+		await connect(distro, posixPath, home);
+	}
+
+	async function reopenInWsl() {
+		const folder = (options.currentFolders?.() ?? [])[0];
+		const unc = parseUncPath(folder?.uri?.fsPath ?? '');
+		if (!unc) {
+			await host.showErrorMessage('当前文件夹不在 \\\\wsl.localhost 或 \\\\wsl$ 下。');
+			return;
+		}
+		const home = await distroHomeOf(runner, unc.distro).catch(() => '/');
+		await connect(unc.distro, unc.posixPath, home);
+	}
+
+	async function reopenInWindows() {
+		const folder = (options.currentFolders?.() ?? [])[0];
+		const distro = parseAuthority(options.currentAuthority?.() ?? '');
+		if (!folder || !distro) {
+			await host.showErrorMessage('当前窗口不是 Picket WSL 窗口。');
+			return;
+		}
+		try {
+			const windowsPath = await toWindowsPath(runner, distro, folder.uri.path);
+			await host.openFolder(host.uriFor({ scheme: 'file', path: windowsPath }), { forceNewWindow: true, remoteAuthority: '' });
+		} catch (error) {
+			await host.showErrorMessage(`无法映射回 Windows 路径：${error.message}`);
+		}
+	}
+
+	/** @param {string} [preselected] */
+	async function stopServer(preselected) {
+		const distro = typeof preselected === 'string' && preselected.length > 0
+			? preselected
+			: await pickDistro('选择要停止服务器的发行版');
+		if (!distro) {
+			return;
+		}
+		await resolver.stop(distro);
+		await host.refreshTargets();
+	}
+
+	async function componentsCommand() {
+		const distro = await pickDistro('选择发行版');
+		if (!distro) {
+			return;
+		}
+		const home = await distroHomeOf(runner, distro);
+		const rows = await createComponents({ distro, home }).list();
+		const picked = await host.showQuickPick(
+			rows.map((/** @type {any} */ row) => ({
+				label: row.id,
+				description: `${row.state}${row.version ? ` · ${row.version}` : ''}`,
+				row
+			})),
+			{ placeHolder: '选择组件' }
+		);
+		if (!picked) {
+			return;
+		}
+		const row = typeof picked === 'string' ? { id: picked } : picked.row;
+		const choice = await host.showInformationMessage(`组件 ${row.id}：${row.state ?? '未知'}`, '重新安装', '取消');
+		if (choice === '重新安装') {
+			await install(createComponents({ distro, home, explicitPath: settings.serverPayloadPath || undefined }));
+			await host.refreshTargets();
+		}
+	}
+
+	async function diagnose() {
+		const report = await buildDiagnostics({
+			runner,
+			settings,
+			catalog,
+			components: createComponents,
+			appRoot: options.appRoot,
+			gallery: options.gallery ? { serviceUrl: options.gallery.get('serviceUrl') } : undefined
+		});
+		await host.showDocument(report);
+	}
+
+	async function galleryCommand() {
+		if (!options.gallery) {
+			await host.showErrorMessage('扩展市场配置不可用。');
+			return;
+		}
+		await selectGallery({ host, configuration: options.gallery });
+	}
+
+	async function vsixCommand() {
+		await installVsix({ host });
+	}
+
+	async function refreshTargets() {
+		await host.refreshTargets();
+	}
+
+	/**
+	 * @param {'add' | 'setDefault' | 'delete'} action
+	 * @param {string} [preselected] the distro a context-menu click carries
+	 */
+	async function manage(action, preselected) {
+		const distro = action === 'add'
+			? undefined
+			: (typeof preselected === 'string' && preselected.length > 0 ? preselected : await pickDistro('选择发行版'));
+		if (action !== 'add' && !distro) {
+			return;
+		}
+		await manageDistro({ host, runner, action, distro });
+		await host.refreshTargets();
+	}
+
+	return {
+		openFolder,
+		reopenInWsl,
+		reopenInWindows,
+		stopServer,
+		componentsCommand,
+		diagnose,
+		refreshTargets,
+		addDistro: () => manage('add'),
+		setDefaultDistro: (distro) => manage('setDefault', distro),
+		deleteDistro: (distro) => manage('delete', distro),
+		selectGallery: galleryCommand,
+		installVsix: vsixCommand,
+		ensureComponentInteractive,
+		pickDistro
+	};
+}
+
+/**
+ * A command invoked from the targets view receives its tree element; one
+ * invoked from the palette receives nothing.
+ * @param {any} node
+ * @returns {string | undefined}
+ */
+function distroOf(node) {
+	return typeof node?.distro === 'string' ? node.distro : undefined;
+}
+
+/**
+ * One table serves registration and the manifest test: a command that is
+ * described in `package.json` but absent here is a dead menu entry.
+ * @type {Record<string, (api: ReturnType<typeof createCommands>) => (...args: any[]) => any>}
+ */
+const COMMANDS = {
+	'picket.wsl.openFolder': (api) => (node) => api.openFolder(distroOf(node)),
+	'picket.wsl.reopenInWsl': (api) => () => api.reopenInWsl(),
+	'picket.wsl.reopenInWindows': (api) => () => api.reopenInWindows(),
+	'picket.wsl.stopServer': (api) => (node) => api.stopServer(distroOf(node)),
+	'picket.wsl.components': (api) => () => api.componentsCommand(),
+	'picket.wsl.diagnose': (api) => () => api.diagnose(),
+	'picket.wsl.refreshTargets': (api) => () => api.refreshTargets(),
+	'picket.wsl.addDistro': (api) => () => api.addDistro(),
+	'picket.wsl.setDefaultDistro': (api) => (node) => api.setDefaultDistro(distroOf(node)),
+	'picket.wsl.deleteDistro': (api) => (node) => api.deleteDistro(distroOf(node)),
+	'picket.wsl.selectGallery': (api) => () => api.selectGallery(),
+	'picket.wsl.installVsix': (api) => () => api.installVsix()
+};
+
+/**
+ * `register` is `vscode.commands.registerCommand`, injected so this file never
+ * requires `vscode`.
+ * @param {Parameters<typeof createCommands>[0] & { register: (id: string, run: (...args: any[]) => any) => any }} options
+ * @returns {any[]}
+ */
+function registerCommands(options) {
+	const api = createCommands(options);
+	return Object.entries(COMMANDS).map(([id, handler]) => options.register(id, handler(api)));
+}
+
+module.exports = { createCommands, registerCommands, COMMANDS, LAST_DISTRO };
diff --git a/extensions/picket-remote-wsl/src/components.js b/extensions/picket-remote-wsl/src/components.js
