+'use strict';
+
+const { readFile } = require('node:fs/promises');
+const { join } = require('node:path');
+
+/**
+ * The product stamp is the only place the client learns which server it may
+ * talk to: `commit` is what the handshake compares, `picketServerMinVersion`
+ * is the floor a catalog has to satisfy.
+ * @param {string} appRoot
+ * @returns {Promise<{ commit: string, version: string, picketServerMinVersion: string }>}
+ */
+async function readProduct(appRoot) {
+	const raw = JSON.parse(await readFile(join(appRoot, 'product.json'), 'utf8'));
+	return {
+		commit: String(raw.commit ?? ''),
+		version: String(raw.version ?? ''),
+		picketServerMinVersion: String(raw.picketServerMinVersion ?? '')
+	};
+}
+
+module.exports = { readProduct };
diff --git a/extensions/picket-remote-wsl/src/remoteUri.js b/extensions/picket-remote-wsl/src/remoteUri.js
new file mode 100644
index 00000000..286ab287
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/remoteUri.js
@@ -0,0 +1,108 @@
+'use strict';
+
+const { decodeWslOutput } = require('./distro.js');
+
+const AUTHORITY_PREFIX = 'picket-wsl';
+/**
+ * The prefix the official `ms-vscode-remote.remote-wsl` wrote into every saved
+ * workspace and history entry. Claiming it is what lets a user who uninstalled
+ * that extension open the folders they already had.
+ */
+const LEGACY_AUTHORITY_PREFIX = 'wsl';
+
+/** @typedef {{ prefix: string, distro: string }} IParsedAuthority */
+
+/**
+ * `picket-wsl+Ubuntu 22.04 LTS` -> `{ prefix: 'picket-wsl', distro: 'Ubuntu 22.04 LTS' }`.
+ * An empty distro means "the default distro", and the official extension spells
+ * that `default`; both collapse to `''` so no caller has to know. Any other
+ * authority is not ours and returns `undefined`.
+ * @param {string} authority
+ * @returns {IParsedAuthority | undefined}
+ */
+function parseAuthority(authority) {
+	for (const prefix of [AUTHORITY_PREFIX, LEGACY_AUTHORITY_PREFIX]) {
+		if (authority === prefix) {
+			return { prefix, distro: '' };
+		}
+		if (authority.startsWith(`${prefix}+`)) {
+			const distro = authority.slice(prefix.length + 1);
+			return { prefix, distro: distro === 'default' ? '' : distro };
+		}
+	}
+	return undefined;
+}
+
+/**
+ * `default` rather than an empty tail: `wsl+default` is what the official
+ * extension writes, so a canonical authority never opens a second identity for
+ * the same folder.
+ * @param {string} prefix
+ * @param {string} distro
+ */
+function canonicalAuthority(prefix, distro) {
+	return `${prefix}+${distro || 'default'}`;
+}
+
+/**
+ * @param {string} distro
+ * @param {string} posixPath
+ */
+function remoteUriFor(distro, posixPath) {
+	return { scheme: /** @type {const} */ ('vscode-remote'), authority: `${AUTHORITY_PREFIX}+${distro}`, path: posixPath };
+}
+
+/**
+ * `\\wsl.localhost\<distro>\<posix>` and `\\wsl$\<distro>\<posix>` both name the
+ * same directory; Windows hands either spelling to a file dialog.
+ * @param {string} path
+ * @returns {{ distro: string, posixPath: string } | undefined}
+ */
+function parseUncPath(path) {
+	const normalized = path.replace(/\\/g, '/');
+	const match = /^\/\/(wsl\.localhost|wsl\$)\/([^/]+)(\/.*)?$/.exec(normalized);
+	if (!match) {
+		return undefined;
+	}
+	const rest = (match[3] ?? '/').replace(/\/+$/, '');
+	return { distro: match[2], posixPath: rest.length === 0 ? '/' : rest };
+}
+
+/**
+ * The only place a Windows path becomes a Linux one: `wslpath` owns the mapping
+ * (`C:\` -> `/mnt/c`, drvfs mounts, `$HOME`-relative shortcuts), and guessing it
+ * would be wrong on exactly the machines that need it most.
+ * @param {string} flag
+ * @param {import('./distro.js').IWslRunner} runner
+ * @param {string} distro
+ * @param {string} path
+ * @returns {Promise<string>}
+ */
+async function wslpath(flag, runner, distro, path) {
+	const result = await runner.exec(['-d', distro, '-e', 'wslpath', flag, path]);
+	const stdout = decodeWslOutput(result.stdout);
+	if (result.code !== 0 || stdout.length === 0) {
+		throw new Error(`wslpath failed: ${decodeWslOutput(result.stderr) || `exit code ${result.code}`}`);
+	}
+	return stdout.split('\n')[0];
+}
+
+/**
+ * @param {import('./distro.js').IWslRunner} runner
+ * @param {string} distro
+ * @param {string} windowsPath
+ */
+function toPosixPath(runner, distro, windowsPath) {
+	return wslpath('-u', runner, distro, windowsPath);
+}
+
+/**
+ * @param {import('./distro.js').IWslRunner} runner
+ * @param {string} distro
+ * @param {string} posixPath
+ */
+function toWindowsPath(runner, distro, posixPath) {
+	return wslpath('-w', runner, distro, posixPath);
+}
+
+module.exports = { AUTHORITY_PREFIX, LEGACY_AUTHORITY_PREFIX, parseAuthority, canonicalAuthority, remoteUriFor, parseUncPath, toPosixPath, toWindowsPath };
diff --git a/extensions/picket-remote-wsl/src/resolver.js b/extensions/picket-remote-wsl/src/resolver.js
