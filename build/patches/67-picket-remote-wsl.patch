+test('the tree puts the default distro first and labels the WSL version', () => {
+	const nodes = buildDistroNodes(LIST, { activeDistro: 'Debian' });
+	assert.deepStrictEqual(nodes.map(n => n.label), ['Ubuntu-24.04（WSL 2）', 'Debian（WSL 2）', 'Old（WSL 1）']);
+});
+
+test('the active distro is marked connected, the others are not', () => {
+	const nodes = buildDistroNodes(LIST, { activeDistro: 'Debian' });
+	assert.strictEqual(nodes[1].contextValue, 'activeDistro');
+	assert.match(nodes[1].tooltip, /Connected/);
+	assert.strictEqual(nodes[0].contextValue, 'inactiveDistro');
+	assert.match(nodes[0].description, /default distro/);
+	assert.match(nodes[0].description, /Not Connected/);
+});
+
+test('the default distro is named in its description', () => {
+	const nodes = buildDistroNodes(LIST, {});
+	assert.match(nodes[0].description, /default distro/);
+	assert.doesNotMatch(nodes[1].description, /default distro/);
+});
+
+test('a docker-desktop distro never reaches the tree', () => {
+	const list = [
+		{ name: 'Ubuntu', isDefault: true, version: '2', state: 'Running' },
+		{ name: 'docker-desktop', isDefault: false, version: '2', state: 'Running' },
+		{ name: 'docker-desktop-data', isDefault: false, version: '2', state: 'Stopped' }
+	];
+	const nodes = buildDistroNodes(visibleDistros(list), {});
+	assert.deepStrictEqual(nodes.map(n => n.label), ['Ubuntu（WSL 2）']);
+});
+
+test('no distros produce no nodes rather than an error', () => {
+	assert.deepStrictEqual(buildDistroNodes([], {}), []);
+});
