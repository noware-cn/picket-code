+'use strict';
+
+const { readFile } = require('node:fs/promises');
+const { join } = require('node:path');
+
+/**
+ * A fresh object every time, so callers cannot share one mutable catalog.
+ * @returns {ICatalog}
+ */
+function emptyCatalog() {
+	return { tag: null, flavor: 'ondemand', components: [] };
+}
+
+/**
+ * @typedef {{ id: string, kind: 'server' | 'extensions', version: string, file: string, size: number, sha256: string, embedded: boolean, embeddedPath?: string }} ICatalogComponent
+ * @typedef {{ tag: string | null, flavor: 'embedded' | 'ondemand', components: ICatalogComponent[] }} ICatalog
+ */
+
+/** @param {unknown} value @returns {value is Record<string, any>} */
+function isObject(value) {
+	return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/** @param {unknown} value @returns {value is string} */
+function nonEmpty(value) {
+	return typeof value === 'string' && value.length > 0;
+}
+
+/** @param {unknown} value @returns {value is number} */
+function positiveInteger(value) {
+	return typeof value === 'number' && Number.isInteger(value) && value > 0;
+}
+
+/**
+ * A component is usable only when every field the installer relies on is present
+ * and well formed. Anything else is dropped rather than trusted.
+ * @param {unknown} raw @returns {ICatalogComponent | undefined}
+ */
+function normalizeComponent(raw) {
+	if (!isObject(raw)) {
+		return undefined;
+	}
+	if (!nonEmpty(raw.id) || !nonEmpty(raw.version) || !nonEmpty(raw.file)) {
+		return undefined;
+	}
+	if (raw.kind !== 'server' && raw.kind !== 'extensions') {
+		return undefined;
+	}
+	if (!positiveInteger(raw.size)) {
+		return undefined;
+	}
+	if (typeof raw.sha256 !== 'string' || !/^[0-9a-f]{64}$/.test(raw.sha256)) {
+		return undefined;
+	}
+	const embedded = raw.embedded === true;
+	const embeddedPath = raw.embeddedPath;
+	if (embedded) {
+		if (!nonEmpty(embeddedPath) || embeddedPath.includes('..') || embeddedPath.startsWith('/')) {
+			return undefined;
+		}
+	}
+	return {
+		id: raw.id,
+		kind: raw.kind,
+		version: raw.version,
+		file: raw.file,
+		size: raw.size,
+		sha256: raw.sha256,
+		embedded,
+		embeddedPath: embedded ? embeddedPath : undefined
+	};
+}
+
+/**
+ * Reads `payloads/catalog.json` from the extension directory. A missing or
+ * malformed catalog is a valid state (an ondemand build with nothing installed
+ * yet), so it resolves to the empty catalog and never throws.
+ * @param {string} extensionPath
+ * @returns {Promise<ICatalog>}
+ */
+async function loadCatalog(extensionPath) {
+	let text;
+	try {
+		text = await readFile(join(extensionPath, 'payloads', 'catalog.json'), 'utf8');
+	} catch {
+		return emptyCatalog();
+	}
+	let parsed;
+	try {
+		parsed = JSON.parse(text);
+	} catch {
+		return emptyCatalog();
+	}
+	if (!isObject(parsed)) {
+		return emptyCatalog();
+	}
+	const components = Array.isArray(parsed.components)
+		? parsed.components.map(normalizeComponent).filter(Boolean)
+		: [];
+	return {
+		tag: nonEmpty(parsed.tag) ? parsed.tag : null,
+		flavor: parsed.flavor === 'embedded' ? 'embedded' : 'ondemand',
+		components
+	};
+}
+
+module.exports = { loadCatalog };
diff --git a/extensions/picket-remote-wsl/src/components.js b/extensions/picket-remote-wsl/src/components.js
new file mode 100644
index 00000000..d587fe9c
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/components.js
@@ -0,0 +1,198 @@
+'use strict';
+
+const { readFile, writeFile } = require('node:fs/promises');
+const { chooseSource, installPayload } = require('./payload.js');
+
+/** @typedef {{ sha256: string, source: string, installedAt: string }} IPayloadMarker */
+/** @typedef {'absent' | 'installed' | 'outdated' | 'broken'} IPayloadState */
+
+/**
+ * @param {string} payloadDir
+ * @returns {string}
+ */
+function markerPath(payloadDir) {
+	return `${payloadDir}/.picket-payload.json`;
+}
+
+/**
+ * @param {string} base
+ * @param {string} child
+ */
+function joinPath(base, child) {
+	return `${base.replace(/\/+$/, '')}/${child}`;
+}
+
+/**
+ * The disk inside the distro is the only source of truth: the Windows-side
+ * cache can be stale or corrupt, and a marker whose hash disagrees with the
+ * catalog means the payload is not the one this build expects.
+ * @param {{ catalog: any, runner: any, distro: string, home: string, statePath?: string, env?: any, fetchImpl?: typeof fetch, onProgress?: (progress: { downloaded: number, total: number }) => void }} options
+ */
+function createComponentManager(options) {
+	const { catalog, runner, distro, home } = options;
+	const payloadRoot = joinPath(home, '.picket-code-server/payloads');
+
+	/** @param {string} script @param {...string} params */
+	function sh(script, ...params) {
+		return runner.exec(['-d', distro, '-e', 'sh', '-c', script, 'sh', ...params]);
+	}
+
+	/** @returns {Promise<string[]>} absolute server-* paths, newest first */
+	async function listServerDirs() {
+		const result = await sh('ls -1t "$1" 2>/dev/null || true', payloadRoot);
+		const base = `${payloadRoot}/`;
+		return String(result.stdout)
+			.split(/\r?\n/)
+			.map(line => line.trim())
+			.filter(line => line.startsWith('server-') || line.startsWith(base))
+			.map(line => (line.startsWith('/') ? line : `${payloadRoot}/${line}`));
+	}
+
+	/** @param {string} dir */
+	async function readMarker(dir) {
+		const result = await sh('cat "$1" 2>/dev/null || true', markerPath(dir));
+		const text = String(result.stdout).trim();
+		if (!text) {
+			return undefined;
+		}
+		try {
+			const parsed = JSON.parse(text);
+			return typeof parsed?.sha256 === 'string' ? parsed : undefined;
+		} catch {
+			return undefined;
+		}
+	}
+
+	/** @param {string} id */
+	function componentOf(id) {
+		const component = catalog?.components?.find((c) => c.id === id);
+		if (!component) {
+			throw new Error(`Unknown component: ${id}`);
+		}
+		return component;
+	}
+
+	/** @param {string} id */
+	async function inspect(id) {
+		const component = componentOf(id);
+		const dirs = await listServerDirs();
+		const expected = joinPath(payloadRoot, `server-${component.version}`);
+		if (dirs.includes(expected)) {
+			const marker = await readMarker(expected);
+			const matches = marker !== undefined && marker.sha256.toLowerCase() === component.sha256.toLowerCase();
+			return {
+				state: /** @type {IPayloadState} */ (matches ? 'installed' : 'broken'),
+				version: component.version,
+				payloadDir: expected
+			};
+		}
+		const other = dirs[0];
+		if (other) {
+			return {
+				state: /** @type {IPayloadState} */ ('outdated'),
+				version: other.slice(other.lastIndexOf('server-') + 'server-'.length),
+				payloadDir: other
+			};
+		}
+		return { state: /** @type {IPayloadState} */ ('absent') };
+	}
+
+	/** @param {string} id */
+	async function ensure(id) {
+		const component = componentOf(id);
+		const current = await inspect(id);
+		if (current.state === 'installed' && current.payloadDir) {
+			return { payloadDir: current.payloadDir, source: sourceOfMarker(await readMarker(current.payloadDir)) };
+		}
+		const source = await chooseSource(component, {
+			explicitPath: options.env?.explicitPath,
+			embeddedDir: options.env?.embeddedDir,
+			baseUrl: options.env?.baseUrl,
+			exists: options.env?.exists
+		});
+		const installed = await installPayload({
+			runner, distro, component, source, payloadRoot,
+			fetchImpl: options.fetchImpl,
+			onProgress: options.onProgress
+		});
+		/** @type {IPayloadMarker} */
+		const marker = {
+			sha256: component.sha256.toLowerCase(),
+			source: source.kind === 'url' ? source.url : source.path,
+			installedAt: new Date().toISOString()
+		};
+		const written = await sh('printf %s "$1" > "$2"', JSON.stringify(marker), markerPath(installed.payloadDir));
+		if (written.code !== 0) {
+			throw new Error(`Could not write the payload marker in ${installed.payloadDir}: ${written.stderr}`);
+		}
+		await remember(id, { version: component.version, payloadDir: installed.payloadDir });
+		return { payloadDir: installed.payloadDir, source };
+	}
+
+	/** @param {any} marker */
+	function sourceOfMarker(marker) {
+		if (!marker || typeof marker.source !== 'string') {
+			return undefined;
+		}
+		return /^https?:\/\//.test(marker.source)
+			? { kind: 'url', url: marker.source }
+			: { kind: 'file', path: marker.source };
+	}
+
+	/** @param {string} id */
+	async function uninstall(id) {
+		const component = componentOf(id);
+		await sh('rm -rf "$1"', joinPath(payloadRoot, `server-${component.version}`));
+		await remember(id, undefined);
+	}
+
+	/**
+	 * Keeps the catalog version plus the newest `keep` of the rest.
+	 * @param {number} keep
+	 * @returns {Promise<string[]>} removed directory names
+	 */
+	async function cleanup(keep) {
+		const dirs = await listServerDirs();
+		const current = joinPath(payloadRoot, `server-${catalog?.tag ?? ''}`);
+		const extras = dirs.filter(dir => dir !== current);
+		const gone = extras.slice(keep);
+		for (const dir of gone) {
+			await sh('rm -rf "$1"', dir);
+		}
+		return gone.map(dir => dir.slice(dir.lastIndexOf('/') + 1));
+	}
+
+	async function list() {
+		const components = Array.isArray(catalog?.components) ? catalog.components : [];
+		/** @type {Array<{ id: string, state: string, version?: string, payloadDir?: string }>} */
+		const rows = [];
+		for (const component of components) {
+			const inspected = await inspect(component.id);
+			rows.push({ id: component.id, state: inspected.state, version: inspected.version, payloadDir: inspected.payloadDir });
+		}
+		return rows;
+	}
+
+	/** @param {string} id @param {any} value */
+	async function remember(id, value) {
+		if (!options.statePath) {
+			return;
+		}
+		let cache = {};
+		try {
+			cache = JSON.parse(await readFile(options.statePath, 'utf8'));
+		} catch {
+			cache = {};
+		}
+		cache[id] = value;
+		try {
+			await writeFile(options.statePath, JSON.stringify(cache, null, '\t'));
+		} catch {
+			// The cache is a convenience; the distro is authoritative.
+		}
+	}
+
+	return { inspect, ensure, uninstall, cleanup, list, markerPath, payloadRoot };
+}
+
+module.exports = { createComponentManager, markerPath };
diff --git a/extensions/picket-remote-wsl/src/distro.js b/extensions/picket-remote-wsl/src/distro.js
new file mode 100644
index 00000000..5d068b16
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/distro.js
@@ -0,0 +1,224 @@
+'use strict';
+
+const { spawn: spawnChild } = require('node:child_process');
+
+/**
+ * @typedef {{ name: string, isDefault: boolean, version: '1' | '2', state: string }} IDistro
+ * @typedef {{ code: number, stdout: Buffer | string, stderr: Buffer | string }} IWslResult
+ * @typedef {{ exec(args: string[], opts?: { input?: string | Buffer, timeoutMs?: number }): Promise<IWslResult>, spawn(args: string[]): { child: import('node:child_process').ChildProcess, stdout: import('node:stream').Readable | null, stderr: import('node:stream').Readable | null } }} IWslRunner
+ */
+
+/**
+ * wsl.exe writes --list output as UTF-16LE with a BOM and CRLF, and everything
+ * else as UTF-8. A NUL byte is the discriminator: no UTF-8 text we consume
+ * contains one, and every UTF-16LE ASCII string does.
+ * @param {Buffer | string} buffer
+ * @returns {string}
+ */
+function decodeWslOutput(buffer) {
+	const text = typeof buffer === 'string'
+		? buffer
+		: buffer.includes(0) ? buffer.toString('utf16le') : buffer.toString('utf8');
+	return text
+		.replace(/^\uFEFF/, '')
+		.split(/\r?\n/)
+		.map(line => line.trim())
+		.filter(line => line.length > 0)
+		.join('\n');
+}
+
+/**
+ * @param {string} distro
+ * @param {string[]} args
+ */
+function distroExec(distro, args) {
+	return ['-d', distro, '-e', ...args];
+}
+
+/**
+ * @param {{ wslPath?: string, spawn?: typeof spawnChild, cwd?: string, timeoutMs?: number }} [options]
+ * @returns {IWslRunner}
+ */
+function createWslRunner(options = {}) {
+	const wslPath = options.wslPath ?? 'wsl.exe';
+	const spawn = options.spawn ?? spawnChild;
+	const defaultTimeout = options.timeoutMs ?? 30000;
+
+	return {
+		exec(args, opts = {}) {
+			const timeoutMs = opts.timeoutMs ?? defaultTimeout;
+			return new Promise((resolve, reject) => {
+				const child = spawn(wslPath, args, { cwd: options.cwd, windowsHide: true });
+				/** @type {Buffer[]} */
+				const out = [];
+				/** @type {Buffer[]} */
+				const err = [];
+				let settled = false;
+				const timer = setTimeout(() => {
+					if (settled) {
+						return;
+					}
+					settled = true;
+					child.kill();
+					reject(new Error(`Timed out after ${timeoutMs} ms: wsl.exe ${args.join(' ')}`));
+				}, timeoutMs);
+				timer.unref?.();
+
+				child.stdout?.on('data', (chunk) => out.push(chunk));
+				child.stderr?.on('data', (chunk) => err.push(chunk));
+				child.on('error', (error) => {
+					if (settled) {
+						return;
+					}
+					settled = true;
+					clearTimeout(timer);
+					reject(error);
+				});
+				child.on('close', (code) => {
+					if (settled) {
+						return;
+					}
+					settled = true;
+					clearTimeout(timer);
+					resolve({ code: code ?? -1, stdout: Buffer.concat(out), stderr: Buffer.concat(err) });
+				});
+
+				if (opts.input !== undefined) {
+					child.stdin?.end(opts.input);
+				} else {
+					child.stdin?.end();
+				}
+			});
+		},
+		spawn(args) {
+			const child = spawn(wslPath, args, { cwd: options.cwd, windowsHide: true });
+			return { child, stdout: child.stdout, stderr: child.stderr };
+		}
+	};
+}
+
+/**
+ * @param {string} stdout
+ * @returns {IDistro[]}
+ */
+function parseDistroTable(stdout) {
+	/** @type {IDistro[]} */
+	const distros = [];
+	for (const line of stdout.split(/\r?\n/).map(l => l.trim())) {
+		// Lines arrive trimmed, so the leading space of a non-default row is gone.
+		const match = /^(\*)?\s*(.+?)\s+(\w+)\s+([12])$/.exec(line);
+		if (!match) {
+			continue;
+		}
+		const [, marker, name, state, version] = match;
+		distros.push({ name: name.trim(), isDefault: marker === '*', version: version === '1' ? '1' : '2', state });
+	}
+	return distros;
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @returns {Promise<IDistro[]>}
+ */
+async function listDistros(runner) {
+	const result = await runner.exec(['--list', '--verbose']);
+	if (result.code !== 0) {
+		throw new Error(`wsl --list --verbose failed (${result.code}): ${decodeWslOutput(result.stderr)}`);
+	}
+	return parseDistroTable(decodeWslOutput(result.stdout));
+}
+
+/**
+ * @param {IDistro[]} list
+ * @returns {string}
+ */
+function defaultDistro(list) {
+	const marked = list.find(d => d.isDefault);
+	if (marked) {
+		return marked.name;
+	}
+	if (list.length === 0) {
+		throw new Error('No WSL distro is installed');
+	}
+	return list[0].name;
+}
+
+/**
+ * docker-desktop / docker-desktop-data are plumbing distros; offering them as
+ * places to open a folder is noise, unless the user made one the default.
+ * @param {IDistro[]} list
+ * @returns {IDistro[]}
+ */
+function visibleDistros(list) {
+	return list.filter(d => d.isDefault || !/^docker-desktop/i.test(d.name));
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @param {string} distro
+ * @returns {Promise<string>}
+ */
+async function distroHome(runner, distro) {
+	const result = await runner.exec(distroExec(distro, ['printenv', 'HOME']));
+	const home = decodeWslOutput(result.stdout);
+	if (result.code !== 0 || home.length === 0) {
+		throw new Error(`Could not read $HOME in ${distro} (${result.code}): ${decodeWslOutput(result.stderr)}`);
+	}
+	return home.split('\n')[0];
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @param {string} distro
+ * @returns {Promise<boolean>}
+ */
+async function isWsl1(runner, distro) {
+	const list = await listDistros(runner);
+	const found = list.find(d => d.name === distro);
+	return found?.version === '1';
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @param {string} distro
+ * @returns {Promise<'missing' | 'ok'>}
+ */
+async function distroStatus(runner, distro) {
+	try {
+		const result = await runner.exec(distroExec(distro, ['true']));
+		return result.code === 0 ? 'ok' : 'missing';
+	} catch {
+		return 'missing';
+	}
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @returns {Promise<{ installed: boolean, kernelUpdateRequired: boolean }>}
+ */
+async function wslStatus(runner) {
+	let result;
+	try {
+		result = await runner.exec(['--status']);
+	} catch (error) {
+		return { installed: false, kernelUpdateRequired: /kernel/i.test(String(error)) };
+	}
+	const stderr = decodeWslOutput(result.stderr);
+	if (result.code !== 0 && /not installed|not enabled/i.test(stderr)) {
+		return { installed: false, kernelUpdateRequired: false };
+	}
+	return { installed: true, kernelUpdateRequired: /kernel/i.test(stderr) };
+}
+
+module.exports = {
+	decodeWslOutput,
+	createWslRunner,
+	parseDistroTable,
+	listDistros,
+	defaultDistro,
+	visibleDistros,
+	distroHome,
+	isWsl1,
+	distroStatus,
+	wslStatus
+};
diff --git a/extensions/picket-remote-wsl/src/log.js b/extensions/picket-remote-wsl/src/log.js
new file mode 100644
index 00000000..918896a0
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/log.js
@@ -0,0 +1,45 @@
+'use strict';
+
+const vscode = require('vscode');
+const { appendFile, mkdir } = require('node:fs/promises');
+const { dirname, join } = require('node:path');
+
+/**
+ * Two sinks so a user can read the log in the editor and a supporter can ask
+ * for a file: the OutputChannel is live, the file survives a closed window.
+ * @param {vscode.ExtensionContext} context
+ */
+function createLog(context) {
+	const channel = vscode.window.createOutputChannel('Picket WSL');
+	const file = join(context.logUri.fsPath, 'picket-wsl.log');
+	context.subscriptions.push(channel);
+
+	/** @param {unknown[]} parts */
+	function write(parts) {
+		const line = parts.map(p => (typeof p === 'string' ? p : String(p))).join(' ');
+		channel.appendLine(line);
+		void mkdir(dirname(file), { recursive: true })
+			.then(() => appendFile(file, `${new Date().toISOString()} ${line}\n`))
+			.catch(() => { /* the channel already has it; a log file failure must not throw */ });
+	}
+
+	return {
+		/** @param {...unknown} parts */
+		info(...parts) {
+			write(parts);
+		},
+		/** @param {...unknown} parts */
+		error(...parts) {
+			write(['ERROR', ...parts]);
+		},
+		show() {
+			channel.show(true);
+		},
+		dispose() {
+			channel.dispose();
+		},
+		logFile: file
+	};
+}
+
+module.exports = { createLog };
diff --git a/extensions/picket-remote-wsl/src/payload.js b/extensions/picket-remote-wsl/src/payload.js
new file mode 100644
index 00000000..62602222
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/payload.js
@@ -0,0 +1,157 @@
+'use strict';
+
+const { createHash, randomBytes } = require('node:crypto');
+const { readFile, stat } = require('node:fs/promises');
+
+/**
+ * @typedef {{ kind: 'file', path: string } | { kind: 'embedded', path: string } | { kind: 'url', url: string }} ISource
+ * @typedef {{ id: string, kind: 'server' | 'extensions', version: string, file: string, size: number, sha256: string, embedded: boolean, embeddedPath?: string }} IComponent
+ */
+
+/**
+ * `sha256sum` writes two spaces, `shasum -a 256` writes one; some tools add a
+ * binary marker. Anything else on the line is junk from a merged log.
+ * @param {string} text
+ * @returns {Map<string, string>}
+ */
+function parseSha256Sums(text) {
+	/** @type {Map<string, string>} */
+	const sums = new Map();
+	for (const line of text.split(/\r?\n/)) {
+		const match = /^([0-9a-fA-F]{64})\s+\*?(.+)$/.exec(line.trim());
+		if (match) {
+			sums.set(match[2].trim(), match[1].toLowerCase());
+		}
+	}
+	return sums;
+}
+
+/**
+ * Three sources, in the order a user would expect them to win: a file they
+ * pointed at, the copy shipped inside the build, then the configured mirror.
+ * @param {IComponent} component
+ * @param {{ explicitPath?: string, embeddedDir?: string, baseUrl?: string, exists?: (path: string) => Promise<boolean> }} options
+ * @returns {Promise<ISource>}
+ */
+async function chooseSource(component, options) {
+	const exists = options.exists ?? (async (path) => {
+		try {
+			return (await stat(path)).isFile();
+		} catch {
+			return false;
+		}
+	});
+
+	if (options.explicitPath && await exists(options.explicitPath)) {
+		return { kind: 'file', path: options.explicitPath };
+	}
+	if (options.embeddedDir) {
+		const embedded = joinPath(options.embeddedDir, component.file);
+		if (await exists(embedded)) {
+			return { kind: 'embedded', path: embedded };
+		}
+	}
+	if (options.baseUrl) {
+		return { kind: 'url', url: `${options.baseUrl.replace(/\/+$/, '')}/${component.file}` };
+	}
+	throw new Error(`No source for ${component.id}: explicit path missing, no embedded payload, and no base URL configured`);
+}
+
+/** @param {string} a @param {string} b */
+function joinPath(a, b) {
+	return `${a.replace(/[\\/]+$/, '')}/${b}`;
+}
+
+/**
+ * @param {string} path
+ * @returns {Promise<string>}
+ */
+async function sha256OfFile(path) {
+	return createHash('sha256').update(await readFile(path)).digest('hex');
+}
+
+/**
+ * @param {Buffer} bytes
+ * @returns {string}
+ */
+function sha256OfBuffer(bytes) {
+	return createHash('sha256').update(bytes).digest('hex');
+}
+
+/**
+ * Downloads a payload, reporting progress without flooding the caller.
+ * @param {string} url
+ * @param {{ fetchImpl?: typeof fetch, onProgress?: (progress: { downloaded: number, total: number }) => void }} options
+ * @returns {Promise<Buffer>}
+ */
+async function download(url, options) {
+	const fetchImpl = options.fetchImpl ?? globalThis.fetch;
+	const response = await fetchImpl(url);
+	if (!response.ok) {
+		throw new Error(`Download failed for ${url}: HTTP ${response.status}`);
+	}
+	const total = Number(response.headers.get('content-length') ?? 0);
+	const onProgress = options.onProgress;
+	let downloaded = 0;
+	let lastReport = 0;
+	/** @type {Buffer[]} */
+	const chunks = [];
+	if (response.body) {
+		for await (const chunk of /** @type {any} */ (response.body)) {
+			const buf = Buffer.from(chunk);
+			chunks.push(buf);
+			downloaded += buf.length;
+			const now = Date.now();
+			if (onProgress && now - lastReport >= 100) {
+				lastReport = now;
+				onProgress({ downloaded, total });
+			}
+		}
+	} else {
+		const buf = Buffer.from(await response.arrayBuffer());
+		chunks.push(buf);
+		downloaded = buf.length;
+	}
+	onProgress?.({ downloaded, total: total || downloaded });
+	return Buffer.concat(chunks);
+}
+
+/**
+ * Verifies on the Windows side, then extracts inside the distro by piping the
+ * archive to `tar -xzf -` over stdin: no temporary copy inside the VM, and a
+ * half-written directory can never be mistaken for an install.
+ *
+ * The archive must be flat at its root (`bin/`, `out/`, `product.json`), which
+ * Task 12 asserts when it packages the payload.
+ * @param {{ runner: any, distro: string, component: IComponent, source: ISource, payloadRoot: string, fetchImpl?: typeof fetch, onProgress?: (progress: { downloaded: number, total: number }) => void }} options
+ * @returns {Promise<{ payloadDir: string, source: ISource }>}
+ */
+async function installPayload(options) {
+	const { runner, distro, component, source, payloadRoot } = options;
+	const bytes = source.kind === 'url'
+		? await download(source.url, { fetchImpl: options.fetchImpl, onProgress: options.onProgress })
+		: await readFile(source.path);
+
+	const actual = sha256OfBuffer(bytes);
+	if (actual !== component.sha256.toLowerCase()) {
+		throw new Error(`Checksum mismatch for ${component.file}: expected ${component.sha256.toLowerCase()}, got ${actual}`);
+	}
+
+	const finalDir = `${payloadRoot}/server-${component.version}`;
+	const tmpDir = `${payloadRoot}/.tmp-${randomBytes(4).toString('hex')}`;
+
+	const prepare = await runner.exec(['-d', distro, '-e', 'sh', '-c', 'mkdir -p "$1" && rm -rf "$2"', 'sh', payloadRoot, tmpDir]);
+	if (prepare.code !== 0) {
+		throw new Error(`Could not prepare ${payloadRoot} in ${distro}: ${prepare.stderr}`);
+	}
+	const unpack = await runner.exec(
+		['-d', distro, '-e', 'sh', '-c', 'rm -rf "$2" && tar -xzf - -C "$1" && mv "$1" "$2"', 'sh', tmpDir, finalDir],
+		{ input: bytes }
+	);
+	if (unpack.code !== 0) {
+		throw new Error(`Could not unpack ${component.file} in ${distro}: ${unpack.stderr}`);
+	}
+	return { payloadDir: finalDir, source };
+}
+
+module.exports = { parseSha256Sums, chooseSource, sha256OfFile, installPayload };
