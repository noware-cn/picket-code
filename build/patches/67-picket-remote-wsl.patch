+test('a proxy that refuses CONNECT reports the proxy status line', async () => {
+	const refusing = net.createServer((client) => {
+		client.once('data', () => client.write('HTTP/1.1 403 Forbidden\r\n\r\n'));
+	});
+	await withServer(refusing, async (port) => {
+		await assert.rejects(
+			() => downloadFile('https://mirror.corp/payload.tar.gz', { proxy: parseProxySetting(`127.0.0.1:${port}`) }),
+			/refused CONNECT mirror\.corp:443: HTTP\/1\.1 403 Forbidden/
+		);
+	});
