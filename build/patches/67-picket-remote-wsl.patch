index 00000000..97a53f86
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/resolver.js
@@ -0,0 +1,443 @@
+'use strict';
+
+const { listDistros, defaultDistro, visibleDistros, distroHome } = require('./distro.js');
+const { compareVersions, normalizeWant } = require('./version.js');
+const { serverPaths, versionFromPayloadDir, runtimeFileFor, buildServerArgs, newConnectionToken, lockAndRead, readRuntime, lockAgeMs, isStartLocked, acquireLock, releaseLock, writeRuntime, clearRuntime, startServer, stopServer } = require('./launch.js');
+const { probeServer } = require('./probe.js');
+const { parseAuthority } = require('./remoteUri.js');
+const { detectIcode } = require('./icode.js');
+const { chooseTunnelMode, readWslConfigFile, wslConfigPath } = require('./preflight.js');
+const { createStdioTunnel } = require('./tunnel.js');
+
+/** @typedef {{ port: number, token: string, version: string, commit: string, pid: number, startedAt: string, tunnelMode?: string, icode?: string }} IRuntimeInfo */
+/** @typedef {{ host: string, port: number, connectionToken: string }} IResolverResult */
+/** @typedef {{ info(...parts: unknown[]): void, error(...parts: unknown[]): void }} ILog */
+/** @typedef {{ ensure(id: string): Promise<{ payloadDir: string }> }} IComponentManager */
+/** @typedef {{ defaultDistro?: string, startTimeoutSeconds?: number, probeRetrySeconds?: number, probeRetryTimeoutMs?: number, loginShell?: boolean, icodePath?: string, tunnelMode?: string }} ISettings */
+
+/**
+ * A remote authority names a distro and nothing else; everything a connection
+ * needs (port, token) is discovered by starting or adopting the one server that
+ * distro is allowed to run.
+ * @param {{
+ *   runner: any,
+ *   product?: { commit: string, version: string, picketServerMinVersion: string },
+ *   components: (ctx: { distro: string, home: string, runner: any }) => IComponentManager,
+ *   settings: ISettings,
+ *   log: ILog,
+ *   platform?: string,
+ *   readWslConfig?: () => Promise<{ localhostForwarding?: boolean, networkingMode?: string }>,
+ *   warn?: (message: string) => void,
+ *   startServer?: typeof startServer,
+ *   stopServer?: typeof stopServer,
+ *   probe?: (target: { host: string, port: number, token: string }) => Promise<'alive' | 'bad-token' | 'dead'>,
+ *   createTunnel?: typeof createStdioTunnel
+ * }} options
+ */
+function createResolver(options) {
+	const { runner, components, log } = options;
+	const settings = options.settings ?? {};
+	const start = options.startServer ?? startServer;
+	const stop = options.stopServer ?? stopServer;
+	const probe = options.probe ?? (target => probeServer(target));
+	const platform = options.platform ?? process.platform;
+	const readWslConfig = options.readWslConfig ?? (() => readWslConfigFile(wslConfigPath()));
+	const warn = options.warn ?? (() => { });
+	const createTunnel = options.createTunnel ?? createStdioTunnel;
+	/** @type {Map<string, Promise<IResolverResult>>} */
+	const inFlight = new Map();
+	/** @type {Map<string, Promise<{ localPort: number, dispose(): Promise<void> }>>} */
+	const tunnels = new Map();
+	/** @type {Set<string>} */
+	const warned = new Set();
+
+	/** @param {string} key @param {string} message */
+	function warnOnce(key, message) {
+		if (warned.has(key)) {
+			return;
+		}
+		warned.add(key);
+		warn(message);
+	}
+
+	/** What the product stamp says this client may talk to. */
+	function want() {
+		return normalizeWant({ commit: options.product?.commit, minVersion: options.product?.picketServerMinVersion });
+	}
+
+	/**
+	 * A running server is adopted across windows only when it is ours in both
+	 * senses: same commit, and not older than the minimum this client needs.
+	 * @param {IRuntimeInfo} info
+	 */
+	function reusable(info) {
+		try {
+			const { commit, minVersion, anyCommit } = want();
+			return (anyCommit || info?.commit === commit) && compareVersions(String(info.version), minVersion) >= 0;
+		} catch {
+			// An unparsable record is a record from before this scheme existed.
+			return false;
+		}
+	}
+
+	/**
+	 * @param {import('./distro.js').IDistro[]} list
+	 * @param {string} requested
+	 * @returns {string} the name wsl.exe answers to
+	 */
+	function pickDistro(list, requested) {
+		const wanted = String(requested).trim().toLowerCase();
+		const match = list.find(d => d.name.toLowerCase() === wanted);
+		if (match) {
+			return match.name;
+		}
+		const known = visibleDistros(list).map(d => d.name).join(', ') || 'none';
+		throw new Error(`Distro "${requested}" not found. Installed: ${known}`);
+	}
+
+	/**
+	 * @param {string} requested a distro name, possibly '' for the default
+	 * @returns {Promise<string>} the name wsl.exe answers to
+	 */
+	async function matchDistro(requested) {
+		const list = await listDistros(runner);
+		return requested ? pickDistro(list, requested) : defaultDistro(list);
+	}
+
+	/**
+	 * `wsl+Ubuntu` is what the official extension wrote and `picket-wsl+Ubuntu`
+	 * is ours, so both have to mean the same window. `Ubuntu@<host>` is a window
+	 * the official extension opened from inside another remote; there is no
+	 * equivalent here, and pretending otherwise would resolve to a server the
+	 * inner window already owns.
+	 * @param {string} authority
+	 * @returns {Promise<string>} the name wsl.exe answers to
+	 */
+	async function resolveDistro(authority) {
+		const parsed = parseAuthority(authority);
+		if (!parsed) {
+			throw new Error(`"${authority}" is not a WSL remote authority`);
+		}
+		if (parsed.distro.includes('@')) {
+			throw new Error(`Nested authorities are not supported: "${parsed.distro}". Open the folder from a local window instead.`);
+		}
+		if (parsed.distro) {
+			return matchDistro(parsed.distro);
+		}
+		// An authority with no distro asks for "the default one". The Picket
+		// setting is the user's own answer to that question, so it wins; a stale
+		// entry falls back to WSL's default rather than failing every window.
+		const configured = String(settings.defaultDistro ?? '').trim();
+		const list = await listDistros(runner);
+		if (!configured) {
+			return defaultDistro(list);
+		}
+		try {
+			return pickDistro(list, configured);
+		} catch (error) {
+			log.info(`picket.wsl.defaultDistro "${configured}" is not installed; using the WSL default distro`);
+			return defaultDistro(list);
+		}
+	}
+
+	/** @param {string} distro @param {number} port */
+	function tunnelKey(distro, port) {
+		return `${distro}:${port}`;
+	}
+
+	/**
+	 * The recorded port is inside the VM. When the tunnel is the only way in, the
+	 * address this window can dial is the tunnel's, and it is created on first use
+	 * and shared by every later request for the same server.
+	 * @param {IRuntimeInfo} info
+	 * @param {string} distro
+	 * @param {ReturnType<typeof serverPaths>} paths
+	 * @returns {Promise<{ host: string, port: number }>}
+	 */
+	async function endpointFor(info, distro, paths) {
+		if (info.tunnelMode !== 'stdio') {
+			return { host: '127.0.0.1', port: info.port };
+		}
+		const key = tunnelKey(distro, info.port);
+		let pending = tunnels.get(key);
+		if (!pending) {
+			pending = createTunnel({ runner, distro, serverPort: info.port, nodePath: paths.node, log });
+			pending.catch(() => tunnels.delete(key));
+			tunnels.set(key, pending);
+		}
+		const tunnel = await pending;
+		log.info(`stdio tunnel for ${distro}: 127.0.0.1:${tunnel.localPort} carries port ${info.port}`);
+		return { host: '127.0.0.1', port: tunnel.localPort };
+	}
+
+	/** @param {string} distro @param {number} port */
+	async function disposeTunnel(distro, port) {
+		const key = tunnelKey(distro, port);
+		const pending = tunnels.get(key);
+		if (!pending) {
+			return;
+		}
+		tunnels.delete(key);
+		await pending.then(tunnel => tunnel.dispose(), () => { /* never bootstrapped */ });
+	}
+
+	/**
+	 * @param {IRuntimeInfo} info
+	 * @param {string} distro
+	 * @param {ReturnType<typeof serverPaths>} paths
+	 * @returns {Promise<'alive' | 'bad-token' | 'dead'>}
+	 */
+	async function probeRecorded(info, distro, paths) {
+		try {
+			const endpoint = await endpointFor(info, distro, paths);
+			return await probe({ host: endpoint.host, port: endpoint.port, token: info.token });
+		} catch (error) {
+			log.info(`The server recorded for ${distro} could not be reached: ${error.message}`);
+			return 'dead';
+		}
+	}
+
+	/**
+	 * `remote.WSL.serverProbeRetryTimeout` (seconds, `0` disables retries): a
+	 * record that does not answer yet is not a record that is wrong — the server
+	 * may still be starting, or the tunnel may still be coming up. Waiting is
+	 * cheaper than a second server fighting the first over the data directory.
+	 */
+	function probeRetryMs() {
+		const value = settings.probeRetryTimeoutMs;
+		return typeof value === 'number' && Number.isFinite(value) && value >= 0 ? value : 60000;
+	}
+
+	/** @param {string} distro @param {number} pid */
+	async function isProcessAlive(distro, pid) {
+		if (!Number.isInteger(pid) || pid <= 0) {
+			return false;
+		}
+		const result = await runner.exec(['-d', distro, '-e', 'sh', '-c', 'kill -0 "$1" 2>/dev/null', 'sh', String(pid)])
+			.catch(() => ({ code: 1 }));
+		return result.code === 0;
+	}
+
+	/**
+	 * @param {IRuntimeInfo} info
+	 * @param {string} distro
+	 * @param {ReturnType<typeof serverPaths>} paths
+	 * @returns {Promise<'alive' | 'bad-token' | 'dead'>}
+	 */
+	async function probeWithRetries(info, distro, paths) {
+		const deadline = Date.now() + probeRetryMs();
+		let verdict = await probeRecorded(info, distro, paths);
+		while (verdict === 'dead' && Date.now() < deadline) {
+			// A crash or a reboot leaves a record whose process is gone. No amount
+			// of waiting brings it back, and the caller needs a start either way.
+			if (!await isProcessAlive(distro, info.pid)) {
+				return verdict;
+			}
+			const interval = Math.max(10, (settings.probeRetrySeconds ?? 2) * 1000);
+			await new Promise(resolve => setTimeout(resolve, Math.min(interval, Math.max(1, deadline - Date.now()))));
+			verdict = await probeRecorded(info, distro, paths);
+		}
+		return verdict;
+	}
+
+	/**
+	 * @param {IRuntimeInfo} info
+	 * @param {string} distro
+	 * @param {ReturnType<typeof serverPaths>} paths
+	 * @returns {Promise<IResolverResult>}
+	 */
+	async function coordinates(info, distro, paths) {
+		const endpoint = await endpointFor(info, distro, paths);
+		return { host: endpoint.host, port: endpoint.port, connectionToken: info.token };
+	}
+
+	/** @param {string} distro @returns {Promise<IResolverResult>} */
+	async function adoptOrStart(distro) {
+		const home = await distroHome(runner, distro);
+		const runtimeFile = runtimeFileFor(home, distro);
+
+		const stored = await lockAndRead(runner, distro, runtimeFile);
+		if (stored && reusable(stored)) {
+			const paths = serverPaths(home, stored.version);
+			const verdict = await probeWithRetries(stored, distro, paths);
+			if (verdict === 'alive') {
+				log.info(`Reusing ${paths.binary} on port ${stored.port} for ${distro}`);
+				return coordinates(stored, distro, paths);
+			}
+			log.info(`The recorded server for ${distro} answered "${verdict}"; starting a new one`);
+			await disposeTunnel(distro, stored.port);
+		}
+
+		const acquired = await acquireLock(runner, distro, runtimeFile) || await takeOverStaleLock(distro, runtimeFile);
+		if (!acquired) {
+			// Another window owns the lock; its server is the one we want.
+			const adopted = await waitForServer(distro, runtimeFile, home);
+			if (adopted) {
+				log.info(`Another window started the server for ${distro} on port ${adopted.port}; adopting it`);
+				return coordinates(adopted, distro, serverPaths(home, adopted.version));
+			}
+			throw new Error(`Another window is starting the server for ${distro}, but it did not appear within ${formatSeconds(timeoutMs())}`);
+		}
+
+		try {
+			await clearRuntime(runner, runtimeFile, distro).catch(error => log.error(`Could not clear ${runtimeFile}: ${error.message}`));
+			return await startFresh(distro, home);
+		} finally {
+			await releaseLock(runner, distro, runtimeFile).catch(error => log.error(`Could not release ${runtimeFile}.lock: ${error.message}`));
+		}
+	}
+
+	/** @param {number} ms */
+	function formatSeconds(ms) {
+		return ms % 1000 === 0 ? `${ms / 1000} s` : `${ms} ms`;
+	}
+
+	/**
+	 * A start that died without releasing its lock must not block every future
+	 * window for the rest of the session, so a lock older than one start timeout
+	 * is taken over. Two windows may both decide that; `mkdir` still picks one.
+	 * @param {string} distro
+	 * @param {string} runtimeFile
+	 * @returns {Promise<boolean>}
+	 */
+	async function takeOverStaleLock(distro, runtimeFile) {
+		if (!await isStartLocked(runner, distro, runtimeFile)) {
+			return acquireLock(runner, distro, runtimeFile);
+		}
+		const age = await lockAgeMs(runner, distro, runtimeFile);
+		// `stat` resolves whole seconds, so anything under one second is noise; a
+		// lock is only "stale" once it has outlived a full start window.
+		if (age === undefined || age <= Math.max(timeoutMs(), 1000)) {
+			return false;
+		}
+		log.info(`Taking over a stale start lock for ${distro} (${formatSeconds(Math.round(age))} old)`);
+		await releaseLock(runner, distro, runtimeFile).catch(error => log.error(`Could not clear the stale lock: ${error.message}`));
+		return acquireLock(runner, distro, runtimeFile);
+	}
+
+	function timeoutMs() {
+		return (settings.startTimeoutSeconds ?? 90) * 1000;
+	}
+
+	/**
+	 * @param {string} distro
+	 * @param {string} runtimeFile
+	 * @param {string} home
+	 * @returns {Promise<IRuntimeInfo | undefined>}
+	 */
+	async function waitForServer(distro, runtimeFile, home) {
+		const deadline = Date.now() + timeoutMs();
+		const interval = Math.max(10, (settings.probeRetrySeconds ?? 2) * 1000);
+		while (Date.now() < deadline) {
+			const info = await readRuntime(runner, distro, runtimeFile).catch(() => undefined);
+			if (info && reusable(info) && await probeRecorded(info, distro, serverPaths(home, info.version)) === 'alive') {
+				return info;
+			}
+			await new Promise(resolve => setTimeout(resolve, Math.min(interval, Math.max(1, deadline - Date.now()))));
+		}
+		return undefined;
+	}
+
+	/**
+	 * @param {string} distro
+	 * @param {string} home
+	 * @returns {Promise<IResolverResult>}
+	 */
+	async function startFresh(distro, home) {
+		const runtimeFile = runtimeFileFor(home, distro);
+		const manager = components({ distro, home, runner });
+		// The payload decides the version: whatever still satisfies the minimum
+		// is what runs, even when the catalog has moved on.
+		const installed = await manager.ensure('wsl-server');
+		const version = versionFromPayloadDir(installed.payloadDir);
+		const paths = serverPaths(home, version);
+
+		const icode = await detectIcode({ runner, distro, configuredPath: settings.icodePath ?? '' });
+		if (icode.source === 'missing') {
+			warnOnce(`${distro}:icode`, 'WSL 里未找到 iCode：AI 功能不可用。设置 Picket: WSL › ICode Path 可指定路径。');
+		}
+		const tunnelMode = chooseTunnelMode({ configured: settings.tunnelMode ?? 'auto', wslConfig: await readWslConfig(), platform });
+		log.info(`Starting ${paths.binary}: tunnel=${tunnelMode}, icode=${icode.path ?? 'missing'} (${icode.source})`);
+
+		const connectionToken = newConnectionToken();
+		const args = buildServerArgs({ paths, connectionToken, distro, icodeBin: icode.path ?? '', loginShell: settings.loginShell !== false });
+		const info = await start({
+			runner,
+			distro,
+			args,
+			runtimeFile,
+			timeoutMs: timeoutMs(),
+			extra: { tunnelMode, icode: icode.source, commit: want().commit },
+			log
+		});
+		// The start records the port the moment it parses it; writing again here
+		// keeps the promise that the lock is released only once the record on disk
+		// is readable, so a waiting window adopts this server instead of starting a
+		// second one.
+		await writeRuntime(runner, runtimeFile, info, distro)
+			.catch(error => log.error(`Could not write ${runtimeFile}: ${error.message}`));
+		return coordinates(info, distro, paths);
+	}
+
+	return {
+		/** @param {string} authority @returns {Promise<string>} */
+		resolveDistro,
+		/** @param {string} authority @returns {Promise<IResolverResult>} */
+		async resolve(authority) {
+			const distro = await resolveDistro(authority);
+			const pending = inFlight.get(distro);
+			if (pending) {
+				return pending;
+			}
+			const promise = adoptOrStart(distro).finally(() => inFlight.delete(distro));
+			inFlight.set(distro, promise);
+			return promise;
+		},
+		/** @param {string} requested @returns {Promise<void>} */
+		async stop(requested) {
+			const distro = await matchDistro(requested ?? '');
+			const home = await distroHome(runner, distro);
+			const runtimeFile = runtimeFileFor(home, distro);
+
+			// Start and stop take the same distro lock. Without it a stop that ran
+			// beside a start in another window would read a record that is about to
+			// be replaced and then kill the server that start had just brought up.
+			const acquired = await acquireLock(runner, distro, runtimeFile) || await takeOverStaleLock(distro, runtimeFile);
+			if (!acquired) {
+				throw new Error(`另一个窗口正在启动或停止 ${distro} 的服务器，请稍后再试`);
+			}
+			try {
+				const info = await readRuntime(runner, distro, runtimeFile);
+				if (!info) {
+					log.info(`No server is recorded for ${distro}`);
+					return;
+				}
+				try {
+					await stop({
+						runner,
+						distro,
+						runtimeFile,
+						info,
+						log,
+						probe: (target) => probe({ host: '127.0.0.1', port: target.port, token: target.token }),
+						dataDir: serverPaths(home, info.version).dataDir
+					});
+				} finally {
+					// The tunnel listens on a local port for a server that is gone; leaving
+					// it behind would keep the port and the map entry for the next start.
+					await disposeTunnel(distro, info.port).catch(error => log.error(`Could not dispose the tunnel for ${distro}: ${error.message}`));
+				}
+			} finally {
+				await releaseLock(runner, distro, runtimeFile).catch(error => log.error(`Could not release ${runtimeFile}.lock: ${error.message}`));
+			}
+		},
+		async dispose() {
+			inFlight.clear();
+			const pending = [...tunnels.values()];
+			tunnels.clear();
+			await Promise.all(pending.map(promise => promise.then(tunnel => tunnel.dispose(), () => { /* never bootstrapped */ })));
+		}
+	};
+}
+
+module.exports = { createResolver };
diff --git a/extensions/picket-remote-wsl/src/settings.js b/extensions/picket-remote-wsl/src/settings.js
new file mode 100644
index 00000000..c8ba4972
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/settings.js
@@ -0,0 +1,85 @@
+'use strict';
+
+/**
+ * Two of the official extension's settings have a real meaning in this
+ * implementation, and a user who came from `ms-vscode-remote.remote-wsl`
+ * expects them to keep working. Everything else it offers describes how *its*
+ * server is built, so the report names those keys instead of pretending.
+ */
+
+const PROBE_RETRY_DEFAULT_MS = 60000;
+/**
+ * The official setting is seconds of retrying; five minutes is long enough for
+ * a slow distro to come up and short enough that a typo cannot look like a hang.
+ */
+const PROBE_RETRY_MAX_MS = 300000;
+
+const IGNORED = [
+	['remote.WSL.debug', 'the Picket WSL log already records every step'],
+	['remote.WSL.downloadInBackground', 'a payload is fetched on first use only'],
+	['remote.WSL.experimental.scriptLessStartup', 'the server is always started through sh'],
+	['remote.WSL.fileWatcher.polling', 'the server uses native file watching'],
+	['remote.WSL.fileWatcher.pollingInterval', 'the server uses native file watching'],
+	['remote.WSL1.connectionMethod', 'WSL 1 is not supported'],
+	['remote.WSL2.connectionMethod', 'picket.wsl.tunnelMode decides how the port is reached']
+];
+
+/**
+ * `remote.WSL.serverProbeRetryTimeout` counts whole seconds and 0 means "do not
+ * retry". Anything else is treated as absent, which is what the official
+ * extension does too.
+ * @param {(key: string) => any} readOfficial
+ */
+function probeRetryTimeoutMs(readOfficial) {
+	const seconds = readOfficial('remote.WSL.serverProbeRetryTimeout');
+	if (typeof seconds !== 'number' || !Number.isInteger(seconds) || seconds < 0) {
+		return PROBE_RETRY_DEFAULT_MS;
+	}
+	return Math.min(seconds * 1000, PROBE_RETRY_MAX_MS);
+}
+
+/**
+ * @param {{ readPicket: (key: string) => any, readOfficial: (key: string) => any }} readers
+ * @returns {{ loginShell: boolean, probeRetryTimeoutMs: number }}
+ */
+function resolveSettings(readers) {
+	const shell = readers.readPicket('shell');
+	const login = shell === 'login' ? true
+		: shell === 'none' ? false
+			: readers.readOfficial('remote.WSL.useShellEnvironment') !== false;
+	return { loginShell: login, probeRetryTimeoutMs: probeRetryTimeoutMs(readers.readOfficial) };
+}
+
+/** @param {any} value */
+function format(value) {
+	return value === undefined ? '(not set)' : String(value);
+}
+
+/**
+ * The report is where a user finds out that a setting they carried over does
+ * nothing, so the reason has to be on the line itself.
+ * @param {{ readPicket: (key: string) => any, readOfficial: (key: string) => any }} readers
+ * @returns {string[]}
+ */
+function describeOfficialSettings(readers) {
+	const shell = readers.readPicket('shell');
+	const officialShell = readers.readOfficial('remote.WSL.useShellEnvironment');
+	const resolved = resolveSettings(readers);
+	const lines = [];
+
+	if (shell === 'login' || shell === 'none') {
+		lines.push(`remote.WSL.useShellEnvironment = ${format(officialShell)} (ignored: picket.wsl.shell = ${shell} decides)`);
+	} else {
+		lines.push(`remote.WSL.useShellEnvironment = ${format(officialShell)} (honoured: login shell ${resolved.loginShell ? 'on' : 'off'})`);
+	}
+
+	const seconds = readers.readOfficial('remote.WSL.serverProbeRetryTimeout');
+	lines.push(`remote.WSL.serverProbeRetryTimeout = ${format(seconds ?? 60)} (honoured: retry probes for ${resolved.probeRetryTimeoutMs} ms)`);
+
+	for (const [key, reason] of IGNORED) {
+		lines.push(`${key} = ${format(readers.readOfficial(key))} (ignored: ${reason})`);
+	}
+	return lines;
+}
+
+module.exports = { resolveSettings, describeOfficialSettings };
diff --git a/extensions/picket-remote-wsl/src/shim.js b/extensions/picket-remote-wsl/src/shim.js
new file mode 100644
index 00000000..f13a2ded
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/shim.js
@@ -0,0 +1,123 @@
+'use strict';
+
+// The in-distro `picket-code` shim: a small shell script that points the
+// payload's remote CLI at this Windows client and the current window's
+// authority, so `picket-code .` inside a distro opens a Picket WSL window.
+
+const { AUTHORITY_PREFIX } = require('./remoteUri.js');
+const { serverPaths } = require('./launch.js');
+
+/** @typedef {{ code: number, stdout: Buffer | string, stderr: Buffer | string }} IWslResult */
+
+/**
+ * POSIX single quoting: the only way to put an arbitrary string into one
+ * shell word. `'` becomes `'\''`, closing and reopening the quotes.
+ * @param {string} value
+ */
+function shQuote(value) {
+	return `'${String(value).replace(/'/g, `'\\''`)}'`;
+}
+
+/**
+ * @param {{ clientPath: string, authority: string, remoteCliPath: string }} options
+ * @returns {string}
+ */
+function shimScript({ clientPath, authority, remoteCliPath }) {
+	return [
+		'#!/bin/sh',
+		'# Generated by the Picket Code WSL extension — reinstall it from there.',
+		`export VSCODE_CLIENT_COMMAND=${shQuote(clientPath)}`,
+		`export VSCODE_CLI_AUTHORITY=${shQuote(authority)}`,
+		`exec ${shQuote(remoteCliPath)} "$@"`
+	].join('\n');
+}
+
+// One constant script per step; every value travels as a positional argument,
+// so nothing the distro reports can turn into shell syntax here.
+const INSPECT_SCRIPT = 'mkdir -p "$1" "$2"; if [ -L "$3" ]; then readlink -f "$3"; elif [ -e "$3" ]; then printf file; else printf none; fi';
+const WRITE_SCRIPT = 'cat > "$1" && chmod 755 "$1"';
+const LINK_SCRIPT = 'ln -sfn "$2" "$1"';
+// Prints `ok` only when the link resolves to our script and the script is
+// executable by the user who will run `picket-code`.
+const VERIFY_SCRIPT = 'if [ ! -x "$2" ]; then printf not-executable; elif [ "$(readlink -f "$1")" != "$(readlink -f "$2")" ]; then printf wrong-target; else printf ok; fi';
+const PROBE_SCRIPT = '"$1" --version >/dev/null 2>&1';
+const REMOVE_SCRIPT = 'rm -rf "$1" "$2"';
+
+/**
+ * Installs `<home>/.vscode-server/bin/picket-<version>/bin/picket-code` and links it
+ * to `<home>/.local/bin/picket-code`. An existing link that resolves inside
+ * our shim root is an upgrade; anything else is never overwritten. The last
+ * step probes that the Windows client is startable from inside the distro at
+ * all — with `[interop] enabled=false` in /etc/wsl.conf it never is, and no
+ * amount of reinstalling fixes that.
+ * @param {{
+ *   runner: { exec(args: string[], opts?: { input?: string | Buffer }): Promise<IWslResult> },
+ *   distro: string, home: string, version: string, clientPath: string
+ * }} options
+ * @returns {Promise<{ status: 'installed' | 'foreign-link' | 'failed', scriptPath: string, linkPath: string, message?: string }>}
+ */
+async function installShim({ runner, distro, home, version, clientPath }) {
+	const paths = serverPaths(home, version);
+	const scriptPath = `${paths.payloadDir}/bin/picket-code`;
+	const linkPath = paths.cliLink;
+	const shimRoot = `${paths.root}/bin`;
+
+	const inspect = await runner.exec(
+		['-d', distro, '-e', 'sh', '-c', INSPECT_SCRIPT, 'sh', `${paths.payloadDir}/bin`, `${home}/.local/bin`, linkPath]);
+	const current = String(inspect.stdout).trim();
+	if (current === 'file') {
+		return { status: 'foreign-link', scriptPath, linkPath, message: `${linkPath} 已存在且不是符号链接` };
+	}
+	if (current !== 'none' && !current.startsWith(`${shimRoot}/picket-`)) {
+		return { status: 'foreign-link', scriptPath, linkPath, message: current || `${linkPath} 状态未知` };
+	}
+
+	const script = shimScript({
+		clientPath,
+		authority: `${AUTHORITY_PREFIX}+${distro}`,
+		remoteCliPath: paths.remoteCli
+	});
+	const wrote = await runner.exec(['-d', distro, '-e', 'sh', '-c', WRITE_SCRIPT, 'sh', scriptPath], { input: script });
+	if (wrote.code !== 0) {
+		return { status: 'failed', scriptPath, linkPath, message: `无法写入 ${scriptPath}（exit ${wrote.code}）：${String(wrote.stderr ?? '').trim()}` };
+	}
+	const linked = await runner.exec(['-d', distro, '-e', 'sh', '-c', LINK_SCRIPT, 'sh', linkPath, scriptPath]);
+	if (linked.code !== 0) {
+		return { status: 'failed', scriptPath, linkPath, message: `无法创建 ${linkPath}（exit ${linked.code}）：${String(linked.stderr ?? '').trim()}` };
+	}
+	// A write that "succeeded" is not an install: the script has to be executable
+	// and the link has to point at it, or `picket-code .` silently runs something
+	// else (or nothing).
+	const verified = await runner.exec(['-d', distro, '-e', 'sh', '-c', VERIFY_SCRIPT, 'sh', linkPath, scriptPath]);
+	const verdict = String(verified.stdout).trim();
+	if (verdict !== 'ok') {
+		return { status: 'failed', scriptPath, linkPath, message: `${linkPath} 校验失败：${verdict || `exit ${verified.code}`}` };
+	}
+
+	const probe = await runner.exec(['-d', distro, '-e', 'sh', '-c', PROBE_SCRIPT, 'sh', clientPath]);
+	if (probe.code === 126 || probe.code === 127) {
+		return {
+			status: 'failed',
+			scriptPath,
+			linkPath,
+			message: `无法从 ${distro} 内启动 Windows 程序（exit ${probe.code}）。检查 /etc/wsl.conf 是否设置了 [interop] enabled=false。`
+		};
+	}
+	return { status: 'installed', scriptPath, linkPath };
+}
+
+/**
+ * Removes the link and every shim script we ever wrote (all tags). The shim
+ * root is ours alone — payloads, runtime and data live in sibling directories.
+ * @param {{
+ *   runner: { exec(args: string[], opts?: { input?: string | Buffer }): Promise<IWslResult> },
+ *   distro: string, home: string
+ * }} options
+ * @returns {Promise<void>}
+ */
+async function removeShim({ runner, distro, home }) {
+	const root = serverPaths(home, '').root;
+	await runner.exec(['-d', distro, '-e', 'sh', '-c', REMOVE_SCRIPT, 'sh', `${root}/bin`, `${home}/.local/bin/picket-code`]);
+}
+
+module.exports = { shQuote, shimScript, installShim, removeShim };
diff --git a/extensions/picket-remote-wsl/src/tree.js b/extensions/picket-remote-wsl/src/tree.js
new file mode 100644
index 00000000..7362fce7
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/tree.js
@@ -0,0 +1,52 @@
+'use strict';
+
+/**
+ * The tree is the only place where a distro's WSL version, whether it is the
+ * default and whether this window is connected to it are visible at once.
+ * @param {import('./distro.js').IDistro[]} list
+ * @param {{ activeDistro?: string }} [ctx]
+ * @returns {Array<{ id: string, distro: string, label: string, description: string, contextValue: 'activeDistro' | 'inactiveDistro', tooltip: string }>}
+ */
+function buildDistroNodes(list, ctx = {}) {
+	const active = (ctx.activeDistro ?? '').toLowerCase();
+	const nodes = list.map(distro => {
+		const connected = distro.name.toLowerCase() === active;
+		const description = [distro.isDefault ? 'default distro' : undefined, connected ? 'Connected' : 'Not Connected'];
+		return {
+			node: {
+				id: `distro:${distro.name}`,
+				distro: distro.name,
+				label: `${distro.name}（WSL ${distro.version}）`,
+				description: description.filter(Boolean).join(' · '),
+				contextValue: /** @type {'activeDistro' | 'inactiveDistro'} */ (connected ? 'activeDistro' : 'inactiveDistro'),
+				tooltip: `${distro.name}\nWSL ${distro.version} · ${distro.state}\n${connected ? 'Connected' : 'Not Connected'}`
+			},
+			position: distro.isDefault ? 0 : 1
+		};
+	});
+	return nodes
+		.map((entry, index) => ({ ...entry, index }))
+		.sort((a, b) => (a.position - b.position) || (a.index - b.index))
+		.map(entry => entry.node);
+}
+
+/**
+ * A blocked tree is not an empty tree: the single node is the whole explanation
+ * and the whole fix, because "nothing here" would leave a user guessing whether
+ * WSL is broken or the feature is off.
+ * @returns {{ id: string, distro: string, label: string, description: string, contextValue: 'blocked', blocked: true, command: string, tooltip: string }}
+ */
+function buildBlockedNode() {
+	return {
+		id: 'blocked:official',
+		distro: '',
+		label: '已禁用：检测到官方 Remote-WSL 扩展',
+		description: '卸载后自动恢复',
+		contextValue: 'blocked',
+		blocked: true,
+		command: 'picket.wsl.uninstallOfficial',
+		tooltip: 'WSL 功能已禁用\n\n官方 Remote-WSL 扩展与本扩展争用同一个 wsl+ 授权、同一个 ~/.vscode-server 目录和同一个服务端口，\n两者不能同时工作。卸载官方扩展（保留数据）后，WSL 功能立即恢复。'
+	};
+}
+
+module.exports = { buildDistroNodes, buildBlockedNode };
diff --git a/extensions/picket-remote-wsl/src/tunnel.js b/extensions/picket-remote-wsl/src/tunnel.js
new file mode 100644
index 00000000..07f34d81
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/tunnel.js
@@ -0,0 +1,239 @@
+'use strict';
+
+const net = require('node:net');
+
+/**
+ * Runs *inside* the distro. It is handed the port the server announced and dials
+ * 127.0.0.1 from there, so the bytes that follow cross only the pipe wsl.exe
+ * gives us. The ready line is the proof that all three layers hold: wsl.exe
+ * started, an in-VM node ran, and the server's listener answered.
+ */
+const PIPE_SCRIPT = `
+const net = require('node:net');
+const socket = net.connect(Number(process.argv[1]), '127.0.0.1');
+socket.setNoDelay(true);
+socket.on('error', (error) => { process.stderr.write(String(error.message) + '\\n'); process.exit(1); });
+socket.on('close', () => process.exit(0));
+process.stdin.on('error', () => process.exit(1));
+process.stdout.on('error', () => process.exit(1));
+socket.on('connect', () => {
+	process.stdout.write('PICKET-TUNNEL-READY\\n');
+	process.stdin.pipe(socket);
+	socket.pipe(process.stdout);
+});
+`;
+
+const READY = 'PICKET-TUNNEL-READY\n';
+const KILL_TIMEOUT_MS = 1000;
+
+/**
+ * Only used when Windows no longer forwards `127.0.0.1` into the VM. One
+ * listener per window, one child per connection — a child per window would be
+ * faster but would serialise every socket behind one pipe, and a websocket
+ * connection is not the only thing the workbench opens.
+ * @param {{
+ *   runner: { spawn(args: string[]): { child: import('node:child_process').ChildProcess, stdout: import('node:stream').Readable | null, stderr: import('node:stream').Readable | null } },
+ *   distro: string,
+ *   serverPort: number,
+ *   nodePath: string,
+ *   log?: { info(...parts: unknown[]): void, error(...parts: unknown[]): void },
+ *   preambleTimeoutMs?: number
+ * }} options
+ * @returns {Promise<{ localPort: number, dispose(): Promise<void> }>}
+ */
+function createStdioTunnel(options) {
+	const { runner, distro, serverPort, nodePath } = options;
+	const log = options.log ?? { info() { }, error() { } };
+	const preambleTimeoutMs = options.preambleTimeoutMs ?? 15000;
+	const host = '127.0.0.1';
+
+	/** @type {Set<import('node:child_process').ChildProcess>} */
+	const children = new Set();
+	/** @type {Set<net.Socket>} */
+	const sockets = new Set();
+	/** @type {{ resolve(): void, reject(error: Error): void } | undefined} */
+	let pendingBootstrap;
+	let localPort = 0;
+	let disposed = false;
+
+	/**
+	 * @param {import('node:child_process').ChildProcess} child
+	 * @returns {Promise<void>}
+	 */
+	function kill(child) {
+		if (child.exitCode !== null || child.signalCode !== null) {
+			children.delete(child);
+			return Promise.resolve();
+		}
+		return new Promise(resolve => {
+			let timer = /** @type {any} */ (undefined);
+			const finish = () => {
+				clearTimeout(timer);
+				children.delete(child);
+				resolve();
+			};
+			timer = setTimeout(finish, KILL_TIMEOUT_MS);
+			timer.unref?.();
+			child.once('exit', finish);
+			child.once('error', finish);
+			child.kill();
+		});
+	}
+
+	/**
+	 * Carries one accepted socket through its own child. Resolves once the
+	 * preamble has arrived; the pipes are what actually matter afterwards.
+	 * @param {net.Socket} socket
+	 * @returns {Promise<void>}
+	 */
+	function relay(socket) {
+		const spawned = runner.spawn(['-d', distro, '-e', nodePath, '-e', PIPE_SCRIPT, String(serverPort)]);
+		const child = spawned.child;
+		children.add(child);
+		// The runner contract promises stdout and stderr, not stdin: the writable
+		// end is only ever reachable through the child itself.
+		const stdin = child.stdin;
+
+		const stdout = spawned.stdout;
+		return new Promise((resolve, reject) => {
+			if (!stdout || !stdin) {
+				void kill(child);
+				reject(new Error('tunnel child has no stdio pipes'));
+				return;
+			}
+			// A relay that dies mid-transfer makes the next write fail with EPIPE;
+			// without a listener that surfaces as an unhandled 'error' event and
+			// takes the extension host down with it. Attached before the preamble
+			// arrives, so the window between spawn and pipe is covered too; the
+			// child's own 'close'/'error' handlers report the failure.
+			stdin.on('error', () => { /* the child is gone; its close handler says so */ });
+			let settled = false;
+			let stderr = '';
+			let buffered = Buffer.alloc(0);
+			let timer = /** @type {any} */ (undefined);
+
+			/** @param {string} reason */
+			const fail = (reason) => {
+				if (settled) {
+					return;
+				}
+				settled = true;
+				clearTimeout(timer);
+				socket.destroy();
+				void kill(child);
+				reject(new Error(stderr ? `${reason}: ${stderr.trim().split('\n').pop()}` : reason));
+			};
+
+			/** @param {Buffer} chunk */
+			const onStdout = (chunk) => {
+				buffered = Buffer.concat([buffered, chunk]);
+				const at = buffered.indexOf(READY);
+				if (at === -1) {
+					return;
+				}
+				settled = true;
+				clearTimeout(timer);
+				stdout.removeListener('data', onStdout);
+				const rest = buffered.subarray(at + READY.length);
+				if (rest.length > 0) {
+					socket.write(rest);
+				}
+				stdout.pipe(socket);
+				socket.pipe(stdin);
+				socket.resume();
+				resolve();
+			};
+
+			timer = setTimeout(() => fail('tunnel preamble timeout'), preambleTimeoutMs);
+			timer.unref?.();
+
+			spawned.stderr?.on('data', (chunk) => {
+				stderr = (stderr + String(chunk)).slice(-8192);
+			});
+			stdout.on('data', onStdout);
+
+			socket.on('error', () => { /* the client went away; the child goes with it */ });
+			socket.on('close', () => {
+				if (!settled) {
+					fail('tunnel socket closed before the preamble');
+					return;
+				}
+				void kill(child);
+			});
+
+			child.once('error', error => fail(`tunnel child failed: ${error.message}`));
+			child.once('close', (code) => {
+				if (!settled) {
+					fail(`tunnel child exited with code ${code} before the preamble`);
+				}
+			});
+		});
+	}
+
+	/**
+	 * Resolves only once a relay has proven the whole path; a tunnel that reports
+	 * success but cannot carry a byte would fail at the worst possible moment —
+	 * after the window has opened and asked for its workbench.
+	 * @returns {Promise<void>}
+	 */
+	function bootstrap() {
+		return new Promise((resolve, reject) => {
+			const socket = net.connect(localPort, host);
+			socket.on('error', (error) => {
+				const pending = pendingBootstrap;
+				pendingBootstrap = undefined;
+				socket.destroy();
+				pending?.reject(error);
+			});
+			pendingBootstrap = {
+				resolve: () => { pendingBootstrap = undefined; socket.destroy(); resolve(); },
+				reject: (error) => { pendingBootstrap = undefined; socket.destroy(); reject(error); }
+			};
+		});
+	}
+
+	async function dispose() {
+		if (disposed) {
+			return;
+		}
+		disposed = true;
+		for (const socket of [...sockets]) {
+			socket.destroy();
+		}
+		sockets.clear();
+		if (localPort !== 0) {
+			await new Promise(/** @param {(value?: void) => void} resolve */ resolve => server.close(() => resolve()));
+		}
+		await Promise.all([...children].map(kill));
+	}
+
+	const server = net.createServer({ pauseOnConnect: true }, (socket) => {
+		sockets.add(socket);
+		socket.on('close', () => sockets.delete(socket));
+		const relayed = relay(socket);
+		relayed.catch(() => { /* already reported to whoever is listening */ });
+		const first = pendingBootstrap;
+		if (first) {
+			pendingBootstrap = undefined;
+			relayed.then(first.resolve, first.reject);
+		}
+	});
+
+	return new Promise((resolve, reject) => {
+		server.once('error', reject);
+		server.listen(0, host, () => {
+			server.removeListener('error', reject);
+			localPort = /** @type {import('node:net').AddressInfo} */ (server.address()).port;
+			log.info(`stdio tunnel for ${distro}: ${host}:${localPort} → ${distro}:${serverPort}`);
+			bootstrap().then(
+				() => resolve({ localPort, dispose }),
+				async (error) => {
+					await dispose();
+					reject(error);
+				}
+			);
+		});
+	});
+}
+
+module.exports = { PIPE_SCRIPT, createStdioTunnel };
diff --git a/extensions/picket-remote-wsl/src/uninstall.js b/extensions/picket-remote-wsl/src/uninstall.js
new file mode 100644
index 00000000..46f94964
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/uninstall.js
@@ -0,0 +1,52 @@
+'use strict';
+
+const { OFFICIAL_EXTENSION_ID } = require('./official.js');
+
+/**
+ * Windows hands back whatever the user typed for the install path (`C:\Program
+ * Files\...` next to `C:/Program Files/...`), so comparison is on one normalised
+ * form: forward slashes, no trailing separator, lower case.
+ * @param {string} value
+ */
+function normalizePath(value) {
+	return String(value ?? '').replace(/\\/g, '/').replace(/\/+$/, '').toLowerCase();
+}
+
+/**
+ * The workbench command removes the extension from the user's profile and leaves
+ * `~/.vscode-server`, the settings and the download cache alone — which is exactly
+ * what takeover needs. A copy under `resources/app/extensions` is part of the
+ * product instead: it comes back on the next start, so refusing is the honest
+ * answer rather than a command that appears to work and changes nothing.
+ * @param {{
+ *   extensions: { get(id: string): { extensionPath?: string } | undefined },
+ *   executeCommand: (command: string, ...args: any[]) => Promise<any>,
+ *   appRoot: string
+ * }} options
+ * @returns {Promise<{ status: 'uninstalled' | 'absent' | 'builtin' | 'failed', message: string }>}
+ */
+async function uninstallOfficialExtension(options) {
+	const { extensions, executeCommand, appRoot } = options;
+	const found = extensions.get(OFFICIAL_EXTENSION_ID);
+	if (!found) {
+		return { status: 'absent', message: '官方 Remote-WSL 扩展已经不在了。' };
+	}
+
+	const builtinRoot = `${normalizePath(appRoot)}/extensions`;
+	const extensionPath = normalizePath(found.extensionPath ?? '');
+	if (extensionPath === builtinRoot || extensionPath.startsWith(`${builtinRoot}/`)) {
+		return {
+			status: 'builtin',
+			message: '检测到的是 Picket Code 内置的官方 Remote-WSL 扩展，卸载会在下次启动时被还原。请改用不带该扩展的安装包。'
+		};
+	}
+
+	try {
+		await executeCommand('workbench.extensions.uninstallExtension', OFFICIAL_EXTENSION_ID);
+	} catch (error) {
+		return { status: 'failed', message: `卸载失败：${error?.message ?? error}` };
+	}
+	return { status: 'uninstalled', message: '已卸载官方 Remote-WSL 扩展，用户数据全部保留。' };
+}
+
+module.exports = { uninstallOfficialExtension };
diff --git a/extensions/picket-remote-wsl/src/version.js b/extensions/picket-remote-wsl/src/version.js
new file mode 100644
index 00000000..b96ee598
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/version.js
@@ -0,0 +1,105 @@
+'use strict';
+
+/**
+ * Three numeric segments, nothing else. A prerelease suffix (`-picket.1-rc.5`)
+ * is metadata for humans: ordering only ever compares the numbers.
+ * @param {string} text
+ * @returns {number[] | undefined}
+ */
+function parseVersion(text) {
+	const match = /^(\d+)\.(\d+)\.(\d+)/.exec(String(text ?? ''));
+	return match ? [Number(match[1]), Number(match[2]), Number(match[3])] : undefined;
+}
+
+/**
+ * @param {string} a
+ * @param {string} b
+ * @returns {-1 | 0 | 1}
+ */
+function compareVersions(a, b) {
+	const left = parseVersion(a);
+	const right = parseVersion(b);
+	if (!left || !right) {
+		throw new TypeError(`Cannot compare "${a}" with "${b}": both must be x.y.z`);
+	}
+	for (let index = 0; index < 3; index++) {
+		if (left[index] !== right[index]) {
+			return left[index] < right[index] ? -1 : 1;
+		}
+	}
+	return 0;
+}
+
+/**
+ * Every branch names what to do next, so the caller never has to invent a
+ * message or discover the mismatch from a failed download.
+ * @param {{ error: 'none' | 'no-commit' | 'below-min', offered?: string }} result
+ * @param {{ commit: string, minVersion: string }} want
+ * @returns {string}
+ */
+function describeSelectionError(result, want) {
+	if (result.error === 'none') {
+		return '这个构建没有 WSL 服务器组件';
+	}
+	if (result.error === 'no-commit') {
+		return `没有为 commit ${want.commit} 构建的服务器组件`;
+	}
+	return `catalog offers ${result.offered ?? 'none'}, requires >= ${want.minVersion}`;
+}
+
+/**
+ * A build that never went through `assemble.mjs` — a developer tree, the
+ * acceptance harness — carries no stamp, and such a client can only work with
+ * whatever the catalog offers. `build/wsl/check.mjs` refuses to package an
+ * unstamped app, so this tolerance cannot reach a release.
+ * @param {{ commit?: string, minVersion?: string } | undefined} want
+ * @returns {{ commit: string, minVersion: string, anyCommit: boolean }}
+ */
+function normalizeWant(want) {
+	return {
+		commit: want?.commit ?? '',
+		minVersion: want?.minVersion || '0.0.0',
+		anyCommit: !want?.commit
+	};
+}
+
+/**
+ * Compatibility is expressed by the handshake commit, so a component is a
+ * candidate only when it was built from this client's commit. Among candidates
+ * the newest wins, and a catalog that cannot satisfy the minimum is an error
+ * rather than a silent downgrade.
+ * @param {{ commit?: string | null, components?: any[] } | undefined} catalog
+ * @param {{ commit?: string, minVersion?: string }} want
+ * @returns {{ component: any } | { error: 'none' | 'no-commit' | 'below-min', offered?: string }}
+ */
+function selectComponent(catalog, want) {
+	const components = Array.isArray(catalog?.components) ? catalog.components : [];
+	if (components.length === 0) {
+		return { error: 'none' };
+	}
+	const { commit, minVersion, anyCommit } = normalizeWant(want);
+	const candidates = components.filter(component => component?.kind === 'server' && (anyCommit || component.commit === commit));
+	if (candidates.length === 0) {
+		return { error: 'no-commit' };
+	}
+	const highest = candidates.reduce((best, component) => (compareVersions(component.version, best.version) > 0 ? component : best));
+	if (compareVersions(highest.version, minVersion) < 0) {
+		return { error: 'below-min', offered: highest.version };
+	}
+	return { component: highest };
+}
+
+/**
+ * `engines.vscode` is a range, and this client only ever needs one number from
+ * it: the lowest editor the extension will load in. Anything that is not a
+ * concrete bound (`*`, deeply compound ranges) yields `undefined`, which the
+ * report prints as `unknown` rather than guessing.
+ * @param {string | undefined} range
+ * @returns {string | undefined}
+ */
+function engineMinimum(range) {
+	const match = /(?:^|[\s|])(?:\^|~|>=?|=)?\s*v?(\d+\.\d+\.\d+)/.exec(String(range ?? ''));
+	return match ? match[1] : undefined;
+}
+
+module.exports = { parseVersion, compareVersions, normalizeWant, selectComponent, describeSelectionError, engineMinimum };
diff --git a/extensions/picket-remote-wsl/test/catalog.test.js b/extensions/picket-remote-wsl/test/catalog.test.js
