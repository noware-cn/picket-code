+	const sha256 = createHash('sha256').update(body).digest('hex');
+	const component = {
+		id: 'wsl-server', kind: 'server', version: 'v1.0.0',
+		file: 'picket-code-server-v1.0.0-linux-x64.tar.gz', size: body.length, sha256, embedded: false
+	};
+	/** @type {Array<{ url?: string, headers: import('node:http').IncomingHttpHeaders }>} */
+	const seen = [];
+	const proxy = recordingServer(seen, body);
+	/** @type {Array<{ args: any[], input?: Buffer }>} */
+	const calls = [];
+	const runner = {
+		exec: async (/** @type {any[]} */ args, /** @type {any} */ opts) => {
