+// RED first: this file must fail until src/probe.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { probeServer } = require('../src/probe.js');
+
+test('HTTP 400 means the server answered and the token was accepted', async () => {
+	const fetchImpl = async () => ({ status: 400, ok: false });
+	assert.strictEqual(await probeServer({ host: '127.0.0.1', port: 1, token: 't', fetchImpl }), 'alive');
+});
+
+test('HTTP 403 means the token was rejected', async () => {
+	const fetchImpl = async () => ({ status: 403, ok: false });
+	assert.strictEqual(await probeServer({ host: '127.0.0.1', port: 1, token: 't', fetchImpl }), 'bad-token');
+});
+
+test('a refused connection is dead', async () => {
+	const fetchImpl = async () => { throw Object.assign(new Error('connect ECONNREFUSED'), { code: 'ECONNREFUSED' }); };
+	assert.strictEqual(await probeServer({ host: '127.0.0.1', port: 1, token: 't', fetchImpl }), 'dead');
+});
+
+test('a fetch that never settles is dead once the timeout elapses', async () => {
+	const fetchImpl = (url, init) => new Promise((resolve, reject) => {
+		init.signal.addEventListener('abort', () => reject(new Error('aborted')));
+	});
+	const started = Date.now();
+	assert.strictEqual(await probeServer({ host: '127.0.0.1', port: 1, token: 't', timeoutMs: 50, fetchImpl }), 'dead');
+	assert.ok(Date.now() - started < 1000);
+});
+
+test('the request carries the token', async () => {
+	let seen;
+	const fetchImpl = async (url) => { seen = String(url); return { status: 400, ok: false }; };
+	await probeServer({ host: '127.0.0.1', port: 41234, token: 'abc', fetchImpl });
+	assert.strictEqual(seen, 'http://127.0.0.1:41234/vscode-remote-resource?tkn=abc');
+});
