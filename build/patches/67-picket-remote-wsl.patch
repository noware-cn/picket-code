+// RED first: this file must fail until src/remoteUri.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { parseAuthority, remoteUriFor, parseUncPath, toPosixPath, toWindowsPath } = require('../src/remoteUri.js');
+
+test('parseAuthority strips the prefix and tolerates spaces in a distro name', () => {
+	assert.strictEqual(parseAuthority('picket-wsl+'), '');
+	assert.strictEqual(parseAuthority('picket-wsl+Ubuntu'), 'Ubuntu');
+	assert.strictEqual(parseAuthority('picket-wsl+Ubuntu 22.04 LTS'), 'Ubuntu 22.04 LTS');
+	assert.strictEqual(parseAuthority('wsl+Ubuntu'), '');
+	assert.strictEqual(parseAuthority(''), '');
+});
+
+test('remoteUriFor builds a vscode-remote uri for the distro', () => {
+	assert.deepStrictEqual(remoteUriFor('Ubuntu-24.04', '/home/u/proj'), {
+		scheme: 'vscode-remote',
+		authority: 'picket-wsl+Ubuntu-24.04',
+		path: '/home/u/proj'
+	});
+	assert.strictEqual(remoteUriFor('Ubuntu', '/').path, '/');
+});
+
+test('UNC paths parse for both prefixes', () => {
+	assert.deepStrictEqual(parseUncPath('\\\\wsl.localhost\\Ubuntu\\home\\u'), { distro: 'Ubuntu', posixPath: '/home/u' });
+	assert.deepStrictEqual(parseUncPath('\\\\wsl$\\Debian\\srv\\app'), { distro: 'Debian', posixPath: '/srv/app' });
+	assert.deepStrictEqual(parseUncPath('//wsl.localhost/Ubuntu/home/u'), { distro: 'Ubuntu', posixPath: '/home/u' });
+	assert.deepStrictEqual(parseUncPath('\\\\wsl.localhost\\Ubuntu'), { distro: 'Ubuntu', posixPath: '/' });
+	assert.deepStrictEqual(parseUncPath('\\\\wsl.localhost\\Ubuntu\\home\\u\\'), { distro: 'Ubuntu', posixPath: '/home/u' });
+});
+
+test('a drive path or another share is not a WSL UNC path', () => {
+	assert.strictEqual(parseUncPath('C:\\Users\\u'), undefined);
+	assert.strictEqual(parseUncPath('\\\\fileserver\\share\\dir'), undefined);
+	assert.strictEqual(parseUncPath('/home/u'), undefined);
+});
+
+test('wslpath converts in both directions', async () => {
+	const r = {
+		exec: async (args) => ({ code: 0, stdout: args[4] === '-u' ? '/mnt/c/Users/u/我的 项目\r\n' : 'C:\\Users\\u\\我的 项目\r\n', stderr: '' })
+	};
+	assert.strictEqual(await toPosixPath(r, 'Ubuntu', 'C:\\Users\\u\\我的 项目'), '/mnt/c/Users/u/我的 项目');
+	assert.strictEqual(await toWindowsPath(r, 'Ubuntu', '/mnt/c/Users/u/我的 项目'), 'C:\\Users\\u\\我的 项目');
+});
+
+test('wslpath keeps its arguments as argv entries', async () => {
+	const seen = [];
+	const r = { exec: async (args) => { seen.push(args); return { code: 0, stdout: '/mnt/c/x\r\n', stderr: '' }; } };
+	await toPosixPath(r, 'Ubuntu 22.04 LTS', 'C:\\Program Files\\x');
+	assert.deepStrictEqual(seen[0], ['-d', 'Ubuntu 22.04 LTS', '-e', 'wslpath', '-u', 'C:\\Program Files\\x']);
+});
+
+test('a failing wslpath rejects with the stderr text', async () => {
+	const r = { exec: async () => ({ code: 1, stdout: '', stderr: 'wslpath: C:\\nope: No such file or directory\n' }) };
+	await assert.rejects(() => toPosixPath(r, 'Ubuntu', 'C:\\nope'), /wslpath failed: wslpath: C:\\nope: No such file or directory/);
+	await assert.rejects(() => toWindowsPath(r, 'Ubuntu', '/nope'), /wslpath failed:/);
+});
