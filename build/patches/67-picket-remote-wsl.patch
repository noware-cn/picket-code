diff --git a/extensions/picket-remote-wsl/src/catalog.js b/extensions/picket-remote-wsl/src/catalog.js
new file mode 100644
index 00000000..2ac6fe0f
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/catalog.js
@@ -0,0 +1,116 @@
+'use strict';
+
+const { readFile } = require('node:fs/promises');
+const { join } = require('node:path');
+
+/**
+ * A fresh object every time, so callers cannot share one mutable catalog.
+ * @returns {ICatalog}
+ */
+function emptyCatalog() {
+	return { schema: 2, minVersion: null, flavor: 'ondemand', components: [] };
+}
+
+/**
+ * A component carries the commit it was built from: that, not the version
+ * string, is what has to match the client's handshake.
+ * @typedef {{ id: string, kind: 'server' | 'extensions', version: string, commit: string, file: string, size: number, sha256: string, embedded: boolean, embeddedPath?: string }} ICatalogComponent
+ * @typedef {{ schema: 2, minVersion: string | null, flavor: 'embedded' | 'ondemand', components: ICatalogComponent[] }} ICatalog
+ */
+
+/** @param {unknown} value @returns {value is Record<string, any>} */
+function isObject(value) {
+	return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+/** @param {unknown} value @returns {value is string} */
+function nonEmpty(value) {
+	return typeof value === 'string' && value.length > 0;
+}
+
+/** @param {unknown} value @returns {value is number} */
+function positiveInteger(value) {
+	return typeof value === 'number' && Number.isInteger(value) && value > 0;
+}
+
+/**
+ * A component is usable only when every field the installer relies on is present
+ * and well formed. Anything else is dropped rather than trusted.
+ * @param {unknown} raw @returns {ICatalogComponent | undefined}
+ */
+function normalizeComponent(raw) {
+	if (!isObject(raw)) {
+		return undefined;
+	}
+	if (!nonEmpty(raw.id) || !nonEmpty(raw.version) || !nonEmpty(raw.file)) {
+		return undefined;
+	}
+	if (raw.kind !== 'server' && raw.kind !== 'extensions') {
+		return undefined;
+	}
+	if (!positiveInteger(raw.size)) {
+		return undefined;
+	}
+	if (typeof raw.sha256 !== 'string' || !/^[0-9a-f]{64}$/.test(raw.sha256)) {
+		return undefined;
+	}
+	if (typeof raw.commit !== 'string' || !/^[0-9a-f]{40}$/.test(raw.commit)) {
+		return undefined;
+	}
+	const embedded = raw.embedded === true;
+	const embeddedPath = raw.embeddedPath;
+	if (embedded) {
+		if (!nonEmpty(embeddedPath) || embeddedPath.includes('..') || embeddedPath.startsWith('/')) {
+			return undefined;
+		}
+	}
+	return {
+		id: raw.id,
+		kind: raw.kind,
+		version: raw.version,
+		commit: raw.commit,
+		file: raw.file,
+		size: raw.size,
+		sha256: raw.sha256,
+		embedded,
+		embeddedPath: embedded ? embeddedPath : undefined
+	};
+}
+
+/**
+ * Reads `payloads/catalog.json` from the extension directory. A missing or
+ * malformed catalog is a valid state (an ondemand build with nothing installed
+ * yet), so it resolves to the empty catalog and never throws.
+ * @param {string} extensionPath
+ * @returns {Promise<ICatalog>}
+ */
+async function loadCatalog(extensionPath) {
+	let text;
+	try {
+		text = await readFile(join(extensionPath, 'payloads', 'catalog.json'), 'utf8');
+	} catch {
+		return emptyCatalog();
+	}
+	let parsed;
+	try {
+		parsed = JSON.parse(text);
+	} catch {
+		return emptyCatalog();
+	}
+	// Schema 1 tied the server version to the client tag and had no commit to
+	// match on; reading it as current would select an unverifiable payload.
+	if (!isObject(parsed) || parsed.schema !== 2) {
+		return emptyCatalog();
+	}
+	const components = Array.isArray(parsed.components)
+		? parsed.components.map(normalizeComponent).filter(Boolean)
+		: [];
+	return {
+		schema: 2,
+		minVersion: nonEmpty(parsed.minVersion) ? parsed.minVersion : null,
+		flavor: parsed.flavor === 'embedded' ? 'embedded' : 'ondemand',
+		components
+	};
+}
+
+module.exports = { loadCatalog };
diff --git a/extensions/picket-remote-wsl/src/commands.js b/extensions/picket-remote-wsl/src/commands.js
new file mode 100644
index 00000000..1dcd6563
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/commands.js
@@ -0,0 +1,548 @@
+'use strict';
+
+const { listDistros, distroHome, visibleDistros } = require('./distro.js');
+const { AUTHORITY_PREFIX, parseAuthority, parseUncPath, toPosixPath, toWindowsPath } = require('./remoteUri.js');
+const { manageDistro } = require('./manage.js');
+const { buildDiagnostics } = require('./diagnose.js');
+const { selectGallery, installVsix } = require('./marketplace.js');
+const { unpackOfflineBundle, removeBundle } = require('./offline.js');
+const { installShim, removeShim } = require('./shim.js');
+const { selectComponent, describeSelectionError } = require('./version.js');
+const { uninstallOfficialExtension } = require('./uninstall.js');
+
+const LAST_DISTRO = 'picket.wsl.lastDistro';
+const SERVER_COMPONENT = 'wsl-server';
+
+/**
+ * The payload download knobs, assembled from the two configuration scopes
+ * that own them: `picket.wsl.*` arrives already unwrapped in `settings`, while
+ * `http.proxy` / `http.proxyStrictSSL` are VS Code's own settings and arrive
+ * through `http` (read in `extension.js`, because nothing in `src/` may touch
+ * `vscode`).
+ *
+ * `''` rather than `undefined` when the user turned the proxy off: an empty
+ * setting is the documented way to say "connect directly".
+ * @param {{ settings: any, http?: { proxy?: string, proxyStrictSSL?: boolean } }} options
+ * @returns {{ proxy: string, strictSSL: boolean, caFile: string }}
+ */
+function downloadFromSettings(options) {
+	const { settings, http } = options;
+	const proxy = http?.proxy;
+	return {
+		proxy: settings.useProxy === false || typeof proxy !== 'string' ? '' : proxy,
+		// Certificate validation is only relaxed when the user said so.
+		strictSSL: http?.proxyStrictSSL !== false,
+		caFile: String(settings.caFile ?? '')
+	};
+}
+
+/**
+ * Every command is a workflow over `host`, the narrow slice of `vscode` this
+ * module is allowed to touch, so the whole command layer runs under `node --test`
+ * with no extension host. `extension.js` supplies the real `vscode` bindings.
+ * @param {{
+ *   host: any,
+ *   runner: any,
+ *   settings: any,
+ *   catalog: any,
+ *   product?: { commit: string, version: string, picketServerMinVersion: string },
+ *   createComponents: (config: { distro: string, home: string, explicitPath?: string, download?: { proxy?: string, strictSSL?: boolean, caFile?: string } }) => any,
+ *   resolver: { stop(distro?: string): Promise<void> },
+ *   memento?: { get(key: string): any, update(key: string, value: any): any },
+ *   log?: { info(...parts: unknown[]): void, error(...parts: unknown[]): void },
+ *   http?: { proxy?: string, proxyStrictSSL?: boolean },
+ *   listDistros?: typeof listDistros,
+ *   distroHome?: typeof distroHome,
+ *   appRoot?: string,
+ *   gallery?: { get(key: string): any, update(key: string, value: any): Promise<void> },
+ *   currentFolders?: () => readonly any[],
+ *   currentAuthority?: () => string,
+ *   clientPath?: string,
+ *   official?: { installed: boolean, blocked: boolean } | (() => { installed: boolean, blocked: boolean }),
+ *   productsVersion?: string,
+ *   extensions?: { get(id: string): { extensionPath?: string } | undefined }
+ * }} options
+ */
+function createCommands(options) {
+	const { host, runner, settings, catalog, product, createComponents, resolver } = options;
+	const listDistrosOf = options.listDistros ?? listDistros;
+	const distroHomeOf = options.distroHome ?? distroHome;
+
+	/** Read on every call: a proxy the user edits applies to the next install. */
+	const downloadOptions = () => downloadFromSettings({ settings, http: options.http });
+
+	/** @param {string} title */
+	async function pickDistro(title) {
+		let list;
+		try {
+			list = visibleDistros(await listDistrosOf(runner));
+		} catch (error) {
+			await host.showErrorMessage(`无法列出 WSL 发行版：${error.message}`);
+			return undefined;
+		}
+		if (list.length === 0) {
+			await host.showErrorMessage('没有检测到 WSL 发行版。先运行 "wsl --install" 安装一个。');
+			return undefined;
+		}
+		const preferred = String(settings.defaultDistro || options.memento?.get(LAST_DISTRO) || '').toLowerCase();
+		const ordered = [...list].sort((a, b) => Number(b.name.toLowerCase() === preferred) - Number(a.name.toLowerCase() === preferred));
+		const items = ordered.map(distro => ({
+			label: distro.name,
+			description: `WSL ${distro.version}${distro.isDefault ? ' · 默认发行版' : ''} · ${distro.state}`,
+			distro: distro.name
+		}));
+		const picked = await host.showQuickPick(items, { placeHolder: title });
+		if (!picked) {
+			return undefined;
+		}
+		const name = typeof picked === 'string' ? picked : picked.distro;
+		await options.memento?.update(LAST_DISTRO, name);
+		return name;
+	}
+
+	/** @param {any} manager */
+	async function install(manager) {
+		try {
+			await host.withProgress({ title: '正在准备 WSL 服务器组件…' }, () => manager.ensure(SERVER_COMPONENT));
+			return true;
+		} catch (error) {
+			await host.showErrorMessage(`安装 WSL 服务器组件失败：${error.message}`);
+			return false;
+		}
+	}
+
+	/**
+	 * The first-use interception. The embedded flavor is meant to be invisible:
+	 * the payload shipped with the build, so there is nothing to ask. The public
+	 * build carries only a catalog, so it asks — and "cancel" must leave the
+	 * window untouched.
+	 * @param {{ distro: string, home: string }} target
+	 * @returns {Promise<boolean>}
+	 */
+	async function ensureComponentInteractive(target) {
+		const component = (catalog?.components ?? []).find((/** @type {any} */ c) => c.id === SERVER_COMPONENT);
+		if (!component) {
+			await host.showErrorMessage('这个构建没有 WSL 服务器组件，无法在 WSL 中打开文件夹。');
+			return false;
+		}
+		const manager = createComponents({ distro: target.distro, home: target.home, download: downloadOptions() });
+		const current = await manager.inspect(SERVER_COMPONENT);
+		if (current.state === 'installed') {
+			return true;
+		}
+
+		if (catalog.flavor === 'embedded') {
+			return install(manager);
+		}
+
+		const choice = await host.showInformationMessage(
+			'WSL 里还没有服务器组件。从哪里获取？',
+			'自动下载',
+			'从文件安装…',
+			'取消'
+		);
+		if (choice === '自动下载') {
+			return install(manager);
+		}
+		if (choice === '从文件安装…') {
+			const picked = await host.showOpenDialog({
+				canSelectFiles: true,
+				canSelectMany: false,
+				title: '选择服务器载荷 tar.gz 或离线组件包 zip',
+				filters: { '服务器载荷': ['gz', 'tgz'], '离线组件包': ['zip'] }
+			});
+			const file = Array.isArray(picked) ? picked[0] : picked;
+			const path = file?.fsPath ?? file?.path ?? (typeof file === 'string' ? file : '');
+			if (!path) {
+				return false;
+			}
+			if (/\.zip$/i.test(path)) {
+				let bundle;
+				try {
+					bundle = await unpackOfflineBundle({ bundlePath: path });
+				} catch (error) {
+					await host.showErrorMessage(`离线组件包无法使用：${error.message}`);
+					return false;
+				}
+				try {
+					return await install(createComponents({ distro: target.distro, home: target.home, explicitPath: bundle.payloadPath, download: downloadOptions() }));
+				} finally {
+					await removeBundle(bundle.dir);
+				}
+			}
+			return install(createComponents({ distro: target.distro, home: target.home, explicitPath: path, download: downloadOptions() }));
+		}
+		return false;
+	}
+
+	/**
+	 * A path the dialog hands back is Windows-shaped unless the user typed or
+	 * pasted a UNC path; `wslpath` owns the translation because only it knows
+	 * where the drives are mounted.
+	 * @param {any} chosen
+	 * @param {string} distro
+	 * @returns {Promise<string | undefined>}
+	 */
+	async function toPosix(chosen, distro) {
+		const raw = String(chosen?.fsPath ?? chosen?.path ?? '');
+		const unc = parseUncPath(raw);
+		if (unc) {
+			return unc.posixPath;
+		}
+		if (chosen?.scheme === 'vscode-remote') {
+			return chosen.path;
+		}
+		const candidate = raw.startsWith('/') ? raw : String(chosen?.path ?? raw);
+		if (candidate.startsWith('/')) {
+			return candidate;
+		}
+		try {
+			return await toPosixPath(runner, distro, candidate);
+		} catch (error) {
+			await host.showErrorMessage(`无法把 ${candidate} 转换成 WSL 路径：${error.message}`);
+			return undefined;
+		}
+	}
+
+	/** @param {string} distro @param {string} posixPath @param {string} home */
+	async function connect(distro, posixPath, home) {
+		if (!await ensureComponentInteractive({ distro, home })) {
+			return;
+		}
+		await host.openFolder(
+			host.uriFor({ scheme: 'vscode-remote', authority: `${AUTHORITY_PREFIX}+${distro}`, path: posixPath }),
+			{ forceNewWindow: true, remoteAuthority: `${AUTHORITY_PREFIX}+${distro}` }
+		);
+	}
+
+	/** @param {string} [preselected] */
+	async function openFolder(preselected) {
+		const distro = typeof preselected === 'string' && preselected.length > 0
+			? preselected
+			: await pickDistro('选择要在其中打开文件夹的发行版');
+		if (!distro) {
+			return;
+		}
+		let home;
+		try {
+			home = await distroHomeOf(runner, distro);
+		} catch (error) {
+			await host.showErrorMessage(`无法进入 ${distro}：${error.message}`);
+			return;
+		}
+		const picked = await host.showOpenDialog({
+			canSelectFiles: false,
+			canSelectFolders: true,
+			canSelectMany: false,
+			title: `在 ${distro} 中选择文件夹`,
+			defaultUri: host.uriFor({ scheme: 'vscode-remote', authority: `${AUTHORITY_PREFIX}+${distro}`, path: home })
+		});
+		const chosen = Array.isArray(picked) ? picked[0] : picked;
+		if (!chosen) {
+			return;
+		}
+		const posixPath = await toPosix(chosen, distro);
+		if (!posixPath) {
+			return;
+		}
+		await connect(distro, posixPath, home);
+	}
+
+	async function reopenInWsl() {
+		const folder = (options.currentFolders?.() ?? [])[0];
+		const unc = parseUncPath(folder?.uri?.fsPath ?? '');
+		if (!unc) {
+			await host.showErrorMessage('当前文件夹不在 \\\\wsl.localhost 或 \\\\wsl$ 下。');
+			return;
+		}
+		const home = await distroHomeOf(runner, unc.distro).catch(() => '/');
+		await connect(unc.distro, unc.posixPath, home);
+	}
+
+	async function reopenInWindows() {
+		const folder = (options.currentFolders?.() ?? [])[0];
+		const distro = parseAuthority(options.currentAuthority?.() ?? '')?.distro ?? '';
+		if (!folder || !distro) {
+			await host.showErrorMessage('当前窗口不是 Picket WSL 窗口。');
+			return;
+		}
+		try {
+			const windowsPath = await toWindowsPath(runner, distro, folder.uri.path);
+			await host.openFolder(host.uriFor({ scheme: 'file', path: windowsPath }), { forceNewWindow: true, remoteAuthority: '' });
+		} catch (error) {
+			await host.showErrorMessage(`无法映射回 Windows 路径：${error.message}`);
+		}
+	}
+
+	/** @param {string} [preselected] */
+	async function stopServer(preselected) {
+		const distro = typeof preselected === 'string' && preselected.length > 0
+			? preselected
+			: await pickDistro('选择要停止服务器的发行版');
+		if (!distro) {
+			return;
+		}
+		await resolver.stop(distro);
+		await host.refreshTargets();
+	}
+
+	async function componentsCommand() {
+		const distro = await pickDistro('选择发行版');
+		if (!distro) {
+			return;
+		}
+		const home = await distroHomeOf(runner, distro);
+		const manager = createComponents({ distro, home, explicitPath: settings.serverPayloadPath || undefined, download: downloadOptions() });
+		const rows = await manager.list();
+		const picked = await host.showQuickPick(
+			rows.map((/** @type {any} */ row) => ({
+				label: row.id,
+				description: `${row.state}${row.version ? ` · ${row.version}` : ''}`,
+				row
+			})),
+			{ placeHolder: '选择组件' }
+		);
+		if (!picked) {
+			return;
+		}
+		const row = typeof picked === 'string' ? { id: picked } : picked.row;
+		const choice = await host.showInformationMessage(`组件 ${row.id}：${row.state ?? '未知'}`, '重新安装', '清理旧版本', '取消');
+		if (choice === '重新安装') {
+			await install(manager);
+			await host.refreshTargets();
+		} else if (choice === '清理旧版本') {
+			const removed = await manager.cleanup(0);
+			await host.showInformationMessage(removed.length > 0
+				? `已清理 ${removed.length} 个旧版本：${removed.join('、')}`
+				: '没有可清理的旧版本');
+		}
+	}
+
+	async function diagnose() {
+		const report = await buildDiagnostics({
+			runner,
+			settings,
+			catalog,
+			components: createComponents,
+			appRoot: options.appRoot,
+			gallery: options.gallery ? { serviceUrl: options.gallery.get('serviceUrl') } : undefined,
+			official: options.official,
+			productsVersion: options.productsVersion
+		});
+		await host.showDocument(report);
+	}
+
+	/**
+	 * The one command that has to work *while* everything else is blocked: it is
+	 * the way out of the blocked state, and it must not touch the data the next
+	 * connection depends on.
+	 */
+	async function uninstallOfficial() {
+		const result = await uninstallOfficialExtension({
+			extensions: options.extensions ?? { get: () => undefined },
+			executeCommand: (command, ...args) => host.executeCommand(command, ...args),
+			appRoot: options.appRoot ?? ''
+		});
+		if (result.status === 'uninstalled') {
+			const choice = await host.showInformationMessage(`${result.message} WSL 功能在重新加载窗口后恢复。`, '重新加载窗口');
+			if (choice === '重新加载窗口') {
+				await host.executeCommand('workbench.action.reloadWindow');
+			}
+			return;
+		}
+		if (result.status === 'absent') {
+			await host.showInformationMessage(result.message);
+			return;
+		}
+		await host.showErrorMessage(result.message);
+	}
+
+	/** For a user who would rather do it themselves: the same two paths, in words. */
+	async function uninstallGuide() {
+		const choice = await host.showInformationMessage(
+			'卸载官方 Remote-WSL 扩展（数据全部保留）：在扩展视图搜索 "Remote - WSL" 点卸载；或运行 '
+			+ '"picket-code --uninstall-extension ms-vscode-remote.remote-wsl"。'
+			+ ' ~/.vscode-server 里的服务器、扩展与设置，以及下载缓存都不会被删除。',
+			'立即卸载', '打开扩展视图'
+		);
+		if (choice === '立即卸载') {
+			await uninstallOfficial();
+		} else if (choice === '打开扩展视图') {
+			await host.executeCommand('workbench.view.extensions');
+		}
+	}
+
+	async function galleryCommand() {
+		if (!options.gallery) {
+			await host.showErrorMessage('扩展市场配置不可用。');
+			return;
+		}
+		await selectGallery({ host, configuration: options.gallery });
+	}
+
+	async function vsixCommand() {
+		await installVsix({ host });
+	}
+
+	async function refreshTargets() {
+		await host.refreshTargets();
+	}
+
+	/**
+	 * @param {'add' | 'setDefault' | 'delete'} action
+	 * @param {string} [preselected] the distro a context-menu click carries
+	 */
+	async function manage(action, preselected) {
+		const distro = action === 'add'
+			? undefined
+			: (typeof preselected === 'string' && preselected.length > 0 ? preselected : await pickDistro('选择发行版'));
+		if (action !== 'add' && !distro) {
+			return;
+		}
+		await manageDistro({ host, runner, action, distro });
+		await host.refreshTargets();
+	}
+
+	/** The distro a command acts on: the current window's, else a picker. */
+	async function targetDistro(title) {
+		return parseAuthority(options.currentAuthority?.() ?? '')?.distro || await pickDistro(title);
+	}
+
+	/**
+	 * `picket-code .` inside the distro. The shim needs the installed server's
+	 * remote CLI plus this Windows client's POSIX path, so the component must
+	 * be in place first — `ensureComponentInteractive` is a no-op when it is.
+	 */
+	async function installCli() {
+		const distro = await targetDistro('选择要安装 picket-code 命令行的发行版');
+		if (!distro) {
+			return;
+		}
+		let home;
+		try {
+			home = await distroHomeOf(runner, distro);
+		} catch (error) {
+			await host.showErrorMessage(`无法进入 ${distro}：${error.message}`);
+			return;
+		}
+		if (!await ensureComponentInteractive({ distro, home })) {
+			return;
+		}
+		const want = { commit: product?.commit ?? '', minVersion: product?.picketServerMinVersion ?? '' };
+		const selection = selectComponent(catalog, want);
+		if ('error' in selection) {
+			await host.showErrorMessage(`无法安装命令行：${describeSelectionError(selection, want)}。`);
+			return;
+		}
+		const version = selection.component.version;
+		let clientPath;
+		try {
+			clientPath = await toPosixPath(runner, distro, options.clientPath ?? process.execPath);
+		} catch (error) {
+			await host.showErrorMessage(`无法把客户端路径转换成 WSL 路径：${error.message}`);
+			return;
+		}
+		const result = await installShim({ runner, distro, home, version, clientPath });
+		if (result.status === 'installed') {
+			await host.showInformationMessage(`picket-code 命令行已就绪：${result.linkPath}`);
+		} else if (result.status === 'foreign-link') {
+			await host.showErrorMessage(`${result.linkPath} 已存在且不是 Picket Code 的（${result.message}），未做改动。`);
+		} else {
+			await host.showErrorMessage(`picket-code 命令行未通过验证：${result.message}`);
+		}
+	}
+
+	async function removeCli() {
+		const distro = await targetDistro('选择要移除 picket-code 命令行的发行版');
+		if (!distro) {
+			return;
+		}
+		try {
+			const home = await distroHomeOf(runner, distro);
+			await removeShim({ runner, distro, home });
+			await host.showInformationMessage('已移除 picket-code 命令行（~/.local/bin/picket-code）。');
+		} catch (error) {
+			await host.showErrorMessage(`移除 picket-code 命令行失败：${error.message}`);
+		}
+	}
+
+	return {
+		openFolder,
+		reopenInWsl,
+		reopenInWindows,
+		stopServer,
+		componentsCommand,
+		diagnose,
+		uninstallOfficial,
+		uninstallGuide,
+		refreshTargets,
+		addDistro: () => manage('add'),
+		setDefaultDistro: (distro) => manage('setDefault', distro),
+		deleteDistro: (distro) => manage('delete', distro),
+		selectGallery: galleryCommand,
+		installVsix: vsixCommand,
+		installCli,
+		removeCli,
+		ensureComponentInteractive,
+		pickDistro
+	};
+}
+
+/**
+ * A command invoked from the targets view receives its tree element; one
+ * invoked from the palette receives nothing.
+ * @param {any} node
+ * @returns {string | undefined}
+ */
+function distroOf(node) {
+	return typeof node?.distro === 'string' ? node.distro : undefined;
+}
+
+/**
+ * One table serves registration and the manifest test: a command that is
+ * described in `package.json` but absent here is a dead menu entry.
+ * @type {Record<string, (api: ReturnType<typeof createCommands>) => (...args: any[]) => any>}
+ */
+const COMMANDS = {
+	'picket.wsl.openFolder': (api) => (node) => api.openFolder(distroOf(node)),
+	'picket.wsl.reopenInWsl': (api) => () => api.reopenInWsl(),
+	'picket.wsl.reopenInWindows': (api) => () => api.reopenInWindows(),
+	'picket.wsl.stopServer': (api) => (node) => api.stopServer(distroOf(node)),
+	'picket.wsl.components': (api) => () => api.componentsCommand(),
+	'picket.wsl.diagnose': (api) => () => api.diagnose(),
+	'picket.wsl.uninstallOfficial': (api) => () => api.uninstallOfficial(),
+	'picket.wsl.uninstallGuide': (api) => () => api.uninstallGuide(),
+	'picket.wsl.refreshTargets': (api) => () => api.refreshTargets(),
+	'picket.wsl.addDistro': (api) => () => api.addDistro(),
+	'picket.wsl.setDefaultDistro': (api) => (node) => api.setDefaultDistro(distroOf(node)),
+	'picket.wsl.deleteDistro': (api) => (node) => api.deleteDistro(distroOf(node)),
+	'picket.wsl.selectGallery': (api) => () => api.selectGallery(),
+	'picket.wsl.installVsix': (api) => () => api.installVsix(),
+	'picket.wsl.installCli': (api) => () => api.installCli(),
+	'picket.wsl.removeCli': (api) => () => api.removeCli()
+};
+
+/**
+ * A resident command answers whether or not the surface is mounted, because it
+ * is how a user finds out *why* nothing else works.
+ */
+const RESIDENT_COMMANDS = ['picket.wsl.diagnose'];
+
+/**
+ * `register` is `vscode.commands.registerCommand`, injected so this file never
+ * requires `vscode`. `only` and `except` split the table across the gate: an id
+ * can be registered once per window, and the resident commands are registered
+ * before the surface exists.
+ * @param {Parameters<typeof createCommands>[0] & { register: (id: string, run: (...args: any[]) => any) => any, only?: string[], except?: string[] }} options
+ * @returns {any[]}
+ */
+function registerCommands(options) {
+	const api = createCommands(options);
+	const only = options.only ? new Set(options.only) : undefined;
+	const except = new Set(options.except ?? []);
+	return Object.entries(COMMANDS)
+		.filter(([id]) => (only ? only.has(id) : true) && !except.has(id))
+		.map(([id, handler]) => options.register(id, handler(api)));
+}
+
+module.exports = { createCommands, registerCommands, downloadFromSettings, COMMANDS, RESIDENT_COMMANDS, LAST_DISTRO };
