--- /dev/null
+++ b/extensions/picket-remote-wsl/test/settings.test.js
@@ -0,0 +1,54 @@
+// RED first: this file must fail until src/settings.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { resolveSettings, describeOfficialSettings } = require('../src/settings.js');
+
+/** @param {Record<string, any>} values */
+function readers(values = {}) {
+	return {
+		readPicket: (/** @type {string} */ key) => values[`picket.${key}`],
+		readOfficial: (/** @type {string} */ key) => values[key]
+	};
+}
+
+test('an explicit Picket setting wins over the official one', () => {
+	const s = resolveSettings(readers({ 'picket.shell': 'none', 'remote.WSL.useShellEnvironment': true }));
+	assert.equal(s.loginShell, false);
+	assert.equal(resolveSettings(readers({ 'picket.shell': 'login', 'remote.WSL.useShellEnvironment': false })).loginShell, true);
+});
+
+test('the official useShellEnvironment=false is honoured', () => {
+	assert.equal(resolveSettings(readers({ 'remote.WSL.useShellEnvironment': false })).loginShell, false);
+});
+
+test('the login shell is the default when neither setting is present', () => {
+	assert.equal(resolveSettings(readers()).loginShell, true);
+});
+
+test('the official probe timeout is read in seconds and clamped', () => {
+	assert.equal(resolveSettings(readers({ 'remote.WSL.serverProbeRetryTimeout': 30 })).probeRetryTimeoutMs, 30000);
+	assert.equal(resolveSettings(readers({ 'remote.WSL.serverProbeRetryTimeout': 0 })).probeRetryTimeoutMs, 0, 'zero disables retries');
+	assert.equal(resolveSettings(readers({ 'remote.WSL.serverProbeRetryTimeout': 9e9 })).probeRetryTimeoutMs, 300000);
+});
+
+test('the probe timeout falls back to the official default of 60 s', () => {
+	assert.equal(resolveSettings(readers()).probeRetryTimeoutMs, 60000);
+	assert.equal(resolveSettings(readers({ 'remote.WSL.serverProbeRetryTimeout': -1 })).probeRetryTimeoutMs, 60000);
+	assert.equal(resolveSettings(readers({ 'remote.WSL.serverProbeRetryTimeout': 1.5 })).probeRetryTimeoutMs, 60000);
+	assert.equal(resolveSettings(readers({ 'remote.WSL.serverProbeRetryTimeout': 'thirty' })).probeRetryTimeoutMs, 60000);
+});
+
+test('the report names the two official settings we honour and why the rest are ignored', () => {
+	const lines = describeOfficialSettings(readers({ 'remote.WSL.useShellEnvironment': false, 'remote.WSL.debug': true }));
+	const joined = lines.join('\n');
+
+	assert.match(joined, /^remote\.WSL\.useShellEnvironment = false \(honoured: login shell off\)$/m);
+	assert.match(joined, /^remote\.WSL\.serverProbeRetryTimeout = 60 \(honoured: retry probes for 60000 ms\)$/m);
+	assert.match(joined, /^remote\.WSL\.debug = true \(ignored: /m);
+	assert.match(joined, /^remote\.WSL\.fileWatcher\.polling = /m);
+});
+
+test('the report says when picket.wsl.shell overrides the official setting', () => {
+	const lines = describeOfficialSettings(readers({ 'picket.shell': 'none', 'remote.WSL.useShellEnvironment': true }));
+	assert.match(lines.join('\n'), /^remote\.WSL\.useShellEnvironment = true \(ignored: picket\.wsl\.shell = none decides\)$/m);
+});
diff --git a/extensions/picket-remote-wsl/test/shim.test.js b/extensions/picket-remote-wsl/test/shim.test.js
new file mode 100644
index 00000000..b73665c7
--- /dev/null
+++ b/extensions/picket-remote-wsl/test/shim.test.js
@@ -0,0 +1,141 @@
+'use strict';
+
+// RED first: this file must fail until src/shim.js exists.
+
+const test = require('node:test');
+const assert = require('node:assert');
+const { shQuote, shimScript, installShim, removeShim } = require('../src/shim.js');
+
+const HOME = '/home/u';
+const VERSION = '1.143.1';
+
+/**
+ * A runner that records every exec and answers them from a list.
+ * @param {Array<{ code?: number, stdout?: string, stderr?: string }>} responses
+ */
+function recordingRunner(responses) {
+	/** @type {Array<{ args: string[], input?: string | Buffer }>} */
+	const calls = [];
+	return {
+		calls,
+		async exec(args, opts) {
+			calls.push({ args, input: opts?.input });
+			const answer = responses[calls.length - 1] ?? { code: 0, stdout: '', stderr: '' };
+			return { code: answer.code ?? 0, stdout: answer.stdout ?? '', stderr: answer.stderr ?? '' };
+		}
+	};
+}
+
+const BASE = { distro: 'Ubuntu', home: HOME, version: VERSION, clientPath: '/mnt/c/Programs/Picket Code.exe' };
+
+test('quotes single quotes so the script cannot break out', () => {
+	assert.strictEqual(shQuote("it's"), "'it'\\''s'");
+});
+
+test('the shim exports the client command and authority, then execs the payload CLI', () => {
+	const script = shimScript({
+		clientPath: '/mnt/c/Users/u/AppData/Local/Programs/Picket Code/Picket Code.exe',
+		authority: 'picket-wsl+Ubuntu 22.04 LTS',
+		remoteCliPath: '/home/u/.vscode-server/bin/picket-T/bin/remote-cli/picket-code'
+	});
+	assert.match(script, /VSCODE_CLIENT_COMMAND='\/mnt\/c\/Users\/u\/AppData\/Local\/Programs\/Picket Code\/Picket Code\.exe'/);
+	assert.match(script, /VSCODE_CLI_AUTHORITY='picket-wsl\+Ubuntu 22\.04 LTS'/);
+	assert.match(script, /exec '\/home\/u\/\.vscode-server\/bin\/picket-T\/bin\/remote-cli\/picket-code' "\$@"$/);
+});
+
+test('installShim writes the script, links it and verifies interop', async () => {
+	const r = recordingRunner([{ code: 0, stdout: 'none\n' }, { code: 0 }, { code: 0 }, { code: 0, stdout: 'ok\n' }]);
+	const result = await installShim({ runner: r, ...BASE });
+	assert.strictEqual(result.status, 'installed');
+	assert.strictEqual(result.scriptPath, `${HOME}/.vscode-server/bin/picket-${VERSION}/bin/picket-code`);
+	assert.strictEqual(result.linkPath, `${HOME}/.local/bin/picket-code`);
+	assert.strictEqual(r.calls.length, 5);
+
+	const [inspect, write, link, verify, probe] = r.calls;
+	for (const call of [inspect, write, link, verify, probe]) {
+		assert.deepStrictEqual(call.args.slice(0, 4), ['-d', 'Ubuntu', '-e', 'sh']);
+	}
+	// inspect: one round trip that creates the directories and reads the link
+	assert.ok(inspect.args.includes(`${HOME}/.vscode-server/bin/picket-${VERSION}/bin`), 'inspect must create the script directory');
+	assert.ok(inspect.args.includes(`${HOME}/.local/bin`), 'inspect must create the link directory too');
+	assert.ok(inspect.args.includes(result.linkPath), 'inspect reads the current link target');
+	// write: the shim content travels on stdin, never through a shell word
+	assert.ok(write.args.includes(result.scriptPath));
+	assert.match(String(write.input), /VSCODE_CLIENT_COMMAND='\/mnt\/c\/Programs\/Picket Code\.exe'/);
+	assert.match(String(write.input), /VSCODE_CLI_AUTHORITY='picket-wsl\+Ubuntu'/);
+	assert.match(String(write.input), new RegExp(`exec '${HOME.replace(/\./g, '\\.')}/\\.vscode-server/bin/picket-${VERSION}/bin/remote-cli/picket-code' "\\$@"`));
+	// link: both paths as positional args
+	assert.ok(link.args.includes(result.scriptPath) && link.args.includes(result.linkPath));
+	// verify: the link must resolve to the script and the script must be executable
+	assert.ok(verify.args.includes(result.linkPath) && verify.args.includes(result.scriptPath), 'verify reads both paths');
+	assert.match(verify.args[5], /-x/);
+	// probe: the Windows client must be startable from inside the distro
+	assert.ok(probe.args.includes('/mnt/c/Programs/Picket Code.exe'));
+	assert.match(probe.args[5], /--version/);
+});
+
+test('a symlink that points somewhere else is reported and left alone', async () => {
+	const r = recordingRunner([{ code: 0, stdout: '/usr/bin/fzf\n' }]);
+	const result = await installShim({ runner: r, ...BASE });
+	assert.strictEqual(result.status, 'foreign-link');
+	assert.match(result.message ?? '', /\/usr\/bin\/fzf/);
+	assert.strictEqual(r.calls.length, 1, 'nothing may be written over a foreign link');
+});
+
+test('a regular file where the link would go is reported and left alone', async () => {
+	const r = recordingRunner([{ code: 0, stdout: 'file\n' }]);
+	const result = await installShim({ runner: r, ...BASE });
+	assert.strictEqual(result.status, 'foreign-link');
+	assert.strictEqual(r.calls.length, 1);
+});
+
+test('a link into our own shim root is upgraded in place', async () => {
+	const r = recordingRunner([{ code: 0, stdout: `${HOME}/.vscode-server/bin/picket-0.9.0/bin/picket-code\n` }, { code: 0 }, { code: 0 }, { code: 0, stdout: 'ok\n' }]);
+	const result = await installShim({ runner: r, ...BASE });
+	assert.strictEqual(result.status, 'installed');
+	assert.strictEqual(r.calls.length, 5);
+});
+
+test('a 126 from the interop probe reports failed with the wsl.conf hint', async () => {
+	const r = recordingRunner([
+		{ code: 0, stdout: 'none\n' },
+		{ code: 0 },
+		{ code: 0 },
+		{ code: 0, stdout: 'ok\n' },
+		{ code: 126 }
+	]);
+	const result = await installShim({ runner: r, ...BASE });
+	assert.strictEqual(result.status, 'failed');
+	assert.match(result.message ?? '', /wsl\.conf/);
+	assert.match(result.message ?? '', /interop/);
+});
+
+test('a write that fails is not reported as an installed shim', async () => {
+	const r = recordingRunner([{ code: 0, stdout: 'none\n' }, { code: 1, stderr: 'cat: write error: Permission denied' }]);
+	const result = await installShim({ runner: r, ...BASE });
+	assert.strictEqual(result.status, 'failed');
+	assert.match(result.message ?? '', /Desktop|Permission|exit 1/);
+	assert.strictEqual(r.calls.length, 2, 'nothing may be linked after a failed write');
+});
+
+test('a link that fails is not reported as an installed shim', async () => {
+	const r = recordingRunner([{ code: 0, stdout: 'none\n' }, { code: 0 }, { code: 1, stderr: 'ln: failed to create symbolic link' }]);
+	const result = await installShim({ runner: r, ...BASE });
+	assert.strictEqual(result.status, 'failed');
+	assert.match(result.message ?? '', /ln: failed|exit 1/);
+});
+
+test('a link that does not point at the script is caught by the verify step', async () => {
+	const r = recordingRunner([{ code: 0, stdout: 'none\n' }, { code: 0 }, { code: 0 }, { code: 0, stdout: 'wrong-target\n' }]);
+	const result = await installShim({ runner: r, ...BASE });
+	assert.strictEqual(result.status, 'failed');
+	assert.match(result.message ?? '', /wrong-target/);
+});
+
+test('removeShim removes the shim root and the link', async () => {
+	const r = recordingRunner([]);
+	await removeShim({ runner: r, distro: 'Ubuntu', home: HOME });
+	assert.strictEqual(r.calls.length, 1);
+	assert.ok(r.calls[0].args.includes(`${HOME}/.vscode-server/bin`));
+	assert.ok(r.calls[0].args.includes(`${HOME}/.local/bin/picket-code`));
+});
diff --git a/extensions/picket-remote-wsl/test/tree.test.js b/extensions/picket-remote-wsl/test/tree.test.js
