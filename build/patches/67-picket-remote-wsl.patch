@@ -0,0 +1,198 @@
+'use strict';
+
+const { readFile, writeFile } = require('node:fs/promises');
+const { chooseSource, installPayload } = require('./payload.js');
+
+/** @typedef {{ sha256: string, source: string, installedAt: string }} IPayloadMarker */
+/** @typedef {'absent' | 'installed' | 'outdated' | 'broken'} IPayloadState */
+
+/**
+ * @param {string} payloadDir
+ * @returns {string}
+ */
+function markerPath(payloadDir) {
+	return `${payloadDir}/.picket-payload.json`;
+}
+
+/**
+ * @param {string} base
+ * @param {string} child
+ */
+function joinPath(base, child) {
+	return `${base.replace(/\/+$/, '')}/${child}`;
+}
+
+/**
+ * The disk inside the distro is the only source of truth: the Windows-side
+ * cache can be stale or corrupt, and a marker whose hash disagrees with the
+ * catalog means the payload is not the one this build expects.
+ * @param {{ catalog: any, runner: any, distro: string, home: string, statePath?: string, env?: any, fetchImpl?: typeof fetch, onProgress?: (progress: { downloaded: number, total: number }) => void }} options
+ */
+function createComponentManager(options) {
+	const { catalog, runner, distro, home } = options;
+	const payloadRoot = joinPath(home, '.picket-code-server/payloads');
+
+	/** @param {string} script @param {...string} params */
+	function sh(script, ...params) {
+		return runner.exec(['-d', distro, '-e', 'sh', '-c', script, 'sh', ...params]);
+	}
+
+	/** @returns {Promise<string[]>} absolute server-* paths, newest first */
+	async function listServerDirs() {
+		const result = await sh('ls -1t "$1" 2>/dev/null || true', payloadRoot);
+		const base = `${payloadRoot}/`;
+		return String(result.stdout)
+			.split(/\r?\n/)
+			.map(line => line.trim())
+			.filter(line => line.startsWith('server-') || line.startsWith(base))
+			.map(line => (line.startsWith('/') ? line : `${payloadRoot}/${line}`));
+	}
+
+	/** @param {string} dir */
+	async function readMarker(dir) {
+		const result = await sh('cat "$1" 2>/dev/null || true', markerPath(dir));
+		const text = String(result.stdout).trim();
+		if (!text) {
+			return undefined;
+		}
+		try {
+			const parsed = JSON.parse(text);
+			return typeof parsed?.sha256 === 'string' ? parsed : undefined;
+		} catch {
+			return undefined;
+		}
+	}
+
+	/** @param {string} id */
+	function componentOf(id) {
+		const component = catalog?.components?.find((c) => c.id === id);
+		if (!component) {
+			throw new Error(`Unknown component: ${id}`);
+		}
+		return component;
+	}
+
+	/** @param {string} id */
+	async function inspect(id) {
+		const component = componentOf(id);
+		const dirs = await listServerDirs();
+		const expected = joinPath(payloadRoot, `server-${component.version}`);
+		if (dirs.includes(expected)) {
+			const marker = await readMarker(expected);
+			const matches = marker !== undefined && marker.sha256.toLowerCase() === component.sha256.toLowerCase();
+			return {
+				state: /** @type {IPayloadState} */ (matches ? 'installed' : 'broken'),
+				version: component.version,
+				payloadDir: expected
+			};
+		}
+		const other = dirs[0];
+		if (other) {
+			return {
+				state: /** @type {IPayloadState} */ ('outdated'),
+				version: other.slice(other.lastIndexOf('server-') + 'server-'.length),
+				payloadDir: other
+			};
+		}
+		return { state: /** @type {IPayloadState} */ ('absent') };
+	}
+
+	/** @param {string} id */
+	async function ensure(id) {
+		const component = componentOf(id);
+		const current = await inspect(id);
+		if (current.state === 'installed' && current.payloadDir) {
+			return { payloadDir: current.payloadDir, source: sourceOfMarker(await readMarker(current.payloadDir)) };
+		}
+		const source = await chooseSource(component, {
+			explicitPath: options.env?.explicitPath,
+			embeddedDir: options.env?.embeddedDir,
+			baseUrl: options.env?.baseUrl,
+			exists: options.env?.exists
+		});
+		const installed = await installPayload({
+			runner, distro, component, source, payloadRoot,
+			fetchImpl: options.fetchImpl,
+			onProgress: options.onProgress
+		});
+		/** @type {IPayloadMarker} */
+		const marker = {
+			sha256: component.sha256.toLowerCase(),
+			source: source.kind === 'url' ? source.url : source.path,
+			installedAt: new Date().toISOString()
+		};
+		const written = await sh('printf %s "$1" > "$2"', JSON.stringify(marker), markerPath(installed.payloadDir));
+		if (written.code !== 0) {
+			throw new Error(`Could not write the payload marker in ${installed.payloadDir}: ${written.stderr}`);
+		}
+		await remember(id, { version: component.version, payloadDir: installed.payloadDir });
+		return { payloadDir: installed.payloadDir, source };
+	}
+
+	/** @param {any} marker */
+	function sourceOfMarker(marker) {
+		if (!marker || typeof marker.source !== 'string') {
+			return undefined;
+		}
+		return /^https?:\/\//.test(marker.source)
+			? { kind: 'url', url: marker.source }
+			: { kind: 'file', path: marker.source };
+	}
+
+	/** @param {string} id */
+	async function uninstall(id) {
+		const component = componentOf(id);
+		await sh('rm -rf "$1"', joinPath(payloadRoot, `server-${component.version}`));
+		await remember(id, undefined);
+	}
+
+	/**
+	 * Keeps the catalog version plus the newest `keep` of the rest.
+	 * @param {number} keep
+	 * @returns {Promise<string[]>} removed directory names
+	 */
+	async function cleanup(keep) {
+		const dirs = await listServerDirs();
+		const current = joinPath(payloadRoot, `server-${catalog?.tag ?? ''}`);
+		const extras = dirs.filter(dir => dir !== current);
+		const gone = extras.slice(keep);
+		for (const dir of gone) {
+			await sh('rm -rf "$1"', dir);
+		}
+		return gone.map(dir => dir.slice(dir.lastIndexOf('/') + 1));
+	}
+
+	async function list() {
+		const components = Array.isArray(catalog?.components) ? catalog.components : [];
+		/** @type {Array<{ id: string, state: string, version?: string, payloadDir?: string }>} */
+		const rows = [];
+		for (const component of components) {
+			const inspected = await inspect(component.id);
+			rows.push({ id: component.id, state: inspected.state, version: inspected.version, payloadDir: inspected.payloadDir });
+		}
+		return rows;
+	}
+
+	/** @param {string} id @param {any} value */
+	async function remember(id, value) {
+		if (!options.statePath) {
+			return;
+		}
+		let cache = {};
+		try {
+			cache = JSON.parse(await readFile(options.statePath, 'utf8'));
+		} catch {
+			cache = {};
+		}
+		cache[id] = value;
+		try {
+			await writeFile(options.statePath, JSON.stringify(cache, null, '\t'));
+		} catch {
+			// The cache is a convenience; the distro is authoritative.
+		}
+	}
+
+	return { inspect, ensure, uninstall, cleanup, list, markerPath, payloadRoot };
+}
+
+module.exports = { createComponentManager, markerPath };
diff --git a/extensions/picket-remote-wsl/src/distro.js b/extensions/picket-remote-wsl/src/distro.js
new file mode 100644
index 00000000..5d068b16
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/distro.js
@@ -0,0 +1,224 @@
+'use strict';
+
+const { spawn: spawnChild } = require('node:child_process');
+
+/**
+ * @typedef {{ name: string, isDefault: boolean, version: '1' | '2', state: string }} IDistro
+ * @typedef {{ code: number, stdout: Buffer | string, stderr: Buffer | string }} IWslResult
+ * @typedef {{ exec(args: string[], opts?: { input?: string | Buffer, timeoutMs?: number }): Promise<IWslResult>, spawn(args: string[]): { child: import('node:child_process').ChildProcess, stdout: import('node:stream').Readable | null, stderr: import('node:stream').Readable | null } }} IWslRunner
+ */
+
+/**
+ * wsl.exe writes --list output as UTF-16LE with a BOM and CRLF, and everything
+ * else as UTF-8. A NUL byte is the discriminator: no UTF-8 text we consume
+ * contains one, and every UTF-16LE ASCII string does.
+ * @param {Buffer | string} buffer
+ * @returns {string}
+ */
+function decodeWslOutput(buffer) {
+	const text = typeof buffer === 'string'
+		? buffer
+		: buffer.includes(0) ? buffer.toString('utf16le') : buffer.toString('utf8');
+	return text
+		.replace(/^\uFEFF/, '')
+		.split(/\r?\n/)
+		.map(line => line.trim())
+		.filter(line => line.length > 0)
+		.join('\n');
+}
+
+/**
+ * @param {string} distro
+ * @param {string[]} args
+ */
+function distroExec(distro, args) {
+	return ['-d', distro, '-e', ...args];
+}
+
+/**
+ * @param {{ wslPath?: string, spawn?: typeof spawnChild, cwd?: string, timeoutMs?: number }} [options]
+ * @returns {IWslRunner}
+ */
+function createWslRunner(options = {}) {
+	const wslPath = options.wslPath ?? 'wsl.exe';
+	const spawn = options.spawn ?? spawnChild;
+	const defaultTimeout = options.timeoutMs ?? 30000;
+
+	return {
+		exec(args, opts = {}) {
+			const timeoutMs = opts.timeoutMs ?? defaultTimeout;
+			return new Promise((resolve, reject) => {
+				const child = spawn(wslPath, args, { cwd: options.cwd, windowsHide: true });
+				/** @type {Buffer[]} */
+				const out = [];
+				/** @type {Buffer[]} */
+				const err = [];
+				let settled = false;
+				const timer = setTimeout(() => {
+					if (settled) {
+						return;
+					}
+					settled = true;
+					child.kill();
+					reject(new Error(`Timed out after ${timeoutMs} ms: wsl.exe ${args.join(' ')}`));
+				}, timeoutMs);
+				timer.unref?.();
+
+				child.stdout?.on('data', (chunk) => out.push(chunk));
+				child.stderr?.on('data', (chunk) => err.push(chunk));
+				child.on('error', (error) => {
+					if (settled) {
+						return;
+					}
+					settled = true;
+					clearTimeout(timer);
+					reject(error);
+				});
+				child.on('close', (code) => {
+					if (settled) {
+						return;
+					}
+					settled = true;
+					clearTimeout(timer);
+					resolve({ code: code ?? -1, stdout: Buffer.concat(out), stderr: Buffer.concat(err) });
+				});
+
+				if (opts.input !== undefined) {
+					child.stdin?.end(opts.input);
+				} else {
+					child.stdin?.end();
+				}
+			});
+		},
+		spawn(args) {
+			const child = spawn(wslPath, args, { cwd: options.cwd, windowsHide: true });
+			return { child, stdout: child.stdout, stderr: child.stderr };
+		}
+	};
+}
+
+/**
+ * @param {string} stdout
+ * @returns {IDistro[]}
+ */
+function parseDistroTable(stdout) {
+	/** @type {IDistro[]} */
+	const distros = [];
+	for (const line of stdout.split(/\r?\n/).map(l => l.trim())) {
+		// Lines arrive trimmed, so the leading space of a non-default row is gone.
+		const match = /^(\*)?\s*(.+?)\s+(\w+)\s+([12])$/.exec(line);
+		if (!match) {
+			continue;
+		}
+		const [, marker, name, state, version] = match;
+		distros.push({ name: name.trim(), isDefault: marker === '*', version: version === '1' ? '1' : '2', state });
+	}
+	return distros;
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @returns {Promise<IDistro[]>}
+ */
+async function listDistros(runner) {
+	const result = await runner.exec(['--list', '--verbose']);
+	if (result.code !== 0) {
+		throw new Error(`wsl --list --verbose failed (${result.code}): ${decodeWslOutput(result.stderr)}`);
+	}
+	return parseDistroTable(decodeWslOutput(result.stdout));
+}
+
+/**
+ * @param {IDistro[]} list
+ * @returns {string}
+ */
+function defaultDistro(list) {
+	const marked = list.find(d => d.isDefault);
+	if (marked) {
+		return marked.name;
+	}
+	if (list.length === 0) {
+		throw new Error('No WSL distro is installed');
+	}
+	return list[0].name;
+}
+
+/**
+ * docker-desktop / docker-desktop-data are plumbing distros; offering them as
+ * places to open a folder is noise, unless the user made one the default.
+ * @param {IDistro[]} list
+ * @returns {IDistro[]}
+ */
+function visibleDistros(list) {
+	return list.filter(d => d.isDefault || !/^docker-desktop/i.test(d.name));
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @param {string} distro
+ * @returns {Promise<string>}
+ */
+async function distroHome(runner, distro) {
+	const result = await runner.exec(distroExec(distro, ['printenv', 'HOME']));
+	const home = decodeWslOutput(result.stdout);
+	if (result.code !== 0 || home.length === 0) {
+		throw new Error(`Could not read $HOME in ${distro} (${result.code}): ${decodeWslOutput(result.stderr)}`);
+	}
+	return home.split('\n')[0];
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @param {string} distro
+ * @returns {Promise<boolean>}
+ */
+async function isWsl1(runner, distro) {
+	const list = await listDistros(runner);
+	const found = list.find(d => d.name === distro);
+	return found?.version === '1';
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @param {string} distro
+ * @returns {Promise<'missing' | 'ok'>}
+ */
+async function distroStatus(runner, distro) {
+	try {
+		const result = await runner.exec(distroExec(distro, ['true']));
+		return result.code === 0 ? 'ok' : 'missing';
+	} catch {
+		return 'missing';
+	}
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @returns {Promise<{ installed: boolean, kernelUpdateRequired: boolean }>}
+ */
+async function wslStatus(runner) {
+	let result;
+	try {
+		result = await runner.exec(['--status']);
+	} catch (error) {
+		return { installed: false, kernelUpdateRequired: /kernel/i.test(String(error)) };
+	}
+	const stderr = decodeWslOutput(result.stderr);
+	if (result.code !== 0 && /not installed|not enabled/i.test(stderr)) {
+		return { installed: false, kernelUpdateRequired: false };
+	}
+	return { installed: true, kernelUpdateRequired: /kernel/i.test(stderr) };
+}
+
+module.exports = {
+	decodeWslOutput,
+	createWslRunner,
+	parseDistroTable,
+	listDistros,
+	defaultDistro,
+	visibleDistros,
+	distroHome,
+	isWsl1,
+	distroStatus,
+	wslStatus
+};
diff --git a/extensions/picket-remote-wsl/src/icode.js b/extensions/picket-remote-wsl/src/icode.js
new file mode 100644
index 00000000..cf40b908
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/icode.js
@@ -0,0 +1,38 @@
+'use strict';
+
+const { decodeWslOutput } = require('./distro.js');
+
+/**
+ * iCode is optional: a distro without it is a working window with no AI, so a
+ * miss is a normal answer (`missing`), never an error. Detection runs in the
+ * same login shell the server is started in, because that shell is what decides
+ * whether `~/.local/bin` is on `PATH` — detecting in a bare `sh -c` would find
+ * nothing on machines where the server would have found it.
+ * @param {{ runner: any, distro: string, configuredPath?: string }} options
+ * @returns {Promise<{ path: string | null, source: 'setting' | 'path' | 'missing' }>}
+ */
+async function detectIcode(options) {
+	const { runner, distro } = options;
+	const configuredPath = options.configuredPath ?? '';
+	if (configuredPath) {
+		const tested = await runner.exec(['-d', distro, '-e', 'test', '-x', configuredPath]);
+		if (tested.code === 0) {
+			return { path: configuredPath, source: 'setting' };
+		}
+	}
+	const found = await runner.exec(['-d', distro, '-e', 'sh', '-lc', 'command -v icode']);
+	if (found.code === 0) {
+		// A login shell may print a profile banner before the answer; the path is
+		// the last absolute line it wrote.
+		const line = decodeWslOutput(found.stdout)
+			.split('\n')
+			.filter(text => text.startsWith('/'))
+			.pop();
+		if (line) {
+			return { path: line, source: 'path' };
+		}
+	}
+	return { path: null, source: 'missing' };
+}
+
+module.exports = { detectIcode };
diff --git a/extensions/picket-remote-wsl/src/launch.js b/extensions/picket-remote-wsl/src/launch.js
