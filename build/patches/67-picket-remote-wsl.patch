diff --git a/test/wsl-harness/fake-wsl.mjs b/test/wsl-harness/fake-wsl.mjs
new file mode 100755
index 00000000..1976546b
--- /dev/null
+++ b/test/wsl-harness/fake-wsl.mjs
@@ -0,0 +1,101 @@
+#!/usr/bin/env node
+// Stand-in `wsl.exe` for the Linux acceptance runs (plan Task 14). It executes
+// the extension's distro-side invocations as plain local commands against a
+// scratch HOME (PICKET_FAKE_HOME), so the whole resolver pipeline — distro
+// listing, payload install through stdin, login-shell server launch, runtime
+// file, probe, kill ladder — runs end to end on a Linux desktop. Only the
+// wsl.exe boundary is faked; the server payload, its node and every `sh`
+// script are the real thing.
+//
+// The distro-side children are spawned detached: on real Windows the server
+// outlives the wsl.exe relay and the window, and the lifecycle acceptance
+// relies on the same shape here (a process-group kill of the window must not
+// take the server down).
+import { spawn } from 'node:child_process';
+
+const args = process.argv.slice(2);
+const home = process.env.PICKET_WSL_FAKE_HOME;
+
+if (!home) {
+	console.error('fake-wsl: PICKET_WSL_FAKE_HOME is not set');
+	process.exit(1);
+}
+
+// decodeWslOutput sniffs for NUL bytes: UTF-8 without NULs decodes fine.
+if (args[0] === '--list' && args[1] === '--verbose') {
+	const distro = process.env.PICKET_WSL_DISTRO ?? 'PicketAccept';
+	process.stdout.write(`  ${distro}  Running 2\n`);
+	process.exit(0);
+}
+if (args[0] === '--status') {
+	process.stdout.write('Default Distribution: PicketAccept\nDefault Version: 2\n');
+	process.exit(0);
+}
+if (args[0] === '--list' && args[1] === '--online') {
+	// One row, so the add-distro flow has something to pick. `--install` is not
+	// handled: manage.js runs it in a user terminal, never through this runner.
+	process.stdout.write('NAME            FRIENDLY NAME\nUbuntu          Ubuntu 24.04 LTS\n');
+	process.exit(0);
+}
+if (args[0] === '--set-default' || args[0] === '--unregister') {
+	process.exit(0);
+}
+
+if (args[0] === '-d' && args[2] === '-e') {
+	const cmd = args.slice(3);
+
+	// Real wsl.exe forwards only the env vars listed in WSLENV. Wholesale
+	// inheritance leaks the calling window's environment (VSCODE_DEV=1) into
+	// the distro and changes server behavior, so build the child env the way
+	// wsl.exe does: HOME points at the fake home, PATH carries over, and only
+	// WSLENV entries join in (`/w` entries never leave Windows).
+	const passthrough = (process.env.WSLENV ?? '').split(':').filter(Boolean).map(entry => {
+		const [name, flags = ''] = entry.split('/');
+		return { name, toWsl: !flags.includes('w') };
+	});
+	const childEnv = { HOME: home, PATH: process.env.PATH ?? '' };
+	for (const { name, toWsl } of passthrough) {
+		if (toWsl && process.env[name] !== undefined) {
+			childEnv[name] = process.env[name];
+		}
+	}
+
+	// The product deliberately asks wslpath instead of guessing the mapping
+	// (remoteUri.js); the fake distro's filesystem is the host's, so a POSIX
+	// path is an identity and only drive-letter inputs need /mnt translation.
+	if (cmd[0] === 'wslpath') {
+		const flag = cmd[1];
+		const value = cmd[2] ?? '';
+		let out = value;
+		if (flag === '-u') {
+			const drive = /^([A-Za-z]):[\\/](.*)$/.exec(value);
+			if (drive) {
+				out = `/mnt/${drive[1].toLowerCase()}/${drive[2].replaceAll('\\', '/')}`;
+			}
+		} else if (flag === '-w') {
+			const mnt = /^\/mnt\/([a-z])\/(.*)$/.exec(value);
+			if (mnt) {
+				out = `${mnt[1].toUpperCase()}:\\${mnt[2].replaceAll('/', '\\')}`;
+			}
+		}
+		process.stdout.write(`${out}\n`);
+		process.exit(0);
+	}
+
+	const child = spawn(cmd[0], cmd.slice(1), {
+		cwd: home,
+		env: childEnv,
+		detached: true,
+		stdio: ['pipe', 'inherit', 'inherit']
+	});
+	process.stdin.pipe(child.stdin);
+	child.stdin.on('error', () => { /* tar died early; its exit code reports the failure */ });
+	child.on('error', error => {
+		console.error(`fake-wsl: ${cmd[0]}: ${error.message}`);
+		process.exit(127);
+	});
+	child.on('exit', code => process.exit(code ?? 1));
+} else {
+	console.error(`fake-wsl: unsupported args ${JSON.stringify(args)}`);
+	process.exit(1);
+}
diff --git a/test/wsl-harness/remote/extension.js b/test/wsl-harness/remote/extension.js
new file mode 100644
index 00000000..fcd9ed20
--- /dev/null
+++ b/test/wsl-harness/remote/extension.js
@@ -0,0 +1,157 @@
+'use strict';
+
+// Acceptance harness for the WSL remote window (plan Task 14). Loads in the
+// remote extension host of a window opened on `picket-wsl+<distro>` and runs
+// the behaviour assertions the UI layer cannot see:
+//
+//   b2 — the opened workspace folder is the folder the authority pointed at
+//   b3 — the server runs under the login shell (profile marker) and is Linux
+//   b4 — a workspace.fs write produces a watcher event within 2 s
+//   b5 — a 10 MB round trip keeps its sha256
+//   b6 — a bogus configured iCode path is never exported into the server
+//
+// Results go out as `WSL-ASSERT ok|fail <name>` lines (they land in the
+// server console/log) and as a JSON file under `<home>/.picket-code-server/`,
+// which acceptance.sh polls for — the file survives the window and needs no
+// log plumbing.
+
+const { execFile } = require('node:child_process');
+const { createHash, randomBytes } = require('node:crypto');
+const { mkdir, rename, writeFile } = require('node:fs/promises');
+const { homedir } = require('node:os');
+const { join } = require('node:path');
+const { promisify } = require('node:util');
+const vscode = require('vscode');
+
+const execFileP = promisify(execFile);
+const RESULTS_FILE = join(homedir(), '.picket-code-server', 'harness-results.json');
+const MEGABYTE = 1024 * 1024;
+
+async function waitForFolder(deadlineMs) {
+	const started = Date.now();
+	while (Date.now() - started < deadlineMs) {
+		const folder = vscode.workspace.workspaceFolders?.[0];
+		if (folder) {
+			return folder;
+		}
+		await new Promise(resolve => setTimeout(resolve, 250));
+	}
+	return undefined;
+}
+
+async function checkB2() {
+	const expected = process.env.WSL_HARNESS_FOLDER;
+	if (!expected) {
+		return { ok: false, detail: 'WSL_HARNESS_FOLDER is not set' };
+	}
+	const folder = await waitForFolder(10_000);
+	if (!folder) {
+		return { ok: false, detail: 'no workspace folder after 10s' };
+	}
+	const actual = folder.uri.fsPath;
+	if (actual !== expected) {
+		return { ok: false, detail: `opened ${actual}, expected ${expected}` };
+	}
+	return { ok: true };
+}
+
+async function checkB3() {
+	const { stdout } = await execFileP('uname', ['-a']);
+	if (!/Linux/i.test(stdout)) {
+		return { ok: false, detail: `uname -a said ${stdout.trim()}` };
+	}
+	const marker = process.env.PICKET_ACCEPT_PROFILE_MARKER;
+	if (marker !== 'from-login-shell') {
+		return { ok: false, detail: `login-shell profile marker not exported (got ${JSON.stringify(marker)})` };
+	}
+	return { ok: true };
+}
+
+async function checkB4(folder) {
+	const name = `.harness-b4-${randomBytes(4).toString('hex')}`;
+	const target = vscode.Uri.joinPath(folder.uri, name);
+	const watcher = vscode.workspace.createFileSystemWatcher(
+		new vscode.RelativePattern(folder, '.harness-b4-*'));
+	try {
+		const event = new Promise((resolve, reject) => {
+			const timer = setTimeout(() => reject(new Error('no watcher event within 2s')), 2_000);
+			watcher.onDidCreate(() => { clearTimeout(timer); resolve(); });
+		});
+		await vscode.workspace.fs.writeFile(target, Buffer.from('b4'));
+		await event;
+		return { ok: true };
+	} catch (error) {
+		return { ok: false, detail: error.message };
+	} finally {
+		watcher.dispose();
+		await vscode.workspace.fs.delete(target, { force: true }).catch(() => { });
+	}
+}
+
+async function sha256(bytes) {
+	return createHash('sha256').update(bytes).digest('hex');
+}
+
+async function checkB5(folder) {
+	const target = vscode.Uri.joinPath(folder.uri, 'harness-b5.bin');
+	const payload = randomBytes(10 * MEGABYTE);
+	const sent = await sha256(payload);
+	try {
+		await vscode.workspace.fs.writeFile(target, payload);
+		const echoed = await vscode.workspace.fs.readFile(target);
+		const returned = await sha256(echoed);
+		if (returned !== sent) {
+			return { ok: false, detail: `sha256 mismatch after round trip` };
+		}
+		return { ok: true };
+	} finally {
+		await vscode.workspace.fs.delete(target, { force: true }).catch(() => { });
+	}
+}
+
+async function checkB6() {
+	if (process.env.WSL_HARNESS_EXPECT_ICODE_MISSING !== '1') {
+		return undefined;
+	}
+	const exported = process.env.PICKET_ICODE_BIN;
+	if (exported === '/nonexistent/icode') {
+		return { ok: false, detail: 'the bogus configured icodePath was exported into the server' };
+	}
+	return { ok: true, detail: `PICKET_ICODE_BIN=${exported ?? '<unset>'} (bogus path not exported)` };
+}
+
+async function main() {
+	const results = {};
+	try {
+		const folder = await waitForFolder(10_000);
+		results.b2 = await checkB2();
+		results.b3 = await checkB3();
+		if (folder) {
+			results.b4 = await checkB4(folder);
+			results.b5 = await checkB5(folder);
+		} else {
+			results.b4 = { ok: false, detail: 'skipped: no workspace folder' };
+			results.b5 = { ok: false, detail: 'skipped: no workspace folder' };
+		}
+		const b6 = await checkB6();
+		if (b6) {
+			results.icode = b6;
+		}
+	} catch (error) {
+		results.harness = { ok: false, detail: error.message };
+	}
+
+	for (const [name, check] of Object.entries(results)) {
+		console.log(`WSL-ASSERT ${check.ok ? 'ok' : 'fail'} ${name}${check.detail ? `: ${check.detail}` : ''}`);
+	}
+	await mkdir(join(RESULTS_FILE, '..'), { recursive: true });
+	// The runner polls for this file; a reader must never see half of it, so it
+	// is written beside the target and renamed into place.
+	const pending = `${RESULTS_FILE}.${process.pid}.tmp`;
+	await writeFile(pending, JSON.stringify(results, null, 2))
+		.then(() => rename(pending, RESULTS_FILE))
+		.catch(() => { });
+}
+
+exports.activate = main;
+exports.deactivate = undefined;
