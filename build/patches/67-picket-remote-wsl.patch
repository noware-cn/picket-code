+	assert.strictEqual(seen.length, 1);
+	assert.strictEqual(seen[0].url, 'http://mirror.corp/wsl/payload.tar.gz');
+	assert.strictEqual(seen[0].headers.host, 'mirror.corp');
+	assert.strictEqual(seen[0].headers['proxy-authorization'], undefined, 'no header without credentials');
+});
+
+test('proxy credentials become a basic Proxy-Authorization header', async () => {
