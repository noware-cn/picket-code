+++ b/extensions/picket-remote-wsl/test/tunnel.test.js
@@ -0,0 +1,222 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const net = require('node:net');
+const { spawn } = require('node:child_process');
+const { once } = require('node:events');
+
+const { PIPE_SCRIPT, createStdioTunnel } = require('../src/tunnel.js');
+
+const silentLog = { info() { }, error() { } };
+
+/** @param {net.Server} server */
+function listen(server) {
+	return new Promise(resolve => server.listen(0, '127.0.0.1', () => resolve(server.address())));
+}
+
+/** @param {net.Server} server */
+function closed(server) {
+	return new Promise(resolve => server.close(() => resolve()));
+}
+
+/**
+ * The tunnel's only process boundary is `IWslRunner.spawn`, so a fake runner that
+ * keeps the argv shape but runs the payload with the host's own node is a
+ * faithful stand-in for wsl.exe: the script and the port are the only things
+ * that matter, and asserting the whole argv keeps the real form honest.
+ */
+function fakeRunner(overrides = {}) {
+	const spawned = [];
+	return {
+		spawned,
+		exec: async () => ({ code: 0, stdout: '', stderr: '' }),
+		spawn(args) {
+			assert.deepEqual(args.slice(0, 5), ['-d', 'Ubuntu', '-e', '/payloads/server-1.0.0/node', '-e']);
+			assert.equal(args[5], PIPE_SCRIPT);
+			assert.match(args[6], /^\d+$/);
+			const child = overrides.spawn
+				? overrides.spawn(args)
+				: spawn(process.execPath, ['-e', PIPE_SCRIPT, args[6]], { stdio: 'pipe' });
+			spawned.push(child);
+			return { child, stdout: child.stdout, stderr: child.stderr };
+		}
+	};
+}
+
+test('the pipe script relays bytes both ways', async () => {
+	const server = net.createServer(socket => socket.pipe(socket));
+	const address = await listen(server);
+
+	const child = spawn(process.execPath, ['-e', PIPE_SCRIPT, String(address.port)], { stdio: 'pipe' });
+	try {
+		await once(child.stdout, 'data');
+		child.stdin.write('ping');
+		const [echoed] = await once(child.stdout, 'data');
+		assert.equal(String(echoed), 'ping');
+	} finally {
+		child.kill();
+		await closed(server);
+	}
+});
+
+test('a connection is relayed to the echo server through the child', async () => {
+	const echo = net.createServer(socket => socket.pipe(socket));
+	const address = await listen(echo);
+	const runner = fakeRunner();
+	const tunnel = await createStdioTunnel({
+		runner,
+		distro: 'Ubuntu',
+		serverPort: address.port,
+		nodePath: '/payloads/server-1.0.0/node',
+		log: silentLog
+	});
+
+	const client = net.connect(tunnel.localPort, '127.0.0.1');
+	try {
+		await once(client, 'connect');
+		client.write('hello');
+		const [chunk] = await once(client, 'data');
+		assert.equal(String(chunk), 'hello');
+	} finally {
+		client.destroy();
+		await tunnel.dispose();
+		await closed(echo);
+	}
+});
+
+test('a binary payload survives the round trip', async () => {
+	const echo = net.createServer(socket => socket.pipe(socket));
+	const address = await listen(echo);
+	const tunnel = await createStdioTunnel({
+		runner: fakeRunner(),
+		distro: 'Ubuntu',
+		serverPort: address.port,
+		nodePath: '/payloads/server-1.0.0/node',
+		log: silentLog
+	});
+
+	const client = net.connect(tunnel.localPort, '127.0.0.1');
+	const payload = Buffer.from([0x00, 0xff, 0x41, 0x0a, 0xc3, 0x28]);
+	try {
+		await once(client, 'connect');
+		client.write(payload);
+		const [chunk] = await once(client, 'data');
+		assert.deepStrictEqual(Buffer.from(chunk).subarray(0, payload.length), payload);
+	} finally {
+		client.destroy();
+		await tunnel.dispose();
+		await closed(echo);
+	}
+});
+
+test('dispose closes the listener and leaves no child alive', async () => {
+	const echo = net.createServer(socket => socket.pipe(socket));
+	const address = await listen(echo);
+	const runner = fakeRunner();
+	const tunnel = await createStdioTunnel({
+		runner,
+		distro: 'Ubuntu',
+		serverPort: address.port,
+		nodePath: '/payloads/server-1.0.0/node',
+		log: silentLog
+	});
+	const port = tunnel.localPort;
+
+	await tunnel.dispose();
+	await closed(echo);
+
+	assert.ok(runner.spawned.length > 0, 'the bootstrap should have spawned a child');
+	for (const child of runner.spawned) {
+		assert.ok(child.exitCode !== null || child.signalCode !== null, 'every child must be dead after dispose');
+	}
+
+	const client = net.connect(port, '127.0.0.1');
+	const [error] = await once(client, 'error');
+	assert.equal(error.code, 'ECONNREFUSED');
+	client.destroy();
+});
+
+test('a silent child fails the bootstrap with a preamble timeout', async () => {
+	const echo = net.createServer(socket => socket.pipe(socket));
+	const address = await listen(echo);
+	const runner = fakeRunner({
+		spawn: () => spawn(process.execPath, ['-e', 'setInterval(() => { }, 1000)'], { stdio: 'pipe' })
+	});
+
+	try {
+		await assert.rejects(
+			() => createStdioTunnel({
+				runner,
+				distro: 'Ubuntu',
+				serverPort: address.port,
+				nodePath: '/payloads/server-1.0.0/node',
+				log: silentLog,
+				preambleTimeoutMs: 200
+			}),
+			/tunnel preamble timeout/
+		);
+	} finally {
+		for (const child of runner.spawned) {
+			child.kill();
+		}
+		await closed(echo);
+	}
+});
+
+test('a child that exits before the preamble reports why', async () => {
+	const echo = net.createServer(socket => socket.pipe(socket));
+	const address = await listen(echo);
+	const runner = fakeRunner({
+		spawn: () => spawn(process.execPath, ['-e', 'process.stderr.write("node: not found\\n"); process.exit(3)'], { stdio: 'pipe' })
+	});
+
+	try {
+		await assert.rejects(
+			() => createStdioTunnel({
+				runner,
+				distro: 'Ubuntu',
+				serverPort: address.port,
+				nodePath: '/payloads/server-1.0.0/node',
+				log: silentLog,
+				preambleTimeoutMs: 5000
+			}),
+			/exited with code 3.*node: not found/s
+		);
+	} finally {
+		await closed(echo);
+	}
+});
+
+test('a relay stdin that errors does not crash the host', async () => {
+	// Without an 'error' listener on the relay's stdin, a write after the child
+	// died raises an unhandled EPIPE and takes the whole extension host with it
+	// (the same defect the distro probe's exec had).
+	const echo = net.createServer(socket => socket.pipe(socket));
+	const address = await listen(echo);
+	const runner = fakeRunner();
+	const tunnel = await createStdioTunnel({
+		runner,
+		distro: 'Ubuntu',
+		serverPort: address.port,
+		nodePath: '/payloads/server-1.0.0/node',
+		log: silentLog
+	});
+
+	const client = net.connect(tunnel.localPort, '127.0.0.1');
+	client.on('error', () => { /* the relay is gone; that is the point */ });
+	try {
+		await once(client, 'connect');
+		// The accepted connection gets its own relay child; the first one was the
+		// bootstrap, already closed with the socket it proved.
+		for (let i = 0; i < 50 && runner.spawned.length < 2; i++) {
+			await new Promise(resolve => setTimeout(resolve, 20));
+		}
+		runner.spawned[runner.spawned.length - 1].stdin.destroy(new Error('write EPIPE'));
+		await new Promise(resolve => setTimeout(resolve, 100));
+	} finally {
+		client.destroy();
+		await tunnel.dispose();
+		await closed(echo);
+	}
+});
