+});
+
+test('a real shell extracts a flat archive through stdin', { skip: process.platform !== 'linux' }, async () => {
+	// The fake runner above cannot see inside the scripts; run them for real so a
+	// missing `mkdir` before `tar -C` fails here instead of in a live window
+	// (acceptance --remote, 2026-11-04: tar -C .tmp-… with no such directory).
+	const { mkdirSync, statSync, existsSync } = require('node:fs');
+	const { execFileSync, spawn } = require('node:child_process');
+	const { sha256OfFile } = require('../src/payload.js');
+	const { createWslRunner } = require('../src/distro.js');
+
+	const dir = mkdtempSync(join(tmpdir(), 'picket-payload-real-'));
+	mkdirSync(join(dir, 'bin'), { recursive: true });
+	writeFileSync(join(dir, 'bin', 'picket-code-server'), '#!/bin/sh\nexec out/server-main.js\n');
+	writeFileSync(join(dir, 'product.json'), '{}\n');
+	const file = join(dir, 'payload.tar.gz');
+	execFileSync('tar', ['-czf', file, '-C', dir, 'bin', 'product.json']);
+	const component = { ...COMPONENT, file: 'payload.tar.gz', size: statSync(file).size, sha256: await sha256OfFile(file) };
+
+	const home = mkdtempSync(join(tmpdir(), 'picket-payload-home-'));
+	const payloadRoot = join(home, '.picket-code-server', 'payloads');
+	// `wsl.exe -d <distro> -e <cmd...>` runs <cmd...>; map it onto the local shell.
+	const runner = createWslRunner({ wslPath: '/bin/sh', spawn: (wslPath, args) => spawn(wslPath, ['-c', 'exec "$@"', '--', ...args.slice(3)]) });
+
+	const result = await installPayload({ runner, distro: 'X', component, source: { kind: 'file', path: file }, payloadRoot });
+	assert.strictEqual(result.payloadDir, join(payloadRoot, `picket-${component.version}`));
+	assert.ok(existsSync(join(result.payloadDir, 'bin', 'picket-code-server')), 'the binary lands in the final directory');
+	assert.deepStrictEqual(readdirSync(payloadRoot).filter(name => name.startsWith('.tmp-')), [], 'no temp directory survives');
+});
+
+test('a real shell unwraps an archive with a single top-level directory', { skip: process.platform !== 'linux' }, async () => {
+	// Release artifacts are packaged from the parent directory, so the archive
+	// root is one wrapping folder; a flat Task 12 bundle must keep working too.
+	const { mkdirSync, statSync, existsSync } = require('node:fs');
+	const { execFileSync, spawn } = require('node:child_process');
+	const { sha256OfFile } = require('../src/payload.js');
+	const { createWslRunner } = require('../src/distro.js');
+
+	const dir = mkdtempSync(join(tmpdir(), 'picket-payload-wrap-'));
+	const inner = join(dir, 'picket-code-server-linux-x64');
+	mkdirSync(join(inner, 'bin'), { recursive: true });
+	writeFileSync(join(inner, 'bin', 'picket-code-server'), '#!/bin/sh\nexec "$ROOT/node" out/server-main.js\n');
+	writeFileSync(join(inner, 'product.json'), '{}\n');
+	const file = join(dir, 'payload.tar.gz');
+	execFileSync('tar', ['-czf', file, '-C', dir, 'picket-code-server-linux-x64']);
+	const component = { ...COMPONENT, file: 'payload.tar.gz', size: statSync(file).size, sha256: await sha256OfFile(file) };
+
+	const home = mkdtempSync(join(tmpdir(), 'picket-payload-home2-'));
+	const payloadRoot = join(home, '.picket-code-server', 'payloads');
+	const runner = createWslRunner({ wslPath: '/bin/sh', spawn: (wslPath, args) => spawn(wslPath, ['-c', 'exec "$@"', '--', ...args.slice(3)]) });
