+const { createFakeComponents, createCatalog } = require('./fixtures/fake-host.js');
+
+/**
+ * wsl.exe answers UTF-16LE for its tables; the report has to survive that.
+ * @param {Array<[string, any]>} handlers
+ */
+function makeRunner(handlers) {
+	return {
+		async exec(args) {
+			const key = args.join(' ');
+			for (const [match, value] of handlers) {
+				if (key.includes(match)) {
+					if (value instanceof Error) {
+						throw value;
+					}
+					return { code: 0, stderr: '', ...value };
+				}
+			}
+			return { code: 0, stdout: '', stderr: '' };
+		}
+	};
+}
+
+/** @param {Array<[string, any]>} handlers */
+function happyRunner(handlers = []) {
+	return makeRunner([
+		...handlers,
+		['--list --verbose', { stdout: Buffer.from('  NAME            STATE           VERSION\n* Ubuntu-24.04    Running         2\n  Debian          Stopped         2', 'utf16le') }],
+		['--status', { stdout: '' }],
+		['printenv HOME', { stdout: '/home/u\n' }],
+		['command -v icode', { stdout: '/usr/local/bin/icode\n' }],
+		['node -v', { stdout: 'v20.11.0\n' }],
+		['git --version', { stdout: 'git version 2.43.0\n' }]
+	]);
+}
+
+/** @param {{ version?: string, minVersion?: string, gallery?: any }} [product] */
+async function appRoot(product = {}) {
+	const dir = await mkdtemp(join(tmpdir(), 'picket-diag-'));
+	await writeFile(join(dir, 'product.json'), JSON.stringify({
+		version: product.version ?? '1.143.1',
