+/** @param {{ version?: string }} [options] */
+function catalog(options = {}) {
+	const version = options.version ?? VERSION;
+	return {
+		schema: 2,
+		minVersion: '1.0.0',
+		flavor: 'ondemand',
+		components: [{
+			id: 'wsl-server',
+			kind: 'server',
+			commit: COMMIT,
+			version,
+			file: `picket-code-server-${version}-linux-x64.tar.gz`,
+			sha256: 'a'.repeat(64),
+			size: 1
+		}]
+	};
+}
+
+/**
+ * Answers the three shapes the resolver sends through `sh -c`: the lock probe,
+ * the runtime read, and (for the component manager) `ls -1t` plus marker and
+ * removal writes.
+ * @param {{ runtime?: any, runtimeSequence?: any[], payloadDirs?: string[], home?: string, table?: string, icode?: string, locked?: boolean, lockAgeSeconds?: number, pidAlive?: boolean }} [options]
+ */
+function makeRunner(options = {}) {
+	const calls = [];
+	const state = { spawns: 0, cleared: 0, removed: [], markers: [], acquired: 0, released: 0 };
+	const sequence = (options.runtimeSequence ?? []).slice();
+	/** @type {any} */
+	let lockHeld = options.locked === true;
+	const runner = {
+		calls,
+		state,
+		async exec(args) {
+			calls.push(args.join(' '));
+			if (args[0] === '--list') {
+				return { code: 0, stdout: options.table ?? TABLE, stderr: '' };
+			}
+			const script = args.slice(args.indexOf('-e') + 1).join(' ');
+			if (script.startsWith('printenv HOME')) {
+				return { code: 0, stdout: `${options.home ?? '/home/u'}\n`, stderr: '' };
+			}
+			if (script.includes('ls -1t')) {
+				return { code: 0, stdout: (options.payloadDirs ?? []).join('\n'), stderr: '' };
+			}
+			if (script.includes('printf %s "$1" > "$2"')) {
+				state.markers.push(args[args.length - 1]);
+				return { code: 0, stdout: '', stderr: '' };
+			}
+			if (script.includes('rmdir "$1"')) {
+				lockHeld = false;
+				state.released += 1;
+				return { code: 0, stdout: '', stderr: '' };
+			}
+			if (script.includes('stat -c %Y')) {
+				return { code: 0, stdout: lockHeld ? `${Math.floor(Date.now() / 1000) - (options.lockAgeSeconds ?? 0)}\n` : '', stderr: '' };
+			}
+			if (script.includes('"$1.lock"')) {
+				state.cleared += 1;
+				lockHeld = false;
+				return { code: 0, stdout: '', stderr: '' };
+			}
+			if (script.includes('rm -rf')) {
+				state.removed.push(args[args.length - 1]);
+				return { code: 0, stdout: '', stderr: '' };
+			}
+			if (script.includes('command -v icode')) {
+				return { code: options.icode === undefined ? 1 : 0, stdout: options.icode ?? '', stderr: '' };
+			}
+			if (script.includes('kill -0')) {
+				return { code: options.pidAlive === true ? 0 : 1, stdout: '', stderr: '' };
+			}
+			if (script.startsWith('test -x')) {
+				return { code: 1, stdout: '', stderr: '' };
+			}
+			if (script.includes('if [ -e')) {
+				return { code: 0, stdout: lockHeld ? '1' : '0', stderr: '' };
+			}
+			if (script.includes('mkdir "$1"')) {
+				if (lockHeld) {
+					return { code: 1, stdout: '', stderr: '' };
+				}
+				lockHeld = true;
+				state.acquired += 1;
+				return { code: 0, stdout: '', stderr: '' };
+			}
+			if (script.includes('rm -f')) {
+				state.cleared += 1;
+				return { code: 0, stdout: '', stderr: '' };
+			}
+			if (script.includes('cat "$1"')) {
+				const value = sequence.length > 1 ? sequence.shift() : sequence.length === 1 ? sequence[0] : options.runtime;
+				return { code: 0, stdout: value === undefined ? '' : JSON.stringify(value), stderr: '' };
+			}
+			throw new Error(`unexpected script: ${script}`);
+		},
+		spawn() {
+			state.spawns += 1;
+			throw new Error('the resolver tests inject startServer; spawn must stay unused');
+		}
+	};
+	return runner;
+}
+
+function silentLog() {
+	return { info() { }, error() { }, show() { }, dispose() { } };
+}
+
+/** @param {{ payloadDir?: string }} [options] */
+function components(options = {}) {
+	return () => ({ ensure: async () => ({ payloadDir: options.payloadDir ?? `/home/u/.vscode-server/bin/picket-${VERSION}` }) });
