+'use strict';
+
+const { join } = require('node:path');
+const vscode = require('vscode');
+const { createLog } = require('./src/log.js');
+const { loadCatalog } = require('./src/catalog.js');
+const { readProduct } = require('./src/product.js');
+const { createWslRunner, listDistros, visibleDistros } = require('./src/distro.js');
+const { createComponentManager } = require('./src/components.js');
+const { createResolver } = require('./src/resolver.js');
+const { AUTHORITY_PREFIX, LEGACY_AUTHORITY_PREFIX, parseAuthority, canonicalAuthority } = require('./src/remoteUri.js');
+const { buildDistroNodes, buildBlockedNode } = require('./src/tree.js');
+const { registerCommands, downloadFromSettings, RESIDENT_COMMANDS } = require('./src/commands.js');
+const { createOfficialGate, OFFICIAL_EXTENSION_ID } = require('./src/official.js');
+const { resolveSettings } = require('./src/settings.js');
+const { maybeNudge } = require('./src/nudge.js');
+
+/** @param {vscode.ExtensionContext} context */
+async function activate(context) {
+	const log = createLog(context);
+	context.subscriptions.push(log);
+
+	const catalog = await loadCatalog(context.extensionPath);
+	// The stamp decides which server this client may talk to: `commit` is what
+	// the handshake compares, `picketServerMinVersion` is the catalog floor.
+	const product = await readProduct(vscode.env.appRoot).catch(() => undefined);
+	log.info(`Picket WSL activated (catalog=schema-${catalog.schema}, min=${catalog.minVersion ?? 'none'}, components=${catalog.components.length}, commit=${product?.commit ?? 'none'}, server-min=${product?.picketServerMinVersion ?? 'none'})`);
+
+	// The official extension being installed turns off every WSL feature here —
+	// not "until it activates", but for as long as it exists. See src/official.js
+	// for why the two cannot share a window.
+	const gate = createOfficialGate({
+		extensions: {
+			get: (id) => vscode.extensions.getExtension(id),
+			onDidChange: (callback) => vscode.extensions.onDidChange(callback)
+		}
+	});
+	context.subscriptions.push(gate);
+
+	// The context key is what every menu entry and view button is gated on, so it
+	// is set before anything else can be clicked.
+	const setBlockedContext = () => vscode.commands.executeCommand('setContext', 'picketWsl.blocked', gate.blocked);
+	await setBlockedContext();
+	if (gate.blocked) {
+		log.info(`${OFFICIAL_EXTENSION_ID} is installed: WSL features are disabled until it is uninstalled (data is kept).`);
+	}
+
+	context.subscriptions.push(vscode.commands.registerCommand('picket.wsl.showLog', () => log.show()));
+
+	/** @returns {vscode.WorkspaceConfiguration} */
+	const config = () => vscode.workspace.getConfiguration('picket.wsl');
+
+	// The official extension's settings, read from the root scope exactly as it
+	// read them, so a value a user carried over keeps its meaning here.
+	const readOfficial = (/** @type {string} */ key) => vscode.workspace.getConfiguration().get(key);
+
+	// The `shell` setting has a manifest default of `login`, so a plain read can
+	// never tell "the user chose login" from "nobody chose anything". Only an
+	// explicit value may outrank `remote.WSL.useShellEnvironment`.
+	const readPicket = (/** @type {string} */ key) => {
+		const inspect = config().inspect(key);
+		return inspect?.globalValue ?? inspect?.workspaceValue ?? inspect?.workspaceFolderValue
+			?? inspect?.globalLanguageValue ?? inspect?.workspaceLanguageValue ?? inspect?.workspaceFolderLanguageValue;
+	};
+	const officialSettings = { readPicket, readOfficial };
+
+	// Getters, not values: a setting changed while a window is open must apply to
+	// the next connection without a reload.
+	const settings = {
+		get defaultDistro() { return config().get('defaultDistro', ''); },
+		get serverPayloadPath() { return config().get('serverPayloadPath', ''); },
+		get serverPayloadBaseUrl() { return config().get('serverPayloadBaseUrl', ''); },
+		get caFile() { return config().get('caFile', ''); },
+		get useProxy() { return config().get('useProxy', true); },
+		get icodePath() { return config().get('icodePath', ''); },
+		get tunnelMode() { return config().get('tunnelMode', 'auto'); },
+		get startTimeoutSeconds() { return config().get('startTimeoutSeconds', 90); },
+		get loginShell() { return resolveSettings(officialSettings).loginShell; },
+		get probeRetryTimeoutMs() { return resolveSettings(officialSettings).probeRetryTimeoutMs; },
+		officialSettings
+	};
+
+	// VS Code's own proxy settings, read the same way: a user who already routed
+	// the extension host through a proxy gets identical behaviour for payloads.
+	const httpSettings = {
+		get proxy() { return vscode.workspace.getConfiguration('http').get('proxy'); },
+		get proxyStrictSSL() { return vscode.workspace.getConfiguration('http').get('proxyStrictSSL', true); }
+	};
+
+	// Acceptance runs a stand-in `wsl.exe` (test/wsl-harness/fake-wsl.mjs);
+	// production keeps the default PATH lookup.
+	const runner = createWslRunner(process.env.PICKET_WSL_RUNNER ? { wslPath: process.env.PICKET_WSL_RUNNER } : undefined);
+
+	/**
+	 * One factory for both the resolver and the command layer: `explicitPath` is
+	 * how "install from a file I picked" reaches the component manager without
+	 * writing a setting. `download` comes from the command layer when it has one;
+	 * the resolver path has no caller to ask, so it reads the same settings here.
+	 * @param {{ distro: string, home: string, explicitPath?: string, download?: { proxy?: string, strictSSL?: boolean, caFile?: string } }} target
+	 */
+	const createComponents = ({ distro, home, explicitPath, download }) => createComponentManager({
+		catalog,
+		product,
+		runner,
+		distro,
+		home,
+		env: {
+			explicitPath: explicitPath ?? (settings.serverPayloadPath || undefined),
+			embeddedDir: catalog.flavor === 'embedded' ? join(context.extensionPath, 'resources', 'wsl-payloads') : undefined,
+			baseUrl: settings.serverPayloadBaseUrl || undefined
+		},
+		download: download ?? downloadFromSettings({ settings, http: httpSettings })
+	});
+
+	// A resolver only exists while the surface is mounted. The command layer gets
+	// this handle instead of a snapshot, so a block/unblock cycle cannot leave a
+	// command holding a disposed resolver.
+	/** @type {ReturnType<typeof createResolver> | undefined} */
+	let resolver;
+	const resolverHandle = {
+		stop: (/** @type {string | undefined} */ distro) => (resolver ? resolver.stop(distro) : Promise.resolve())
+	};
+
+	const changed = new vscode.EventEmitter();
+	context.subscriptions.push(changed);
+
+	const treeProvider = {
+		onDidChangeTreeData: changed.event,
+		refresh() {
+			changed.fire(undefined);
+		},
+		/** @param {any} element */
+		async getChildren(element) {
+			if (element) {
+				return [];
+			}
+			// An empty tree would read as "WSL is broken"; one node that says why and
+			// what to do is the whole point of the gate being visible.
+			if (gate.blocked) {
+				return [buildBlockedNode()];
+			}
+			const activeDistro = parseAuthority(vscode.env.remoteAuthority ?? '')?.distro ?? '';
+			try {
+				return buildDistroNodes(visibleDistros(await listDistros(runner)), { activeDistro });
+			} catch (error) {
+				log.error(`Could not list WSL distros: ${error.message}`);
+				return [];
+			}
+		},
+		/** @param {any} node */
+		getTreeItem(node) {
+			const item = new vscode.TreeItem(node.label, vscode.TreeItemCollapsibleState.None);
+			item.id = node.id;
+			item.description = node.description;
+			item.tooltip = node.tooltip;
+			item.contextValue = node.contextValue;
+			if (node.blocked) {
+				item.iconPath = new vscode.ThemeIcon('warning');
+				item.command = { command: node.command, title: '卸载官方 Remote-WSL 扩展' };
+				return item;
+			}
+			item.iconPath = new vscode.ThemeIcon(node.contextValue === 'activeDistro' ? 'vm-active' : 'vm-outline');
+			item.command = { command: 'picket.wsl.openFolder', title: 'Open Folder', arguments: [node.distro] };
+			return item;
+		}
+	};
+
+	const view = vscode.window.createTreeView('picketWsl.targets', { treeDataProvider: treeProvider });
+	context.subscriptions.push(view);
+
+	const host = {
+		showQuickPick: (items, options) => vscode.window.showQuickPick(items, options),
+		showOpenDialog: (options) => vscode.window.showOpenDialog(options),
+		showInformationMessage: (message, ...actions) => vscode.window.showInformationMessage(message, ...actions),
+		showWarningMessage: (message, ...actions) => vscode.window.showWarningMessage(message, ...actions),
+		showErrorMessage: (message, ...actions) => vscode.window.showErrorMessage(message, ...actions),
+		withProgress: (options, task) => vscode.window.withProgress(
+			{ location: vscode.ProgressLocation.Notification, title: options.title },
+			task
+		),
+		openFolder: (uri, options) => vscode.commands.executeCommand('vscode.openFolder', uri, options),
+		runInTerminal: (command) => {
+			const terminal = vscode.window.createTerminal('Picket WSL');
+			terminal.show();
+			terminal.sendText(command);
+		},
+		refreshTargets: () => treeProvider.refresh(),
+		showDocument: async (text) => {
+			const document = await vscode.workspace.openTextDocument({ content: text, language: 'plaintext' });
+			await vscode.window.showTextDocument(document);
+		},
+		uriFor: (parts) => vscode.Uri.from(parts),
+		executeCommand: (id, ...args) => vscode.commands.executeCommand(id, ...args)
+	};
+
+	// The marketplace settings are read and written through the same object: `update` on the
+	// user target is what an administrator would put in settings.json by hand.
+	const gallery = {
+		get: (key) => vscode.workspace.getConfiguration('extensions.gallery').get(key),
+		update: async (key, value) => vscode.workspace.getConfiguration('extensions.gallery').update(key, value, vscode.ConfigurationTarget.Global)
+	};
+
+	const commandOptions = {
+		host,
+		runner,
+		settings,
+		catalog,
+		product,
+		createComponents,
+		resolver: resolverHandle,
+		memento: context.globalState,
+		log,
+		http: httpSettings,
+		appRoot: vscode.env.appRoot,
+		gallery,
+		currentFolders: () => vscode.workspace.workspaceFolders ?? [],
+		currentAuthority: () => vscode.env.remoteAuthority ?? '',
+		official: () => ({ installed: gate.installed, blocked: gate.blocked }),
+		extensions: { get: (id) => vscode.extensions.getExtension(id) },
+		// The build's own version is what `engines.vscode` is compared against:
+		// `env` exposes no version, and the product file is already read above.
+		productsVersion: product?.version,
+		register: (/** @type {string} */ id, /** @type {any} */ run) => vscode.commands.registerCommand(id, run)
+	};
+
+	// Diagnostics must answer with the gate closed: the report is the only place
+	// that says which extension is blocking and what came over from its server.
+	context.subscriptions.push(...registerCommands({ ...commandOptions, only: RESIDENT_COMMANDS }));
+
+	/** @type {Array<{ dispose(): void }>} */
+	let surface = [];
+
+	const mountWsl = () => {
+		if (surface.length > 0) {
+			return;
+		}
+		resolver = createResolver({
+			runner,
+			product,
+			settings,
+			log,
+			warn: (message) => void vscode.window.showWarningMessage(message),
+			components: createComponents
+		});
+
+		// One resolver object for both authorities: `picket-wsl+Ubuntu` is what this
+		// extension writes, `wsl+Ubuntu` is what the official extension left behind
+		// in saved workspaces and history. Canonicalising means each folder opens
+		// under one identity instead of forking its state on the first reload.
+		const authorityResolver = {
+			resolve: async (/** @type {string} */ authority) => {
+				const result = await resolver.resolve(authority);
+				return new vscode.ResolvedAuthority(result.host, result.port, result.connectionToken);
+			},
+			getCanonicalURI: (/** @type {vscode.Uri} */ uri) => {
+				const parsed = parseAuthority(uri.authority);
+				if (!parsed) {
+					return undefined;
+				}
+				const authority = canonicalAuthority(AUTHORITY_PREFIX, parsed.distro);
+				return authority === uri.authority ? undefined : uri.with({ authority });
+			}
+		};
+		for (const prefix of [AUTHORITY_PREFIX, LEGACY_AUTHORITY_PREFIX]) {
+			surface.push(vscode.workspace.registerRemoteAuthorityResolver(prefix, authorityResolver));
+		}
+		surface.push(...registerCommands({ ...commandOptions, except: RESIDENT_COMMANDS }));
+
+		if (!(vscode.env.remoteAuthority ?? '')) {
+			void maybeNudge({
+				host,
+				memento: context.globalState,
+				folders: vscode.workspace.workspaceFolders,
+				openFolderInWsl: async () => { await vscode.commands.executeCommand('picket.wsl.reopenInWsl'); }
+			}).catch((error) => log.error(`Could not show the WSL nudge: ${error.message}`));
+		}
+	};
+
+	const unmountWsl = () => {
+		for (const item of surface.splice(0)) {
+			item.dispose();
+		}
+		resolver?.dispose();
+		resolver = undefined;
+	};
+	context.subscriptions.push({ dispose: unmountWsl });
+
+	if (!gate.blocked) {
+		mountWsl();
+	}
+
+	// Installing or removing the official extension takes effect now, not at the
+	// next reload: the folders this window cannot serve should not look available.
+	context.subscriptions.push(gate.onChange((state) => {
+		void (async () => {
+			await setBlockedContext();
+			if (state.blocked) {
+				unmountWsl();
+				log.info(`${OFFICIAL_EXTENSION_ID} was installed: WSL features are now disabled.`);
+			} else {
+				mountWsl();
+				log.info(`${OFFICIAL_EXTENSION_ID} was removed: WSL features are enabled again.`);
+			}
+			treeProvider.refresh();
+		})();
+	}));
+}
+
+function deactivate() { }
+
+module.exports = { activate, deactivate };
