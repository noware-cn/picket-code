+// RED first: this file must fail until src/preflight.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { tmpdir } = require('node:os');
+const { join } = require('node:path');
+const { writeFile, mkdtemp } = require('node:fs/promises');
+const { parseWslConfig, chooseTunnelMode, readWslConfigFile, wslConfigPath } = require('../src/preflight.js');
+
+test('a disabled localhost forwarding is read as a boolean', () => {
+	assert.deepStrictEqual(parseWslConfig('[wsl2]\nlocalhostForwarding=false\n'), { localhostForwarding: false });
+	assert.deepStrictEqual(parseWslConfig('[wsl2]\nlocalhostforwarding = TRUE\n'), { localhostForwarding: true });
+});
+
+test('keys outside [wsl2] are ignored', () => {
+	assert.deepStrictEqual(parseWslConfig('[experimental]\nnetworkingMode=mirrored\nlocalhostForwarding=false\n'), {});
+	assert.deepStrictEqual(parseWslConfig('# comment\n[wsl2]\n; another\nnetworkingMode=mirrored\n'), { networkingMode: 'mirrored' });
+});
+
+test('a disabled localhost forwarding selects the tunnel', () => {
+	assert.strictEqual(chooseTunnelMode({ configured: 'auto', wslConfig: parseWslConfig('[wsl2]\nlocalhostForwarding=false\n'), platform: 'win32' }), 'stdio');
+});
+
+test('a mirrored network selects the tunnel', () => {
+	assert.strictEqual(chooseTunnelMode({ configured: 'auto', wslConfig: parseWslConfig('[wsl2]\nnetworkingMode=mirrored\n'), platform: 'win32' }), 'stdio');
+});
+
+test('auto on a non-Windows host is a plain direct connection', () => {
+	assert.strictEqual(chooseTunnelMode({ configured: 'auto', wslConfig: {}, platform: 'linux' }), 'direct');
+});
+
+test('an explicit mode wins over the config', () => {
+	assert.strictEqual(chooseTunnelMode({ configured: 'direct', wslConfig: parseWslConfig('[wsl2]\nlocalhostForwarding=false\n'), platform: 'win32' }), 'direct');
+	assert.strictEqual(chooseTunnelMode({ configured: 'stdio', wslConfig: parseWslConfig('[wsl2]\nlocalhostForwarding=true\n'), platform: 'win32' }), 'stdio');
+});
+
+test('a default config means a plain direct connection', () => {
+	assert.strictEqual(chooseTunnelMode({ configured: 'auto', wslConfig: parseWslConfig(''), platform: 'win32' }), 'direct');
+});
+
+test('an unreadable .wslconfig degrades to an empty config', async () => {
+	const dir = await mkdtemp(join(tmpdir(), 'picket-wsl-'));
+	const missing = join(dir, '.wslconfig');
+	assert.deepStrictEqual(await readWslConfigFile(missing), {});
+	const present = join(dir, 'present.wslconfig');
+	await writeFile(present, '[wsl2]\r\nnetworkingMode=mirrored\r\n');
+	assert.deepStrictEqual(await readWslConfigFile(present), { networkingMode: 'mirrored' });
+});
+
+test('the default config location is the Windows user profile', () => {
+	assert.ok(/\.wslconfig$/.test(wslConfigPath()));
+});
