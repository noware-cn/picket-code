+#!/usr/bin/env node
+'use strict';
+
+// A wsl.exe stand-in so the spawn path, the UTF-16LE decoding and the timeout
+// handling can be exercised on Linux. Keep the table identical to the one in
+// test/distro.test.js: the real wsl.exe writes exactly this shape.
+
+const TABLE = [
+	'  NAME            STATE           VERSION',
+	'* Ubuntu-24.04    Running         2',
+	'  Ubuntu 22.04 LTS Stopped        1',
+	'  docker-desktop  Running         2',
+	''
+].join('\r\n');
+
+const args = process.argv.slice(2);
+
+if (args[0] === '--list' && args[1] === '--verbose') {
+	process.stdout.write(Buffer.from(TABLE, 'utf16le'));
+	process.exit(0);
+}
+
+if (args[0] === '--status') {
+	process.stderr.write('WSL is not installed. Run wsl --install.\r\n');
+	process.exit(1);
+}
+
+if (args[0] === '--hang') {
+	setTimeout(() => process.exit(0), 60000);
+} else if (args[0] === '-d' && args.length >= 3) {
+	const distro = args[1];
+	const known = /^(Ubuntu-24\.04|Ubuntu 22\.04 LTS|docker-desktop)$/.test(distro);
+	if (!known) {
+		process.stderr.write(`There is no distribution with the supplied name.\r\n`);
+		process.exit(1);
+	}
+	const command = args.slice(3).join(' ');
+	if (command === 'printenv HOME') {
+		process.stdout.write(`/home/${distro.split(/[ .]/)[0].toLowerCase()}\r\n`);
+		process.exit(0);
+	}
+	if (command === 'true') {
+		process.exit(0);
+	}
+	process.stderr.write(`unknown command: ${command}\r\n`);
+	process.exit(1);
+} else {
+	process.stderr.write(`fake-wsl: unsupported arguments: ${args.join(' ')}\r\n`);
+	process.exit(1);
+}
