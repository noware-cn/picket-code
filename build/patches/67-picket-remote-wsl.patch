+const { createFakeHost, createFakeComponents, createCatalog } = require('./fixtures/fake-host.js');
+
+const run = promisify(execFile);
+
+const TABLE = '* Ubuntu-24.04    Running         2\n  Debian          Stopped         2';
+
+/**
+ * Everything the command layer touches, minus VS Code itself.
+ * @param {{ flavor?: 'embedded' | 'ondemand', state?: 'installed' | 'absent', host?: any, fail?: string, http?: { proxy?: string, proxyStrictSSL?: boolean }, settings?: any }} [options]
+ */
+function harness(options = {}) {
+	const host = createFakeHost(options.host);
+	/** @type {any[]} */
+	const calls = [];
+	/** @type {any[]} */
+	const configs = [];
+	/** @type {Array<{ id: string, config: any }>} */
+	const ensured = [];
+	/** @type {string[]} */
+	const stopped = [];
+
+	const createComponents = (config) => {
+		configs.push(config);
+		const components = createFakeComponents({ state: options.state ?? 'absent', fail: options.fail });
+		const ensure = components.ensure.bind(components);
+		components.ensure = async (id) => {
+			ensured.push({ id, config });
+			return ensure(id);
+		};
+		return components;
+	};
+
+	const runner = {
+		async exec(args) {
+			const key = args.join(' ');
+			calls.push(args);
+			if (key === '--list --verbose') {
+				return { code: 0, stdout: Buffer.from(TABLE, 'utf16le'), stderr: '' };
+			}
+			if (key.endsWith('printenv HOME')) {
+				return { code: 0, stdout: '/home/u\n', stderr: '' };
+			}
+			if (key.includes('wslpath -u')) {
+				return { code: 0, stdout: '/mnt/c/project\n', stderr: '' };
+			}
+			if (key.includes('! -x')) {
+				// The shim verify step asks whether the link and the script landed; a
+				// real distro answers `ok` after a good write.
+				return { code: 0, stdout: 'ok\n', stderr: '' };
+			}
+			if (key.includes('readlink -f')) {
+				return { code: 0, stdout: 'none\n', stderr: '' };
+			}
+			return { code: 0, stdout: '', stderr: '' };
+		}
+	};
+
+	const settings = {
+		defaultDistro: '',
+		serverPayloadPath: '',
+		serverPayloadBaseUrl: '',
+		caFile: '',
+		useProxy: true,
+		tunnelMode: 'auto',
+		icodePath: '',
+		startTimeoutSeconds: 90,
+		...options.settings
+	};
+	const store = new Map();
+	const memento = {
+		get: (key) => store.get(key),
+		async update(key, value) { store.set(key, value); }
+	};
+
+	const commands = createCommands({
+		host,
+		runner,
+		settings,
+		memento,
+		catalog: createCatalog({ flavor: options.flavor ?? 'ondemand' }),
+		product: { commit: 'e646868227c3e3a9e3f24277c8c7220be42c0be7', version: '1.143.1', picketServerMinVersion: '1.143.1' },
+		createComponents,
+		resolver: { async stop(distro) { stopped.push(distro); } },
+		log: { info() { }, error() { } },
+		http: options.http,
+		extensionPath: '/ext'
+	});
+
+	return { host, commands, calls, configs, ensured, stopped, memento };
+}
+
