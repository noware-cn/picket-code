+	assert.ok(args.includes(`--user-data-dir=/home/u/.picket-code-server/data`));
+	assert.strictEqual(args[1], 'Ubuntu');
+	assert.strictEqual(starts[0].runtimeFile, `/home/u/.picket-code-server/runtime/Ubuntu.json`);
+});
+
