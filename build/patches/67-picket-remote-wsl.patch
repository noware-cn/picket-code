+test('an https target is tunnelled through CONNECT and the proxy never sees the TLS', async () => {
+	const body = Buffer.from('tls-behind-a-proxy');
+	const target = https.createServer({ key: KEY, cert: CERT }, (request, response) => {
+		response.writeHead(200, { 'content-length': String(body.length) });
+		response.end(body);
+	});
+	/** @type {string[]} */
+	const tunnels = [];
+	await withServer(target, async (targetPort) => {
+		await withServer(connectProxy(tunnels), async (proxyPort) => {
+			const bytes = await downloadFile(`https://localhost:${targetPort}/payload.tar.gz`, {
+				proxy: parseProxySetting(`127.0.0.1:${proxyPort}`),
+				ca: CERT
+			});
+			assert.deepStrictEqual(bytes, body);
+		});
+	});
+	assert.deepStrictEqual(tunnels.length, 1);
+	assert.match(tunnels[0], /^CONNECT localhost:\d+ HTTP\/1\.1$/);
