+			return { localPort: 6000 + created.length, dispose: async () => { disposed += 1; } };
+		},
+		probe: async (/** @type {any} */ target) => { probed.push(target.port); return 'alive'; }
+	});
+
+	const result = await resolver.resolve('picket-wsl+Ubuntu');
+	assert.deepStrictEqual(result, { host: '127.0.0.1', port: 6001, connectionToken: 'tok' });
+	assert.deepStrictEqual(probed, [6001], 'the VM port is not dialable from the host, so the probe must use the tunnel');
+	assert.strictEqual(created.length, 1);
+	assert.strictEqual(created[0].serverPort, 41234);
+	assert.strictEqual(created[0].nodePath, `/home/u/.vscode-server/bin/picket-${VERSION}/node`);
+	assert.strictEqual(starts.length, 0);
+
+	await resolver.resolve('picket-wsl+Ubuntu');
+	assert.strictEqual(created.length, 1, 'one tunnel per server, not one per resolve');
+
+	await resolver.dispose();
+	assert.strictEqual(disposed, 1);
+});
+
+test('a fresh start on a host without localhost forwarding answers with the tunnel port', async () => {
+	const runner = makeRunner();
+	const { starts } = startsRecording();
+	/** @type {any} */
+	const startServer = async (/** @type {any} */ options) => {
+		starts.push(options);
+		return { port: 5555, token: 'fresh-token', version: VERSION, commit: COMMIT, pid: 1234, startedAt: 'now', ...(options.extra ?? {}) };
+	};
+	/** @type {any[]} */
+	const created = [];
+	const resolver = createResolver({
+		runner, product: PRODUCT, settings: {}, log: silentLog(), startServer,
+		platform: 'win32',
+		readWslConfig: async () => ({ localhostForwarding: false }),
+		components: components(),
+		createTunnel: async (/** @type {any} */ options) => {
+			created.push(options);
+			return { localPort: 6200, dispose: async () => { } };
+		}
+	});
+
+	const result = await resolver.resolve('picket-wsl+Ubuntu');
+	assert.strictEqual(result.port, 6200);
+	assert.strictEqual(result.connectionToken, 'fresh-token');
+	assert.strictEqual(starts.length, 1);
+	assert.strictEqual(created.length, 1);
+	assert.strictEqual(created[0].serverPort, 5555);
+	assert.strictEqual(starts[0].extra.tunnelMode, 'stdio', 'the record carries the mode so a later window knows to tunnel');
+});
+
+test('a tunnel that cannot bootstrap is treated as a dead server, not as an error', async () => {
+	const runtime = recorded({ tunnelMode: 'stdio' });
+	const runner = makeRunner({ runtime });
+	const { starts, startServer } = startsRecording();
+	let attempts = 0;
+	const resolver = createResolver({
+		runner, product: PRODUCT, settings: {}, log: silentLog(), startServer,
+		components: components(),
+		readWslConfig: async () => ({ localhostForwarding: false }),
+		createTunnel: async () => {
+			attempts += 1;
+			throw new Error('tunnel preamble timeout');
+		},
+		probe: async () => 'alive'
+	});
+
+	const result = await resolver.resolve('picket-wsl+Ubuntu');
+	assert.strictEqual(result.port, 5555);
+	assert.strictEqual(attempts, 1);
+	assert.strictEqual(starts.length, 1, 'an unreachable tunnel means the recorded server is gone');
+});
+
+test('a cached server that is briefly unreachable is probed again instead of being replaced', async () => {
+	// remote.WSL.serverProbeRetryTimeout exists for exactly this: WSL is up, the
+	// recorded server is starting or the network is settling, and swapping in a
+	// second server would fight the first for the data directory.
+	const runner = makeRunner({ runtime: recorded(), pidAlive: true });
+	const { starts, startServer } = startsRecording();
+	const verdicts = ['dead', 'dead', 'alive'];
+	let probed = 0;
+	const resolver = createResolver({
+		runner, product: PRODUCT, settings: { probeRetryTimeoutMs: 2000, probeRetrySeconds: 0.01 }, log: silentLog(), startServer,
+		components: () => { throw new Error('must not install when the recorded server answers in time'); },
+		probe: async () => verdicts[Math.min(probed++, verdicts.length - 1)]
+	});
+
+	assert.strictEqual((await resolver.resolve('picket-wsl+Ubuntu')).port, 41234);
+	assert.strictEqual(starts.length, 0);
+	assert.ok(probed >= 3, `the retry window was not used (${probed} probes)`);
+});
+
+test('a cached record whose process is gone is replaced without waiting out the retry window', async () => {
+	const runner = makeRunner({ runtime: recorded(), pidAlive: false });
+	const { starts, startServer } = startsRecording();
+	let probed = 0;
+	const resolver = createResolver({
+		runner, product: PRODUCT, settings: { probeRetryTimeoutMs: 30000, probeRetrySeconds: 0.01 }, log: silentLog(), startServer,
+		components: components(),
+		probe: async () => { probed += 1; return 'dead'; }
+	});
+
+	const before = Date.now();
+	assert.strictEqual((await resolver.resolve('picket-wsl+Ubuntu')).port, 5555);
+	assert.ok(Date.now() - before < 5000, 'waiting for a pid that no longer exists buys nothing');
+	assert.strictEqual(probed, 1);
+	assert.strictEqual(starts.length, 1);
+});
+
+test('a wrong token is not retried: the record is wrong, not late', async () => {
+	const runner = makeRunner({ runtime: recorded(), pidAlive: true });
+	const { starts, startServer } = startsRecording();
+	let probed = 0;
+	const resolver = createResolver({
+		runner, product: PRODUCT, settings: { probeRetryTimeoutMs: 30000, probeRetrySeconds: 0.01 }, log: silentLog(), startServer,
+		components: components(),
+		probe: async () => { probed += 1; return 'bad-token'; }
+	});
+
+	assert.strictEqual((await resolver.resolve('picket-wsl+Ubuntu')).port, 5555);
+	assert.strictEqual(probed, 1, 'a server that rejects our token will keep rejecting it');
+	assert.strictEqual(starts.length, 1);
+});
+
+test('zero retries means one probe, as the official setting documents', async () => {
+	const runner = makeRunner({ runtime: recorded(), pidAlive: true });
+	const { starts, startServer } = startsRecording();
+	let probed = 0;
+	const resolver = createResolver({
+		runner, product: PRODUCT, settings: { probeRetryTimeoutMs: 0, probeRetrySeconds: 0.01 }, log: silentLog(), startServer,
+		components: components(),
+		probe: async () => { probed += 1; return 'dead'; }
+	});
+
+	assert.strictEqual((await resolver.resolve('picket-wsl+Ubuntu')).port, 5555);
+	assert.strictEqual(probed, 1);
+	assert.strictEqual(starts.length, 1);
+});
+
+test('the login shell setting reaches the started server', async () => {
+	const runner = makeRunner();
+	const { starts, startServer } = startsRecording();
+	const resolver = createResolver({
+		runner, product: PRODUCT, settings: { loginShell: false }, log: silentLog(), startServer,
+		components: components(),
+		readWslConfig: async () => ({})
+	});
+
+	await resolver.resolve('picket-wsl+Ubuntu');
+	assert.strictEqual(starts[0].args[4], '-c');
+});
+
+test('an authority written by the official extension opens the same distro', async () => {
+	const runner = makeRunner({ runtime: recorded() });
+	const { starts, startServer } = startsRecording();
+	const resolver = createResolver({
+		runner, product: PRODUCT, settings: {}, log: silentLog(), startServer,
+		components: () => { throw new Error('must not install when the recorded server is alive'); },
+		probe: async () => 'alive'
+	});
+
+	assert.strictEqual((await resolver.resolve('wsl+Ubuntu')).port, 41234);
+	assert.strictEqual(starts.length, 0);
+});
+
+test('resolveDistro matches the installed spelling and lists what exists', async () => {
+	const runner = makeRunner();
+	const resolver = createResolver({
+		runner, product: PRODUCT, settings: {}, log: silentLog(), startServer: async () => { throw new Error('unused'); },
+		components: components()
+	});
+
+	assert.strictEqual(await resolver.resolveDistro('wsl+ubuntu'), 'Ubuntu');
+	assert.strictEqual(await resolver.resolveDistro('wsl+default'), 'Ubuntu');
+	await assert.rejects(() => resolver.resolveDistro('wsl+Debian 9'), /Installed: Ubuntu, Debian/);
+});
+
+test('a configured default distro answers an authority with no distro', async () => {
+	const runner = makeRunner({ runtime: recorded({ version: '1.0.0' }) });
+	const resolver = createResolver({
+		runner, product: PRODUCT, settings: { defaultDistro: 'debian' }, log: silentLog(),
+		startServer: async () => { throw new Error('unused'); },
+		components: components()
+	});
+
+	assert.strictEqual(await resolver.resolveDistro('picket-wsl+'), 'Debian');
+});
+
+test('a nested authority is rejected with a readable error', async () => {
+	const runner = makeRunner();
+	const resolver = createResolver({
+		runner, product: PRODUCT, settings: {}, log: silentLog(), startServer: async () => { throw new Error('unused'); },
+		components: components()
+	});
+
+	await assert.rejects(
+		() => resolver.resolveDistro('wsl+Ubuntu@7b22686f73744e616d65223a2278227d'),
+		/nested authorities are not supported/i
+	);
+});
+
+test('an authority that belongs to another extension is refused', async () => {
+	const runner = makeRunner();
+	const resolver = createResolver({
+		runner, product: PRODUCT, settings: {}, log: silentLog(), startServer: async () => { throw new Error('unused'); },
+		components: components()
+	});
+
+	await assert.rejects(() => resolver.resolveDistro('ssh-remote+host'), /not a WSL remote authority/);
+});
diff --git a/extensions/picket-remote-wsl/test/settings.test.js b/extensions/picket-remote-wsl/test/settings.test.js
