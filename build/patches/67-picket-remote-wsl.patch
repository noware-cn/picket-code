index 00000000..118dde5d
--- /dev/null
+++ b/extensions/picket-remote-wsl/test/manage.test.js
@@ -0,0 +1,66 @@
+// RED first: this file must fail until src/manage.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { manageDistro, parseOnlineTable } = require('../src/manage.js');
+const { createFakeHost } = require('./fixtures/fake-host.js');
+
+/** @param {{ code?: number, stdout?: string }} [options] */
+function recordingRunner(options = {}) {
+	const calls = [];
+	const runner = {
+		calls,
+		async exec(args) {
+			calls.push(args);
+			return { code: options.code ?? 0, stdout: options.stdout ?? '', stderr: '' };
+		}
+	};
+	return runner;
+}
+
+test('setDefault sends exactly the set-default arguments', async () => {
+	const runner = recordingRunner();
+	await manageDistro({ host: createFakeHost(), runner, action: 'setDefault', distro: 'Debian' });
+	assert.deepStrictEqual(runner.calls, [['--set-default', 'Debian']]);
+});
+
+test('deleting without a confirmation runs nothing', async () => {
+	const runner = recordingRunner();
+	const host = createFakeHost({ confirm: false });
+	await manageDistro({ host, runner, action: 'delete', distro: 'Debian' });
+	assert.deepStrictEqual(runner.calls, []);
+	assert.match(host.messages.at(-1), /Debian/);
+});
+
+test('deleting after an affirmative confirmation unregisters', async () => {
+	const runner = recordingRunner();
+	const host = createFakeHost({ confirm: true });
+	await manageDistro({ host, runner, action: 'delete', distro: 'Debian' });
+	assert.deepStrictEqual(runner.calls, [['--unregister', 'Debian']]);
+});
+
+test('adding parses the online table and hands an install command to a terminal', async () => {
+	const runner = recordingRunner({
+		stdout: '以下是可安装的有效分发。\n使用 “wsl.exe --install -d <Distro>” 安装分发。\n\nNAME            FRIENDLY NAME\nUbuntu          Ubuntu\nDebian          Debian GNU/Linux\ndocker-desktop  Docker Desktop\n'
+	});
+	const host = createFakeHost({ quickPick: 'Debian（Debian GNU/Linux）' });
+	await manageDistro({ host, runner, action: 'add' });
+	assert.deepStrictEqual(runner.calls[0], ['--list', '--online']);
+	assert.deepStrictEqual(host.terminals, ["wsl.exe --install -d 'Debian'"]);
+});
+
+test('an install name that is not a plain distro name is refused', async () => {
+	// A name reaches a shell, so the guard has to hold even when the table it
+	// came from is hostile rather than merely wrong.
+	const runner = recordingRunner({ stdout: 'NAME                  FRIENDLY NAME\nE; rm -rf /           Evil\n' });
+	const host = createFakeHost({ quickPick: 'E; rm -rf /' });
+	await manageDistro({ host, runner, action: 'add' });
+	assert.deepStrictEqual(host.terminals, []);
+	assert.match(host.messages.at(-1), /非法|invalid/i);
+});
+
+test('the online table parser ignores headers, hints and docker plumbing', () => {
+	assert.deepStrictEqual(
+		parseOnlineTable('以下是可安装的有效分发。\n使用 “wsl.exe --install -d <Distro>” 安装分发。\n\nNAME            FRIENDLY NAME\nUbuntu-24.04    Ubuntu 24.04 LTS\nDebian          Debian GNU/Linux\n'),
+		[{ name: 'Ubuntu-24.04', friendly: 'Ubuntu 24.04 LTS' }, { name: 'Debian', friendly: 'Debian GNU/Linux' }]
+	);
+});
diff --git a/extensions/picket-remote-wsl/test/manifest.test.js b/extensions/picket-remote-wsl/test/manifest.test.js
new file mode 100644
index 00000000..5a6b3dd8
--- /dev/null
+++ b/extensions/picket-remote-wsl/test/manifest.test.js
@@ -0,0 +1,118 @@
+// RED first: the manifest and the code must agree about which commands exist.
+const test = require('node:test');
+const assert = require('node:assert');
+const { readFileSync } = require('node:fs');
+const { join } = require('node:path');
+const { COMMANDS, RESIDENT_COMMANDS } = require('../src/commands.js');
+
+const root = join(__dirname, '..');
+const manifest = JSON.parse(readFileSync(join(root, 'package.json'), 'utf8'));
+const extension = readFileSync(join(root, 'extension.js'), 'utf8');
+
+const contributed = manifest.contributes.commands.map(command => command.command);
+// Two places can register: `extension.js` itself (log plus the not-yet-built
+// commands) and the table in `commands.js`.
+const registered = new Set([
+	...(extension.match(/picket\.wsl\.[A-Za-z]+/g) ?? []),
+	...Object.keys(COMMANDS)
+]);
+
+test('every contributed command is registered somewhere', () => {
+	const missing = contributed.filter(id => !registered.has(id));
+	assert.deepStrictEqual(missing, [], `contributed but never registered: ${missing.join(', ')}`);
+});
+
+test('every registered command is contributed', () => {
+	const stray = [...registered].filter(id => !contributed.includes(id));
+	assert.deepStrictEqual(stray, [], `registered but not in the manifest: ${stray.join(', ')}`);
+});
+
+test('the command layer owns the sixteen commands of this milestone', () => {
+	assert.deepStrictEqual(Object.keys(COMMANDS).sort(), [
+		'picket.wsl.addDistro',
+		'picket.wsl.components',
+		'picket.wsl.deleteDistro',
+		'picket.wsl.diagnose',
+		'picket.wsl.installCli',
+		'picket.wsl.installVsix',
+		'picket.wsl.openFolder',
+		'picket.wsl.refreshTargets',
+		'picket.wsl.removeCli',
+		'picket.wsl.reopenInWindows',
+		'picket.wsl.reopenInWsl',
+		'picket.wsl.selectGallery',
+		'picket.wsl.setDefaultDistro',
+		'picket.wsl.stopServer',
+		'picket.wsl.uninstallGuide',
+		'picket.wsl.uninstallOfficial'
+	]);
+});
+
+test('the only file that imports vscode is the one that can', () => {
+	// log.js is the one vscode-bound helper: it owns an OutputChannel.
+	const sources = ['catalog.js', 'distro.js', 'components.js', 'payload.js', 'download.js', 'launch.js', 'probe.js',
+		'remoteUri.js', 'resolver.js', 'icode.js', 'preflight.js', 'tree.js', 'manage.js', 'diagnose.js',
+		'nudge.js', 'commands.js', 'marketplace.js', 'offline.js', 'shim.js', 'settings.js', 'version.js', 'product.js', 'official.js', 'uninstall.js'];
+	for (const name of sources) {
+		const text = readFileSync(join(root, 'src', name), 'utf8');
+		assert.doesNotMatch(text, /require\(['"]vscode['"]\)/, `${name} must stay testable without an extension host`);
+	}
+});
+
+test('the view is contributed to the remote explorer and has a welcome state', () => {
+	const remote = manifest.contributes.views.remote.map(view => view.id);
+	assert.ok(remote.includes('picketWsl.targets'));
+	const welcomed = manifest.contributes.viewsWelcome.map(entry => entry.view);
+	assert.ok(welcomed.includes('picketWsl.targets'));
+	const menu = manifest.contributes.menus['view/item/context'].map(entry => entry.command);
+	assert.ok(menu.includes('picket.wsl.setDefaultDistro'));
+	assert.ok(menu.includes('picket.wsl.deleteDistro'));
+});
+
+test('folders opened under either authority render with the WSL label', () => {
+	const authorities = manifest.contributes.resourceLabelFormatters.map((/** @type {any} */ entry) => entry.authority);
+	assert.ok(authorities.includes('picket-wsl+*'));
+	assert.ok(authorities.includes('wsl+*'), 'a workspace carried over from the official extension must look like ours');
+});
+
+test('the surface is mounted only while the gate is open', () => {
+	// The branch is the guarantee: resolver, tree commands and the nudge live in
+	// `mountWsl`, and nothing but this call reaches it.
+	assert.match(extension, /if \(!gate\.blocked\) \{\s*mountWsl\(\);/);
+	assert.match(extension, /registerCommands\(\{ \.\.\.commandOptions, only: RESIDENT_COMMANDS \}\)/);
+	assert.match(extension, /registerCommands\(\{ \.\.\.commandOptions, except: RESIDENT_COMMANDS \}\)/);
+	assert.match(extension, /'setContext', 'picketWsl\.blocked'/);
+});
+
+test('every clickable command is hidden while the gate is closed', () => {
+	// Diagnostics and both uninstall paths answer with the gate closed: one
+	// explains why, the other is the way out.
+	const resident = new Set([
+		...RESIDENT_COMMANDS,
+		'picket.wsl.showLog',
+		'picket.wsl.uninstallOfficial',
+		'picket.wsl.uninstallGuide'
+	]);
+	for (const entry of manifest.contributes.menus.commandPalette) {
+		if (resident.has(entry.command)) {
+			assert.doesNotMatch(entry.when, /blocked/, `${entry.command} must stay reachable while blocked`);
+			continue;
+		}
+		assert.match(entry.when, /!picketWsl\.blocked/, `${entry.command} stays clickable while blocked`);
+	}
+	for (const entry of manifest.contributes.menus['view/title']) {
+		assert.match(entry.when, /!picketWsl\.blocked/, `${entry.command} stays clickable while blocked`);
+	}
+});
+
+test('the way out of the blocked state is reachable from the blocked state', () => {
+	const blockedHint = manifest.contributes.menus['statusBar/remoteIndicator']
+		.find(entry => entry.command === 'picket.wsl.uninstallGuide');
+	assert.ok(blockedHint, 'the remote indicator must offer the uninstall while blocked');
+	assert.match(blockedHint.when, /picketWsl\.blocked/);
+	for (const id of ['picket.wsl.uninstallOfficial', 'picket.wsl.uninstallGuide']) {
+		const entry = manifest.contributes.menus.commandPalette.find(e => e.command === id);
+		assert.ok(entry, `${id} is contributed but not in the palette`);
+		assert.doesNotMatch(entry.when, /picketWsl\.blocked/, `${id} must not be gated`);
+	}
+});
