+// RED first: this file must fail until src/commands.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { createCommands } = require('../src/commands.js');
+const { createFakeHost, createFakeComponents, createCatalog } = require('./fixtures/fake-host.js');
+
+const TABLE = '* Ubuntu-24.04    Running         2\n  Debian          Stopped         2';
+
+/**
+ * Everything the command layer touches, minus VS Code itself.
+ * @param {{ flavor?: 'embedded' | 'ondemand', state?: 'installed' | 'absent', host?: any, fail?: string }} [options]
+ */
+function harness(options = {}) {
+	const host = createFakeHost(options.host);
+	/** @type {any[]} */
+	const calls = [];
+	/** @type {any[]} */
+	const configs = [];
+	/** @type {Array<{ id: string, config: any }>} */
+	const ensured = [];
+	/** @type {string[]} */
+	const stopped = [];
+
+	const createComponents = (config) => {
+		configs.push(config);
+		const components = createFakeComponents({ state: options.state ?? 'absent', fail: options.fail });
+		const ensure = components.ensure.bind(components);
+		components.ensure = async (id) => {
+			ensured.push({ id, config });
+			return ensure(id);
+		};
+		return components;
+	};
+
+	const runner = {
+		async exec(args) {
+			const key = args.join(' ');
+			calls.push(args);
+			if (key === '--list --verbose') {
+				return { code: 0, stdout: Buffer.from(TABLE, 'utf16le'), stderr: '' };
+			}
+			if (key.endsWith('printenv HOME')) {
+				return { code: 0, stdout: '/home/u\n', stderr: '' };
+			}
+			if (key.includes('wslpath -u')) {
+				return { code: 0, stdout: '/mnt/c/project\n', stderr: '' };
+			}
+			return { code: 0, stdout: '', stderr: '' };
+		}
+	};
+
+	const settings = {
+		defaultDistro: '',
+		serverPayloadPath: '',
+		serverPayloadBaseUrl: '',
+		tunnelMode: 'auto',
+		icodePath: '',
+		startTimeoutSeconds: 90
+	};
+	const store = new Map();
+	const memento = {
+		get: (key) => store.get(key),
+		async update(key, value) { store.set(key, value); }
+	};
+
+	const commands = createCommands({
+		host,
+		runner,
+		settings,
+		memento,
+		catalog: createCatalog({ flavor: options.flavor ?? 'ondemand' }),
+		createComponents,
+		resolver: { async stop(distro) { stopped.push(distro); } },
+		log: { info() { }, error() { } },
+		extensionPath: '/ext'
+	});
+
+	return { host, commands, calls, configs, ensured, stopped, memento };
+}
+
+test('the embedded flavor installs without asking where to get the payload', async () => {
+	const ctx = harness({
+		flavor: 'embedded',
+		host: { quickPick: 'Ubuntu-24.04', openDialog: [{ path: '/home/u/project' }] }
+	});
+	await ctx.commands.openFolder();
+	assert.ok(!ctx.host.messages.some(message => message.includes('从哪里获取')), `unexpected prompt: ${ctx.host.messages.join(' | ')}`);
+	assert.strictEqual(ctx.ensured.length, 1);
+	assert.strictEqual(ctx.host.opened.length, 1);
+});
+
+test('the ondemand flavor offers exactly three ways to get the payload', async () => {
+	const ctx = harness({ flavor: 'ondemand', host: { quickPick: 'Ubuntu-24.04', openDialog: [{ path: '/home/u/project' }] } });
+	await ctx.commands.openFolder();
+	assert.match(ctx.host.messages.at(-1), /从哪里获取/);
+	assert.deepStrictEqual(ctx.host.lastActions, ['自动下载', '从文件安装…', '取消']);
+	assert.deepStrictEqual(ctx.host.opened, []);
+});
+
+test('picking "install from file" hands the chosen path to the component manager', async () => {
+	const ctx = harness({
+		flavor: 'ondemand',
+		host: {
+			quickPick: 'Ubuntu-24.04',
+			openDialog: (opts) => (opts.canSelectFolders ? [{ path: '/home/u/project' }] : '/tmp/payload.tar.gz'),
+			info: ['从文件安装…']
+		}
+	});
+	await ctx.commands.openFolder();
+	assert.strictEqual(ctx.ensured.length, 1);
+	assert.strictEqual(ctx.ensured[0].config.explicitPath, '/tmp/payload.tar.gz');
+	assert.strictEqual(ctx.host.opened.length, 1);
+});
+
+test('cancelling the folder dialog opens nothing', async () => {
+	const ctx = harness({ host: { quickPick: 'Ubuntu-24.04' } });
+	await ctx.commands.openFolder();
+	assert.deepStrictEqual(ctx.host.opened, []);
+	assert.strictEqual(ctx.ensured.length, 0);
+});
+
+test('an installed component goes straight to a new window', async () => {
+	const ctx = harness({
+		state: 'installed',
+		host: { quickPick: 'Ubuntu-24.04', openDialog: [{ path: '/home/u/project' }] }
+	});
+	await ctx.commands.openFolder();
+	assert.strictEqual(ctx.host.opened.length, 1);
+	assert.deepStrictEqual(ctx.host.opened[0].opts, { forceNewWindow: true, remoteAuthority: 'picket-wsl+Ubuntu-24.04' });
+	assert.strictEqual(ctx.host.opened[0].uri.path, '/home/u/project');
+	assert.strictEqual(ctx.ensured.length, 0);
+});
+
+test('a UNC path chosen in the dialog is already posix', async () => {
+	const ctx = harness({
+		state: 'installed',
+		host: { quickPick: 'Debian', openDialog: [{ path: '', fsPath: '\\\\wsl.localhost\\Debian\\home\\u\\src' }] }
+	});
+	await ctx.commands.openFolder();
+	assert.strictEqual(ctx.host.opened[0].uri.path, '/home/u/src');
+	assert.strictEqual(ctx.host.opened[0].uri.authority, 'picket-wsl+Debian');
+});
+
+test('a Windows path chosen in the dialog is translated by wslpath', async () => {
+	const ctx = harness({
+		state: 'installed',
+		host: { quickPick: 'Ubuntu-24.04', openDialog: [{ path: 'C:\\project', fsPath: 'C:\\project', scheme: 'file' }] }
+	});
+	await ctx.commands.openFolder();
+	assert.ok(ctx.calls.some(args => args.join(' ').includes('wslpath -u')), 'expected a wslpath translation');
+	assert.strictEqual(ctx.host.opened[0].uri.path, '/mnt/c/project');
+});
+
+test('a failing install is reported, not thrown', async () => {
+	const ctx = harness({
+		flavor: 'embedded',
+		fail: 'no source configured',
+		host: { quickPick: 'Ubuntu-24.04', openDialog: [{ path: '/home/u/project' }] }
+	});
+	await ctx.commands.openFolder();
+	assert.deepStrictEqual(ctx.host.opened, []);
+	assert.match(ctx.host.messages.at(-1), /no source configured/);
+});
+
+test('stopping the server asks which distro and hands it to the resolver', async () => {
+	const ctx = harness({ host: { quickPick: 'Debian' } });
+	await ctx.commands.stopServer();
+	assert.deepStrictEqual(ctx.stopped, ['Debian']);
+});
+
+test('refresh reloads the targets view', async () => {
+	const ctx = harness();
+	await ctx.commands.refreshTargets();
+	assert.strictEqual(ctx.host.state.refreshed, 1);
+});
+
+test('diagnostics open in a document', async () => {
+	const ctx = harness();
+	await ctx.commands.diagnose();
+	assert.strictEqual(ctx.host.documents.length, 1);
+	assert.match(ctx.host.documents[0], /Product tag/);
+});
+
+test('setting the default distro goes through manage and refreshes the view', async () => {
+	const ctx = harness({ host: { quickPick: 'Debian' } });
+	await ctx.commands.setDefaultDistro();
+	assert.deepStrictEqual(ctx.calls.at(-1), ['--set-default', 'Debian']);
+	assert.strictEqual(ctx.host.state.refreshed, 1);
+});
+
+test('remembering a distro survives into the next quick pick', async () => {
+	const ctx = harness({ state: 'installed', host: { quickPick: 'Debian', openDialog: [{ path: '/home/u/src' }] } });
+	await ctx.commands.openFolder();
+	assert.strictEqual(ctx.memento.get('picket.wsl.lastDistro'), 'Debian');
+});
