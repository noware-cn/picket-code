@@ -0,0 +1,35 @@
+'use strict';
+
+const { parseUncPath } = require('./remoteUri.js');
+
+const NUDGE_KEY = 'picket.wsl.nudgedUncFolder';
+
+/**
+ * A folder opened from `\\wsl.localhost\...` works, badly: the extension host,
+ * the file watcher and every task run on Windows against a 9p share. Say so
+ * once — a warning on every window would be worse than the problem.
+ * @param {{ host: any, memento?: any, folders?: readonly any[], openFolderInWsl?: (distro: string, posixPath: string) => Promise<void> }} options
+ * @returns {Promise<boolean>} true when the user was warned this time
+ */
+async function maybeNudge(options) {
+	const { host, memento } = options;
+	const folder = Array.isArray(options.folders) ? options.folders[0] : undefined;
+	const unc = parseUncPath(folder?.uri?.fsPath ?? '');
+	if (!unc) {
+		return false;
+	}
+	if (memento?.get(NUDGE_KEY)) {
+		return false;
+	}
+	await memento?.update(NUDGE_KEY, true);
+	const choice = await host.showInformationMessage(
+		'这个文件夹位于 WSL 中。用 Picket 在 WSL 里打开，扩展、终端和文件监听都会跑在 Linux 上。',
+		'在 WSL 中打开'
+	);
+	if (choice === '在 WSL 中打开') {
+		await options.openFolderInWsl?.(unc.distro, unc.posixPath);
+	}
+	return true;
+}
+
+module.exports = { maybeNudge, NUDGE_KEY };
diff --git a/extensions/picket-remote-wsl/src/official.js b/extensions/picket-remote-wsl/src/official.js
new file mode 100644
index 00000000..d74358c5
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/official.js
@@ -0,0 +1,67 @@
+'use strict';
+
+/**
+ * `ms-vscode-remote.remote-wsl` is the extension this one replaces, and the two
+ * cannot share a window: they fight over the same `wsl+` authority, the same
+ * `~/.vscode-server` tree and the same server port, and whichever resolves
+ * first wins the folder. So the official extension being *installed* — enabled,
+ * disabled, activated or not — turns every WSL feature here off. This is not a
+ * preference; the only way back is to remove it.
+ */
+const OFFICIAL_EXTENSION_ID = 'ms-vscode-remote.remote-wsl';
+
+/** @typedef {{ blocked: boolean, installed: boolean }} IGateState */
+/** @typedef {{ get(id: string): any, onDidChange(callback: () => void): { dispose(): void } }} IExtensions */
+
+/**
+ * @param {{ extensions: IExtensions }} options
+ */
+function createOfficialGate(options) {
+	const { extensions } = options;
+	/** @type {IGateState} */
+	let state = { blocked: false, installed: false };
+	/** @type {Set<(state: IGateState) => void>} */
+	const listeners = new Set();
+
+	/** @returns {IGateState} */
+	function evaluate() {
+		let installed = false;
+		try {
+			installed = Boolean(extensions.get(OFFICIAL_EXTENSION_ID));
+		} catch {
+			// An extensions API that throws must not take WSL down with it; the
+			// next onDidChange re-evaluates, and the report shows the state.
+			installed = false;
+		}
+		state = { blocked: installed, installed };
+		return { ...state };
+	}
+
+	evaluate();
+	const subscription = extensions.onDidChange(() => {
+		const before = state.blocked;
+		const next = evaluate();
+		if (next.blocked !== before) {
+			for (const listener of [...listeners]) {
+				listener(next);
+			}
+		}
+	});
+
+	return {
+		evaluate,
+		get blocked() { return state.blocked; },
+		get installed() { return state.installed; },
+		/** @param {(state: IGateState) => void} listener */
+		onChange(listener) {
+			listeners.add(listener);
+			return { dispose() { listeners.delete(listener); } };
+		},
+		dispose() {
+			listeners.clear();
+			subscription.dispose();
+		}
+	};
+}
+
+module.exports = { OFFICIAL_EXTENSION_ID, createOfficialGate };
diff --git a/extensions/picket-remote-wsl/src/offline.js b/extensions/picket-remote-wsl/src/offline.js
new file mode 100644
index 00000000..5a909a32
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/offline.js
@@ -0,0 +1,134 @@
+'use strict';
+
+const { execFile } = require('node:child_process');
+const { mkdtemp, readFile, readdir, rm, stat } = require('node:fs/promises');
+const { tmpdir } = require('node:os');
+const { join } = require('node:path');
+const { createHash } = require('node:crypto');
+const { promisify } = require('node:util');
+
+const run = promisify(execFile);
+
+/**
+ * A Windows path with spaces arrives through argv, so neither tool ever sees a
+ * shell string: `unzip` takes argv directly and PowerShell reads the two paths
+ * from the environment, which no quoting rule can mangle.
+ * @param {string} zipPath
+ * @param {string} destDir
+ * @returns {Promise<void>}
+ */
+async function defaultExpand(zipPath, destDir) {
+	if (process.platform === 'win32') {
+		await run('powershell.exe', [
+			'-NoProfile', '-NonInteractive', '-Command',
+			'Expand-Archive -LiteralPath $env:PICKET_ZIP -DestinationPath $env:PICKET_DEST -Force'
+		], { env: { ...process.env, PICKET_ZIP: zipPath, PICKET_DEST: destDir } });
+		return;
+	}
+	await run('unzip', ['-o', '-q', zipPath, '-d', destDir]);
+}
+
+/** @param {string} dir @returns {Promise<string[]>} every file below dir */
+async function walk(dir) {
+	const entries = await readdir(dir, { withFileTypes: true });
+	const files = [];
+	for (const entry of entries) {
+		const path = join(dir, entry.name);
+		if (entry.isDirectory()) {
+			files.push(...await walk(path));
+		} else if (entry.isFile()) {
+			files.push(path);
+		}
+	}
+	return files;
+}
+
+/**
+ * Everything a bundle claims must hold before the installer touches the distro:
+ * the payload exists, its digest is the one SHA256SUMS records, and the catalog
+ * describes exactly that file.
+ * @param {{
+ *   bundlePath: string,
+ *   destDir?: string,
+ *   expand?: (zipPath: string, destDir: string) => Promise<void>
+ * }} options
+ * @returns {Promise<{ dir: string, payloadPath: string, payloadSha256: string, payloadSize: number, catalog: any, sums: Map<string, string> }>}
+ */
+async function unpackOfflineBundle(options) {
+	const dir = options.destDir ?? await mkdtemp(join(tmpdir(), 'picket-wsl-bundle-'));
+	try {
+		await (options.expand ?? defaultExpand)(options.bundlePath, dir);
+
+		const files = await walk(dir);
+		const payload = files.find(file => /\.t(?:ar\.)?gz$/i.test(file) && !file.includes('picket-wsl-offline'));
+		if (!payload) {
+			throw new Error('The offline bundle contains no *.tar.gz server payload');
+		}
+		const catalogFile = files.find(file => file.endsWith('catalog.json'));
+		if (!catalogFile) {
+			throw new Error('The offline bundle contains no catalog.json');
+		}
+		const sumsFile = files.find(file => file.endsWith('SHA256SUMS'));
+		if (!sumsFile) {
+			throw new Error('The offline bundle contains no SHA256SUMS');
+		}
+
+		const sums = parseSha256Sums(await readFile(sumsFile, 'utf8'));
+		const name = payload.slice(payload.lastIndexOf('/') + 1).replace(/\\/g, '/');
+		const expected = sums.get(name);
+		if (!expected) {
+			throw new Error(`SHA256SUMS has no entry for ${name}`);
+		}
+
+		const bytes = await readFile(payload);
+		const actual = createHash('sha256').update(bytes).digest('hex');
+		if (actual !== expected.toLowerCase()) {
+			throw new Error(`sha256 mismatch for ${name}: expected ${expected.toLowerCase()}, got ${actual}`);
+		}
+
+		const catalog = JSON.parse(await readFile(catalogFile, 'utf8'));
+		const component = Array.isArray(catalog?.components)
+			? catalog.components.find((/** @type {any} */ c) => c.file === name)
+			: undefined;
+		if (!component) {
+			throw new Error(`The bundle's catalog has no component for ${name}`);
+		}
+
+		return {
+			dir,
+			payloadPath: payload,
+			payloadSha256: actual,
+			payloadSize: bytes.length,
+			catalog,
+			sums
+		};
+	} catch (error) {
+		if (!options.destDir) {
+			await rm(dir, { recursive: true, force: true }).catch(() => { });
+		}
+		throw error;
+	}
+}
+
+/**
+ * @param {string} text
+ * @returns {Map<string, string>}
+ */
+function parseSha256Sums(text) {
+	/** @type {Map<string, string>} */
+	const sums = new Map();
+	for (const line of String(text ?? '').split(/\r?\n/)) {
+		const match = /^([0-9a-fA-F]{64})\s+\*?(.+)$/.exec(line.trim());
+		if (match) {
+			sums.set(match[2].trim(), match[1].toLowerCase());
+		}
+	}
+	return sums;
+}
+
+/** @param {string} dir */
+async function removeBundle(dir) {
+	await rm(dir, { recursive: true, force: true });
+}
+
+module.exports = { unpackOfflineBundle, removeBundle, parseSha256Sums, defaultExpand };
diff --git a/extensions/picket-remote-wsl/src/payload.js b/extensions/picket-remote-wsl/src/payload.js
new file mode 100644
index 00000000..bfc4b865
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/payload.js
@@ -0,0 +1,245 @@
+'use strict';
+
+const { createHash, randomBytes } = require('node:crypto');
+const { readFile, stat } = require('node:fs/promises');
+const { downloadFile, parseProxySetting } = require('./download.js');
+
+/**
+ * @typedef {{ kind: 'file', path: string } | { kind: 'embedded', path: string } | { kind: 'url', url: string }} ISource
+ * @typedef {{ id: string, kind: 'server' | 'extensions', version: string, file: string, size: number, sha256: string, embedded: boolean, embeddedPath?: string }} IComponent
+ */
+
+/**
+ * `sha256sum` writes two spaces, `shasum -a 256` writes one; some tools add a
+ * binary marker. Anything else on the line is junk from a merged log.
+ * @param {string} text
+ * @returns {Map<string, string>}
+ */
+function parseSha256Sums(text) {
+	/** @type {Map<string, string>} */
+	const sums = new Map();
+	for (const line of text.split(/\r?\n/)) {
+		const match = /^([0-9a-fA-F]{64})\s+\*?(.+)$/.exec(line.trim());
+		if (match) {
+			sums.set(match[2].trim(), match[1].toLowerCase());
+		}
+	}
+	return sums;
+}
+
+/**
+ * Three sources, in the order a user would expect them to win: a file they
+ * pointed at, the copy shipped inside the build, then the configured mirror.
+ * @param {IComponent} component
+ * @param {{ explicitPath?: string, embeddedDir?: string, baseUrl?: string, exists?: (path: string) => Promise<boolean> }} options
+ * @returns {Promise<ISource>}
+ */
+async function chooseSource(component, options) {
+	const exists = options.exists ?? (async (path) => {
+		try {
+			return (await stat(path)).isFile();
+		} catch {
+			return false;
+		}
+	});
+
+	if (options.explicitPath && await exists(options.explicitPath)) {
+		return { kind: 'file', path: options.explicitPath };
+	}
+	if (options.embeddedDir) {
+		const embedded = joinPath(options.embeddedDir, component.file);
+		if (await exists(embedded)) {
+			return { kind: 'embedded', path: embedded };
+		}
+	}
+	if (options.baseUrl) {
+		return { kind: 'url', url: `${options.baseUrl.replace(/\/+$/, '')}/${component.file}` };
+	}
+	throw new Error(`No source for ${component.id}: explicit path missing, no embedded payload, and no base URL configured`);
+}
+
+/** @param {string} a @param {string} b */
+function joinPath(a, b) {
+	return `${a.replace(/[\\/]+$/, '')}/${b}`;
+}
+
+/**
+ * @param {string} path
+ * @returns {Promise<string>}
+ */
+async function sha256OfFile(path) {
+	return createHash('sha256').update(await readFile(path)).digest('hex');
+}
+
+/**
+ * @param {Buffer} bytes
+ * @returns {string}
+ */
+function sha256OfBuffer(bytes) {
+	return createHash('sha256').update(bytes).digest('hex');
+}
+
+/**
+ * Downloads a payload, reporting progress without flooding the caller.
+ *
+ * Two paths, and the precedence is deliberate: an injected `fetchImpl` wins
+ * over everything else so tests can stub the network without a server; the
+ * real path is `downloadFile`, which is the only one that understands
+ * proxies and custom CAs. Production never passes `fetchImpl`.
+ * @param {string} url
+ * @param {{
+ *   fetchImpl?: typeof fetch,
+ *   proxy?: string,
+ *   strictSSL?: boolean,
+ *   caFile?: string,
+ *   timeoutMs?: number,
+ *   maxBytes?: number,
+ *   onProgress?: (progress: { downloaded: number, total: number }) => void
+ * }} options
+ * @returns {Promise<Buffer>}
+ */
+async function download(url, options) {
+	if (options.fetchImpl) {
+		return downloadViaFetch(url, { fetchImpl: options.fetchImpl, onProgress: options.onProgress });
+	}
+	const proxy = parseProxySetting(options.proxy, url);
+	if (proxy.kind === 'invalid') {
+		throw new Error(`The configured HTTP proxy cannot be used for ${url}: ${proxy.reason}`);
+	}
+	return downloadFile(url, {
+		proxy,
+		ca: options.caFile ? await readCaFile(options.caFile) : undefined,
+		rejectUnauthorized: options.strictSSL !== false,
+		timeoutMs: options.timeoutMs,
+		maxBytes: options.maxBytes,
+		onProgress: options.onProgress
+	});
+}
+
+/**
+ * A mistyped CA path must say so here rather than surface later as an opaque
+ * TLS handshake failure.
+ * @param {string} path
+ * @returns {Promise<Buffer>}
+ */
+async function readCaFile(path) {
+	try {
+		return await readFile(path);
+	} catch (error) {
+		throw new Error(`Could not read the CA file ${path}: ${error.message}`);
+	}
+}
+
+/**
+ * @param {string} url
+ * @param {{ fetchImpl: typeof fetch, onProgress?: (progress: { downloaded: number, total: number }) => void }} options
+ * @returns {Promise<Buffer>}
+ */
+async function downloadViaFetch(url, options) {
+	const response = await options.fetchImpl(url);
+	if (!response.ok) {
+		throw new Error(`Download failed for ${url}: HTTP ${response.status}`);
+	}
+	const total = Number(response.headers.get('content-length') ?? 0);
+	const onProgress = options.onProgress;
+	let downloaded = 0;
+	let lastReport = 0;
+	/** @type {Buffer[]} */
+	const chunks = [];
+	if (response.body) {
+		for await (const chunk of /** @type {any} */ (response.body)) {
+			const buf = Buffer.from(chunk);
+			chunks.push(buf);
+			downloaded += buf.length;
+			const now = Date.now();
+			if (onProgress && now - lastReport >= 100) {
+				lastReport = now;
+				onProgress({ downloaded, total });
+			}
+		}
+	} else {
+		const buf = Buffer.from(await response.arrayBuffer());
+		chunks.push(buf);
+		downloaded = buf.length;
+	}
+	onProgress?.({ downloaded, total: total || downloaded });
+	return Buffer.concat(chunks);
+}
+
+/**
+ * Verifies on the Windows side, then extracts inside the distro by piping the
+ * archive to `tar -xzf -` over stdin: no temporary copy inside the VM, and a
+ * half-written directory can never be mistaken for an install.
+ *
+ * The archive must be flat at its root (`bin/`, `out/`, `product.json`), which
+ * Task 12 asserts when it packages the payload.
+ * @param {{
+ *   runner: any,
+ *   distro: string,
+ *   component: IComponent,
+ *   source: ISource,
+ *   payloadRoot: string,
+ *   fetchImpl?: typeof fetch,
+ *   proxy?: string,
+ *   strictSSL?: boolean,
+ *   caFile?: string,
+ *   timeoutMs?: number,
+ *   onProgress?: (progress: { downloaded: number, total: number }) => void
+ * }} options
+ * @returns {Promise<{ payloadDir: string, source: ISource }>}
+ */
+async function installPayload(options) {
+	const { runner, distro, component, source, payloadRoot } = options;
+	const bytes = source.kind === 'url'
+		? await download(source.url, {
+			fetchImpl: options.fetchImpl,
+			proxy: options.proxy,
+			strictSSL: options.strictSSL,
+			caFile: options.caFile,
+			timeoutMs: options.timeoutMs,
+			maxBytes: component.size,
+			onProgress: options.onProgress
+		})
+		: await readFile(source.path);
+
+	// The size the catalog declares is cheap to check and catches a mirror that
+	// serves a different artifact before the (slower) hash does.
+	if (bytes.length !== component.size) {
+		throw new Error(`Size mismatch for ${component.file}: expected ${component.size} bytes, got ${bytes.length}`);
+	}
+
+	const actual = sha256OfBuffer(bytes);
+	if (actual !== component.sha256.toLowerCase()) {
+		throw new Error(`Checksum mismatch for ${component.file}: expected ${component.sha256.toLowerCase()}, got ${actual}`);
+	}
+
+	const finalDir = `${payloadRoot}/picket-${component.version}`;
+	const tmpDir = `${payloadRoot}/.tmp-${randomBytes(4).toString('hex')}`;
+
+	const prepare = await runner.exec(['-d', distro, '-e', 'sh', '-c', 'mkdir -p "$1" && rm -rf "$1"/.tmp-* "$1"/picket-*.old', 'sh', payloadRoot]);
+	if (prepare.code !== 0) {
+		throw new Error(`Could not prepare ${payloadRoot} in ${distro}: ${prepare.stderr}`);
+	}
+	const unpack = await runner.exec(
+		['-d', distro, '-e', 'sh', '-c',
+			// Release archives wrap everything in one top-level directory (packaged
+			// from the parent); Task 12 bundles are flat. Unwrap when there is
+			// exactly one entry and it is a directory.
+			// The previously installed directory survives until the new tree is
+			// in place, so a failed re-install leaves the server usable.
+			'rm -rf "$1" && mkdir -p "$1" || exit 1; ' +
+			'tar -xzf - -C "$1" || { rm -rf "$1"; exit 1; }; ' +
+			'src="$1"; if [ "$(ls -1A "$1" | wc -l)" = 1 ] && [ -d "$1/$(ls -1A "$1")" ]; then src="$1/$(ls -1A "$1")"; fi; ' +
+			'mv "$2" "$2.old" 2>/dev/null; ' +
+			'mv "$src" "$2" || { rm -rf "$1"; mv "$2.old" "$2" 2>/dev/null; exit 1; }; ' +
+			'rm -rf "$2.old" "$1"',
+			'sh', tmpDir, finalDir],
+		{ input: bytes }
+	);
+	if (unpack.code !== 0) {
+		throw new Error(`Could not unpack ${component.file} in ${distro}: ${unpack.stderr}`);
+	}
+	return { payloadDir: finalDir, source };
+}
+
+module.exports = { parseSha256Sums, chooseSource, sha256OfFile, download, installPayload };
diff --git a/extensions/picket-remote-wsl/src/preflight.js b/extensions/picket-remote-wsl/src/preflight.js
new file mode 100644
index 00000000..8450e077
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/preflight.js
@@ -0,0 +1,81 @@
+'use strict';
+
+const { readFile } = require('node:fs/promises');
+const { homedir } = require('node:os');
+const { join } = require('node:path');
+
+/**
+ * Only `[wsl2]` matters here, and only two keys of it. Everything else in the
+ * file belongs to other WSL features; reading more would invite acting on
+ * settings this extension does not own.
+ * @param {string} text
+ * @returns {{ localhostForwarding?: boolean, networkingMode?: string }}
+ */
+function parseWslConfig(text) {
+	/** @type {{ localhostForwarding?: boolean, networkingMode?: string }} */
+	const config = {};
+	let section = '';
+	for (const raw of String(text ?? '').split(/\r?\n/)) {
+		const line = raw.trim();
+		if (line.length === 0 || line.startsWith('#') || line.startsWith(';')) {
+			continue;
+		}
+		const header = /^\[(.+)\]$/.exec(line);
+		if (header) {
+			section = header[1].trim().toLowerCase();
+			continue;
+		}
+		if (section !== 'wsl2') {
+			continue;
+		}
+		const separator = line.indexOf('=');
+		if (separator === -1) {
+			continue;
+		}
+		const key = line.slice(0, separator).trim().toLowerCase();
+		const value = line.slice(separator + 1).trim();
+		if (key === 'localhostforwarding') {
+			config.localhostForwarding = /^true$/i.test(value);
+		} else if (key === 'networkingmode') {
+			config.networkingMode = value.toLowerCase();
+		}
+	}
+	return config;
+}
+
+/**
+ * Direct is the fast path and the normal case. It stops working exactly when
+ * Windows no longer owns `127.0.0.1` for the VM — disabled localhost forwarding
+ * or mirrored networking — and then a pipe is the only way in.
+ * @param {{ configured?: string, wslConfig?: { localhostForwarding?: boolean, networkingMode?: string }, platform?: string }} options
+ * @returns {'direct' | 'stdio'}
+ */
+function chooseTunnelMode(options) {
+	const configured = options.configured ?? 'auto';
+	if (configured === 'direct' || configured === 'stdio') {
+		return configured;
+	}
+	if ((options.platform ?? process.platform) !== 'win32') {
+		return 'direct';
+	}
+	const config = options.wslConfig ?? {};
+	if (config.localhostForwarding === false || config.networkingMode === 'mirrored') {
+		return 'stdio';
+	}
+	return 'direct';
+}
+
+/** @param {string} path */
+async function readWslConfigFile(path) {
+	try {
+		return parseWslConfig(await readFile(path, 'utf8'));
+	} catch {
+		return {};
+	}
+}
+
+function wslConfigPath() {
+	return join(homedir(), '.wslconfig');
+}
+
+module.exports = { parseWslConfig, chooseTunnelMode, readWslConfigFile, wslConfigPath };
diff --git a/extensions/picket-remote-wsl/src/probe.js b/extensions/picket-remote-wsl/src/probe.js
new file mode 100644
index 00000000..59ade20e
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/probe.js
@@ -0,0 +1,33 @@
+'use strict';
+
+/**
+ * The server has no health endpoint; asking for a resource without a valid
+ * token is the cheapest question it answers. A 400 means "reachable and the
+ * token was accepted" (the request itself is malformed on purpose), a 4xx
+ * auth status means the token is wrong, and anything else is dead.
+ * @param {{ host: string, port: number, token: string, timeoutMs?: number, fetchImpl?: typeof fetch }} options
+ * @returns {Promise<'alive' | 'bad-token' | 'dead'>}
+ */
+async function probeServer(options) {
+	const timeoutMs = options.timeoutMs ?? 2000;
+	const fetchImpl = options.fetchImpl ?? globalThis.fetch;
+	const controller = new AbortController();
+	const timer = setTimeout(() => controller.abort(), timeoutMs);
+	timer.unref?.();
+	try {
+		const response = await fetchImpl(`http://${options.host}:${options.port}/vscode-remote-resource?tkn=${encodeURIComponent(options.token)}`, { signal: controller.signal });
+		if (response.status === 400 || response.status === 200) {
+			return 'alive';
+		}
+		if (response.status === 401 || response.status === 403) {
+			return 'bad-token';
+		}
+		return 'dead';
+	} catch {
+		return 'dead';
+	} finally {
+		clearTimeout(timer);
+	}
+}
+
+module.exports = { probeServer };
