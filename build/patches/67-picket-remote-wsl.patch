+++ b/extensions/picket-remote-wsl/src/distro.js
@@ -0,0 +1,224 @@
+'use strict';
+
+const { spawn: spawnChild } = require('node:child_process');
+
+/**
+ * @typedef {{ name: string, isDefault: boolean, version: '1' | '2', state: string }} IDistro
+ * @typedef {{ code: number, stdout: Buffer | string, stderr: Buffer | string }} IWslResult
+ * @typedef {{ exec(args: string[], opts?: { input?: string | Buffer, timeoutMs?: number }): Promise<IWslResult>, spawn(args: string[]): { child: import('node:child_process').ChildProcess, stdout: import('node:stream').Readable | null, stderr: import('node:stream').Readable | null } }} IWslRunner
+ */
+
+/**
+ * wsl.exe writes --list output as UTF-16LE with a BOM and CRLF, and everything
+ * else as UTF-8. A NUL byte is the discriminator: no UTF-8 text we consume
+ * contains one, and every UTF-16LE ASCII string does.
+ * @param {Buffer | string} buffer
+ * @returns {string}
+ */
+function decodeWslOutput(buffer) {
+	const text = typeof buffer === 'string'
+		? buffer
+		: buffer.includes(0) ? buffer.toString('utf16le') : buffer.toString('utf8');
+	return text
+		.replace(/^\uFEFF/, '')
+		.split(/\r?\n/)
+		.map(line => line.trim())
+		.filter(line => line.length > 0)
+		.join('\n');
+}
+
+/**
+ * @param {string} distro
+ * @param {string[]} args
+ */
+function distroExec(distro, args) {
+	return ['-d', distro, '-e', ...args];
+}
+
+/**
+ * @param {{ wslPath?: string, spawn?: typeof spawnChild, cwd?: string, timeoutMs?: number }} [options]
+ * @returns {IWslRunner}
+ */
+function createWslRunner(options = {}) {
+	const wslPath = options.wslPath ?? 'wsl.exe';
+	const spawn = options.spawn ?? spawnChild;
+	const defaultTimeout = options.timeoutMs ?? 30000;
+
+	return {
+		exec(args, opts = {}) {
+			const timeoutMs = opts.timeoutMs ?? defaultTimeout;
+			return new Promise((resolve, reject) => {
+				const child = spawn(wslPath, args, { cwd: options.cwd, windowsHide: true });
+				/** @type {Buffer[]} */
+				const out = [];
+				/** @type {Buffer[]} */
+				const err = [];
+				let settled = false;
+				const timer = setTimeout(() => {
+					if (settled) {
+						return;
+					}
+					settled = true;
+					child.kill();
+					reject(new Error(`Timed out after ${timeoutMs} ms: wsl.exe ${args.join(' ')}`));
+				}, timeoutMs);
+				timer.unref?.();
+
+				child.stdout?.on('data', (chunk) => out.push(chunk));
+				child.stderr?.on('data', (chunk) => err.push(chunk));
+				child.on('error', (error) => {
+					if (settled) {
+						return;
+					}
+					settled = true;
+					clearTimeout(timer);
+					reject(error);
+				});
+				child.on('close', (code) => {
+					if (settled) {
+						return;
+					}
+					settled = true;
+					clearTimeout(timer);
+					resolve({ code: code ?? -1, stdout: Buffer.concat(out), stderr: Buffer.concat(err) });
+				});
+
+				if (opts.input !== undefined) {
+					child.stdin?.end(opts.input);
+				} else {
+					child.stdin?.end();
+				}
+			});
+		},
+		spawn(args) {
+			const child = spawn(wslPath, args, { cwd: options.cwd, windowsHide: true });
+			return { child, stdout: child.stdout, stderr: child.stderr };
+		}
+	};
+}
+
+/**
+ * @param {string} stdout
+ * @returns {IDistro[]}
+ */
+function parseDistroTable(stdout) {
+	/** @type {IDistro[]} */
+	const distros = [];
+	for (const line of stdout.split(/\r?\n/).map(l => l.trim())) {
+		// Lines arrive trimmed, so the leading space of a non-default row is gone.
+		const match = /^(\*)?\s*(.+?)\s+(\w+)\s+([12])$/.exec(line);
+		if (!match) {
+			continue;
+		}
+		const [, marker, name, state, version] = match;
+		distros.push({ name: name.trim(), isDefault: marker === '*', version: version === '1' ? '1' : '2', state });
+	}
+	return distros;
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @returns {Promise<IDistro[]>}
+ */
+async function listDistros(runner) {
+	const result = await runner.exec(['--list', '--verbose']);
+	if (result.code !== 0) {
+		throw new Error(`wsl --list --verbose failed (${result.code}): ${decodeWslOutput(result.stderr)}`);
+	}
+	return parseDistroTable(decodeWslOutput(result.stdout));
+}
+
+/**
+ * @param {IDistro[]} list
+ * @returns {string}
+ */
+function defaultDistro(list) {
+	const marked = list.find(d => d.isDefault);
+	if (marked) {
+		return marked.name;
+	}
+	if (list.length === 0) {
+		throw new Error('No WSL distro is installed');
+	}
+	return list[0].name;
+}
+
+/**
+ * docker-desktop / docker-desktop-data are plumbing distros; offering them as
+ * places to open a folder is noise, unless the user made one the default.
+ * @param {IDistro[]} list
+ * @returns {IDistro[]}
+ */
+function visibleDistros(list) {
+	return list.filter(d => d.isDefault || !/^docker-desktop/i.test(d.name));
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @param {string} distro
+ * @returns {Promise<string>}
+ */
+async function distroHome(runner, distro) {
+	const result = await runner.exec(distroExec(distro, ['printenv', 'HOME']));
+	const home = decodeWslOutput(result.stdout);
+	if (result.code !== 0 || home.length === 0) {
+		throw new Error(`Could not read $HOME in ${distro} (${result.code}): ${decodeWslOutput(result.stderr)}`);
+	}
+	return home.split('\n')[0];
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @param {string} distro
+ * @returns {Promise<boolean>}
+ */
+async function isWsl1(runner, distro) {
+	const list = await listDistros(runner);
+	const found = list.find(d => d.name === distro);
+	return found?.version === '1';
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @param {string} distro
+ * @returns {Promise<'missing' | 'ok'>}
+ */
+async function distroStatus(runner, distro) {
+	try {
+		const result = await runner.exec(distroExec(distro, ['true']));
+		return result.code === 0 ? 'ok' : 'missing';
+	} catch {
+		return 'missing';
+	}
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @returns {Promise<{ installed: boolean, kernelUpdateRequired: boolean }>}
+ */
+async function wslStatus(runner) {
+	let result;
+	try {
+		result = await runner.exec(['--status']);
+	} catch (error) {
+		return { installed: false, kernelUpdateRequired: /kernel/i.test(String(error)) };
+	}
+	const stderr = decodeWslOutput(result.stderr);
+	if (result.code !== 0 && /not installed|not enabled/i.test(stderr)) {
+		return { installed: false, kernelUpdateRequired: false };
+	}
+	return { installed: true, kernelUpdateRequired: /kernel/i.test(stderr) };
+}
+
+module.exports = {
+	decodeWslOutput,
+	createWslRunner,
+	parseDistroTable,
+	listDistros,
+	defaultDistro,
+	visibleDistros,
+	distroHome,
+	isWsl1,
+	distroStatus,
+	wslStatus
+};
diff --git a/extensions/picket-remote-wsl/src/icode.js b/extensions/picket-remote-wsl/src/icode.js
