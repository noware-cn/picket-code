index 00000000..3f9029a1
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/download.js
@@ -0,0 +1,373 @@
+'use strict';
+
+const http = require('node:http');
+const https = require('node:https');
+const net = require('node:net');
+const tls = require('node:tls');
+
+const MAX_REDIRECTS = 5;
+const PROGRESS_INTERVAL_MS = 100;
+const DEFAULT_TIMEOUT_MS = 60000;
+const REDIRECT_STATUS = new Set([301, 302, 303, 307, 308]);
+
+/** @typedef {(options: any) => import('node:http').ClientRequest} IRequestFunction */
+/** @typedef {{ kind: 'direct' } | { kind: 'proxy', host: string, port: number, auth?: string, protocol: 'http:' } | { kind: 'invalid', reason: string }} IProxy */
+
+/**
+ * `http.proxy` is a free-form string: a URL, a bare `host:port`, or one of the
+ * words that mean "do not proxy". Credentials stay in the returned value so
+ * the caller can build a header; nothing here ever logs them.
+ *
+ * `no_proxy` / `NO_PROXY` matching is deliberately not implemented in v1:
+ * every payload URL goes through the configured proxy, which is what a user
+ * who set a proxy on an intranet expects, and the narrower rule (per-host
+ * exclusions) can be added without changing this signature — hence the
+ * currently unused `targetUrl` parameter.
+ * @param {string | null | undefined} value
+ * @param {string} [targetUrl]
+ * @returns {IProxy}
+ */
+function parseProxySetting(value, targetUrl) {
+	const text = typeof value === 'string' ? value.trim() : '';
+	if (text === '' || /^(off|direct)$/i.test(text)) {
+		return { kind: 'direct' };
+	}
+	// `new URL` would reject a bare `proxy:3128` as a scheme; VS Code accepts it,
+	// so treat anything without `scheme://` as http.
+	let parsed;
+	try {
+		parsed = new URL(/^[a-z][a-z0-9+.-]*:\/\//i.test(text) ? text : `http://${text}`);
+	} catch {
+		return { kind: 'invalid', reason: `not a proxy URL: ${text}` };
+	}
+	if (parsed.protocol !== 'http:') {
+		return { kind: 'invalid', reason: `unsupported proxy protocol ${parsed.protocol}` };
+	}
+	const host = parsed.hostname.replace(/^\[(.*)\]$/, '$1');
+	const port = Number(parsed.port || 80);
+	if (!host) {
+		return { kind: 'invalid', reason: `no proxy host in: ${text}` };
+	}
+	if (!Number.isInteger(port) || port < 1 || port > 65535) {
+		return { kind: 'invalid', reason: `invalid proxy port in: ${text}` };
+	}
+	/** @type {IProxy} */
+	const proxy = { kind: 'proxy', host, port, protocol: 'http:' };
+	if (parsed.username) {
+		proxy.auth = `${decodeURIComponent(parsed.username)}:${decodeURIComponent(parsed.password)}`;
+	}
+	return proxy;
+}
+
+/**
+ * Downloads `url` to a buffer, honouring an HTTP proxy and a custom CA.
+ *
+ * `fetch` cannot be told about either, which is why this exists: intranet
+ * users reach the payload mirror through the same proxy as everything else,
+ * and a self-signed mirror is trusted through `ca` rather than by switching
+ * certificate validation off.
+ * @param {string} url
+ * @param {{
+ *   proxy?: IProxy,
+ *   ca?: Buffer | string | Array<Buffer | string>,
+ *   rejectUnauthorized?: boolean,
+ *   timeoutMs?: number,
+ *   maxBytes?: number,
+ *   onProgress?: (progress: { downloaded: number, total: number }) => void,
+ *   httpRequest?: IRequestFunction,
+ *   httpsRequest?: IRequestFunction
+ * }} [options]
+ * @returns {Promise<Buffer>}
+ */
+async function downloadFile(url, options = {}) {
+	const timeoutMs = options.timeoutMs ?? DEFAULT_TIMEOUT_MS;
+	let target = new URL(url);
+	for (let hop = 0; hop <= MAX_REDIRECTS; hop += 1) {
+		if (target.protocol !== 'http:' && target.protocol !== 'https:') {
+			throw new Error(`Unsupported URL scheme for download: ${target.protocol}`);
+		}
+		const response = await openResponse(target, options, timeoutMs);
+		const status = response.statusCode ?? 0;
+		const location = response.headers.location;
+		if (REDIRECT_STATUS.has(status) && location) {
+			discard(response);
+			target = new URL(location, target);
+			continue;
+		}
+		if (status < 200 || status >= 300) {
+			discard(response);
+			throw new Error(`Download failed for ${target.href}: HTTP ${status}`);
+		}
+		return collect(response, options.onProgress, options.maxBytes);
+	}
+	throw new Error(`Download failed for ${url}: more than ${MAX_REDIRECTS} redirects`);
+}
+
+/**
+ * The body of a response we are not going to read is destroyed rather than
+ * drained: a redirect or an error page must not cost the bytes it points at.
+ * @param {import('node:http').IncomingMessage} response
+ */
+function discard(response) {
+	response.on('error', () => { });
+	response.destroy();
+}
+
+/**
+ * A redirect target is an arbitrary URL, so it goes back through the whole
+ * loop: a redirect can switch scheme, and each hop re-decides direct versus
+ * proxied.
+ * @param {URL} target
+ * @param {{ proxy?: IProxy, ca?: any, rejectUnauthorized?: boolean, httpRequest?: IRequestFunction, httpsRequest?: IRequestFunction }} options
+ * @param {number} timeoutMs
+ * @returns {Promise<import('node:http').IncomingMessage>}
+ */
+async function openResponse(target, options, timeoutMs) {
+	const proxy = options.proxy?.kind === 'proxy' ? options.proxy : undefined;
+	if (!proxy) {
+		return requestDirect(target, options, timeoutMs);
+	}
+	if (target.protocol === 'http:') {
+		return requestThroughProxy(target, proxy, options, timeoutMs);
+	}
+	const socket = await openTunnel(target, proxy, timeoutMs);
+	// The tunnel is a plain byte pipe; TLS still has to be negotiated with the
+	// target, and only then is the HTTPS client given a socket it can write to.
+	const secure = tls.connect({ ...tlsOptions(target, options), host: target.hostname, port: portOf(target), socket });
+	try {
+		return await requestOverTunnel(target, secure, options, timeoutMs);
+	} catch (error) {
+		secure.destroy();
+		throw error;
+	}
+}
+
+/**
+ * `agent: false` gives every download its own socket with `Connection: close`:
+ * a payload is fetched once, and a lingering keep-alive socket would only keep
+ * the extension host's event loop busy.
+ * @param {URL} target
+ * @param {{ ca?: any, rejectUnauthorized?: boolean, httpRequest?: IRequestFunction, httpsRequest?: IRequestFunction }} options
+ * @param {number} timeoutMs
+ * @returns {Promise<import('node:http').IncomingMessage>}
+ */
+function requestDirect(target, options, timeoutMs) {
+	const secure = target.protocol === 'https:';
+	const requestFn = secure ? (options.httpsRequest ?? https.request) : (options.httpRequest ?? http.request);
+	/** @type {any} */
+	const requestOptions = {
+		host: target.hostname,
+		port: portOf(target),
+		path: pathOf(target),
+		method: 'GET',
+		agent: false,
+		headers: { Accept: '*/*' }
+	};
+	if (secure) {
+		Object.assign(requestOptions, tlsOptions(target, options));
+	}
+	return sendRequest(requestFn, requestOptions, timeoutMs);
+}
+
+/**
+ * Plain `http:` targets travel to the proxy as an absolute-URI request: the
+ * proxy fetches them itself, and there is nothing to negotiate — the payload
+ * is already readable on the wire.
+ * @param {URL} target
+ * @param {{ host: string, port: number, auth?: string }} proxy
+ * @param {{ httpRequest?: IRequestFunction }} options
+ * @param {number} timeoutMs
+ * @returns {Promise<import('node:http').IncomingMessage>}
+ */
+function requestThroughProxy(target, proxy, options, timeoutMs) {
+	return sendRequest(options.httpRequest ?? http.request, {
+		host: proxy.host,
+		port: proxy.port,
+		path: target.href.replace(/#.*$/, ''),
+		method: 'GET',
+		agent: false,
+		headers: {
+			Host: target.host,
+			Accept: '*/*',
+			...proxyAuthHeader(proxy)
+		}
+	}, timeoutMs);
+}
+
+/**
+ * TLS is negotiated with the *target*, not with the proxy: `CONNECT` only
+ * opens a byte pipe, so a proxy never sees the payload and a self-signed
+ * mirror is validated against `ca` exactly as in a direct download.
+ * @param {URL} target
+ * @param {{ host: string, port: number, auth?: string }} proxy
+ * @param {number} timeoutMs
+ * @returns {Promise<net.Socket>}
+ */
+function openTunnel(target, proxy, timeoutMs) {
+	const authority = `${target.hostname}:${portOf(target)}`;
+	return new Promise((resolve, reject) => {
+		const socket = net.connect({ host: proxy.host, port: proxy.port });
+		/** @param {Error} error */
+		const fail = (error) => {
+			socket.destroy();
+			reject(error);
+		};
+		socket.setTimeout(timeoutMs, () => fail(new Error(`Proxy ${proxy.host}:${proxy.port} did not answer CONNECT within ${timeoutMs} ms`)));
+		socket.once('error', fail);
+		socket.once('connect', () => {
+			const headers = [`CONNECT ${authority} HTTP/1.1`, `Host: ${authority}`, ...authHeaderLines(proxy)];
+			socket.write(`${headers.join('\r\n')}\r\n\r\n`);
+		});
+
+		let buffer = Buffer.alloc(0);
+		/** @param {Buffer} chunk */
+		const onData = (chunk) => {
+			buffer = Buffer.concat([buffer, chunk]);
+			const end = buffer.indexOf('\r\n\r\n');
+			if (end < 0) {
+				return;
+			}
+			socket.pause();
+			socket.removeListener('data', onData);
+			const statusLine = buffer.subarray(0, end).toString('latin1').split('\r\n')[0];
+			const status = Number(/^HTTP\/1\.[01] (\d{3})/.exec(statusLine)?.[1] ?? 0);
+			if (status !== 200) {
+				fail(new Error(`Proxy ${proxy.host}:${proxy.port} refused CONNECT ${authority}: ${statusLine}`));
+				return;
+			}
+			const rest = buffer.subarray(end + 4);
+			if (rest.length > 0) {
+				socket.unshift(rest);
+			}
+			socket.setTimeout(0);
+			socket.removeListener('error', fail);
+			resolve(socket);
+		};
+		socket.on('data', onData);
+	});
+}
+
+/**
+ * @param {URL} target
+ * @param {import('node:tls').TLSSocket} socket
+ * @param {{ httpsRequest?: IRequestFunction }} options
+ * @param {number} timeoutMs
+ * @returns {Promise<import('node:http').IncomingMessage>}
+ */
+function requestOverTunnel(target, socket, options, timeoutMs) {
+	const requestFn = options.httpsRequest ?? https.request;
+	// No agent on purpose: node then uses `createConnection` verbatim instead of
+	// opening (and handshaking) a second socket.
+	return sendRequest(requestFn, {
+		host: target.hostname,
+		port: portOf(target),
+		path: pathOf(target),
+		method: 'GET',
+		headers: { Accept: '*/*' },
+		createConnection: () => socket
+	}, timeoutMs);
+}
+
+/**
+ * @param {URL} target
+ * @param {{ ca?: any, rejectUnauthorized?: boolean }} options
+ * @returns {any}
+ */
+function tlsOptions(target, options) {
+	/** @type {any} */
+	const secure = {
+		// An IP literal in SNI is invalid; node uses the socket host otherwise.
+		servername: net.isIP(target.hostname) ? undefined : target.hostname,
+		// Certificate validation stays on unless the user turned
+		// `http.proxyStrictSSL` off: an untrusted mirror must fail loudly.
+		rejectUnauthorized: options.rejectUnauthorized !== false
+	};
+	if (options.ca) {
+		secure.ca = options.ca;
+	}
+	return secure;
+}
+
+/** @param {{ auth?: string }} proxy @returns {Record<string, string>} */
+function proxyAuthHeader(proxy) {
+	return proxy.auth ? { 'Proxy-Authorization': `Basic ${Buffer.from(proxy.auth).toString('base64')}` } : {};
+}
+
+/** @param {{ auth?: string }} proxy @returns {string[]} */
+function authHeaderLines(proxy) {
+	return Object.entries(proxyAuthHeader(proxy)).map(([name, value]) => `${name}: ${value}`);
+}
+
+/** @param {URL} target @returns {number} */
+function portOf(target) {
+	return Number(target.port || (target.protocol === 'https:' ? 443 : 80));
+}
+
+/** @param {URL} target @returns {string} */
+function pathOf(target) {
+	return `${target.pathname}${target.search}`;
+}
+
+/**
+ * A socket timeout is idle time, not total time: a mirror that stalls halfway
+ * through a large payload fails the download instead of hanging the window.
+ * @param {IRequestFunction} requestFn
+ * @param {any} requestOptions
+ * @param {number} timeoutMs
+ * @returns {Promise<import('node:http').IncomingMessage>}
+ */
+function sendRequest(requestFn, requestOptions, timeoutMs) {
+	return new Promise((resolve, reject) => {
+		const request = requestFn(requestOptions);
+		request.setTimeout(timeoutMs, () => {
+			request.destroy(new Error(`Download timed out after ${timeoutMs} ms of inactivity`));
+		});
+		request.on('error', reject);
+		request.on('response', resolve);
+		request.end();
+	});
+}
+
+/**
+ * Reports at most every 100 ms, plus one final call with the real total: a
+ * `content-length` that disagrees with the bytes received must not leave the
+ * progress bar stuck at 99%.
+ *
+ * `maxBytes` is the size the catalog expects: a mirror that answers with more
+ * than that is refused mid-flight rather than buffered to the end.
+ * @param {import('node:http').IncomingMessage} response
+ * @param {((progress: { downloaded: number, total: number }) => void) | undefined} onProgress
+ * @param {number | undefined} [maxBytes]
+ * @returns {Promise<Buffer>}
+ */
+function collect(response, onProgress, maxBytes) {
+	const total = Number(response.headers['content-length'] ?? 0);
+	/** @type {Buffer[]} */
+	const chunks = [];
+	let downloaded = 0;
+	let lastReport = 0;
+	return new Promise((resolve, reject) => {
+		response.on('data', (/** @type {Buffer} */ chunk) => {
+			const buf = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);
+			downloaded += buf.length;
+			if (typeof maxBytes === 'number' && downloaded > maxBytes) {
+				response.destroy();
+				reject(new Error(`Download exceeded the expected size of ${maxBytes} bytes`));
+				return;
+			}
+			chunks.push(buf);
+			const now = Date.now();
+			if (onProgress && now - lastReport >= PROGRESS_INTERVAL_MS) {
+				lastReport = now;
+				onProgress({ downloaded, total });
+			}
+		});
+		response.on('end', () => {
+			onProgress?.({ downloaded, total: total || downloaded });
+			resolve(Buffer.concat(chunks));
+		});
+		response.on('error', reject);
+	});
+}
+
+module.exports = { parseProxySetting, downloadFile };
diff --git a/extensions/picket-remote-wsl/src/icode.js b/extensions/picket-remote-wsl/src/icode.js
