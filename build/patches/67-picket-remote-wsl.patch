@@ -0,0 +1,38 @@
+'use strict';
+
+const { decodeWslOutput } = require('./distro.js');
+
+/**
+ * iCode is optional: a distro without it is a working window with no AI, so a
+ * miss is a normal answer (`missing`), never an error. Detection runs in the
+ * same login shell the server is started in, because that shell is what decides
+ * whether `~/.local/bin` is on `PATH` — detecting in a bare `sh -c` would find
+ * nothing on machines where the server would have found it.
+ * @param {{ runner: any, distro: string, configuredPath?: string }} options
+ * @returns {Promise<{ path: string | null, source: 'setting' | 'path' | 'missing' }>}
+ */
+async function detectIcode(options) {
+	const { runner, distro } = options;
+	const configuredPath = options.configuredPath ?? '';
+	if (configuredPath) {
+		const tested = await runner.exec(['-d', distro, '-e', 'test', '-x', configuredPath]);
+		if (tested.code === 0) {
+			return { path: configuredPath, source: 'setting' };
+		}
+	}
+	const found = await runner.exec(['-d', distro, '-e', 'sh', '-lc', 'command -v icode']);
+	if (found.code === 0) {
+		// A login shell may print a profile banner before the answer; the path is
+		// the last absolute line it wrote.
+		const line = decodeWslOutput(found.stdout)
+			.split('\n')
+			.filter(text => text.startsWith('/'))
+			.pop();
+		if (line) {
+			return { path: line, source: 'path' };
+		}
+	}
+	return { path: null, source: 'missing' };
+}
+
+module.exports = { detectIcode };
