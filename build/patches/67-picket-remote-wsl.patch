+
+test('a failed re-install leaves the previous payload in place', { skip: process.platform !== 'linux' }, async () => {
+	// The new tree is built beside the old one and swapped in only once it is
+	// complete; a corrupt archive must not cost the user a working server.
+	const { mkdirSync, statSync, existsSync } = require('node:fs');
+	const { execFileSync, spawn } = require('node:child_process');
+	const { sha256OfFile } = require('../src/payload.js');
+	const { createWslRunner } = require('../src/distro.js');
+
+	const dir = mkdtempSync(join(tmpdir(), 'picket-payload-reinstall-'));
+	const home = mkdtempSync(join(tmpdir(), 'picket-payload-home3-'));
+	const payloadRoot = join(home, '.picket-code-server', 'payloads');
+	const runner = createWslRunner({ wslPath: '/bin/sh', spawn: (wslPath, args) => spawn(wslPath, ['-c', 'exec "$@"', '--', ...args.slice(3)]) });
+
+	const goodDir = join(dir, 'good');
+	mkdirSync(join(goodDir, 'bin'), { recursive: true });
+	writeFileSync(join(goodDir, 'bin', 'picket-code-server'), '#!/bin/sh\nexit 0\n');
+	writeFileSync(join(goodDir, 'product.json'), '{}\n');
+	const good = join(dir, 'good.tar.gz');
+	execFileSync('tar', ['-czf', good, '-C', goodDir, 'bin', 'product.json']);
+	const first = await installPayload({
+		runner, distro: 'X', payloadRoot,
+		component: { ...COMPONENT, file: 'good.tar.gz', size: statSync(good).size, sha256: await sha256OfFile(good) },
