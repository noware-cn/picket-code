index 00000000..6a6d596c
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/components.js
@@ -0,0 +1,254 @@
+'use strict';
+
+const { readFile, writeFile } = require('node:fs/promises');
+const { chooseSource, installPayload } = require('./payload.js');
+const { compareVersions, normalizeWant, selectComponent, describeSelectionError } = require('./version.js');
+
+/** @typedef {{ sha256: string, version: string, commit: string, source: string, installedAt: string }} IPayloadMarker */
+/** @typedef {'absent' | 'installed' | 'outdated' | 'incompatible' | 'broken'} IPayloadState */
+
+/**
+ * @param {string} payloadDir
+ * @returns {string}
+ */
+function markerPath(payloadDir) {
+	return `${payloadDir}/.picket-payload.json`;
+}
+
+/**
+ * @param {string} base
+ * @param {string} child
+ */
+function joinPath(base, child) {
+	return `${base.replace(/\/+$/, '')}/${child}`;
+}
+
+/**
+ * The disk inside the distro is the only source of truth: the Windows-side
+ * cache can be stale or corrupt, and a marker whose hash disagrees with the
+ * catalog means the payload is not the one this build expects.
+ * @param {{ catalog: any, product?: { commit: string, version: string, picketServerMinVersion: string }, runner: any, distro: string, home: string, statePath?: string, env?: any, download?: { proxy?: string, strictSSL?: boolean, caFile?: string }, fetchImpl?: typeof fetch, onProgress?: (progress: { downloaded: number, total: number }) => void }} options
+ */
+function createComponentManager(options) {
+	const { catalog, runner, distro, home } = options;
+	const payloadRoot = joinPath(home, '.vscode-server/bin');
+
+	/** @param {string} script @param {...string} params */
+	function sh(script, ...params) {
+		return runner.exec(['-d', distro, '-e', 'sh', '-c', script, 'sh', ...params]);
+	}
+
+	/** @returns {Promise<string[]>} absolute picket-* paths, newest first */
+	async function listServerDirs() {
+		const result = await sh('ls -1t "$1" 2>/dev/null || true', payloadRoot);
+		const base = `${payloadRoot}/`;
+		return String(result.stdout)
+			.split(/\r?\n/)
+			.map(line => line.trim())
+			.filter(line => line.startsWith('picket-') || line.startsWith(base))
+			.map(line => (line.startsWith('/') ? line : `${payloadRoot}/${line}`));
+	}
+
+	/** @param {string} dir */
+	async function readMarker(dir) {
+		const result = await sh('cat "$1" 2>/dev/null || true', markerPath(dir));
+		const text = String(result.stdout).trim();
+		if (!text) {
+			return undefined;
+		}
+		try {
+			const parsed = JSON.parse(text);
+			return typeof parsed?.sha256 === 'string' ? parsed : undefined;
+		} catch {
+			return undefined;
+		}
+	}
+
+	/** What this build is allowed to talk to. */
+	function want() {
+		return normalizeWant({ commit: options.product?.commit, minVersion: options.product?.picketServerMinVersion });
+	}
+
+	/** @param {string} version */
+	function atLeastMinimum(version) {
+		try {
+			return compareVersions(version, want().minVersion) >= 0;
+		} catch {
+			// An unparsable record or an unstamped product is not a reason to
+			// reuse anything: treat it as below the minimum and move on.
+			return false;
+		}
+	}
+
+	/**
+	 * The newest catalog entry this client may install for `id`.
+	 * @param {string} id
+	 */
+	function componentOf(id) {
+		const only = { ...catalog, components: (Array.isArray(catalog?.components) ? catalog.components : []).filter((c) => c.id === id) };
+		const selection = selectComponent(only, want());
+		if ('error' in selection) {
+			throw new Error(`Cannot install ${id}: ${describeSelectionError(selection, want())}`);
+		}
+		return selection.component;
+	}
+
+	/**
+	 * The verdict is about the payloads on disk, not about the catalog: a server
+	 * this build already installed keeps working after the catalog moves on, as
+	 * long as it was built from our commit and is not older than the minimum.
+	 * @param {string} id
+	 * @returns {Promise<{ state: IPayloadState, version?: string, payloadDir?: string, candidateVersion?: string }>}
+	 */
+	async function inspect(id) {
+		const dirs = await listServerDirs();
+		if (dirs.length === 0) {
+			return { state: /** @type {IPayloadState} */ ('absent') };
+		}
+		/** @type {Array<IPayloadMarker & { dir: string }>} */
+		const marked = [];
+		let unreadable = 0;
+		for (const dir of dirs) {
+			const marker = await readMarker(dir);
+			if (!marker || typeof marker.version !== 'string' || typeof marker.commit !== 'string') {
+				unreadable += 1;
+				continue;
+			}
+			marked.push({ ...marker, dir });
+		}
+		/** @param {IPayloadMarker & { dir: string }} entry */
+		const intact = (entry) => {
+			const declared = (catalog?.components ?? []).find((/** @type {any} */ c) => c.version === entry.version);
+			return !declared || declared.sha256.toLowerCase() === entry.sha256.toLowerCase();
+		};
+		const ours = marked.filter(entry => want().anyCommit || entry.commit === want().commit);
+		const usable = ours.filter(entry => intact(entry) && atLeastMinimum(entry.version));
+		if (usable.length > 0) {
+			const best = usable.reduce((top, entry) => (compareVersions(entry.version, top.version) > 0 ? entry : top));
+			return { state: /** @type {IPayloadState} */ ('installed'), version: best.version, payloadDir: best.dir };
+		}
+		if (ours.length > 0) {
+			const best = ours.reduce((top, entry) => (compareVersions(entry.version, top.version) > 0 ? entry : top));
+			return { state: /** @type {IPayloadState} */ ('outdated'), candidateVersion: best.version };
+		}
+		if (marked.length > 0) {
+			return { state: /** @type {IPayloadState} */ ('incompatible') };
+		}
+		return { state: /** @type {IPayloadState} */ (unreadable > 0 ? 'broken' : 'absent') };
+	}
+
+	/** @param {string} id */
+	async function ensure(id) {
+		const current = await inspect(id);
+		if (current.state === 'installed' && current.payloadDir) {
+			return {
+				payloadDir: current.payloadDir,
+				version: current.version,
+				source: sourceOfMarker(await readMarker(current.payloadDir))
+			};
+		}
+		const component = componentOf(id);
+		const source = await chooseSource(component, {
+			explicitPath: options.env?.explicitPath,
+			embeddedDir: options.env?.embeddedDir,
+			baseUrl: options.env?.baseUrl,
+			exists: options.env?.exists
+		});
+		const installed = await installPayload({
+			runner, distro, component, source, payloadRoot,
+			fetchImpl: options.fetchImpl,
+			onProgress: options.onProgress,
+			proxy: options.download?.proxy,
+			strictSSL: options.download?.strictSSL,
+			caFile: options.download?.caFile
+		});
+		/** @type {IPayloadMarker} */
+		const marker = {
+			version: component.version,
+			commit: component.commit,
+			sha256: component.sha256.toLowerCase(),
+			source: source.kind === 'url' ? source.url : source.path,
+			installedAt: new Date().toISOString()
+		};
+		const written = await sh('printf %s "$1" > "$2"', JSON.stringify(marker), markerPath(installed.payloadDir));
+		if (written.code !== 0) {
+			throw new Error(`Could not write the payload marker in ${installed.payloadDir}: ${written.stderr}`);
+		}
+		await remember(id, { version: component.version, payloadDir: installed.payloadDir });
+		return { payloadDir: installed.payloadDir, version: component.version, source };
+	}
+
+	/** @param {any} marker */
+	function sourceOfMarker(marker) {
+		if (!marker || typeof marker.source !== 'string') {
+			return undefined;
+		}
+		return /^https?:\/\//.test(marker.source)
+			? { kind: 'url', url: marker.source }
+			: { kind: 'file', path: marker.source };
+	}
+
+	/** @param {string} id */
+	async function uninstall(id) {
+		const component = componentOf(id);
+		await sh('rm -rf "$1"', joinPath(payloadRoot, `picket-${component.version}`));
+		await remember(id, undefined);
+	}
+
+	/**
+	 * Payloads this build can still run are never removed; the rest keep only
+	 * the newest `keep`, so an upgrade does not leave every old server behind.
+	 * @param {number} keep
+	 * @returns {Promise<string[]>} removed directory names
+	 */
+	async function cleanup(keep) {
+		const dirs = await listServerDirs();
+		/** @type {Set<string>} */
+		const live = new Set();
+		for (const dir of dirs) {
+			const marker = await readMarker(dir);
+			if (marker && (want().anyCommit || marker.commit === want().commit) && atLeastMinimum(marker.version)) {
+				live.add(dir);
+			}
+		}
+		const gone = dirs.filter(dir => !live.has(dir)).slice(keep);
+		for (const dir of gone) {
+			await sh('rm -rf "$1"', dir);
+		}
+		return gone.map(dir => dir.slice(dir.lastIndexOf('/') + 1));
+	}
+
+	async function list() {
+		const components = Array.isArray(catalog?.components) ? catalog.components : [];
+		/** @type {Array<{ id: string, state: string, version?: string, payloadDir?: string }>} */
+		const rows = [];
+		for (const component of components) {
+			const inspected = await inspect(component.id);
+			rows.push({ id: component.id, state: inspected.state, version: inspected.version, payloadDir: inspected.payloadDir });
+		}
+		return rows;
+	}
+
+	/** @param {string} id @param {any} value */
+	async function remember(id, value) {
+		if (!options.statePath) {
+			return;
+		}
+		let cache = {};
+		try {
+			cache = JSON.parse(await readFile(options.statePath, 'utf8'));
+		} catch {
+			cache = {};
+		}
+		cache[id] = value;
+		try {
+			await writeFile(options.statePath, JSON.stringify(cache, null, '\t'));
+		} catch {
+			// The cache is a convenience; the distro is authoritative.
+		}
+	}
+
+	return { inspect, ensure, uninstall, cleanup, list, markerPath, payloadRoot };
+}
+
+module.exports = { createComponentManager, markerPath };
