index 00000000..93979e6f
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/launch.js
@@ -0,0 +1,351 @@
+'use strict';
+
+const { randomBytes } = require('node:crypto');
+
+/** @typedef {{ port: number, token: string, tag: string, pid: number, startedAt: string, tunnelMode?: string, icode?: string }} IRuntimeInfo */
+
+/**
+ * Sourced inside the distro before the binary starts: the login shell has by
+ * then applied the user's profile, so `PATH`, `NVM_DIR`, `BUN_INSTALL` and
+ * friends are what an interactive shell would see. Every value arrives as an
+ * argv entry, so nothing here is ever re-parsed by a shell.
+ */
+const LAUNCH_SCRIPT = 'setup="$1"; icode="$2"; shift 2; [ -f "$setup" ] && . "$setup"; [ -n "$icode" ] && export PICKET_ICODE_BIN="$icode"; exec "$0" "$@"';
+
+/** @type {readonly string[]} */
+const SERVER_FLAGS = [
+	'--host=127.0.0.1',
+	'--port=0',
+	'--use-host-proxy',
+	'--without-browser-env-var',
+	'--disable-websocket-compression',
+	'--accept-server-license-terms'
+];
+
+/**
+ * @param {string} home
+ * @param {string} tag
+ */
+function serverPaths(home, tag) {
+	const root = `${home}/.picket-code-server`;
+	const payloadDir = `${root}/payloads/server-${tag}`;
+	return {
+		root,
+		payloadDir,
+		binary: `${payloadDir}/bin/picket-code-server`,
+		remoteCli: `${payloadDir}/bin/remote-cli/picket-code`,
+		cliLink: `${home}/.local/bin/picket-code`,
+		dataDir: `${root}/data`,
+		extensionsDir: `${root}/extensions`,
+		logDir: `${root}/logs`,
+		runtimeDir: `${root}/runtime`,
+		envSetupFile: `${root}/server-env-setup`
+	};
+}
+
+/**
+ * One server per distro, so one record per distro: two distros must not be able
+ * to overwrite each other's port and token.
+ * @param {string} home
+ * @param {string} distro
+ */
+function runtimeFileFor(home, distro) {
+	return `${home}/.picket-code-server/runtime/${distro}.json`;
+}
+
+/**
+ * @param {{ paths: ReturnType<typeof serverPaths>, connectionToken: string, icodeBin?: string, distro: string }} options
+ * @returns {string[]}
+ */
+function buildServerArgs(options) {
+	const { paths, connectionToken, icodeBin, distro } = options;
+	const flags = SERVER_FLAGS.flatMap(flag => flag === '--port=0' ? [flag, `--connection-token=${connectionToken}`] : [flag]);
+	return [
+		'-d', distro, '-e', 'sh', '-lc', LAUNCH_SCRIPT, paths.binary, paths.envSetupFile, icodeBin ?? '',
+		...flags,
+		`--user-data-dir=${paths.dataDir}`,
+		`--extensions-dir=${paths.extensionsDir}`,
+		'--log=trace'
+	];
+}
+
+/**
+ * The server picks its own port (`--port=0`) and announces it once. Profile
+ * banners and warnings are expected around the line, so only an exact match
+ * to the first announcement counts.
+ */
+function createPortParser() {
+	return {
+		port: /** @type {number | undefined} */ (undefined),
+		/** @param {string} text */
+		feed(text) {
+			if (this.port !== undefined) {
+				return;
+			}
+			const match = /Extension host agent listening on (\d+)/.exec(text);
+			if (match) {
+				this.port = Number(match[1]);
+			}
+		}
+	};
+}
+
+function newConnectionToken() {
+	return randomBytes(32).toString('base64url');
+}
+
+/**
+ * @param {any} runner
+ * @param {string} distro
+ * @param {string} runtimeFile
+ * @returns {Promise<IRuntimeInfo | undefined>}
+ */
+async function readRuntime(runner, distro, runtimeFile) {
+	const read = await runner.exec(['-d', distro, '-e', 'sh', '-c', 'cat "$1" 2>/dev/null || true', 'sh', runtimeFile]);
+	const text = String(read.stdout).trim();
+	if (!text) {
+		return undefined;
+	}
+	try {
+		const info = JSON.parse(text);
+		return typeof info?.port === 'number' ? info : undefined;
+	} catch {
+		return undefined;
+	}
+}
+
+/**
+ * A crash leaves the lock directory behind. Its age is what separates "another
+ * window is starting" from "a start died before it could clean up".
+ * @param {any} runner
+ * @param {string} distro
+ * @param {string} runtimeFile
+ * @returns {Promise<number | undefined>} age in milliseconds, or undefined when the lock is gone or unreadable
+ */
+async function lockAgeMs(runner, distro, runtimeFile) {
+	const result = await runner.exec(['-d', distro, '-e', 'sh', '-c', 'stat -c %Y "$1" 2>/dev/null || true', 'sh', `${runtimeFile}.lock`]);
+	const seconds = Number(String(result.stdout).trim());
+	return Number.isFinite(seconds) && seconds > 0 ? Date.now() - seconds * 1000 : undefined;
+}
+
+/**
+ * @param {any} runner
+ * @param {string} distro
+ * @param {string} runtimeFile
+ * @returns {Promise<boolean>} true when a start is in progress somewhere
+ */
+async function isStartLocked(runner, distro, runtimeFile) {
+	const lock = await runner.exec(['-d', distro, '-e', 'sh', '-c', 'if [ -e "$1" ]; then printf 1; else printf 0; fi', 'sh', `${runtimeFile}.lock`]);
+	return String(lock.stdout).trim() !== '0';
+}
+
+/**
+ * `mkdir` is the atomic primitive every POSIX filesystem has: exactly one of two
+ * racing windows gets a zero exit. A read of the runtime file only happens when
+ * no lock is held, so a second window never adopts a record that is about to be
+ * replaced.
+ * @param {any} runner
+ * @param {string} distro
+ * @param {string} runtimeFile
+ * @returns {Promise<IRuntimeInfo | undefined>}
+ */
+async function lockAndRead(runner, distro, runtimeFile) {
+	if (await isStartLocked(runner, distro, runtimeFile)) {
+		return undefined;
+	}
+	return readRuntime(runner, distro, runtimeFile);
+}
+
+/**
+ * @param {any} runner
+ * @param {string} distro
+ * @param {string} runtimeFile
+ * @returns {Promise<boolean>} true when this caller owns the lock
+ */
+async function acquireLock(runner, distro, runtimeFile) {
+	const taken = await runner.exec(['-d', distro, '-e', 'sh', '-c', 'mkdir "$1" 2>/dev/null', 'sh', `${runtimeFile}.lock`]);
+	return taken.code === 0;
+}
+
+/**
+ * @param {any} runner
+ * @param {string} distro
+ * @param {string} runtimeFile
+ */
+async function releaseLock(runner, distro, runtimeFile) {
+	await runner.exec(['-d', distro, '-e', 'sh', '-c', 'rmdir "$1" 2>/dev/null || rm -rf "$1"', 'sh', `${runtimeFile}.lock`]);
+}
+
+/**
+ * @param {any} runner
+ * @param {string} runtimeFile
+ * @param {IRuntimeInfo} info
+ * @param {string} distro
+ */
+async function writeRuntime(runner, runtimeFile, info, distro) {
+	const json = JSON.stringify(info);
+	await runner.exec(['-d', distro, '-e', 'sh', '-c', 'mkdir -p "$(dirname "$1")" && printf %s "$2" > "$1.tmp" && mv "$1.tmp" "$1"', 'sh', runtimeFile, json]);
+}
+
+/**
+ * @param {any} runner
+ * @param {string} runtimeFile
+ * @param {string} distro
+ */
+async function clearRuntime(runner, runtimeFile, distro) {
+	// The lock is a directory, so only `rm -rf` can clear a stale one.
+	await runner.exec(['-d', distro, '-e', 'sh', '-c', 'rm -rf "$1" "$1.lock"', 'sh', runtimeFile]);
+}
+
+/**
+ * @param {string[]} args
+ * @param {string} prefix
+ * @returns {string | undefined}
+ */
+function argValue(args, prefix) {
+	const index = args.findIndex(a => a.startsWith(prefix));
+	return index === -1 ? undefined : args[index].slice(prefix.length);
+}
+
+/**
+ * @param {{ runner: any, distro: string, args: string[], runtimeFile: string, timeoutMs?: number, extra?: Record<string, unknown>, log?: { info(...parts: unknown[]): void, error(...parts: unknown[]): void }, writeRuntime?: typeof writeRuntime }} options
+ * @returns {Promise<IRuntimeInfo>}
+ */
+async function startServer(options) {
+	const { runner, distro, args, runtimeFile } = options;
+	const timeoutMs = options.timeoutMs ?? 90000;
+	const log = options.log ?? { info() { }, error() { } };
+	const persist = options.writeRuntime ?? writeRuntime;
+	const token = argValue(args, '--connection-token=') ?? '';
+	const tag = /payloads\/server-([^/]+)\/bin\//.exec(args[6] ?? args.join(' '))?.[1] ?? '';
+
+	return new Promise((resolve, reject) => {
+		const { child, stdout, stderr } = runner.spawn(args);
+		const parser = createPortParser();
+		/** @type {string[]} */
+		const tail = [];
+		let settled = false;
+
+		const timer = setTimeout(() => {
+			if (settled) {
+				return;
+			}
+			settled = true;
+			child.kill();
+			const last = tail.slice(-40).join('\n');
+			reject(new Error(`Start timed out after ${formatMs(timeoutMs)}${last ? `:\n${last}` : ''}`));
+		}, timeoutMs);
+		timer.unref?.();
+
+		/** @param {Buffer | string} chunk */
+		const onChunk = (chunk) => {
+			const text = String(chunk);
+			for (const line of text.split(/\r?\n/)) {
+				if (line.trim()) {
+					tail.push(line.trim());
+					if (tail.length > 40) {
+						tail.shift();
+					}
+					log.info(`[server] ${line.trim()}`);
+				}
+			}
+			parser.feed(text);
+			if (parser.port !== undefined && !settled) {
+				settled = true;
+				clearTimeout(timer);
+				/** @type {IRuntimeInfo} */
+				const info = { port: parser.port, token, tag, pid: child.pid ?? -1, startedAt: new Date().toISOString(), ...(options.extra ?? {}) };
+				void persist(runner, runtimeFile, info, distro).catch((error) => log.error(`Could not write ${runtimeFile}: ${error.message}`));
+				resolve(info);
+			}
+		};
+		stdout?.on('data', onChunk);
+		stderr?.on('data', onChunk);
+
+		child.on('error', (error) => {
+			if (settled) {
+				return;
+			}
+			settled = true;
+			clearTimeout(timer);
+			reject(error);
+		});
+		child.on('close', ( /** @type {number | null} */ code) => {
+			if (settled) {
+				return;
+			}
+			settled = true;
+			clearTimeout(timer);
+			const last = tail.slice(-40).join('\n');
+			if (code === 99) {
+				reject(new Error(`WSL 1 or an unsupported distro cannot run the server (exit 99). Convert with "wsl --set-version <distro> 2".${last ? `\n${last}` : ''}`));
+				return;
+			}
+			reject(new Error(`Server exited with code ${code}${last ? `:\n${last}` : ''}`));
+		});
+	});
+}
+
+/** @param {number} ms */
+function formatMs(ms) {
+	return ms % 1000 === 0 ? `${ms / 1000} s` : `${ms} ms`;
+}
+
+/**
+ * Best effort and in a fixed order: TERM, wait, probe, KILL, sweep, forget.
+ * A failure at one step must not stop the next — a stale server is worse than
+ * a noisy log.
+ * @param {{ runner: any, distro: string, runtimeFile: string, info: IRuntimeInfo, log?: any, probe?: (info: IRuntimeInfo) => Promise<string>, waitMs?: number, dataDir?: string }} options
+ */
+async function stopServer(options) {
+	const { runner, distro, runtimeFile, info } = options;
+	const log = options.log ?? { info() { }, error() { } };
+	const probe = options.probe;
+	const waitMs = options.waitMs ?? 5000;
+
+	const step = async (name, fn) => {
+		try {
+			await fn();
+			log.info(`stop: ${name} ok`);
+		} catch (error) {
+			log.error(`stop: ${name} failed: ${error.message}`);
+		}
+	};
+
+	await step('SIGTERM', () => runner.exec(['-d', distro, '-e', 'kill', '-TERM', String(info.pid)]));
+	await step('wait', () => new Promise(resolve => setTimeout(resolve, waitMs)));
+	if (probe) {
+		await step('probe', async () => {
+			if (await probe(info) === 'dead') {
+				log.info('stop: server is gone');
+				return;
+			}
+			throw new Error('still answering');
+		});
+	}
+	await step('SIGKILL', () => runner.exec(['-d', distro, '-e', 'sh', '-c', 'kill -9 "$1" 2>/dev/null || true', 'sh', String(info.pid)]));
+	if (options.dataDir) {
+		await step('sweep', () => runner.exec(['-d', distro, '-e', 'sh', '-c', 'pkill -f "picket-code-server.*--user-data-dir=$1" 2>/dev/null || true', 'sh', options.dataDir]));
+	}
+	await step('clear runtime', () => clearRuntime(runner, runtimeFile, distro));
+}
+
+module.exports = {
+	LAUNCH_SCRIPT,
+	SERVER_FLAGS,
+	serverPaths,
+	runtimeFileFor,
+	buildServerArgs,
+	createPortParser,
+	newConnectionToken,
+	readRuntime,
+	lockAgeMs,
+	isStartLocked,
+	lockAndRead,
+	acquireLock,
+	releaseLock,
+	writeRuntime,
+	clearRuntime,
+	startServer,
+	stopServer
+};
diff --git a/extensions/picket-remote-wsl/src/log.js b/extensions/picket-remote-wsl/src/log.js
new file mode 100644
index 00000000..918896a0
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/log.js
@@ -0,0 +1,45 @@
+'use strict';
+
+const vscode = require('vscode');
+const { appendFile, mkdir } = require('node:fs/promises');
+const { dirname, join } = require('node:path');
+
+/**
+ * Two sinks so a user can read the log in the editor and a supporter can ask
+ * for a file: the OutputChannel is live, the file survives a closed window.
+ * @param {vscode.ExtensionContext} context
+ */
+function createLog(context) {
+	const channel = vscode.window.createOutputChannel('Picket WSL');
+	const file = join(context.logUri.fsPath, 'picket-wsl.log');
+	context.subscriptions.push(channel);
+
+	/** @param {unknown[]} parts */
+	function write(parts) {
+		const line = parts.map(p => (typeof p === 'string' ? p : String(p))).join(' ');
+		channel.appendLine(line);
+		void mkdir(dirname(file), { recursive: true })
+			.then(() => appendFile(file, `${new Date().toISOString()} ${line}\n`))
+			.catch(() => { /* the channel already has it; a log file failure must not throw */ });
+	}
+
+	return {
+		/** @param {...unknown} parts */
+		info(...parts) {
+			write(parts);
+		},
+		/** @param {...unknown} parts */
+		error(...parts) {
+			write(['ERROR', ...parts]);
+		},
+		show() {
+			channel.show(true);
+		},
+		dispose() {
+			channel.dispose();
+		},
+		logFile: file
+	};
+}
+
+module.exports = { createLog };
diff --git a/extensions/picket-remote-wsl/src/payload.js b/extensions/picket-remote-wsl/src/payload.js
new file mode 100644
index 00000000..62602222
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/payload.js
@@ -0,0 +1,157 @@
+'use strict';
+
+const { createHash, randomBytes } = require('node:crypto');
+const { readFile, stat } = require('node:fs/promises');
+
+/**
+ * @typedef {{ kind: 'file', path: string } | { kind: 'embedded', path: string } | { kind: 'url', url: string }} ISource
+ * @typedef {{ id: string, kind: 'server' | 'extensions', version: string, file: string, size: number, sha256: string, embedded: boolean, embeddedPath?: string }} IComponent
+ */
+
+/**
+ * `sha256sum` writes two spaces, `shasum -a 256` writes one; some tools add a
+ * binary marker. Anything else on the line is junk from a merged log.
+ * @param {string} text
+ * @returns {Map<string, string>}
+ */
+function parseSha256Sums(text) {
+	/** @type {Map<string, string>} */
+	const sums = new Map();
+	for (const line of text.split(/\r?\n/)) {
+		const match = /^([0-9a-fA-F]{64})\s+\*?(.+)$/.exec(line.trim());
+		if (match) {
+			sums.set(match[2].trim(), match[1].toLowerCase());
+		}
+	}
+	return sums;
+}
+
+/**
+ * Three sources, in the order a user would expect them to win: a file they
+ * pointed at, the copy shipped inside the build, then the configured mirror.
+ * @param {IComponent} component
+ * @param {{ explicitPath?: string, embeddedDir?: string, baseUrl?: string, exists?: (path: string) => Promise<boolean> }} options
+ * @returns {Promise<ISource>}
+ */
+async function chooseSource(component, options) {
+	const exists = options.exists ?? (async (path) => {
+		try {
+			return (await stat(path)).isFile();
+		} catch {
+			return false;
+		}
+	});
+
+	if (options.explicitPath && await exists(options.explicitPath)) {
+		return { kind: 'file', path: options.explicitPath };
+	}
+	if (options.embeddedDir) {
+		const embedded = joinPath(options.embeddedDir, component.file);
+		if (await exists(embedded)) {
+			return { kind: 'embedded', path: embedded };
+		}
+	}
+	if (options.baseUrl) {
+		return { kind: 'url', url: `${options.baseUrl.replace(/\/+$/, '')}/${component.file}` };
+	}
+	throw new Error(`No source for ${component.id}: explicit path missing, no embedded payload, and no base URL configured`);
+}
+
+/** @param {string} a @param {string} b */
+function joinPath(a, b) {
+	return `${a.replace(/[\\/]+$/, '')}/${b}`;
+}
+
+/**
+ * @param {string} path
+ * @returns {Promise<string>}
+ */
+async function sha256OfFile(path) {
+	return createHash('sha256').update(await readFile(path)).digest('hex');
+}
+
+/**
+ * @param {Buffer} bytes
+ * @returns {string}
+ */
+function sha256OfBuffer(bytes) {
+	return createHash('sha256').update(bytes).digest('hex');
+}
+
+/**
+ * Downloads a payload, reporting progress without flooding the caller.
+ * @param {string} url
+ * @param {{ fetchImpl?: typeof fetch, onProgress?: (progress: { downloaded: number, total: number }) => void }} options
+ * @returns {Promise<Buffer>}
+ */
+async function download(url, options) {
+	const fetchImpl = options.fetchImpl ?? globalThis.fetch;
+	const response = await fetchImpl(url);
+	if (!response.ok) {
+		throw new Error(`Download failed for ${url}: HTTP ${response.status}`);
+	}
+	const total = Number(response.headers.get('content-length') ?? 0);
+	const onProgress = options.onProgress;
+	let downloaded = 0;
+	let lastReport = 0;
+	/** @type {Buffer[]} */
+	const chunks = [];
+	if (response.body) {
+		for await (const chunk of /** @type {any} */ (response.body)) {
+			const buf = Buffer.from(chunk);
+			chunks.push(buf);
+			downloaded += buf.length;
+			const now = Date.now();
+			if (onProgress && now - lastReport >= 100) {
+				lastReport = now;
+				onProgress({ downloaded, total });
+			}
+		}
+	} else {
+		const buf = Buffer.from(await response.arrayBuffer());
+		chunks.push(buf);
+		downloaded = buf.length;
+	}
+	onProgress?.({ downloaded, total: total || downloaded });
+	return Buffer.concat(chunks);
+}
+
+/**
+ * Verifies on the Windows side, then extracts inside the distro by piping the
+ * archive to `tar -xzf -` over stdin: no temporary copy inside the VM, and a
+ * half-written directory can never be mistaken for an install.
+ *
+ * The archive must be flat at its root (`bin/`, `out/`, `product.json`), which
+ * Task 12 asserts when it packages the payload.
+ * @param {{ runner: any, distro: string, component: IComponent, source: ISource, payloadRoot: string, fetchImpl?: typeof fetch, onProgress?: (progress: { downloaded: number, total: number }) => void }} options
+ * @returns {Promise<{ payloadDir: string, source: ISource }>}
+ */
+async function installPayload(options) {
+	const { runner, distro, component, source, payloadRoot } = options;
+	const bytes = source.kind === 'url'
+		? await download(source.url, { fetchImpl: options.fetchImpl, onProgress: options.onProgress })
+		: await readFile(source.path);
+
+	const actual = sha256OfBuffer(bytes);
+	if (actual !== component.sha256.toLowerCase()) {
+		throw new Error(`Checksum mismatch for ${component.file}: expected ${component.sha256.toLowerCase()}, got ${actual}`);
+	}
+
+	const finalDir = `${payloadRoot}/server-${component.version}`;
+	const tmpDir = `${payloadRoot}/.tmp-${randomBytes(4).toString('hex')}`;
+
+	const prepare = await runner.exec(['-d', distro, '-e', 'sh', '-c', 'mkdir -p "$1" && rm -rf "$2"', 'sh', payloadRoot, tmpDir]);
+	if (prepare.code !== 0) {
+		throw new Error(`Could not prepare ${payloadRoot} in ${distro}: ${prepare.stderr}`);
+	}
+	const unpack = await runner.exec(
+		['-d', distro, '-e', 'sh', '-c', 'rm -rf "$2" && tar -xzf - -C "$1" && mv "$1" "$2"', 'sh', tmpDir, finalDir],
+		{ input: bytes }
+	);
+	if (unpack.code !== 0) {
+		throw new Error(`Could not unpack ${component.file} in ${distro}: ${unpack.stderr}`);
+	}
+	return { payloadDir: finalDir, source };
+}
+
+module.exports = { parseSha256Sums, chooseSource, sha256OfFile, installPayload };
diff --git a/extensions/picket-remote-wsl/src/preflight.js b/extensions/picket-remote-wsl/src/preflight.js
new file mode 100644
index 00000000..8450e077
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/preflight.js
@@ -0,0 +1,81 @@
+'use strict';
+
+const { readFile } = require('node:fs/promises');
+const { homedir } = require('node:os');
+const { join } = require('node:path');
+
+/**
+ * Only `[wsl2]` matters here, and only two keys of it. Everything else in the
+ * file belongs to other WSL features; reading more would invite acting on
+ * settings this extension does not own.
+ * @param {string} text
+ * @returns {{ localhostForwarding?: boolean, networkingMode?: string }}
+ */
+function parseWslConfig(text) {
+	/** @type {{ localhostForwarding?: boolean, networkingMode?: string }} */
+	const config = {};
+	let section = '';
+	for (const raw of String(text ?? '').split(/\r?\n/)) {
+		const line = raw.trim();
+		if (line.length === 0 || line.startsWith('#') || line.startsWith(';')) {
+			continue;
+		}
+		const header = /^\[(.+)\]$/.exec(line);
+		if (header) {
+			section = header[1].trim().toLowerCase();
+			continue;
+		}
+		if (section !== 'wsl2') {
+			continue;
+		}
+		const separator = line.indexOf('=');
+		if (separator === -1) {
+			continue;
+		}
+		const key = line.slice(0, separator).trim().toLowerCase();
+		const value = line.slice(separator + 1).trim();
+		if (key === 'localhostforwarding') {
+			config.localhostForwarding = /^true$/i.test(value);
+		} else if (key === 'networkingmode') {
+			config.networkingMode = value.toLowerCase();
+		}
+	}
+	return config;
+}
+
+/**
+ * Direct is the fast path and the normal case. It stops working exactly when
+ * Windows no longer owns `127.0.0.1` for the VM — disabled localhost forwarding
+ * or mirrored networking — and then a pipe is the only way in.
+ * @param {{ configured?: string, wslConfig?: { localhostForwarding?: boolean, networkingMode?: string }, platform?: string }} options
+ * @returns {'direct' | 'stdio'}
+ */
+function chooseTunnelMode(options) {
+	const configured = options.configured ?? 'auto';
+	if (configured === 'direct' || configured === 'stdio') {
+		return configured;
+	}
+	if ((options.platform ?? process.platform) !== 'win32') {
+		return 'direct';
+	}
+	const config = options.wslConfig ?? {};
+	if (config.localhostForwarding === false || config.networkingMode === 'mirrored') {
+		return 'stdio';
+	}
+	return 'direct';
+}
+
+/** @param {string} path */
+async function readWslConfigFile(path) {
+	try {
+		return parseWslConfig(await readFile(path, 'utf8'));
+	} catch {
+		return {};
+	}
+}
+
+function wslConfigPath() {
+	return join(homedir(), '.wslconfig');
+}
+
+module.exports = { parseWslConfig, chooseTunnelMode, readWslConfigFile, wslConfigPath };
diff --git a/extensions/picket-remote-wsl/src/probe.js b/extensions/picket-remote-wsl/src/probe.js
new file mode 100644
index 00000000..59ade20e
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/probe.js
@@ -0,0 +1,33 @@
+'use strict';
+
+/**
+ * The server has no health endpoint; asking for a resource without a valid
+ * token is the cheapest question it answers. A 400 means "reachable and the
+ * token was accepted" (the request itself is malformed on purpose), a 4xx
+ * auth status means the token is wrong, and anything else is dead.
+ * @param {{ host: string, port: number, token: string, timeoutMs?: number, fetchImpl?: typeof fetch }} options
+ * @returns {Promise<'alive' | 'bad-token' | 'dead'>}
+ */
+async function probeServer(options) {
+	const timeoutMs = options.timeoutMs ?? 2000;
+	const fetchImpl = options.fetchImpl ?? globalThis.fetch;
+	const controller = new AbortController();
+	const timer = setTimeout(() => controller.abort(), timeoutMs);
+	timer.unref?.();
+	try {
+		const response = await fetchImpl(`http://${options.host}:${options.port}/vscode-remote-resource?tkn=${encodeURIComponent(options.token)}`, { signal: controller.signal });
+		if (response.status === 400 || response.status === 200) {
+			return 'alive';
+		}
+		if (response.status === 401 || response.status === 403) {
+			return 'bad-token';
+		}
+		return 'dead';
+	} catch {
+		return 'dead';
+	} finally {
+		clearTimeout(timer);
+	}
+}
+
+module.exports = { probeServer };
diff --git a/extensions/picket-remote-wsl/src/remoteUri.js b/extensions/picket-remote-wsl/src/remoteUri.js
new file mode 100644
index 00000000..f736d42b
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/remoteUri.js
@@ -0,0 +1,81 @@
+'use strict';
+
+const { decodeWslOutput } = require('./distro.js');
+
+const AUTHORITY_PREFIX = 'picket-wsl';
+
+/**
+ * `picket-wsl+Ubuntu 22.04 LTS` -> `Ubuntu 22.04 LTS`. An empty distro means
+ * "the default distro"; any other authority is not ours.
+ * @param {string} authority
+ * @returns {string}
+ */
+function parseAuthority(authority) {
+	if (!authority.startsWith(`${AUTHORITY_PREFIX}+`)) {
+		return '';
+	}
+	return authority.slice(AUTHORITY_PREFIX.length + 1);
+}
+
+/**
+ * @param {string} distro
+ * @param {string} posixPath
+ */
+function remoteUriFor(distro, posixPath) {
+	return { scheme: /** @type {const} */ ('vscode-remote'), authority: `${AUTHORITY_PREFIX}+${distro}`, path: posixPath };
+}
+
+/**
+ * `\\wsl.localhost\<distro>\<posix>` and `\\wsl$\<distro>\<posix>` both name the
+ * same directory; Windows hands either spelling to a file dialog.
+ * @param {string} path
+ * @returns {{ distro: string, posixPath: string } | undefined}
+ */
+function parseUncPath(path) {
+	const normalized = path.replace(/\\/g, '/');
+	const match = /^\/\/(wsl\.localhost|wsl\$)\/([^/]+)(\/.*)?$/.exec(normalized);
+	if (!match) {
+		return undefined;
+	}
+	const rest = (match[3] ?? '/').replace(/\/+$/, '');
+	return { distro: match[2], posixPath: rest.length === 0 ? '/' : rest };
+}
+
+/**
+ * The only place a Windows path becomes a Linux one: `wslpath` owns the mapping
+ * (`C:\` -> `/mnt/c`, drvfs mounts, `$HOME`-relative shortcuts), and guessing it
+ * would be wrong on exactly the machines that need it most.
+ * @param {string} flag
+ * @param {import('./distro.js').IWslRunner} runner
+ * @param {string} distro
+ * @param {string} path
+ * @returns {Promise<string>}
+ */
+async function wslpath(flag, runner, distro, path) {
+	const result = await runner.exec(['-d', distro, '-e', 'wslpath', flag, path]);
+	const stdout = decodeWslOutput(result.stdout);
+	if (result.code !== 0 || stdout.length === 0) {
+		throw new Error(`wslpath failed: ${decodeWslOutput(result.stderr) || `exit code ${result.code}`}`);
+	}
+	return stdout.split('\n')[0];
+}
+
+/**
+ * @param {import('./distro.js').IWslRunner} runner
+ * @param {string} distro
+ * @param {string} windowsPath
+ */
+function toPosixPath(runner, distro, windowsPath) {
+	return wslpath('-u', runner, distro, windowsPath);
+}
+
+/**
+ * @param {import('./distro.js').IWslRunner} runner
+ * @param {string} distro
+ * @param {string} posixPath
+ */
+function toWindowsPath(runner, distro, posixPath) {
+	return wslpath('-w', runner, distro, posixPath);
+}
+
+module.exports = { AUTHORITY_PREFIX, parseAuthority, remoteUriFor, parseUncPath, toPosixPath, toWindowsPath };
diff --git a/extensions/picket-remote-wsl/src/resolver.js b/extensions/picket-remote-wsl/src/resolver.js
new file mode 100644
index 00000000..cad3f9b8
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/resolver.js
@@ -0,0 +1,252 @@
+'use strict';
+
+const { listDistros, defaultDistro, visibleDistros, distroHome } = require('./distro.js');
+const { serverPaths, runtimeFileFor, buildServerArgs, newConnectionToken, lockAndRead, readRuntime, lockAgeMs, isStartLocked, acquireLock, releaseLock, writeRuntime, clearRuntime, startServer, stopServer } = require('./launch.js');
+const { probeServer } = require('./probe.js');
+const { parseAuthority } = require('./remoteUri.js');
+const { detectIcode } = require('./icode.js');
+const { chooseTunnelMode, readWslConfigFile, wslConfigPath } = require('./preflight.js');
+
+/** @typedef {{ port: number, token: string, tag: string, pid: number, startedAt: string, tunnelMode?: string, icode?: string }} IRuntimeInfo */
+/** @typedef {{ host: string, port: number, connectionToken: string }} IResolverResult */
+/** @typedef {{ info(...parts: unknown[]): void, error(...parts: unknown[]): void }} ILog */
+/** @typedef {{ ensure(id: string): Promise<{ payloadDir: string }> }} IComponentManager */
+/** @typedef {{ startTimeoutSeconds?: number, probeRetrySeconds?: number, icodePath?: string, tunnelMode?: string }} ISettings */
+
+/**
+ * A remote authority names a distro and nothing else; everything a connection
+ * needs (port, token) is discovered by starting or adopting the one server that
+ * distro is allowed to run.
+ * @param {{
+ *   runner: any,
+ *   catalog: any,
+ *   components: (ctx: { distro: string, home: string, runner: any }) => IComponentManager,
+ *   settings: ISettings,
+ *   log: ILog,
+ *   platform?: string,
+ *   readWslConfig?: () => Promise<{ localhostForwarding?: boolean, networkingMode?: string }>,
+ *   warn?: (message: string) => void,
+ *   startServer?: typeof startServer,
+ *   stopServer?: typeof stopServer,
+ *   probe?: (target: { host: string, port: number, token: string }) => Promise<'alive' | 'bad-token' | 'dead'>
+ * }} options
+ */
+function createResolver(options) {
+	const { runner, catalog, components, log } = options;
+	const settings = options.settings ?? {};
+	const start = options.startServer ?? startServer;
+	const stop = options.stopServer ?? stopServer;
+	const probe = options.probe ?? (target => probeServer(target));
+	const platform = options.platform ?? process.platform;
+	const readWslConfig = options.readWslConfig ?? (() => readWslConfigFile(wslConfigPath()));
+	const warn = options.warn ?? (() => { });
+	/** @type {Map<string, Promise<IResolverResult>>} */
+	const inFlight = new Map();
+	/** @type {Set<string>} */
+	const warned = new Set();
+
+	/** @param {string} key @param {string} message */
+	function warnOnce(key, message) {
+		if (warned.has(key)) {
+			return;
+		}
+		warned.add(key);
+		warn(message);
+	}
+
+	function serverVersion() {
+		const component = Array.isArray(catalog?.components) ? catalog.components.find((/** @type {any} */ c) => c.id === 'wsl-server') : undefined;
+		if (!component?.version) {
+			throw new Error('The component catalog has no wsl-server entry; this build cannot start a WSL server');
+		}
+		return String(component.version);
+	}
+
+	/**
+	 * @param {string} requested an authority's distro, possibly '' or differently cased
+	 * @returns {Promise<string>} the name wsl.exe answers to
+	 */
+	async function resolveDistroName(requested) {
+		const list = await listDistros(runner);
+		if (!requested) {
+			return defaultDistro(list);
+		}
+		const wanted = requested.trim().toLowerCase();
+		const match = list.find(d => d.name.toLowerCase() === wanted);
+		if (match) {
+			return match.name;
+		}
+		const known = visibleDistros(list).map(d => d.name).join(', ') || 'none';
+		throw new Error(`Distro "${requested}" not found. Installed: ${known}`);
+	}
+
+	/** @param {IRuntimeInfo} info @returns {IResolverResult} */
+	function coordinates(info) {
+		return { host: '127.0.0.1', port: info.port, connectionToken: info.token };
+	}
+
+	/** @param {string} distro @returns {Promise<IResolverResult>} */
+	async function adoptOrStart(distro) {
+		const home = await distroHome(runner, distro);
+		const version = serverVersion();
+		const paths = serverPaths(home, version);
+		const runtimeFile = runtimeFileFor(home, distro);
+
+		const stored = await lockAndRead(runner, distro, runtimeFile);
+		if (stored && stored.tag === version) {
+			const verdict = await probe({ host: '127.0.0.1', port: stored.port, token: stored.token });
+			if (verdict === 'alive') {
+				log.info(`Reusing ${paths.binary} on port ${stored.port} for ${distro}`);
+				return coordinates(stored);
+			}
+			log.info(`The recorded server for ${distro} answered "${verdict}"; starting a new one`);
+		}
+
+		const acquired = await acquireLock(runner, distro, runtimeFile) || await takeOverStaleLock(distro, runtimeFile);
+		if (!acquired) {
+			// Another window owns the lock; its server is the one we want.
+			const adopted = await waitForServer(distro, runtimeFile, version);
+			if (adopted) {
+				log.info(`Another window started the server for ${distro} on port ${adopted.port}; adopting it`);
+				return coordinates(adopted);
+			}
+			throw new Error(`Another window is starting the server for ${distro}, but it did not appear within ${formatSeconds(timeoutMs())}`);
+		}
+
+		try {
+			await clearRuntime(runner, runtimeFile, distro).catch(error => log.error(`Could not clear ${runtimeFile}: ${error.message}`));
+			return await startFresh(distro, home);
+		} finally {
+			await releaseLock(runner, distro, runtimeFile).catch(error => log.error(`Could not release ${runtimeFile}.lock: ${error.message}`));
+		}
+	}
+
+	/** @param {number} ms */
+	function formatSeconds(ms) {
+		return ms % 1000 === 0 ? `${ms / 1000} s` : `${ms} ms`;
+	}
+
+	/**
+	 * A start that died without releasing its lock must not block every future
+	 * window for the rest of the session, so a lock older than one start timeout
+	 * is taken over. Two windows may both decide that; `mkdir` still picks one.
+	 * @param {string} distro
+	 * @param {string} runtimeFile
+	 * @returns {Promise<boolean>}
+	 */
+	async function takeOverStaleLock(distro, runtimeFile) {
+		if (!await isStartLocked(runner, distro, runtimeFile)) {
+			return acquireLock(runner, distro, runtimeFile);
+		}
+		const age = await lockAgeMs(runner, distro, runtimeFile);
+		// `stat` resolves whole seconds, so anything under one second is noise; a
+		// lock is only "stale" once it has outlived a full start window.
+		if (age === undefined || age <= Math.max(timeoutMs(), 1000)) {
+			return false;
+		}
+		log.info(`Taking over a stale start lock for ${distro} (${formatSeconds(Math.round(age))} old)`);
+		await releaseLock(runner, distro, runtimeFile).catch(error => log.error(`Could not clear the stale lock: ${error.message}`));
+		return acquireLock(runner, distro, runtimeFile);
+	}
+
+	function timeoutMs() {
+		return (settings.startTimeoutSeconds ?? 90) * 1000;
+	}
+
+	/**
+	 * @param {string} distro
+	 * @param {string} runtimeFile
+	 * @param {string} version
+	 * @returns {Promise<IRuntimeInfo | undefined>}
+	 */
+	async function waitForServer(distro, runtimeFile, version) {
+		const deadline = Date.now() + timeoutMs();
+		const interval = Math.max(10, (settings.probeRetrySeconds ?? 2) * 1000);
+		while (Date.now() < deadline) {
+			const info = await readRuntime(runner, distro, runtimeFile).catch(() => undefined);
+			if (info && info.tag === version && await probe({ host: '127.0.0.1', port: info.port, token: info.token }) === 'alive') {
+				return info;
+			}
+			await new Promise(resolve => setTimeout(resolve, Math.min(interval, Math.max(1, deadline - Date.now()))));
+		}
+		return undefined;
+	}
+
+	/**
+	 * @param {string} distro
+	 * @param {string} home
+	 * @returns {Promise<IResolverResult>}
+	 */
+	async function startFresh(distro, home) {
+		const version = serverVersion();
+		const paths = serverPaths(home, version);
+		const runtimeFile = runtimeFileFor(home, distro);
+		const manager = components({ distro, home, runner });
+		await manager.ensure('wsl-server');
+
+		const icode = await detectIcode({ runner, distro, configuredPath: settings.icodePath ?? '' });
+		if (icode.source === 'missing') {
+			warnOnce(`${distro}:icode`, 'WSL 里未找到 iCode：AI 功能不可用。设置 Picket: WSL › ICode Path 可指定路径。');
+		}
+		const tunnelMode = chooseTunnelMode({ configured: settings.tunnelMode ?? 'auto', wslConfig: await readWslConfig(), platform });
+		log.info(`Starting ${paths.binary}: tunnel=${tunnelMode}, icode=${icode.path ?? 'missing'} (${icode.source})`);
+
+		const connectionToken = newConnectionToken();
+		const args = buildServerArgs({ paths, connectionToken, distro, icodeBin: icode.path ?? '' });
+		const info = await start({
+			runner,
+			distro,
+			args,
+			runtimeFile,
+			timeoutMs: timeoutMs(),
+			extra: { tunnelMode, icode: icode.source },
+			log
+		});
+		// The start records the port the moment it parses it; writing again here
+		// keeps the promise that the lock is released only once the record on disk
+		// is readable, so a waiting window adopts this server instead of starting a
+		// second one.
+		await writeRuntime(runner, runtimeFile, info, distro)
+			.catch(error => log.error(`Could not write ${runtimeFile}: ${error.message}`));
+		return coordinates(info);
+	}
+
+	return {
+		/** @param {string} authority @returns {Promise<IResolverResult>} */
+		async resolve(authority) {
+			const distro = await resolveDistroName(parseAuthority(authority));
+			const pending = inFlight.get(distro);
+			if (pending) {
+				return pending;
+			}
+			const promise = adoptOrStart(distro).finally(() => inFlight.delete(distro));
+			inFlight.set(distro, promise);
+			return promise;
+		},
+		/** @param {string} requested @returns {Promise<void>} */
+		async stop(requested) {
+			const distro = await resolveDistroName(requested ?? '');
+			const home = await distroHome(runner, distro);
+			const runtimeFile = runtimeFileFor(home, distro);
+			const info = await lockAndRead(runner, distro, runtimeFile);
+			if (!info) {
+				log.info(`No server is recorded for ${distro}`);
+				return;
+			}
+			await stop({
+				runner,
+				distro,
+				runtimeFile,
+				info,
+				log,
+				probe: (target) => probe({ host: '127.0.0.1', port: target.port, token: target.token }),
+				dataDir: serverPaths(home, serverVersion()).dataDir
+			});
+		},
+		dispose() {
+			inFlight.clear();
+		}
+	};
+}
+
+module.exports = { createResolver };
diff --git a/extensions/picket-remote-wsl/test/catalog.test.js b/extensions/picket-remote-wsl/test/catalog.test.js
