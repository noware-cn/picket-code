+'use strict';
+
+const { join } = require('node:path');
+const vscode = require('vscode');
+const { createLog } = require('./src/log.js');
+const { loadCatalog } = require('./src/catalog.js');
+const { createWslRunner, listDistros, visibleDistros } = require('./src/distro.js');
+const { createComponentManager } = require('./src/components.js');
+const { createResolver } = require('./src/resolver.js');
+const { AUTHORITY_PREFIX, parseAuthority } = require('./src/remoteUri.js');
+const { buildDistroNodes } = require('./src/tree.js');
+const { registerCommands } = require('./src/commands.js');
+const { maybeNudge } = require('./src/nudge.js');
+
+/** @param {vscode.ExtensionContext} context */
+async function activate(context) {
+	const log = createLog(context);
+	context.subscriptions.push(log);
+
+	const catalog = await loadCatalog(context.extensionPath);
+	log.info(`Picket WSL activated (tag=${catalog.tag ?? 'none'}, flavor=${catalog.flavor}, components=${catalog.components.length})`);
+
+	context.subscriptions.push(vscode.commands.registerCommand('picket.wsl.showLog', () => log.show()));
+
+	/** @returns {vscode.WorkspaceConfiguration} */
+	const config = () => vscode.workspace.getConfiguration('picket.wsl');
+
+	// Getters, not values: a setting changed while a window is open must apply to
+	// the next connection without a reload.
+	const settings = {
+		get defaultDistro() { return config().get('defaultDistro', ''); },
+		get serverPayloadPath() { return config().get('serverPayloadPath', ''); },
+		get serverPayloadBaseUrl() { return config().get('serverPayloadBaseUrl', ''); },
+		get icodePath() { return config().get('icodePath', ''); },
+		get tunnelMode() { return config().get('tunnelMode', 'auto'); },
+		get startTimeoutSeconds() { return config().get('startTimeoutSeconds', 90); }
+	};
+
+	const runner = createWslRunner();
+
+	/**
+	 * One factory for both the resolver and the command layer: `explicitPath` is
+	 * how "install from a file I picked" reaches the component manager without
+	 * writing a setting.
+	 * @param {{ distro: string, home: string, explicitPath?: string }} target
+	 */
+	const createComponents = ({ distro, home, explicitPath }) => createComponentManager({
+		catalog,
+		runner,
+		distro,
+		home,
+		env: {
+			explicitPath: explicitPath ?? (settings.serverPayloadPath || undefined),
+			embeddedDir: catalog.flavor === 'embedded' ? join(context.extensionPath, 'resources', 'wsl-payloads') : undefined,
+			baseUrl: settings.serverPayloadBaseUrl || undefined
+		}
+	});
+
+	const resolver = createResolver({
+		runner,
+		catalog,
+		settings,
+		log,
+		warn: (message) => void vscode.window.showWarningMessage(message),
+		components: createComponents
+	});
+
+	context.subscriptions.push(vscode.workspace.registerRemoteAuthorityResolver(AUTHORITY_PREFIX, {
+		resolve: async (authority) => {
+			const result = await resolver.resolve(authority);
+			return new vscode.ResolvedAuthority(result.host, result.port, result.connectionToken);
+		}
+	}));
+	context.subscriptions.push({ dispose: () => resolver.dispose() });
+
+	const changed = new vscode.EventEmitter();
+	context.subscriptions.push(changed);
+
+	const treeProvider = {
+		onDidChangeTreeData: changed.event,
+		refresh() {
+			changed.fire(undefined);
+		},
+		/** @param {any} element */
+		async getChildren(element) {
+			if (element) {
+				return [];
+			}
+			const activeDistro = parseAuthority(vscode.env.remoteAuthority ?? '');
+			try {
+				return buildDistroNodes(visibleDistros(await listDistros(runner)), { activeDistro });
+			} catch (error) {
+				log.error(`Could not list WSL distros: ${error.message}`);
+				return [];
+			}
+		},
+		/** @param {any} node */
+		getTreeItem(node) {
+			const item = new vscode.TreeItem(node.label, vscode.TreeItemCollapsibleState.None);
+			item.id = node.id;
+			item.description = node.description;
+			item.tooltip = node.tooltip;
+			item.contextValue = node.contextValue;
+			item.iconPath = new vscode.ThemeIcon(node.contextValue === 'activeDistro' ? 'vm-active' : 'vm-outline');
+			item.command = { command: 'picket.wsl.openFolder', title: 'Open Folder', arguments: [node.distro] };
+			return item;
+		}
+	};
+
+	const view = vscode.window.createTreeView('picketWsl.targets', { treeDataProvider: treeProvider });
+	context.subscriptions.push(view);
+
+	const host = {
+		showQuickPick: (items, options) => vscode.window.showQuickPick(items, options),
+		showOpenDialog: (options) => vscode.window.showOpenDialog(options),
+		showInformationMessage: (message, ...actions) => vscode.window.showInformationMessage(message, ...actions),
+		showWarningMessage: (message, ...actions) => vscode.window.showWarningMessage(message, ...actions),
+		showErrorMessage: (message, ...actions) => vscode.window.showErrorMessage(message, ...actions),
+		withProgress: (options, task) => vscode.window.withProgress(
+			{ location: vscode.ProgressLocation.Notification, title: options.title },
+			task
+		),
+		openFolder: (uri, options) => vscode.commands.executeCommand('vscode.openFolder', uri, options),
+		runInTerminal: (command) => {
+			const terminal = vscode.window.createTerminal('Picket WSL');
+			terminal.show();
+			terminal.sendText(command);
+		},
+		refreshTargets: () => treeProvider.refresh(),
+		showDocument: async (text) => {
+			const document = await vscode.workspace.openTextDocument({ content: text, language: 'plaintext' });
+			await vscode.window.showTextDocument(document);
+		},
+		uriFor: (parts) => vscode.Uri.from(parts),
+		executeCommand: (id, ...args) => vscode.commands.executeCommand(id, ...args)
+	};
+
+	// The marketplace settings are read and written through the same object: `update` on the
+	// user target is what an administrator would put in settings.json by hand.
+	const gallery = {
+		get: (key) => vscode.workspace.getConfiguration('extensions.gallery').get(key),
+		update: async (key, value) => vscode.workspace.getConfiguration('extensions.gallery').update(key, value, vscode.ConfigurationTarget.Global)
+	};
+
+	context.subscriptions.push(...registerCommands({
+		host,
+		runner,
+		settings,
+		catalog,
+		createComponents,
+		resolver,
+		memento: context.globalState,
+		log,
+		appRoot: vscode.env.appRoot,
+		gallery,
+		currentFolders: () => vscode.workspace.workspaceFolders ?? [],
+		currentAuthority: () => vscode.env.remoteAuthority ?? '',
+		register: (id, run) => vscode.commands.registerCommand(id, run)
+	}));
+
+	// Until the CLI shim lands, its commands exist so the palette and the remote indicator do
+	// not offer dead entries.
+	for (const id of ['picket.wsl.installCli', 'picket.wsl.removeCli']) {
+		context.subscriptions.push(vscode.commands.registerCommand(id, () => {
+			log.info(`${id} is not implemented yet`);
+		}));
+	}
+
+	if (!(vscode.env.remoteAuthority ?? '')) {
+		void maybeNudge({
+			host,
+			memento: context.globalState,
+			folders: vscode.workspace.workspaceFolders,
+			openFolderInWsl: async () => { await vscode.commands.executeCommand('picket.wsl.reopenInWsl'); }
+		}).catch((error) => log.error(`Could not show the WSL nudge: ${error.message}`));
+	}
+}
+
+function deactivate() { }
+
+module.exports = { activate, deactivate };
