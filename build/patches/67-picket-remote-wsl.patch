+	assert.deepStrictEqual(readdirSync(payloadRoot), [`picket-${COMPONENT.version}`], 'only the working install remains');
+	assert.ok(existsSync(join(payloadRoot, `picket-${COMPONENT.version}`, 'bin', 'picket-code-server')), 'the previous install is intact');
