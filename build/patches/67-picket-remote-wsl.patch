index 00000000..eab68457
--- /dev/null
+++ b/extensions/picket-remote-wsl/test/download.test.js
@@ -0,0 +1,435 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert');
+const http = require('node:http');
+const https = require('node:https');
+const net = require('node:net');
+const { EventEmitter } = require('node:events');
+const { readFileSync } = require('node:fs');
+const { join } = require('node:path');
+const { parseProxySetting, downloadFile } = require('../src/download.js');
+const { download, installPayload } = require('../src/payload.js');
+const { createHash } = require('node:crypto');
+
+const KEY = readFileSync(join(__dirname, 'fixtures', 'localhost-key.pem'));
+const CERT = readFileSync(join(__dirname, 'fixtures', 'localhost.pem'));
+
+/**
+ * A server that is listening on an ephemeral port and always goes away again:
+ * a test that leaks a socket also leaks the whole `node --test` run.
+ * @param {import('node:net').Server} server
+ * @param {(port: number) => Promise<any>} run
+ */
+async function withServer(server, run) {
+	/** @type {Set<import('node:net').Socket>} */
+	const sockets = new Set();
+	server.on('connection', (socket) => {
+		sockets.add(socket);
+		socket.on('close', () => sockets.delete(socket));
+	});
+	await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+	const address = /** @type {import('node:net').AddressInfo} */ (server.address());
+	try {
+		return await run(address.port);
+	} finally {
+		for (const socket of sockets) {
+			socket.destroy();
+		}
+		await new Promise((resolve) => server.close(resolve));
+	}
+}
+
+/**
+ * An http server that records what it was asked, so a test can tell a direct
+ * request from an absolute-URI one.
+ * @param {Array<{ url?: string, headers: import('node:http').IncomingHttpHeaders }>} seen
+ * @param {Buffer} body
+ */
+function recordingServer(seen, body) {
+	return http.createServer((request, response) => {
+		seen.push({ url: request.url, headers: request.headers });
+		response.writeHead(200, { 'content-length': String(body.length) });
+		response.end(body);
+	});
+}
+
+/**
+ * A `CONNECT` proxy: it answers the tunnel request and then becomes a dumb
+ * byte pipe to the target, which is all a payload download ever asks of one.
+ * @param {string[]} seen request lines, in arrival order
+ */
+function connectProxy(seen) {
+	return net.createServer((client) => {
+		let buffer = '';
+		/** @param {Buffer} chunk */
+		const onData = (chunk) => {
+			buffer += chunk.toString('latin1');
+			const end = buffer.indexOf('\r\n\r\n');
+			if (end < 0) {
+				return;
+			}
+			client.removeListener('data', onData);
+			const [requestLine] = buffer.slice(0, end).split('\r\n');
+			seen.push(requestLine);
+			const [method, authority] = requestLine.split(' ');
+			if (method !== 'CONNECT') {
+				client.end('HTTP/1.1 405 Method Not Allowed\r\n\r\n');
+				return;
+			}
+			const [host, port] = authority.split(':');
+			const upstream = net.connect({ host, port: Number(port) }, () => {
+				client.write('HTTP/1.1 200 Connection Established\r\n\r\n');
+				client.pipe(upstream);
+				upstream.pipe(client);
+			});
+			upstream.on('error', () => client.destroy());
+			client.on('error', () => upstream.destroy());
+		};
+		client.on('data', onData);
+	});
+}
+
+/**
+ * Stands in for `https.request` when the point of the test is the options
+ * object rather than the bytes: no socket, no certificate, same interface.
+ * @param {any[]} seen
+ * @param {Buffer} body
+ */
+function fakeHttpsRequest(seen, body) {
+	return (/** @type {any} */ options) => {
+		seen.push(options);
+		const request = new EventEmitter();
+		/** @type {any} */ (request).setTimeout = () => request;
+		/** @type {any} */ (request).destroy = (/** @type {any} */ error) => {
+			if (error) {
+				request.emit('error', error);
+			}
+		};
+		/** @type {any} */ (request).end = () => {
+			const response = new EventEmitter();
+			/** @type {any} */ (response).statusCode = 200;
+			/** @type {any} */ (response).headers = { 'content-length': String(body.length) };
+			process.nextTick(() => {
+				request.emit('response', response);
+				// The body must arrive after the caller has attached its own
+				// listeners, which happens in the microtask after `response`.
+				setImmediate(() => {
+					response.emit('data', body);
+					response.emit('end');
+				});
+			});
+		};
+		return request;
+	};
+}
+
+test('parseProxySetting reads the forms VS Code accepts', () => {
+	for (const value of ['', '   ', null, undefined, 'off', 'OFF', 'direct', 'Direct']) {
+		assert.deepStrictEqual(parseProxySetting(value), { kind: 'direct' }, `expected direct for ${JSON.stringify(value)}`);
+	}
+
+	assert.deepStrictEqual(parseProxySetting('http://proxy.corp:8080'), { kind: 'proxy', host: 'proxy.corp', port: 8080, protocol: 'http:' });
+	assert.deepStrictEqual(parseProxySetting('proxy.corp:3128'), { kind: 'proxy', host: 'proxy.corp', port: 3128, protocol: 'http:' });
+	assert.deepStrictEqual(parseProxySetting('http://proxy.corp'), { kind: 'proxy', host: 'proxy.corp', port: 80, protocol: 'http:' });
+	assert.deepStrictEqual(parseProxySetting('http://user:pa%40ss@proxy.corp:8080'), {
+		kind: 'proxy', host: 'proxy.corp', port: 8080, auth: 'user:pa@ss', protocol: 'http:'
+	});
+	assert.deepStrictEqual(parseProxySetting('[::1]:3128'), { kind: 'proxy', host: '::1', port: 3128, protocol: 'http:' });
+});
+
+test('parseProxySetting rejects what it cannot use', () => {
+	const socks = parseProxySetting('socks5://proxy.corp:1080');
+	assert.strictEqual(socks.kind, 'invalid');
+	assert.match(socks.reason, /unsupported proxy protocol socks5:/);
+
+	const https = parseProxySetting('https://proxy.corp:8080');
+	assert.strictEqual(https.kind, 'invalid', 'an https proxy would need a TLS connection to the proxy itself');
+
+	const port = parseProxySetting('http://proxy.corp:0');
+	assert.strictEqual(port.kind, 'invalid');
+	assert.match(port.reason, /invalid proxy port/);
+
+	const garbage = parseProxySetting('not a url');
+	assert.strictEqual(garbage.kind, 'invalid');
+});
+
+test('a direct http download returns the body', async () => {
+	const body = Buffer.from('payload-bytes');
+	const server = recordingServer([], body);
+	const bytes = await withServer(server, (port) => downloadFile(`http://127.0.0.1:${port}/picket-code-server.tar.gz`));
+	assert.deepStrictEqual(bytes, body);
+});
+
+test('a body larger than the catalog size is refused mid-flight', async () => {
+	const server = http.createServer((request, response) => {
+		response.writeHead(200, { 'content-length': String(4096) });
+		let written = 0;
+		const timer = setInterval(() => {
+			response.write(Buffer.alloc(256, 1));
+			written += 1;
+			if (written === 16) {
+				clearInterval(timer);
+				response.end();
+			}
+		}, 5);
+		// The client hangs up on purpose; writing into the dead socket is expected.
+		response.on('error', () => { });
+		response.on('close', () => clearInterval(timer));
+	});
+	await assert.rejects(
+		() => withServer(server, (port) => downloadFile(`http://127.0.0.1:${port}/big`, { maxBytes: 512 })),
+		/Download exceeded the expected size of 512 bytes/);
+});
+
+test('progress is throttled and ends with the real total', async () => {
+	const chunks = 12;
+	const chunk = Buffer.alloc(1024, 7);
+	const total = chunks * chunk.length;
+	const server = http.createServer((request, response) => {
+		response.writeHead(200, { 'content-length': String(total) });
+		let written = 0;
+		const timer = setInterval(() => {
+			response.write(chunk);
+			written += 1;
+			if (written === chunks) {
+				clearInterval(timer);
+				response.end();
+			}
+		}, 25);
+	});
+	/** @type {Array<{ downloaded: number, total: number, at: number }>} */
+	const reports = [];
+	await withServer(server, (port) => downloadFile(`http://127.0.0.1:${port}/slow`, {
+		onProgress: ({ downloaded, total }) => reports.push({ downloaded, total, at: Date.now() })
+	}));
+
+	assert.ok(reports.length >= 2, `expected several reports, got ${reports.length}`);
+	assert.deepStrictEqual(reports.at(-1), { downloaded: total, total, at: /** @type {any} */ (reports.at(-1)).at });
+	// 90 rather than 100: the throttle compares the clock inside the download, the
+	// reports timestamps come from the clock here, and a millisecond boundary that
+	// falls between the two reads turns an exact 100 into 99. The spacing that
+	// matters — "not one report per chunk" — is still proven by this bound.
+	for (let index = 1; index < reports.length - 1; index += 1) {
+		assert.ok(reports[index].at - reports[index - 1].at >= 90, `report ${index} came less than 90 ms after the previous one`);
+	}
+	assert.ok(reports.every(report => report.total === total), 'every report knows the content length');
+});
+
+test('redirects are followed and counted', async () => {
+	const body = Buffer.from('redirected');
+	const server = http.createServer((request, response) => {
+		if (request.url === '/start') {
+			response.writeHead(302, { location: '/middle' });
+			response.end();
+		} else if (request.url === '/middle') {
+			response.writeHead(301, { location: `http://127.0.0.1:${request.socket.localPort}/end` });
+			response.end();
+		} else {
+			response.writeHead(200, { 'content-length': String(body.length) });
+			response.end(body);
+		}
+	});
+	const bytes = await withServer(server, (port) => downloadFile(`http://127.0.0.1:${port}/start`));
+	assert.deepStrictEqual(bytes, body);
+});
+
+test('more than five redirects fail instead of looping', async () => {
