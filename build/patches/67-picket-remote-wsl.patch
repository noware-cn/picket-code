@@ -0,0 +1,59 @@
+// RED first: this file must fail until src/icode.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { detectIcode } = require('../src/icode.js');
+
+/** @param {{ configured?: string, executable?: boolean, onPath?: string, pathExit?: number, scripts?: string[] }} [options] */
+function makeRunner(options = {}) {
+	const scripts = [];
+	const runner = {
+		scripts,
+		async exec(args) {
+			const script = args.slice(args.indexOf('-e') + 1).join(' ');
+			scripts.push(script);
+			if (script.startsWith('test -x')) {
+				return { code: options.executable ? 0 : 1, stdout: '', stderr: '' };
+			}
+			if (script.includes('command -v icode')) {
+				return { code: options.pathExit ?? (options.onPath ? 0 : 1), stdout: options.onPath ? `${options.onPath}\n` : '', stderr: '' };
+			}
+			throw new Error(`unexpected script: ${script}`);
+		}
+	};
+	return runner;
+}
+
+test('a configured path that is executable wins', async () => {
+	const runner = makeRunner({ configured: '/opt/icode/bin/icode', executable: true, onPath: '/home/u/.local/bin/icode' });
+	assert.deepStrictEqual(await detectIcode({ runner, distro: 'Ubuntu', configuredPath: '/opt/icode/bin/icode' }), { path: '/opt/icode/bin/icode', source: 'setting' });
+	assert.ok(runner.scripts[0].startsWith('test -x'));
+});
+
+test('a configured path that is not executable falls through to PATH', async () => {
+	const runner = makeRunner({ executable: false, onPath: '/home/u/.local/bin/icode' });
+	assert.deepStrictEqual(await detectIcode({ runner, distro: 'Ubuntu', configuredPath: '/opt/gone/icode' }), { path: '/home/u/.local/bin/icode', source: 'path' });
+});
+
+test('nothing configured and nothing on PATH means missing', async () => {
+	const runner = makeRunner({});
+	assert.deepStrictEqual(await detectIcode({ runner, distro: 'Ubuntu', configuredPath: '' }), { path: null, source: 'missing' });
+	assert.deepStrictEqual(runner.scripts, ['sh -lc command -v icode'], 'detection must use the same login shell the server starts in');
+});
+
+test('a failing command -v is missing, not an error', async () => {
+	const runner = makeRunner({ onPath: '/home/u/.local/bin/icode', pathExit: 1 });
+	assert.deepStrictEqual(await detectIcode({ runner, distro: 'Ubuntu', configuredPath: '' }), { path: null, source: 'missing' });
+});
+
+test('profile banners do not become the detected path', async () => {
+	const runner = {
+		async exec(args) {
+			const script = args.slice(args.indexOf('-e') + 1).join(' ');
+			if (script.includes('command -v icode')) {
+				return { code: 0, stdout: 'Welcome to Ubuntu!\n/home/u/.local/bin/icode\n', stderr: '' };
+			}
+			return { code: 1, stdout: '', stderr: '' };
+		}
+	};
+	assert.deepStrictEqual(await detectIcode({ runner, distro: 'Ubuntu', configuredPath: '' }), { path: '/home/u/.local/bin/icode', source: 'path' });
+});
diff --git a/extensions/picket-remote-wsl/test/launch.test.js b/extensions/picket-remote-wsl/test/launch.test.js
new file mode 100644
index 00000000..9c28c453
--- /dev/null
+++ b/extensions/picket-remote-wsl/test/launch.test.js
@@ -0,0 +1,139 @@
+// RED first: this file must fail until src/launch.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { serverPaths, runtimeFileFor, buildServerArgs, createPortParser, lockAndRead, acquireLock, releaseLock, lockAgeMs, LAUNCH_SCRIPT } = require('../src/launch.js');
+
+test('serverPaths composes the documented layout', () => {
+	const p = serverPaths('/home/u', 'v1.143.1-picket.1-rc.4');
+	assert.strictEqual(p.binary, '/home/u/.picket-code-server/payloads/server-v1.143.1-picket.1-rc.4/bin/picket-code-server');
+	assert.strictEqual(p.dataDir, '/home/u/.picket-code-server/data');
+	assert.strictEqual(p.extensionsDir, '/home/u/.picket-code-server/extensions');
+	assert.strictEqual(p.runtimeDir, '/home/u/.picket-code-server/runtime');
+	assert.strictEqual(runtimeFileFor('/home/u', 'Ubuntu 22.04 LTS'), '/home/u/.picket-code-server/runtime/Ubuntu 22.04 LTS.json');
+});
+
+test('buildServerArgs launches through a login shell with argv-passed values', () => {
+	const p = serverPaths('/home/u', 'T');
+	const args = buildServerArgs({ paths: p, connectionToken: 'a-b-c-d', icodeBin: '/usr/local/bin/icode', distro: 'Ubuntu' });
+	assert.deepStrictEqual(args.slice(0, 9), ['-d', 'Ubuntu', '-e', 'sh', '-lc', LAUNCH_SCRIPT, p.binary, p.envSetupFile, '/usr/local/bin/icode']);
+	assert.ok(!args.includes('env'));   // PICKET_ICODE_BIN travels inside the launch script, not a second binary
+	assert.ok(args.includes('--without-browser-env-var'));
+	assert.ok(args.includes('--port=0'));
+	assert.ok(args.includes(`--user-data-dir=${p.dataDir}`));
+	assert.ok(args.includes('--connection-token=a-b-c-d'));
+	assert.ok(args.includes(`--extensions-dir=${p.extensionsDir}`));
+	assert.ok(args.includes('--host=127.0.0.1'));
+	assert.ok(args.includes('--use-host-proxy'));
+	assert.ok(args.includes('--disable-websocket-compression'));
+	assert.ok(args.includes('--accept-server-license-terms'));
+	assert.ok(args.includes('--log=trace'));
+});
+
+test('a space and a quote inside the icode path stay one argv entry', () => {
+	const p = serverPaths('/home/u', 'T');
+	const args = buildServerArgs({ paths: p, connectionToken: 'x', icodeBin: "/home/u/my tools/it's icode", distro: 'Ubuntu 22.04 LTS' });
+	assert.strictEqual(args[1], 'Ubuntu 22.04 LTS');
+	assert.strictEqual(args[8], "/home/u/my tools/it's icode");
+});
+
+test('the port parser ignores banners and trailing noise', () => {
+	const parser = createPortParser();
+	parser.feed('Your Windows build is out of date.\n');
+	parser.feed('Extension host agent listening on 41234\n');
+	parser.feed('another line\n');
+	assert.strictEqual(parser.port, 41234);
+});
+
+test('a lock that already exists keeps the second caller from spawning', async () => {
+	const calls = [];
+	const runner = { exec: async (args) => { calls.push(args.join(' ')); return { code: 0, stdout: '1', stderr: '' }; }, spawn: () => { throw new Error('not used'); } };
+	assert.strictEqual(await lockAndRead(runner, 'Ubuntu', '/home/u/.picket-code-server/runtime.json'), undefined);
+	assert.ok(!calls.some(c => c.includes('cat')));
+});
+
+test('a free lock reads the runtime file', async () => {
+	const info = { port: 41234, token: 't', tag: 'T', pid: 7, startedAt: 'now' };
+	const runner = { exec: async (args) => {
+		const script = args.slice(args.indexOf('-e') + 1).join(' ');
+		return script.includes('cat')
+			? { code: 0, stdout: JSON.stringify(info), stderr: '' }
+			: { code: 0, stdout: '0', stderr: '' };
+	}, spawn: () => { throw new Error('not used'); } };
+	assert.deepStrictEqual(await lockAndRead(runner, 'Ubuntu', '/home/u/.picket-code-server/runtime.json'), info);
+});
+
+const { EventEmitter } = require('node:events');
+const { newConnectionToken, startServer } = require('../src/launch.js');
+
+function spawnEmitting(script) {
+	return () => {
+		const child = new EventEmitter();
+		child.stdout = new EventEmitter();
+		child.stderr = new EventEmitter();
+		child.stdin = { end() { } };
+		child.kill = () => { };
+		child.pid = 4242;
+		setImmediate(() => script(child));
+		return { child, stdout: child.stdout, stderr: child.stderr };
+	};
+}
+
+test('a start resolves with the parsed port and a runtime record', async () => {
+	const paths = serverPaths('/home/u', 'T');
+	const args = buildServerArgs({ paths, connectionToken: 'tok', icodeBin: undefined, distro: 'Ubuntu' });
+	const info = await startServer({
+		runner: { spawn: spawnEmitting(child => child.stdout.emit('data', Buffer.from('banner line\nExtension host agent listening on 51234\n'))) },
+		distro: 'Ubuntu', args, runtimeFile: '/dev/null/runtime.json', timeoutMs: 500, writeRuntime: async () => { }
+	});
+	assert.strictEqual(info.port, 51234);
+	assert.strictEqual(info.token, 'tok');
+	assert.strictEqual(info.tag, 'T');
+	assert.strictEqual(info.pid, 4242);
+});
+
+test('a silent server fails with the timeout and keeps the last output line', async () => {
+	const paths = serverPaths('/home/u', 'T');
+	const args = buildServerArgs({ paths, connectionToken: 'tok', icodeBin: undefined, distro: 'Ubuntu' });
+	await assert.rejects(() => startServer({
+		runner: { spawn: spawnEmitting(child => child.stderr.emit('data', Buffer.from('loading extensions...\n'))) },
+		distro: 'Ubuntu', args, runtimeFile: '/dev/null/runtime.json', timeoutMs: 80, writeRuntime: async () => { }
+	}), (error) => /Start timed out after 80 ms/.test(error.message) && /loading extensions/.test(error.message));
+});
+
+test('exit code 99 names the distro as unsupported', async () => {
+	const paths = serverPaths('/home/u', 'T');
+	const args = buildServerArgs({ paths, connectionToken: 'tok', icodeBin: undefined, distro: 'Ubuntu' });
+	await assert.rejects(() => startServer({
+		runner: { spawn: spawnEmitting(child => child.emit('close', 99)) },
+		distro: 'Ubuntu', args, runtimeFile: '/dev/null/runtime.json', timeoutMs: 500, writeRuntime: async () => { }
+	}), /WSL 1|unsupported|not supported/i);
+});
+
+test('the token is url-safe and long enough to be unguessable', () => {
+	const token = newConnectionToken();
+	assert.match(token, /^[A-Za-z0-9_-]{32,}$/);
+	assert.notStrictEqual(token, newConnectionToken());
+});
+
+test('the start lock is taken with mkdir and released with rmdir', async () => {
+	const calls = [];
+	const runner = { exec: async (args) => { calls.push(args.slice(args.indexOf('-e') + 1, args.indexOf('-e') + 4).join(' ')); return { code: 0, stdout: '', stderr: '' }; }, spawn: () => { throw new Error('not used'); } };
+	const file = '/home/u/.picket-code-server/runtime/Ubuntu.json';
+	assert.strictEqual(await acquireLock(runner, 'Ubuntu', file), true);
+	await releaseLock(runner, 'Ubuntu', file);
+	assert.deepStrictEqual(calls, ['sh -c mkdir "$1" 2>/dev/null', 'sh -c rmdir "$1" 2>/dev/null || rm -rf "$1"']);
+});
+
+test('a lock another window holds reports false', async () => {
+	const runner = { exec: async () => ({ code: 1, stdout: '', stderr: 'mkdir: cannot create directory' }), spawn: () => { throw new Error('not used'); } };
+	assert.strictEqual(await acquireLock(runner, 'Ubuntu', '/home/u/.picket-code-server/runtime/Ubuntu.json'), false);
+});
+
+test('the lock age turns stat seconds into milliseconds', async () => {
+	const seconds = Math.floor(Date.now() / 1000) - 30;
+	const runner = { exec: async () => ({ code: 0, stdout: `${seconds}\n`, stderr: '' }), spawn: () => { throw new Error('not used'); } };
+	const age = await lockAgeMs(runner, 'Ubuntu', '/home/u/.picket-code-server/runtime/Ubuntu.json');
+	assert.ok(age !== undefined && age >= 30000 && age < 33000, `unexpected age ${age}`);
+	const gone = { exec: async () => ({ code: 0, stdout: '', stderr: '' }), spawn: () => { throw new Error('not used'); } };
+	assert.strictEqual(await lockAgeMs(gone, 'Ubuntu', '/home/u/.picket-code-server/runtime/Ubuntu.json'), undefined);
+});
diff --git a/extensions/picket-remote-wsl/test/payload.test.js b/extensions/picket-remote-wsl/test/payload.test.js
new file mode 100644
index 00000000..93dac3fe
--- /dev/null
+++ b/extensions/picket-remote-wsl/test/payload.test.js
@@ -0,0 +1,57 @@
+// RED first: this file must fail until src/payload.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { createHash } = require('node:crypto');
+const { mkdtempSync, writeFileSync, readdirSync } = require('node:fs');
+const { tmpdir } = require('node:os');
+const { join } = require('node:path');
+const { parseSha256Sums, chooseSource, installPayload } = require('../src/payload.js');
+
+const COMPONENT = { id: 'wsl-server', kind: 'server', version: 'v1.143.1-picket.1-rc.4',
+	file: 'picket-code-server-v1.143.1-picket.1-rc.4-linux-x64.tar.gz', size: 3, sha256: '', embedded: false };
+
+test('parses SHA256SUMS with both separators', () => {
+	const sums = parseSha256Sums(`${'a'.repeat(64)}  a.tar.gz\n${'b'.repeat(64)} *b.tar.gz\nnot a line\n`);
+	assert.strictEqual(sums.get('a.tar.gz'), 'a'.repeat(64));
+	assert.strictEqual(sums.get('b.tar.gz'), 'b'.repeat(64));
+	assert.strictEqual(sums.size, 2);
+});
+
+test('source precedence is explicit, embedded, url', async () => {
+	const exists = async () => true;
+	assert.deepStrictEqual(await chooseSource(COMPONENT, { explicitPath: 'C:\\p.tar.gz', embeddedDir: 'E', baseUrl: 'https://x/', exists }), { kind: 'file', path: 'C:\\p.tar.gz' });
+	assert.deepStrictEqual(await chooseSource(COMPONENT, { embeddedDir: 'E', baseUrl: 'https://x/', exists }), { kind: 'embedded', path: join('E', COMPONENT.file) });
+	assert.deepStrictEqual(await chooseSource(COMPONENT, { baseUrl: 'https://x/', exists }), { kind: 'url', url: `https://x/${COMPONENT.file}` });
+});
+
+test('no source at all throws with every reason', async () => {
+	await assert.rejects(() => chooseSource(COMPONENT, { exists: async () => false }),
+		/explicit path missing, no embedded payload, and no base URL configured/);
+});
+
+test('a checksum mismatch aborts and leaves no payload directory', async () => {
+	const dir = mkdtempSync(join(tmpdir(), 'picket-payload-'));
+	const file = join(dir, 'bad.tar.gz');
+	writeFileSync(file, 'nope');
+	const calls = [];
+	const runner = { exec: async (args) => { calls.push(args.join(' ')); return { code: 0, stdout: '', stderr: '' }; } };
+	await assert.rejects(() => installPayload({ runner, distro: 'D', component: { ...COMPONENT, sha256: 'c'.repeat(64) },
+		source: { kind: 'file', path: file }, payloadRoot: '/home/u/.picket-code-server/payloads', onProgress: () => { } }), /checksum mismatch/i);
+	assert.deepStrictEqual(calls, []);
+});
+
+test('a successful install extracts via stdin and leaves no temp directory', async () => {
+	const dir = mkdtempSync(join(tmpdir(), 'picket-payload-'));
+	const file = join(dir, 'ok.tar.gz');
+	writeFileSync(file, 'abc');
+	const sha = createHash('sha256').update('abc').digest('hex');
+	const calls = [];
+	const runner = { exec: async (args, opts) => { calls.push({ args, hasInput: !!(opts && opts.input) }); return { code: 0, stdout: '', stderr: '' }; } };
+	const result = await installPayload({ runner, distro: 'D', component: { ...COMPONENT, sha256: sha },
+		source: { kind: 'file', path: file }, payloadRoot: '/home/u/.picket-code-server/payloads', onProgress: () => { } });
+	assert.strictEqual(result.payloadDir, '/home/u/.picket-code-server/payloads/server-v1.143.1-picket.1-rc.4');
+	assert.strictEqual(calls.length, 2);
+	assert.match(calls[0].args.join(' '), /mkdir -p/);
+	assert.ok(calls[1].hasInput, 'tar receives the archive on stdin');
+	assert.deepStrictEqual(readdirSync(dir), ['ok.tar.gz']);
+});
