diff --git a/extensions/picket-remote-wsl/test/icode.test.js b/extensions/picket-remote-wsl/test/icode.test.js
new file mode 100644
index 00000000..5e31eaaa
--- /dev/null
+++ b/extensions/picket-remote-wsl/test/icode.test.js
@@ -0,0 +1,59 @@
+// RED first: this file must fail until src/icode.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { detectIcode } = require('../src/icode.js');
+
+/** @param {{ configured?: string, executable?: boolean, onPath?: string, pathExit?: number, scripts?: string[] }} [options] */
+function makeRunner(options = {}) {
+	const scripts = [];
+	const runner = {
+		scripts,
+		async exec(args) {
+			const script = args.slice(args.indexOf('-e') + 1).join(' ');
+			scripts.push(script);
+			if (script.startsWith('test -x')) {
+				return { code: options.executable ? 0 : 1, stdout: '', stderr: '' };
+			}
+			if (script.includes('command -v icode')) {
+				return { code: options.pathExit ?? (options.onPath ? 0 : 1), stdout: options.onPath ? `${options.onPath}\n` : '', stderr: '' };
+			}
+			throw new Error(`unexpected script: ${script}`);
+		}
+	};
+	return runner;
+}
+
+test('a configured path that is executable wins', async () => {
+	const runner = makeRunner({ configured: '/opt/icode/bin/icode', executable: true, onPath: '/home/u/.local/bin/icode' });
+	assert.deepStrictEqual(await detectIcode({ runner, distro: 'Ubuntu', configuredPath: '/opt/icode/bin/icode' }), { path: '/opt/icode/bin/icode', source: 'setting' });
+	assert.ok(runner.scripts[0].startsWith('test -x'));
+});
+
+test('a configured path that is not executable falls through to PATH', async () => {
+	const runner = makeRunner({ executable: false, onPath: '/home/u/.local/bin/icode' });
+	assert.deepStrictEqual(await detectIcode({ runner, distro: 'Ubuntu', configuredPath: '/opt/gone/icode' }), { path: '/home/u/.local/bin/icode', source: 'path' });
+});
+
+test('nothing configured and nothing on PATH means missing', async () => {
+	const runner = makeRunner({});
+	assert.deepStrictEqual(await detectIcode({ runner, distro: 'Ubuntu', configuredPath: '' }), { path: null, source: 'missing' });
+	assert.deepStrictEqual(runner.scripts, ['sh -lc command -v icode'], 'detection must use the same login shell the server starts in');
+});
+
+test('a failing command -v is missing, not an error', async () => {
+	const runner = makeRunner({ onPath: '/home/u/.local/bin/icode', pathExit: 1 });
+	assert.deepStrictEqual(await detectIcode({ runner, distro: 'Ubuntu', configuredPath: '' }), { path: null, source: 'missing' });
+});
+
+test('profile banners do not become the detected path', async () => {
+	const runner = {
+		async exec(args) {
+			const script = args.slice(args.indexOf('-e') + 1).join(' ');
+			if (script.includes('command -v icode')) {
+				return { code: 0, stdout: 'Welcome to Ubuntu!\n/home/u/.local/bin/icode\n', stderr: '' };
+			}
+			return { code: 1, stdout: '', stderr: '' };
+		}
+	};
+	assert.deepStrictEqual(await detectIcode({ runner, distro: 'Ubuntu', configuredPath: '' }), { path: '/home/u/.local/bin/icode', source: 'path' });
+});
diff --git a/extensions/picket-remote-wsl/test/launch.test.js b/extensions/picket-remote-wsl/test/launch.test.js
new file mode 100644
index 00000000..15ee9c64
--- /dev/null
+++ b/extensions/picket-remote-wsl/test/launch.test.js
@@ -0,0 +1,272 @@
+// RED first: this file must fail until src/launch.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { serverPaths, runtimeFileFor, buildServerArgs, createLaunchParser, lockAndRead, acquireLock, releaseLock, lockAgeMs, LAUNCH_SCRIPT } = require('../src/launch.js');
+
+test('serverPaths composes the documented layout', () => {
+	const p = serverPaths('/home/u', 'v1.143.1-picket.1-rc.4');
+	assert.strictEqual(p.binary, '/home/u/.vscode-server/bin/picket-v1.143.1-picket.1-rc.4/bin/picket-code-server');
+	assert.strictEqual(p.dataDir, '/home/u/.vscode-server/data');
+	assert.strictEqual(p.extensionsDir, '/home/u/.vscode-server/extensions');
+	assert.strictEqual(p.runtimeDir, '/home/u/.picket-code-server/runtime');
+	assert.strictEqual(runtimeFileFor('/home/u', 'Ubuntu 22.04 LTS'), '/home/u/.picket-code-server/runtime/Ubuntu 22.04 LTS.json');
+});
+
+test('server paths live under the shared .vscode-server root', () => {
+	const paths = serverPaths('/home/u', '1.2.0');
+	assert.equal(paths.root, '/home/u/.vscode-server');
+	assert.equal(paths.payloadDir, '/home/u/.vscode-server/bin/picket-1.2.0');
+	assert.equal(paths.binary, '/home/u/.vscode-server/bin/picket-1.2.0/bin/picket-code-server');
+	assert.equal(paths.dataDir, '/home/u/.vscode-server/data');
+	assert.equal(paths.extensionsDir, '/home/u/.vscode-server/extensions');
+	assert.equal(paths.envSetupFile, '/home/u/.vscode-server/server-env-setup');
+	assert.equal(paths.stateDir, '/home/u/.picket-code-server');
+	assert.equal(paths.runtimeDir, '/home/u/.picket-code-server/runtime');
+});
+
+test('buildServerArgs launches through a login shell with argv-passed values', () => {
+	const p = serverPaths('/home/u', 'T');
+	const args = buildServerArgs({ paths: p, connectionToken: 'a-b-c-d', icodeBin: '/usr/local/bin/icode', distro: 'Ubuntu' });
+	assert.deepStrictEqual(args.slice(0, 9), ['-d', 'Ubuntu', '-e', 'sh', '-lc', LAUNCH_SCRIPT, p.binary, p.envSetupFile, '/usr/local/bin/icode']);
+	assert.ok(!args.includes('env'));   // PICKET_ICODE_BIN travels inside the launch script, not a second binary
+	assert.ok(args.includes('--without-browser-env-var'));
+	assert.ok(args.includes('--port=0'));
+	assert.ok(args.includes(`--user-data-dir=${p.dataDir}`));
+	assert.ok(args.includes('--connection-token=a-b-c-d'));
+	assert.ok(args.includes(`--extensions-dir=${p.extensionsDir}`));
+	assert.ok(args.includes('--host=127.0.0.1'));
+	assert.ok(args.includes('--use-host-proxy'));
+	assert.ok(args.includes('--disable-websocket-compression'));
+	assert.ok(args.includes('--accept-server-license-terms'));
+	assert.ok(args.includes('--log=trace'));
+});
+
+test('a space and a quote inside the icode path stay one argv entry', () => {
+	const p = serverPaths('/home/u', 'T');
+	const args = buildServerArgs({ paths: p, connectionToken: 'x', icodeBin: "/home/u/my tools/it's icode", distro: 'Ubuntu 22.04 LTS' });
+	assert.strictEqual(args[1], 'Ubuntu 22.04 LTS');
+	assert.strictEqual(args[8], "/home/u/my tools/it's icode");
+});
+
+test('useShellEnvironment=false starts the server without a login shell', () => {
+	const p = serverPaths('/home/u', 'T');
+	const args = buildServerArgs({ paths: p, connectionToken: 'x', icodeBin: '', distro: 'Ubuntu', loginShell: false });
+	assert.strictEqual(args[4], '-c', 'no profile is sourced, so the environment is whatever wsl.exe hands over');
+	assert.strictEqual(args[6], p.binary, 'the flags after the shell keep their positions');
+});
+
+test('the launch parser ignores banners and trailing noise', () => {
+	const parser = createLaunchParser();
+	parser.feed('Your Windows build is out of date.\n');
+	parser.feed('Extension host agent listening on 41234\n');
+	parser.feed('another line\n');
+	assert.strictEqual(parser.port, 41234);
+});
+
+test('the launch parser keeps a line that is split across chunks', () => {
+	const parser = createLaunchParser();
+	parser.feed('picket-server-pid 42');
+	parser.feed('17\nExtension host agent listen');
+	parser.feed('ing on 41234\n');
+	assert.strictEqual(parser.pid, 4217);
+	assert.strictEqual(parser.port, 41234);
+});
+
+test('a pid that is split mid-number is not read as a shorter pid', () => {
+	const parser = createLaunchParser();
+	parser.feed('picket-server-pid 42');
+	assert.strictEqual(parser.pid, undefined, 'the line is not complete yet');
+	parser.feed('\n');
+	assert.strictEqual(parser.pid, 42);
+});
+
+test('the launch script announces its own pid before exec, which keeps it', () => {
+	assert.match(LAUNCH_SCRIPT, /echo "picket-server-pid \$\$"; exec "\$0" "\$@"/);
+});
+
+test('a lock that already exists keeps the second caller from spawning', async () => {
+	const calls = [];
+	const runner = { exec: async (args) => { calls.push(args.join(' ')); return { code: 0, stdout: '1', stderr: '' }; }, spawn: () => { throw new Error('not used'); } };
+	assert.strictEqual(await lockAndRead(runner, 'Ubuntu', '/home/u/.picket-code-server/runtime.json'), undefined);
+	assert.ok(!calls.some(c => c.includes('cat')));
+});
+
+test('a free lock reads the runtime file', async () => {
+	const info = { port: 41234, token: 't', version: 'T', commit: 'C', pid: 7, startedAt: 'now' };
+	const runner = { exec: async (args) => {
+		const script = args.slice(args.indexOf('-e') + 1).join(' ');
+		return script.includes('cat')
+			? { code: 0, stdout: JSON.stringify(info), stderr: '' }
+			: { code: 0, stdout: '0', stderr: '' };
+	}, spawn: () => { throw new Error('not used'); } };
+	assert.deepStrictEqual(await lockAndRead(runner, 'Ubuntu', '/home/u/.picket-code-server/runtime.json'), info);
+});
+
+const { EventEmitter } = require('node:events');
+const { newConnectionToken, startServer, clearRuntime, stopServer, writeRuntime } = require('../src/launch.js');
+
+function spawnEmitting(script) {
+	return () => {
+		const child = new EventEmitter();
+		child.stdout = new EventEmitter();
+		child.stderr = new EventEmitter();
+		child.stdin = { end() { } };
+		child.kill = () => { };
+		child.pid = 4242;
+		setImmediate(() => script(child));
+		return { child, stdout: child.stdout, stderr: child.stderr };
+	};
+}
+
+test('a start resolves with the parsed port and a runtime record', async () => {
+	const paths = serverPaths('/home/u', 'T');
+	const args = buildServerArgs({ paths, connectionToken: 'tok', icodeBin: undefined, distro: 'Ubuntu' });
+	const info = await startServer({
+		runner: { spawn: spawnEmitting(child => child.stdout.emit('data', Buffer.from('picket-server-pid 51234\nbanner line\nExtension host agent listening on 51234\n'))) },
+		distro: 'Ubuntu', args, runtimeFile: '/dev/null/runtime.json', timeoutMs: 500, writeRuntime: async () => { }
+	});
+	assert.strictEqual(info.port, 51234);
+	assert.strictEqual(info.token, 'tok');
+	assert.strictEqual(info.version, 'T', 'the payload directory is where a start reads its version from');
+	assert.strictEqual(info.pid, 51234, 'the in-distro pid, not the Windows wsl.exe pid (4242)');
+});
+
+test('a start without the pid line records -1 instead of the wsl.exe pid', async () => {
+	const paths = serverPaths('/home/u', 'T');
+	const args = buildServerArgs({ paths, connectionToken: 'tok', icodeBin: undefined, distro: 'Ubuntu' });
+	const info = await startServer({
+		runner: { spawn: spawnEmitting(child => child.stdout.emit('data', Buffer.from('Extension host agent listening on 51234\n'))) },
+		distro: 'Ubuntu', args, runtimeFile: '/dev/null/runtime.json', timeoutMs: 500, writeRuntime: async () => { }
+	});
+	assert.strictEqual(info.pid, -1, 'child.pid is a Windows pid and must never reach kill');
+});
+
+test('a start whose record cannot be written fails and stops the server it started', async () => {
+	// Nothing can find a server with no record: a second window would start its
+	// own, so a start that cannot record itself must not be reported as running.
+	const paths = serverPaths('/home/u', 'T');
+	const args = buildServerArgs({ paths, connectionToken: 'tok', icodeBin: undefined, distro: 'Ubuntu' });
+	let killed = 0;
+	const spawnKill = () => {
+		const child = new EventEmitter();
+		child.stdout = new EventEmitter();
+		child.stderr = new EventEmitter();
+		child.stdin = { end() { } };
+		child.kill = () => { killed += 1; };
+		child.pid = 4242;
+		setImmediate(() => child.stdout.emit('data', Buffer.from('picket-server-pid 777\nExtension host agent listening on 51234\n')));
+		return { child, stdout: child.stdout, stderr: child.stderr };
+	};
+	await assert.rejects(() => startServer({
+		runner: { spawn: spawnKill },
+		distro: 'Ubuntu', args, runtimeFile: '/home/u/.picket-code-server/runtime/Ubuntu.json', timeoutMs: 500,
+		writeRuntime: async () => { throw new Error('exit 1: no space left on device'); }
+	}), (error) => /could not be written/.test(error.message) && /no space left/.test(error.message));
+	assert.strictEqual(killed, 1, 'the orphaned process must be stopped');
+});
+
+test('a silent server fails with the timeout and keeps the last output line', async () => {
+	const paths = serverPaths('/home/u', 'T');
+	const args = buildServerArgs({ paths, connectionToken: 'tok', icodeBin: undefined, distro: 'Ubuntu' });
+	await assert.rejects(() => startServer({
+		runner: { spawn: spawnEmitting(child => child.stderr.emit('data', Buffer.from('loading extensions...\n'))) },
+		distro: 'Ubuntu', args, runtimeFile: '/dev/null/runtime.json', timeoutMs: 80, writeRuntime: async () => { }
+	}), (error) => /Start timed out after 80 ms/.test(error.message) && /loading extensions/.test(error.message));
+});
+
+test('exit code 99 names the distro as unsupported', async () => {
+	const paths = serverPaths('/home/u', 'T');
+	const args = buildServerArgs({ paths, connectionToken: 'tok', icodeBin: undefined, distro: 'Ubuntu' });
+	await assert.rejects(() => startServer({
+		runner: { spawn: spawnEmitting(child => child.emit('close', 99)) },
+		distro: 'Ubuntu', args, runtimeFile: '/dev/null/runtime.json', timeoutMs: 500, writeRuntime: async () => { }
+	}), /WSL 1|unsupported|not supported/i);
+});
+
+test('the token is url-safe and long enough to be unguessable', () => {
+	const token = newConnectionToken();
+	assert.match(token, /^[A-Za-z0-9_-]{32,}$/);
+	assert.notStrictEqual(token, newConnectionToken());
+});
+
+test('the start lock is taken with mkdir and released with rmdir', async () => {
+	const calls = [];
+	const runner = { exec: async (args) => { calls.push(args.slice(args.indexOf('-e') + 1, args.indexOf('-e') + 4).join(' ')); return { code: 0, stdout: '', stderr: '' }; }, spawn: () => { throw new Error('not used'); } };
+	const file = '/home/u/.picket-code-server/runtime/Ubuntu.json';
+	assert.strictEqual(await acquireLock(runner, 'Ubuntu', file), true);
+	await releaseLock(runner, 'Ubuntu', file);
+	assert.deepStrictEqual(calls, ['sh -c mkdir -p "$(dirname "$1")" && mkdir "$1" 2>/dev/null', 'sh -c rmdir "$1" 2>/dev/null || rm -rf "$1"']);
+});
+
+test('a lock another window holds reports false', async () => {
+	const runner = { exec: async () => ({ code: 1, stdout: '', stderr: 'mkdir: cannot create directory' }), spawn: () => { throw new Error('not used'); } };
+	assert.strictEqual(await acquireLock(runner, 'Ubuntu', '/home/u/.picket-code-server/runtime/Ubuntu.json'), false);
+});
+
+test('acquireLock creates the runtime parent on a fresh home (real shell)', { skip: process.platform !== 'linux' }, async () => {
+	// A first-ever start has no runtime/ directory yet; the mkdir must create it
+	// or the lock is mistaken for "another window is starting" and the resolver
+	// waits out its whole timeout (acceptance --remote, 2026-11-04).
+	const { mkdtempSync } = require('node:fs');
+	const { tmpdir } = require('node:os');
+	const { join } = require('node:path');
+	const { spawn } = require('node:child_process');
+	const { createWslRunner } = require('../src/distro.js');
+
+	const home = mkdtempSync(join(tmpdir(), 'picket-wsl-lock-'));
+	const file = join(home, '.picket-code-server', 'runtime', 'Ubuntu.json');
+	// `wsl.exe -d <distro> -e <cmd...>` runs <cmd...>; map it onto the local shell.
+	const runner = createWslRunner({ wslPath: '/bin/sh', spawn: (wslPath, args) => spawn(wslPath, ['-c', 'exec "$@"', '--', ...args.slice(3)]) });
+
+	assert.strictEqual(await acquireLock(runner, 'Ubuntu', file), true, 'fresh home must be lockable');
+	assert.strictEqual(await acquireLock(runner, 'Ubuntu', file), false, 'a held lock must not be re-taken');
+	await releaseLock(runner, 'Ubuntu', file);
+	assert.strictEqual(await acquireLock(runner, 'Ubuntu', file), true, 'released lock must be re-taken');
+});
+
+test('the lock age turns stat seconds into milliseconds', async () => {
+	const seconds = Math.floor(Date.now() / 1000) - 30;
+	const runner = { exec: async () => ({ code: 0, stdout: `${seconds}\n`, stderr: '' }), spawn: () => { throw new Error('not used'); } };
+	const age = await lockAgeMs(runner, 'Ubuntu', '/home/u/.picket-code-server/runtime/Ubuntu.json');
+	assert.ok(age !== undefined && age >= 30000 && age < 33000, `unexpected age ${age}`);
+	const gone = { exec: async () => ({ code: 0, stdout: '', stderr: '' }), spawn: () => { throw new Error('not used'); } };
+	assert.strictEqual(await lockAgeMs(gone, 'Ubuntu', '/home/u/.picket-code-server/runtime/Ubuntu.json'), undefined);
+});
+
+test('a runtime write that exits non-zero is a failure, not a record', async () => {
+	const runner = { exec: async () => ({ code: 1, stdout: '', stderr: 'mv: cannot create regular file' }), spawn: () => { throw new Error('not used'); } };
+	await assert.rejects(() => writeRuntime(runner, '/home/u/runtime/Ubuntu.json', { port: 1, token: 't', version: 'T', commit: 'C', pid: 2, startedAt: 'now' }, 'Ubuntu'),
+		/mv: cannot create regular file/);
+	const ok = { exec: async () => ({ code: 0, stdout: '', stderr: '' }), spawn: () => { throw new Error('not used'); } };
+	await writeRuntime(ok, '/home/u/runtime/Ubuntu.json', { port: 1, token: 't', version: 'T', commit: 'C', pid: 2, startedAt: 'now' }, 'Ubuntu');
+});
+
+test('clearing the runtime record leaves the start lock alone', async () => {
+	// adoptOrStart takes the lock and then clears the record before starting. If
+	// the clear also removed the lock, every window would start its own server.
+	const calls = [];
+	const runner = { exec: async (args) => { calls.push(args.join(' ')); return { code: 0, stdout: '', stderr: '' }; }, spawn: () => { throw new Error('not used'); } };
+	await clearRuntime(runner, '/home/u/.picket-code-server/runtime/Ubuntu.json', 'Ubuntu');
+	assert.deepStrictEqual(calls, ['-d Ubuntu -e sh -c rm -f "$1" sh /home/u/.picket-code-server/runtime/Ubuntu.json']);
+});
+
+test('stop signals the in-distro pid it was given', async () => {
+	const calls = [];
+	const runner = { exec: async (args) => { calls.push(args.join(' ').replace(/-d Ubuntu -e /, '')); return { code: 0, stdout: '', stderr: '' }; }, spawn: () => { throw new Error('not used'); } };
+	await stopServer({ runner, distro: 'Ubuntu', runtimeFile: '/home/u/runtime/Ubuntu.json', info: { port: 1, token: 't', version: 'T', commit: 'C', pid: 4321, startedAt: 'now' }, waitMs: 0 });
+	assert.deepStrictEqual(calls, [
+		'kill -TERM 4321',
+		'sh -c kill -9 "$1" 2>/dev/null || true sh 4321',
+		'sh -c rm -f "$1" sh /home/u/runtime/Ubuntu.json'
+	]);
+});
+
+test('an unknown pid is never handed to kill', async () => {
+	// `kill -TERM -1` signals every process the user may signal, `kill -9 0` the
+	// whole process group. -1 is what a start records when the pid line is absent.
+	const calls = [];
+	const runner = { exec: async (args) => { calls.push(args.join(' ').replace(/-d Ubuntu -e /, '')); return { code: 0, stdout: '', stderr: '' }; }, spawn: () => { throw new Error('not used'); } };
+	await stopServer({ runner, distro: 'Ubuntu', runtimeFile: '/home/u/runtime/Ubuntu.json', info: { port: 1, token: 't', version: 'T', commit: 'C', pid: -1, startedAt: 'now' }, waitMs: 0, dataDir: '/home/u/data' });
+	assert.ok(!calls.some(c => /\bkill -/.test(c)), `no kill may run for pid -1: ${JSON.stringify(calls)}`);
+	assert.ok(calls.some(c => c.includes('pkill')), 'the sweep is what still stops it');
+});
diff --git a/extensions/picket-remote-wsl/test/manage.test.js b/extensions/picket-remote-wsl/test/manage.test.js
