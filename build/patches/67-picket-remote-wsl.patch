@@ -0,0 +1,417 @@
+'use strict';
+
+const { randomBytes } = require('node:crypto');
+
+/** @typedef {{ port: number, token: string, version: string, commit: string, pid: number, startedAt: string, tunnelMode?: string, icode?: string }} IRuntimeInfo */
+
+/**
+ * Sourced inside the distro before the binary starts: the login shell has by
+ * then applied the user's profile, so `PATH`, `NVM_DIR`, `BUN_INSTALL` and
+ * friends are what an interactive shell would see. Every value arrives as an
+ * argv entry, so nothing here is ever re-parsed by a shell.
+ */
+const LAUNCH_SCRIPT = 'setup="$1"; icode="$2"; shift 2; [ -f "$setup" ] && . "$setup"; [ -n "$icode" ] && export PICKET_ICODE_BIN="$icode"; echo "picket-server-pid $$"; exec "$0" "$@"';
+
+/** @type {readonly string[]} */
+const SERVER_FLAGS = [
+	'--host=127.0.0.1',
+	'--port=0',
+	'--use-host-proxy',
+	'--without-browser-env-var',
+	'--disable-websocket-compression',
+	'--accept-server-license-terms'
+];
+
+/**
+ * @param {string} home
+ * @param {string} tag
+ */
+function serverPaths(home, tag) {
+	const root = `${home}/.vscode-server`;
+	const stateDir = `${home}/.picket-code-server`;
+	const payloadDir = `${root}/bin/picket-${tag}`;
+	return {
+		root,
+		payloadDir,
+		binary: `${payloadDir}/bin/picket-code-server`,
+		node: `${payloadDir}/node`,
+		remoteCli: `${payloadDir}/bin/remote-cli/picket-code`,
+		cliLink: `${home}/.local/bin/picket-code`,
+		dataDir: `${root}/data`,
+		extensionsDir: `${root}/extensions`,
+		logDir: `${stateDir}/logs`,
+		stateDir,
+		runtimeDir: `${stateDir}/runtime`,
+		envSetupFile: `${root}/server-env-setup`
+	};
+}
+
+/**
+ * `~/.vscode-server/bin/picket-<version>` is the only place a version is
+ * spelled out for an installed payload, so it is what a start reads back.
+ * @param {string} payloadDir
+ * @returns {string}
+ */
+function versionFromPayloadDir(payloadDir) {
+	const marker = '/picket-';
+	const at = payloadDir.lastIndexOf(marker);
+	return at === -1 ? payloadDir : payloadDir.slice(at + marker.length);
+}
+
+/**
+ * One server per distro, so one record per distro: two distros must not be able
+ * to overwrite each other's port and token.
+ * @param {string} home
+ * @param {string} distro
+ */
+function runtimeFileFor(home, distro) {
+	return `${home}/.picket-code-server/runtime/${distro}.json`;
+}
+
+/**
+ * @param {{ paths: ReturnType<typeof serverPaths>, connectionToken: string, icodeBin?: string, distro: string, loginShell?: boolean }} options
+ * @returns {string[]}
+ */
+function buildServerArgs(options) {
+	const { paths, connectionToken, icodeBin, distro } = options;
+	// `-l` is what makes a login shell read `/etc/profile` and the user's
+	// profile, which is where `nvm`, `pyenv` and custom `PATH` entries live.
+	const shell = options.loginShell === false ? '-c' : '-lc';
+	const flags = SERVER_FLAGS.flatMap(flag => flag === '--port=0' ? [flag, `--connection-token=${connectionToken}`] : [flag]);
+	return [
+		'-d', distro, '-e', 'sh', shell, LAUNCH_SCRIPT, paths.binary, paths.envSetupFile, icodeBin ?? '',
+		...flags,
+		`--user-data-dir=${paths.dataDir}`,
+		`--extensions-dir=${paths.extensionsDir}`,
+		'--log=trace'
+	];
+}
+
+/**
+ * The server picks its own port (`--port=0`) and announces it once. Profile
+ * banners and warnings are expected around the line, so only an exact match
+ * to the first announcement counts.
+ *
+ * The pid is the one the launch script announces just before `exec`, so it is
+ * an in-distro pid; the Windows `wsl.exe` pid is useless for `kill`.
+ *
+ * Either line can arrive split across chunks, so text is held until its
+ * newline shows up.
+ */
+function createLaunchParser() {
+	let partial = '';
+	return {
+		port: /** @type {number | undefined} */ (undefined),
+		pid: /** @type {number | undefined} */ (undefined),
+		/** @param {string} text */
+		feed(text) {
+			partial += text;
+			let index;
+			while ((index = partial.indexOf('\n')) !== -1) {
+				this.onLine(partial.slice(0, index).replace(/\r$/, ''));
+				partial = partial.slice(index + 1);
+			}
+		},
+		/** @param {string} line */
+		onLine(line) {
+			if (this.pid === undefined) {
+				const pid = /^picket-server-pid (\d+)$/.exec(line);
+				if (pid) {
+					this.pid = Number(pid[1]);
+				}
+			}
+			if (this.port === undefined) {
+				const port = /Extension host agent listening on (\d+)/.exec(line);
+				if (port) {
+					this.port = Number(port[1]);
+				}
+			}
+		}
+	};
+}
+
+function newConnectionToken() {
+	return randomBytes(32).toString('base64url');
+}
+
+/**
+ * @param {any} runner
+ * @param {string} distro
+ * @param {string} runtimeFile
+ * @returns {Promise<IRuntimeInfo | undefined>}
+ */
+async function readRuntime(runner, distro, runtimeFile) {
+	const read = await runner.exec(['-d', distro, '-e', 'sh', '-c', 'cat "$1" 2>/dev/null || true', 'sh', runtimeFile]);
+	const text = String(read.stdout).trim();
+	if (!text) {
+		return undefined;
+	}
+	try {
+		const info = JSON.parse(text);
+		return typeof info?.port === 'number' ? info : undefined;
+	} catch {
+		return undefined;
+	}
+}
+
+/**
+ * A crash leaves the lock directory behind. Its age is what separates "another
+ * window is starting" from "a start died before it could clean up".
+ * @param {any} runner
+ * @param {string} distro
+ * @param {string} runtimeFile
+ * @returns {Promise<number | undefined>} age in milliseconds, or undefined when the lock is gone or unreadable
+ */
+async function lockAgeMs(runner, distro, runtimeFile) {
+	const result = await runner.exec(['-d', distro, '-e', 'sh', '-c', 'stat -c %Y "$1" 2>/dev/null || true', 'sh', `${runtimeFile}.lock`]);
+	const seconds = Number(String(result.stdout).trim());
+	return Number.isFinite(seconds) && seconds > 0 ? Date.now() - seconds * 1000 : undefined;
+}
+
+/**
+ * @param {any} runner
+ * @param {string} distro
+ * @param {string} runtimeFile
+ * @returns {Promise<boolean>} true when a start is in progress somewhere
+ */
+async function isStartLocked(runner, distro, runtimeFile) {
+	const lock = await runner.exec(['-d', distro, '-e', 'sh', '-c', 'if [ -e "$1" ]; then printf 1; else printf 0; fi', 'sh', `${runtimeFile}.lock`]);
+	return String(lock.stdout).trim() !== '0';
+}
+
+/**
+ * `mkdir` is the atomic primitive every POSIX filesystem has: exactly one of two
+ * racing windows gets a zero exit. A read of the runtime file only happens when
+ * no lock is held, so a second window never adopts a record that is about to be
+ * replaced.
+ * @param {any} runner
+ * @param {string} distro
+ * @param {string} runtimeFile
+ * @returns {Promise<IRuntimeInfo | undefined>}
+ */
+async function lockAndRead(runner, distro, runtimeFile) {
+	if (await isStartLocked(runner, distro, runtimeFile)) {
+		return undefined;
+	}
+	return readRuntime(runner, distro, runtimeFile);
+}
+
+/**
+ * @param {any} runner
+ * @param {string} distro
+ * @param {string} runtimeFile
+ * @returns {Promise<boolean>} true when this caller owns the lock
+ */
+async function acquireLock(runner, distro, runtimeFile) {
+	const taken = await runner.exec(['-d', distro, '-e', 'sh', '-c', 'mkdir -p "$(dirname "$1")" && mkdir "$1" 2>/dev/null', 'sh', `${runtimeFile}.lock`]);
+	return taken.code === 0;
+}
+
+/**
+ * @param {any} runner
+ * @param {string} distro
+ * @param {string} runtimeFile
+ */
+async function releaseLock(runner, distro, runtimeFile) {
+	await runner.exec(['-d', distro, '-e', 'sh', '-c', 'rmdir "$1" 2>/dev/null || rm -rf "$1"', 'sh', `${runtimeFile}.lock`]);
+}
+
+/**
+ * @param {any} runner
+ * @param {string} runtimeFile
+ * @param {IRuntimeInfo} info
+ * @param {string} distro
+ */
+async function writeRuntime(runner, runtimeFile, info, distro) {
+	const json = JSON.stringify(info);
+	const result = await runner.exec(['-d', distro, '-e', 'sh', '-c', 'mkdir -p "$(dirname "$1")" && printf %s "$2" > "$1.tmp" && mv "$1.tmp" "$1"', 'sh', runtimeFile, json]);
+	if (result.code !== 0) {
+		// `exec` resolves with the exit code; a shell that could not write must not
+		// look like a written record, or the next window starts a second server.
+		throw new Error(`exit ${result.code}${String(result.stderr ?? '').trim() ? `: ${String(result.stderr).trim()}` : ''}`);
+	}
+}
+
+/**
+ * @param {any} runner
+ * @param {string} runtimeFile
+ * @param {string} distro
+ */
+async function clearRuntime(runner, runtimeFile, distro) {
+	// Only the record: the start lock belongs to whoever took it, and a caller
+	// that clears a record may not be the one holding it. Stale locks are
+	// removed by releaseLock, which runs at the end of every start attempt.
+	await runner.exec(['-d', distro, '-e', 'sh', '-c', 'rm -f "$1"', 'sh', runtimeFile]);
+}
+
+/**
+ * @param {string[]} args
+ * @param {string} prefix
+ * @returns {string | undefined}
+ */
+function argValue(args, prefix) {
+	const index = args.findIndex(a => a.startsWith(prefix));
+	return index === -1 ? undefined : args[index].slice(prefix.length);
+}
+
+/**
+ * @param {{ runner: any, distro: string, args: string[], runtimeFile: string, timeoutMs?: number, extra?: Record<string, unknown>, log?: { info(...parts: unknown[]): void, error(...parts: unknown[]): void }, writeRuntime?: typeof writeRuntime }} options
+ * @returns {Promise<IRuntimeInfo>}
+ */
+async function startServer(options) {
+	const { runner, distro, args, runtimeFile } = options;
+	const timeoutMs = options.timeoutMs ?? 90000;
+	const log = options.log ?? { info() { }, error() { } };
+	const persist = options.writeRuntime ?? writeRuntime;
+	const token = argValue(args, '--connection-token=') ?? '';
+	const version = /bin\/picket-([^/]+)\/bin\//.exec(args[6] ?? args.join(' '))?.[1] ?? '';
+
+	return new Promise((resolve, reject) => {
+		const { child, stdout, stderr } = runner.spawn(args);
+		const parser = createLaunchParser();
+		/** @type {string[]} */
+		const tail = [];
+		let settled = false;
+
+		const timer = setTimeout(() => {
+			if (settled) {
+				return;
+			}
+			settled = true;
+			child.kill();
+			const last = tail.slice(-40).join('\n');
+			reject(new Error(`Start timed out after ${formatMs(timeoutMs)}${last ? `:\n${last}` : ''}`));
+		}, timeoutMs);
+		timer.unref?.();
+
+		/** @param {Buffer | string} chunk */
+		const onChunk = (chunk) => {
+			const text = String(chunk);
+			for (const line of text.split(/\r?\n/)) {
+				if (line.trim()) {
+					tail.push(line.trim());
+					if (tail.length > 40) {
+						tail.shift();
+					}
+					log.info(`[server] ${line.trim()}`);
+				}
+			}
+			parser.feed(text);
+			if (parser.port !== undefined && !settled) {
+				settled = true;
+				clearTimeout(timer);
+				// An empty commit can never match the product stamp, so a caller that
+				// forgets to pass one gets a record no window will adopt, not a wrong one.
+				/** @type {IRuntimeInfo} */
+				const info = { port: parser.port, token, version, commit: '', pid: parser.pid ?? -1, startedAt: new Date().toISOString(), ...(options.extra ?? {}) };
+				// The record is the only way another window can find this server, so a
+				// start that cannot write it is a failed start, not a running one.
+				persist(runner, runtimeFile, info, distro).then(
+					() => resolve(info),
+					(error) => {
+						log.error(`Could not write ${runtimeFile}: ${error.message}`);
+						child.kill();
+						reject(new Error(`The server for ${distro} started on port ${info.port} but its record could not be written (${error.message}); the process was stopped.`));
+					});
+			}
+		};
+		stdout?.on('data', onChunk);
+		stderr?.on('data', onChunk);
+
+		child.on('error', (error) => {
+			if (settled) {
+				return;
+			}
+			settled = true;
+			clearTimeout(timer);
+			reject(error);
+		});
+		child.on('close', ( /** @type {number | null} */ code) => {
+			if (settled) {
+				return;
+			}
+			settled = true;
+			clearTimeout(timer);
+			const last = tail.slice(-40).join('\n');
+			if (code === 99) {
+				reject(new Error(`WSL 1 or an unsupported distro cannot run the server (exit 99). Convert with "wsl --set-version <distro> 2".${last ? `\n${last}` : ''}`));
+				return;
+			}
+			reject(new Error(`Server exited with code ${code}${last ? `:\n${last}` : ''}`));
+		});
+	});
+}
+
+/** @param {number} ms */
+function formatMs(ms) {
+	return ms % 1000 === 0 ? `${ms / 1000} s` : `${ms} ms`;
+}
+
+/**
+ * Best effort and in a fixed order: TERM, wait, probe, KILL, sweep, forget.
+ * A failure at one step must not stop the next — a stale server is worse than
+ * a noisy log.
+ * @param {{ runner: any, distro: string, runtimeFile: string, info: IRuntimeInfo, log?: any, probe?: (info: IRuntimeInfo) => Promise<string>, waitMs?: number, dataDir?: string }} options
+ */
+async function stopServer(options) {
+	const { runner, distro, runtimeFile, info } = options;
+	const log = options.log ?? { info() { }, error() { } };
+	const probe = options.probe;
+	const waitMs = options.waitMs ?? 5000;
+
+	const step = async (name, fn) => {
+		try {
+			await fn();
+			log.info(`stop: ${name} ok`);
+		} catch (error) {
+			log.error(`stop: ${name} failed: ${error.message}`);
+		}
+	};
+
+	// A pid of 0 or below means "unknown" (-1 is the recorded fallback). Passing it
+	// to kill would be catastrophic: `kill -TERM -1` signals every process this
+	// user may signal, and `kill -9 0` the whole process group. The sweep below
+	// still stops the server by its --user-data-dir.
+	const killable = Number.isInteger(info.pid) && info.pid > 0;
+	if (killable) {
+		await step('SIGTERM', () => runner.exec(['-d', distro, '-e', 'kill', '-TERM', String(info.pid)]));
+		await step('wait', () => new Promise(resolve => setTimeout(resolve, waitMs)));
+	}
+	if (probe) {
+		await step('probe', async () => {
+			if (await probe(info) === 'dead') {
+				log.info('stop: server is gone');
+				return;
+			}
+			throw new Error('still answering');
+		});
+	}
+	if (killable) {
+		await step('SIGKILL', () => runner.exec(['-d', distro, '-e', 'sh', '-c', 'kill -9 "$1" 2>/dev/null || true', 'sh', String(info.pid)]));
+	}
+	if (options.dataDir) {
+		await step('sweep', () => runner.exec(['-d', distro, '-e', 'sh', '-c', 'pkill -f "picket-code-server.*--user-data-dir=$1" 2>/dev/null || true', 'sh', options.dataDir]));
+	}
+	await step('clear runtime', () => clearRuntime(runner, runtimeFile, distro));
+}
+
+module.exports = {
+	LAUNCH_SCRIPT,
+	SERVER_FLAGS,
+	serverPaths,
+	versionFromPayloadDir,
+	runtimeFileFor,
+	buildServerArgs,
+	createLaunchParser,
+	newConnectionToken,
+	readRuntime,
+	lockAgeMs,
+	isStartLocked,
+	lockAndRead,
+	acquireLock,
+	releaseLock,
+	writeRuntime,
+	clearRuntime,
+	startServer,
+	stopServer
+};
diff --git a/extensions/picket-remote-wsl/src/log.js b/extensions/picket-remote-wsl/src/log.js
new file mode 100644
index 00000000..918896a0
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/log.js
@@ -0,0 +1,45 @@
+'use strict';
+
+const vscode = require('vscode');
+const { appendFile, mkdir } = require('node:fs/promises');
+const { dirname, join } = require('node:path');
+
+/**
+ * Two sinks so a user can read the log in the editor and a supporter can ask
+ * for a file: the OutputChannel is live, the file survives a closed window.
+ * @param {vscode.ExtensionContext} context
+ */
+function createLog(context) {
+	const channel = vscode.window.createOutputChannel('Picket WSL');
+	const file = join(context.logUri.fsPath, 'picket-wsl.log');
+	context.subscriptions.push(channel);
+
+	/** @param {unknown[]} parts */
+	function write(parts) {
+		const line = parts.map(p => (typeof p === 'string' ? p : String(p))).join(' ');
+		channel.appendLine(line);
+		void mkdir(dirname(file), { recursive: true })
+			.then(() => appendFile(file, `${new Date().toISOString()} ${line}\n`))
+			.catch(() => { /* the channel already has it; a log file failure must not throw */ });
+	}
+
+	return {
+		/** @param {...unknown} parts */
+		info(...parts) {
+			write(parts);
+		},
+		/** @param {...unknown} parts */
+		error(...parts) {
+			write(['ERROR', ...parts]);
+		},
+		show() {
+			channel.show(true);
+		},
+		dispose() {
+			channel.dispose();
+		},
+		logFile: file
+	};
+}
+
+module.exports = { createLog };
diff --git a/extensions/picket-remote-wsl/src/manage.js b/extensions/picket-remote-wsl/src/manage.js
new file mode 100644
index 00000000..3769f45d
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/manage.js
@@ -0,0 +1,92 @@
+'use strict';
+
+const { decodeWslOutput } = require('./distro.js');
+
+/**
+ * A distro name reaches a shell only through this gate. `wsl --install` is run
+ * in a terminal the user can see, but the name still comes from a table we
+ * parsed, so anything that is not a plain distro name is refused rather than
+ * quoted and hoped for.
+ */
+const PLAIN_NAME = /^[A-Za-z0-9._-]+$/;
+
+/**
+ * `wsl.exe --list --online` prints a header, a hint paragraph and rows whose
+ * columns are separated by two or more spaces. Everything else is noise.
+ * @param {string} stdout
+ * @returns {Array<{ name: string, friendly: string }>}
+ */
+function parseOnlineTable(stdout) {
+	/** @type {Array<{ name: string, friendly: string }>} */
+	const rows = [];
+	for (const raw of decodeWslOutput(stdout).split(/\r?\n/)) {
+		const parts = raw.split(/\s{2,}/).map(part => part.trim()).filter(Boolean);
+		if (parts.length < 2) {
+			continue;
+		}
+		if (/^NAME$/i.test(parts[0])) {
+			continue;
+		}
+		if (/^docker-desktop/i.test(parts[0])) {
+			continue;
+		}
+		rows.push({ name: parts[0], friendly: parts.slice(1).join(' ') });
+	}
+	return rows;
+}
+
+/**
+ * @param {{ host: any, runner: any, action: 'add' | 'setDefault' | 'delete', distro?: string }} options
+ * @returns {Promise<void>}
+ */
+async function manageDistro(options) {
+	const { host, runner, action, distro } = options;
+
+	if (action === 'setDefault') {
+		const result = await runner.exec(['--set-default', distro]);
+		if (result.code !== 0) {
+			await host.showErrorMessage(`无法把 ${distro} 设为默认发行版：${decodeWslOutput(result.stderr)}`);
+		}
+		return;
+	}
+
+	if (action === 'delete') {
+		const confirmed = await host.showWarningMessage(
+			`删除 ${distro} 会删除它里面的所有文件，且无法撤销。确定要删除吗？`,
+			{ modal: true },
+			'删除'
+		);
+		if (confirmed !== '删除') {
+			return;
+		}
+		const result = await runner.exec(['--unregister', distro]);
+		if (result.code !== 0) {
+			await host.showErrorMessage(`无法删除 ${distro}：${decodeWslOutput(result.stderr)}`);
+		}
+		return;
+	}
+
+	const listed = await runner.exec(['--list', '--online']);
+	const rows = parseOnlineTable(String(listed.stdout));
+	if (rows.length === 0) {
+		await host.showErrorMessage(`无法读取可安装的发行版列表：${decodeWslOutput(listed.stderr) || '列表为空'}`);
+		return;
+	}
+	const picked = await host.showQuickPick(
+		rows.map(row => ({ label: row.friendly ? `${row.name}（${row.friendly}）` : row.name, name: row.name })),
+		{ placeHolder: '选择要安装的 WSL 发行版' }
+	);
+	if (!picked) {
+		return;
+	}
+	const name = typeof picked === 'string' ? picked : picked.name;
+	if (!PLAIN_NAME.test(name ?? '')) {
+		await host.showErrorMessage(`非法发行版名称：${name ?? '(空)'}`);
+		return;
+	}
+	// Visible in a terminal on purpose: the install downloads gigabytes and asks
+	// for a UNIX user name, so it cannot be a silent background step.
+	host.runInTerminal(`wsl.exe --install -d '${name}'`);
+}
+
+module.exports = { manageDistro, parseOnlineTable, PLAIN_NAME };
diff --git a/extensions/picket-remote-wsl/src/marketplace.js b/extensions/picket-remote-wsl/src/marketplace.js
new file mode 100644
index 00000000..1e33e1a7
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/marketplace.js
@@ -0,0 +1,143 @@
+'use strict';
+
+/**
+ * The Extensions Marketplace is a core setting, not ours: `extensions.gallery.serviceUrl` points
+ * the client at a gallery and `extensions.gallery.authProvider` says who vouches for it. Both are
+ * application-scoped, so what a command writes here is exactly what an administrator would paste
+ * into `settings.json` — no second file format, and a value that survives an upgrade.
+ */
+const SERVICE_URL = 'serviceUrl';
+const AUTH_PROVIDER = 'authProvider';
+/** The `authProvider` value for a gallery that authenticates nobody: Open VSX and its mirrors. */
+const NO_ACCOUNT = 'none';
+/** The `serviceUrl` value that turns the gallery off rather than pointing it somewhere. */
+const DISABLED = 'none';
+const RELOAD = '重新加载';
+
+const MODES = [
+	{ id: 'default', label: 'Open VSX（默认）', detail: '使用发行包内置的市场地址' },
+	{ id: 'custom', label: '内网/自建 gallery…', detail: '填一个 Open VSX 兼容的地址，不需要登录' },
+	{ id: 'none', label: '关闭（离线，只用 VSIX）', detail: '不再发市场请求，扩展用 .vsix 离线安装' }
+];
+
+/**
+ * @param {{ serviceUrl?: string }} [config]
+ * @returns {{ mode: 'default' } | { mode: 'none' } | { mode: 'custom', serviceUrl: string }}
+ */
+function describeGallery(config = {}) {
+	const serviceUrl = String(config.serviceUrl ?? '');
+	if (serviceUrl === DISABLED) {
+		return { mode: 'none' };
+	}
+	if (serviceUrl) {
+		return { mode: 'custom', serviceUrl };
+	}
+	return { mode: 'default' };
+}
+
+/**
+ * Writing `undefined` removes the key, which is how "back to the build's own gallery" survives a
+ * later build shipping a different default. Nosy validation stays here rather than in the input
+ * box: the box is a hint, this is the gate.
+ * @param {{ mode: 'default' | 'none' | 'custom', url?: string, configuration: any }} options
+ * @returns {Promise<string>} the value the setting now holds ('' for the default gallery)
+ */
+async function applyGalleryMode({ mode, url, configuration }) {
+	if (mode === 'custom') {
+		const value = String(url ?? '').trim().replace(/\/+$/, '');
+		if (!/^https?:\/\/[^/]+/i.test(value)) {
+			throw new Error('市场地址必须以 http:// 或 https:// 开头，例如 https://openvsx.example.com/vscode/gallery');
+		}
+		await configuration.update(SERVICE_URL, value);
+		await configuration.update(AUTH_PROVIDER, NO_ACCOUNT);
+		return value;
+	}
+	if (mode === 'none') {
+		await configuration.update(SERVICE_URL, DISABLED);
+		await configuration.update(AUTH_PROVIDER, undefined);
+		return DISABLED;
+	}
+	await configuration.update(SERVICE_URL, undefined);
+	await configuration.update(AUTH_PROVIDER, undefined);
+	return '';
+}
+
+/**
+ * @param {{ host: any, configuration: any }} options
+ * @returns {Promise<boolean>} whether a setting was written
+ */
+async function selectGallery({ host, configuration }) {
+	const current = describeGallery({ serviceUrl: configuration.get(SERVICE_URL) });
+	const picked = await host.showQuickPick(
+		MODES.map(mode => ({
+			label: mode.label,
+			description: mode.id === current.mode ? '当前' : undefined,
+			detail: mode.detail,
+			mode: mode.id
+		})),
+		{ placeHolder: '选择扩展市场来源' }
+	);
+	if (!picked) {
+		return false;
+	}
+	const mode = typeof picked === 'string' ? MODES.find(candidate => candidate.label === picked)?.id : picked.mode;
+	if (!mode) {
+		return false;
+	}
+
+	let url;
+	if (mode === 'custom') {
+		url = await host.showInputBox({
+			prompt: 'Open VSX 兼容的 gallery 地址',
+			placeHolder: 'https://openvsx.example.com/vscode/gallery',
+			value: current.mode === 'custom' ? current.serviceUrl : '',
+			validateInput: (value) => (/^https?:\/\/[^/]+/i.test(String(value ?? '').trim()) ? undefined : '必须以 http:// 或 https:// 开头')
+		});
+		if (url === undefined) {
+			return false;
+		}
+	}
+
+	try {
+		await applyGalleryMode({ mode, url, configuration });
+	} catch (error) {
+		await host.showErrorMessage(error.message);
+		return false;
+	}
+
+	// The marketplace is resolved once per window (the manifest service asks for a restart when
+	// the setting changes), so say so instead of pretending the new source is live.
+	const choice = await host.showInformationMessage('扩展市场来源已保存，重新加载窗口后生效。', RELOAD);
+	if (choice === RELOAD) {
+		await host.executeCommand('workbench.action.reloadWindow');
+	}
+	return true;
+}
+
+/**
+ * The air-gapped path: a packaged extension is the only way in when no gallery is reachable.
+ * @param {{ host: any }} options
+ * @returns {Promise<boolean>}
+ */
+async function installVsix({ host }) {
+	const picked = await host.showOpenDialog({
+		canSelectFiles: true,
+		canSelectMany: false,
+		title: '选择 .vsix 扩展包',
+		filters: { '扩展包': ['vsix'] }
+	});
+	const file = Array.isArray(picked) ? picked[0] : picked;
+	if (!file) {
+		return false;
+	}
+	try {
+		await host.executeCommand('workbench.extensions.installExtension', file);
+		await host.showInformationMessage('安装请求已提交，进度见“扩展”视图。');
+		return true;
+	} catch (error) {
+		await host.showErrorMessage(`安装 .vsix 失败：${error.message}`);
+		return false;
+	}
+}
+
+module.exports = { MODES, NO_ACCOUNT, DISABLED, describeGallery, applyGalleryMode, selectGallery, installVsix };
diff --git a/extensions/picket-remote-wsl/src/nudge.js b/extensions/picket-remote-wsl/src/nudge.js
