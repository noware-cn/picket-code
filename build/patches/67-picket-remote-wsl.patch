+test('a size that disagrees with the catalog aborts before hashing', async () => {
+	const dir = mkdtempSync(join(tmpdir(), 'picket-payload-'));
+	const file = join(dir, 'short.tar.gz');
+	writeFileSync(file, 'abcd');
+	const sha = createHash('sha256').update('abcd').digest('hex');
+	const calls = [];
+	const runner = { exec: async (args) => { calls.push(args.join(' ')); return { code: 0, stdout: '', stderr: '' }; } };
+	await assert.rejects(() => installPayload({ runner, distro: 'D', component: { ...COMPONENT, sha256: sha },
+		source: { kind: 'file', path: file }, payloadRoot: '/home/u/.vscode-server/bin' }),
+	/Size mismatch for .*: expected 3 bytes, got 4/);
