+++ b/extensions/picket-remote-wsl/src/diagnose.js
@@ -0,0 +1,279 @@
+'use strict';
+
+const { readFile } = require('node:fs/promises');
+const { join } = require('node:path');
+const { listDistros, defaultDistro, distroHome, wslStatus } = require('./distro.js');
+const { readProduct } = require('./product.js');
+const { detectIcode } = require('./icode.js');
+const { describeGallery } = require('./marketplace.js');
+const { chooseTunnelMode, readWslConfigFile, wslConfigPath } = require('./preflight.js');
+const { describeOfficialSettings } = require('./settings.js');
+const { compareVersions, engineMinimum } = require('./version.js');
+
+// One shell pass for every installed extension's manifest: a per-extension round
+// trip through `wsl.exe` would make the report take seconds on a machine with a
+// normal number of extensions. The tab is the only separator that cannot appear
+// in a path we hand in ourselves.
+const READ_MANIFESTS = 'for p in "$@"; do printf \'%s\\t\' "$p"; cat "$p/package.json" 2>/dev/null | tr -d \'\\r\\n\'; printf \'\\n\'; done';
+
+/**
+ * The shared `~/.vscode-server` is what makes takeover work, and it is also what
+ * carries the previous owner's extensions over: one built for the official server
+ * may declare an `engines.vscode` this client cannot satisfy, and the only
+ * symptom is that the extension quietly never activates. This section turns that
+ * into a line someone can act on.
+ * @param {{ runner: any, distro: string, home: string, productsVersion?: string }} options
+ * @returns {Promise<string[]>}
+ */
+async function extensionLines(options) {
+	const { runner, distro, home, productsVersion } = options;
+	const root = `${home}/.vscode-server/extensions`;
+	const read = async (/** @type {string} */ path) => String((await runner.exec(['-d', distro, '-e', 'sh', '-c', 'cat "$1" 2>/dev/null || true', 'sh', path])).stdout);
+
+	const raw = (await read(`${root}/extensions.json`)).trim();
+	if (!raw) {
+		return ['(none)'];
+	}
+	/** @type {any[]} */
+	let entries;
+	try {
+		const parsed = JSON.parse(raw);
+		// Written as an array, documented as `{ extensions: [] }`: both are in the wild.
+		entries = Array.isArray(parsed) ? parsed : Array.isArray(parsed?.extensions) ? parsed.extensions : [];
+	} catch {
+		return ['(none)'];
+	}
+	if (entries.length === 0) {
+		return ['(none)'];
+	}
+
+	const located = entries.map(entry => {
+		const location = entry?.location;
+		const path = String((typeof location === 'string' ? location : location?.path ?? location?.fsPath) || '');
+		return {
+			id: String(entry?.identifier?.id ?? entry?.id ?? 'unknown'),
+			version: String(entry?.version ?? '?'),
+			path: path || (entry?.relativeLocation ? `${root}/${entry.relativeLocation}` : '')
+		};
+	});
+
+	/** @type {Map<string, string | undefined>} */
+	const engines = new Map();
+	const paths = located.map(entry => entry.path).filter(Boolean);
+	if (paths.length > 0) {
+		const output = String((await runner.exec(['-d', distro, '-e', 'sh', '-c', READ_MANIFESTS, 'sh', ...paths])).stdout);
+		for (const line of output.split(/\r?\n/)) {
+			const tab = line.indexOf('\t');
+			if (tab <= 0) {
+				continue;
+			}
+			try {
+				engines.set(line.slice(0, tab), JSON.parse(line.slice(tab + 1))?.engines?.vscode);
+			} catch {
+				// Unparsable manifest: not evidence of a clash, so leave it unknown.
+			}
+		}
+	}
+
+	const lines = located.map(entry => {
+		const range = engines.get(entry.path);
+		const minimum = engineMinimum(range);
+		const compatible = !minimum || !productsVersion
+			? 'unknown'
+			: compareVersions(productsVersion, minimum) >= 0 ? 'yes' : 'no';
+		return `${entry.id}@${entry.version}  engines=${range || 'unknown'}  compatible=${compatible}`;
+	});
+	if (lines.some(line => line.endsWith('compatible=no'))) {
+		lines.push('the extensions marked compatible=no were installed for the official server; reinstall them from this build');
+	}
+	return lines;
+}
+
+/**
+ * A support report is only useful if it is complete, so every probe is fenced:
+ * a broken distro or a missing binary degrades to `unavailable: <reason>` on
+ * that one line instead of truncating everything after it.
+ * @param {{
+ *   runner: any,
+ *   settings?: any,
+ *   catalog?: any,
+ *   components: (ctx: { distro: string, home: string, runner: any }) => { list(): Promise<any[]> },
+ *   appRoot?: string,
+ *   gallery?: { serviceUrl?: string },
+ *   platform?: string,
+ *   official?: { installed: boolean, blocked: boolean } | (() => { installed: boolean, blocked: boolean }),
+ *   productsVersion?: string,
+ *   readWslConfig?: () => Promise<{ localhostForwarding?: boolean, networkingMode?: string }>
+ * }} options
+ * @returns {Promise<string>}
+ */
+async function buildDiagnostics(options) {
+	const { runner, catalog, components } = options;
+	const settings = options.settings ?? {};
+	const appRoot = options.appRoot ?? '';
+	/** @type {string[]} */
+	const lines = [];
+
+	/**
+	 * @param {string} title
+	 * @param {() => Promise<string | string[]>} probe
+	 */
+	const section = async (title, probe) => {
+		try {
+			const value = await probe();
+			if (Array.isArray(value)) {
+				lines.push(`${title}:`);
+				for (const line of value) {
+					lines.push(`  ${line}`);
+				}
+			} else {
+				lines.push(`${title}: ${value}`);
+			}
+		} catch (error) {
+			lines.push(`${title}: unavailable: ${error?.message ?? error}`);
+		}
+	};
+
+	const product = async () => JSON.parse(await readFile(join(appRoot, 'product.json'), 'utf8'));
+
+	lines.push('Picket WSL diagnostics');
+	lines.push('======================');
+
+	await section('Server version', async () => (await readProduct(appRoot)).version || 'none');
+	await section('Server minimum', async () => (await readProduct(appRoot)).picketServerMinVersion || 'none');
+
+	// A user arriving from the official extension carries `remote.WSL.*` in their
+	// settings; this is the one place that says which of those keys still do
+	// something here. Without the readers every line reads "(not set)".
+	await section('Official settings', async () => describeOfficialSettings(
+		settings.officialSettings ?? { readPicket: () => undefined, readOfficial: () => undefined }
+	));
+
+	await section('Official extension', async () => {
+		const state = typeof options.official === 'function' ? options.official() : options.official;
+		if (!state) {
+			return 'unknown';
+		}
+		return `installed=${state.installed ? 'yes' : 'no'}  blocked=${state.blocked ? 'yes' : 'no'}`;
+	});
+
+	await section('WSL', async () => {
+		const status = await wslStatus(runner);
+		if (!status.installed) {
+			return 'not installed';
+		}
+		return status.kernelUpdateRequired ? 'installed (kernel update required)' : 'installed';
+	});
+
+	/** @type {import('./distro.js').IDistro[]} */
+	let distros = [];
+	await section('Distros', async () => {
+		distros = await listDistros(runner);
+		if (distros.length === 0) {
+			return ['(none)'];
+		}
+		return distros.map(d => `${d.isDefault ? '*' : ' '} ${d.name}  ${d.state}  WSL ${d.version}`);
+	});
+
+	const configured = String(settings.defaultDistro ?? '').toLowerCase();
+	const primary = distros.length === 0
+		? undefined
+		: (configured && distros.find(d => d.name.toLowerCase() === configured)?.name) || defaultDistro(distros);
+
+	/** @param {string} distro @param {string} command */
+	const versionOf = async (distro, command) => {
+		const result = await runner.exec(['-d', distro, '-e', 'sh', '-lc', `${command} 2>/dev/null || true`]);
+		const text = String(result.stdout).trim().split(/\r?\n/).filter(Boolean).pop();
+		return text || 'not found';
+	};
+
+	await section('Tunnel mode', async () => {
+		const setting = settings.tunnelMode ?? 'auto';
+		const wslConfig = options.readWslConfig ? await options.readWslConfig() : await readWslConfigFile(wslConfigPath());
+		const mode = chooseTunnelMode({ configured: setting, wslConfig, platform: options.platform });
+		const hints = [];
+		if (wslConfig.localhostForwarding !== undefined) {
+			hints.push(`localhostForwarding=${wslConfig.localhostForwarding}`);
+		}
+		if (wslConfig.networkingMode) {
+			hints.push(`networkingMode=${wslConfig.networkingMode}`);
+		}
+		return `${mode} (setting=${setting}${hints.length > 0 ? `, ${hints.join(', ')}` : ''})`;
+	});
+
+	await section('Components', async () => {
+		if (!primary) {
+			throw new Error('no WSL distro installed');
+		}
+		if (!Array.isArray(catalog?.components) || catalog.components.length === 0) {
+			return ['(none in this build)'];
+		}
+		const home = await distroHome(runner, primary);
+		const rows = await components({ distro: primary, home, runner }).list();
+		return rows.map(row => `${row.id}  ${row.state}${row.version ? `  ${row.version}` : ''}${row.payloadDir ? `  ${row.payloadDir}` : ''}`);
+	});
+
+	// Extensions came with the shared root, not with this client; see extensionLines.
+	await section('Extensions', async () => {
+		if (!primary) {
+			throw new Error('no WSL distro installed');
+		}
+		return extensionLines({
+			runner,
+			distro: primary,
+			home: await distroHome(runner, primary),
+			productsVersion: options.productsVersion
+		});
+	});
+
+	// The old private root is not deleted on upgrade: it is the only copy of
+	// what the user had before the switch to the shared root, and the report is
+	// where someone looks before deciding to remove it by hand.
+	await section('Legacy data', async () => {
+		if (!primary) {
+			throw new Error('no WSL distro installed');
+		}
+		const home = await distroHome(runner, primary);
+		const legacy = `${home}/.picket-code-server/payloads`;
+		const result = await runner.exec(['-d', primary, '-e', 'sh', '-c', 'du -sh "$1" 2>/dev/null || true', 'sh', legacy]);
+		return String(result.stdout).trim() || 'none';
+	});
+
+	await section('iCode', async () => {
+		if (!primary) {
+			throw new Error('no WSL distro installed');
+		}
+		const found = await detectIcode({ runner, distro: primary, configuredPath: settings.icodePath ?? '' });
+		return found.path ? `${found.path} (${found.source})` : 'not found';
+	});
+
+	await section('node', async () => {
+		if (!primary) {
+			throw new Error('no WSL distro installed');
+		}
+		return versionOf(primary, 'node -v');
+	});
+
+	await section('git', async () => {
+		if (!primary) {
+			throw new Error('no WSL distro installed');
+		}
+		return versionOf(primary, 'git --version');
+	});
+
+	await section('Gallery', async () => {
+		const configured = describeGallery(options.gallery ?? {});
+		if (configured.mode === 'none') {
+			return 'none (disabled by extension setting)';
+		}
+		if (configured.mode === 'custom') {
+			return `custom (${configured.serviceUrl})`;
+		}
+		const gallery = (await product()).extensionsGallery ?? null;
+		return gallery ? `default (${gallery.serviceUrl})` : 'none (not in this build)';
+	});
+
+	return lines.join('\n');
+}
+
+module.exports = { buildDiagnostics };
diff --git a/extensions/picket-remote-wsl/src/distro.js b/extensions/picket-remote-wsl/src/distro.js
new file mode 100644
index 00000000..4b793ee5
--- /dev/null
+++ b/extensions/picket-remote-wsl/src/distro.js
@@ -0,0 +1,228 @@
+'use strict';
+
+const { spawn: spawnChild } = require('node:child_process');
+
+/**
+ * @typedef {{ name: string, isDefault: boolean, version: '1' | '2', state: string }} IDistro
+ * @typedef {{ code: number, stdout: Buffer | string, stderr: Buffer | string }} IWslResult
+ * @typedef {{ exec(args: string[], opts?: { input?: string | Buffer, timeoutMs?: number }): Promise<IWslResult>, spawn(args: string[]): { child: import('node:child_process').ChildProcess, stdout: import('node:stream').Readable | null, stderr: import('node:stream').Readable | null } }} IWslRunner
+ */
+
+/**
+ * wsl.exe writes --list output as UTF-16LE with a BOM and CRLF, and everything
+ * else as UTF-8. A NUL byte is the discriminator: no UTF-8 text we consume
+ * contains one, and every UTF-16LE ASCII string does.
+ * @param {Buffer | string} buffer
+ * @returns {string}
+ */
+function decodeWslOutput(buffer) {
+	const text = typeof buffer === 'string'
+		? buffer
+		: buffer.includes(0) ? buffer.toString('utf16le') : buffer.toString('utf8');
+	return text
+		.replace(/^\uFEFF/, '')
+		.split(/\r?\n/)
+		.map(line => line.trim())
+		.filter(line => line.length > 0)
+		.join('\n');
+}
+
+/**
+ * @param {string} distro
+ * @param {string[]} args
+ */
+function distroExec(distro, args) {
+	return ['-d', distro, '-e', ...args];
+}
+
+/**
+ * @param {{ wslPath?: string, spawn?: typeof spawnChild, cwd?: string, timeoutMs?: number }} [options]
+ * @returns {IWslRunner}
+ */
+function createWslRunner(options = {}) {
+	const wslPath = options.wslPath ?? 'wsl.exe';
+	const spawn = options.spawn ?? spawnChild;
+	const defaultTimeout = options.timeoutMs ?? 30000;
+
+	return {
+		exec(args, opts = {}) {
+			const timeoutMs = opts.timeoutMs ?? defaultTimeout;
+			return new Promise((resolve, reject) => {
+				const child = spawn(wslPath, args, { cwd: options.cwd, windowsHide: true });
+				// A distro side that dies before consuming the input makes the queued
+				// writes fail with EPIPE; the exit code and stderr carry the real
+				// failure, so the write error itself must not become an unhandled event.
+				child.stdin?.on('error', () => { });
+				/** @type {Buffer[]} */
+				const out = [];
+				/** @type {Buffer[]} */
+				const err = [];
+				let settled = false;
+				const timer = setTimeout(() => {
+					if (settled) {
+						return;
+					}
+					settled = true;
+					child.kill();
+					reject(new Error(`Timed out after ${timeoutMs} ms: wsl.exe ${args.join(' ')}`));
+				}, timeoutMs);
+				timer.unref?.();
+
+				child.stdout?.on('data', (chunk) => out.push(chunk));
+				child.stderr?.on('data', (chunk) => err.push(chunk));
+				child.on('error', (error) => {
+					if (settled) {
+						return;
+					}
+					settled = true;
+					clearTimeout(timer);
+					reject(error);
+				});
+				child.on('close', (code) => {
+					if (settled) {
+						return;
+					}
+					settled = true;
+					clearTimeout(timer);
+					resolve({ code: code ?? -1, stdout: Buffer.concat(out), stderr: Buffer.concat(err) });
+				});
+
+				if (opts.input !== undefined) {
+					child.stdin?.end(opts.input);
+				} else {
+					child.stdin?.end();
+				}
+			});
+		},
+		spawn(args) {
+			const child = spawn(wslPath, args, { cwd: options.cwd, windowsHide: true });
+			return { child, stdout: child.stdout, stderr: child.stderr };
+		}
+	};
+}
+
+/**
+ * @param {string} stdout
+ * @returns {IDistro[]}
+ */
+function parseDistroTable(stdout) {
+	/** @type {IDistro[]} */
+	const distros = [];
+	for (const line of stdout.split(/\r?\n/).map(l => l.trim())) {
+		// Lines arrive trimmed, so the leading space of a non-default row is gone.
+		const match = /^(\*)?\s*(.+?)\s+(\w+)\s+([12])$/.exec(line);
+		if (!match) {
+			continue;
+		}
+		const [, marker, name, state, version] = match;
+		distros.push({ name: name.trim(), isDefault: marker === '*', version: version === '1' ? '1' : '2', state });
+	}
+	return distros;
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @returns {Promise<IDistro[]>}
+ */
+async function listDistros(runner) {
+	const result = await runner.exec(['--list', '--verbose']);
+	if (result.code !== 0) {
+		throw new Error(`wsl --list --verbose failed (${result.code}): ${decodeWslOutput(result.stderr)}`);
+	}
+	return parseDistroTable(decodeWslOutput(result.stdout));
+}
+
+/**
+ * @param {IDistro[]} list
+ * @returns {string}
+ */
+function defaultDistro(list) {
+	const marked = list.find(d => d.isDefault);
+	if (marked) {
+		return marked.name;
+	}
+	if (list.length === 0) {
+		throw new Error('No WSL distro is installed');
+	}
+	return list[0].name;
+}
+
+/**
+ * docker-desktop / docker-desktop-data are plumbing distros; offering them as
+ * places to open a folder is noise, unless the user made one the default.
+ * @param {IDistro[]} list
+ * @returns {IDistro[]}
+ */
+function visibleDistros(list) {
+	return list.filter(d => d.isDefault || !/^docker-desktop/i.test(d.name));
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @param {string} distro
+ * @returns {Promise<string>}
+ */
+async function distroHome(runner, distro) {
+	const result = await runner.exec(distroExec(distro, ['printenv', 'HOME']));
+	const home = decodeWslOutput(result.stdout);
+	if (result.code !== 0 || home.length === 0) {
+		throw new Error(`Could not read $HOME in ${distro} (${result.code}): ${decodeWslOutput(result.stderr)}`);
+	}
+	return home.split('\n')[0];
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @param {string} distro
+ * @returns {Promise<boolean>}
+ */
+async function isWsl1(runner, distro) {
+	const list = await listDistros(runner);
+	const found = list.find(d => d.name === distro);
+	return found?.version === '1';
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @param {string} distro
+ * @returns {Promise<'missing' | 'ok'>}
+ */
+async function distroStatus(runner, distro) {
+	try {
+		const result = await runner.exec(distroExec(distro, ['true']));
+		return result.code === 0 ? 'ok' : 'missing';
+	} catch {
+		return 'missing';
+	}
+}
+
+/**
+ * @param {IWslRunner} runner
+ * @returns {Promise<{ installed: boolean, kernelUpdateRequired: boolean }>}
+ */
+async function wslStatus(runner) {
+	let result;
+	try {
+		result = await runner.exec(['--status']);
+	} catch (error) {
+		return { installed: false, kernelUpdateRequired: /kernel/i.test(String(error)) };
+	}
+	const stderr = decodeWslOutput(result.stderr);
+	if (result.code !== 0 && /not installed|not enabled/i.test(stderr)) {
+		return { installed: false, kernelUpdateRequired: false };
+	}
+	return { installed: true, kernelUpdateRequired: /kernel/i.test(stderr) };
+}
+
+module.exports = {
+	decodeWslOutput,
+	createWslRunner,
+	parseDistroTable,
+	listDistros,
+	defaultDistro,
+	visibleDistros,
+	distroHome,
+	isWsl1,
+	distroStatus,
+	wslStatus
+};
