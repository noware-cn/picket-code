+test('payload.download reports an unusable proxy and a missing CA file', async () => {
+	await assert.rejects(() => download('http://mirror.corp/x', { proxy: 'socks5://proxy:1080' }), /cannot be used/);
+	await assert.rejects(() => download('https://mirror.corp/x', { caFile: '/definitely/not/a/ca.pem' }), /Could not read the CA file/);
+});
+
+test('payload.download uses the configured proxy and CA', async () => {
+	const body = Buffer.from('payload-through-the-proxy');
