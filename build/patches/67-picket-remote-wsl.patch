+// RED first: this file must fail until src/marketplace.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { describeGallery, applyGalleryMode, selectGallery, installVsix } = require('../src/marketplace.js');
+const { createFakeHost, createFakeGalleryConfig } = require('./fixtures/fake-host.js');
+
+test('an unset serviceUrl means the build gallery stands', () => {
+	assert.deepStrictEqual(describeGallery({}), { mode: 'default' });
+	assert.deepStrictEqual(describeGallery({ serviceUrl: '' }), { mode: 'default' });
+});
+
+test('a URL means a gallery the deployment configured', () => {
+	assert.deepStrictEqual(
+		describeGallery({ serviceUrl: 'https://openvsx.corp.local/vscode/gallery' }),
+		{ mode: 'custom', serviceUrl: 'https://openvsx.corp.local/vscode/gallery' }
+	);
+});
+
+test('the disabled sentinel is a mode of its own, not a URL', () => {
+	assert.deepStrictEqual(describeGallery({ serviceUrl: 'none' }), { mode: 'none' });
+});
+
+test('a custom gallery is written with the no-account provider', async () => {
+	const configuration = createFakeGalleryConfig();
+	await applyGalleryMode({ mode: 'custom', url: 'https://openvsx.corp.local/vscode/gallery/', configuration });
+
+	// The trailing slash would double up in every derived resource URL.
+	assert.deepStrictEqual(configuration.writes, [
+		['serviceUrl', 'https://openvsx.corp.local/vscode/gallery'],
+		['authProvider', 'none']
+	]);
+});
+
+test('a custom gallery without http(s) is refused before anything is written', async () => {
+	const configuration = createFakeGalleryConfig();
+	await assert.rejects(
+		() => applyGalleryMode({ mode: 'custom', url: 'openvsx.corp.local', configuration }),
+		/http/
+	);
+	assert.deepStrictEqual(configuration.writes, []);
+});
+
+test('turning the gallery off writes the sentinel and clears the account provider', async () => {
+	const configuration = createFakeGalleryConfig({ serviceUrl: 'https://x/vscode/gallery', authProvider: 'none' });
+	await applyGalleryMode({ mode: 'none', configuration });
+
+	assert.deepStrictEqual(configuration.writes, [['serviceUrl', 'none'], ['authProvider', undefined]]);
+});
+
+test('going back to the default clears both keys instead of copying the URL', async () => {
+	// Copying Open VSX's URL into the setting would freeze it: a later build that ships a
+	// different default could never take effect.
+	const configuration = createFakeGalleryConfig({ serviceUrl: 'none', authProvider: 'none' });
+	await applyGalleryMode({ mode: 'default', configuration });
+
+	assert.deepStrictEqual(configuration.writes, [['serviceUrl', undefined], ['authProvider', undefined]]);
+});
+
+test('picking an intranet gallery asks for a URL and then offers a reload', async () => {
+	const configuration = createFakeGalleryConfig();
+	const host = createFakeHost({
+		quickPick: '内网/自建 gallery…',
+		inputBox: 'https://openvsx.corp.local/vscode/gallery',
+		info: ['重新加载']
+	});
+
+	await selectGallery({ host, configuration });
+
+	assert.deepStrictEqual(configuration.values, {
+		serviceUrl: 'https://openvsx.corp.local/vscode/gallery',
+		authProvider: 'none'
+	});
+	assert.deepStrictEqual(host.executed.at(-1), ['workbench.action.reloadWindow']);
+});
+
+test('a rejected URL surfaces the reason and leaves the setting alone', async () => {
+	const configuration = createFakeGalleryConfig();
+	const host = createFakeHost({ quickPick: '内网/自建 gallery…', inputBox: 'openvsx.corp.local' });
+
+	await selectGallery({ host, configuration });
+
+	assert.deepStrictEqual(configuration.writes, []);
+	assert.match(host.messages.at(-1), /http/);
+});
+
+test('cancelling the picker changes nothing', async () => {
+	const configuration = createFakeGalleryConfig();
+	const host = createFakeHost({ quickPick: undefined });
+
+	await selectGallery({ host, configuration });
+
+	assert.deepStrictEqual(configuration.writes, []);
+	assert.deepStrictEqual(host.messages, []);
+});
+
+test('installing a VSIX hands the picked file to the extensions view', async () => {
+	const uri = { scheme: 'file', fsPath: '/tmp/picket.vsix', path: '/tmp/picket.vsix' };
+	const host = createFakeHost({ openDialog: [uri] });
+
+	await installVsix({ host });
+
+	assert.strictEqual(host.executed.length, 1);
+	assert.strictEqual(host.executed[0][0], 'workbench.extensions.installExtension');
+	assert.strictEqual(host.executed[0][1], uri);
+});
+
+test('a failed VSIX install is reported, not swallowed', async () => {
+	const uri = { scheme: 'file', fsPath: '/tmp/broken.vsix', path: '/tmp/broken.vsix' };
+	const host = createFakeHost({
+		openDialog: [uri],
+		executeCommand: () => { throw new Error('not a valid extension'); }
+	});
+
+	await installVsix({ host });
+
+	assert.match(host.messages.at(-1), /not a valid extension/);
+});
diff --git a/extensions/picket-remote-wsl/test/nudge.test.js b/extensions/picket-remote-wsl/test/nudge.test.js
