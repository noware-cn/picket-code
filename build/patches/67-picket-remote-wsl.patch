+// RED first: this file must fail until src/components.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { createComponentManager } = require('../src/components.js');
+
+const HOME = '/home/u';
+const ROOT = `${HOME}/.vscode-server/bin`;
+const COMMIT = 'abc';
+const PRODUCT = { commit: COMMIT, version: '1.143.1', picketServerMinVersion: '1.0.0' };
+
+/** @param {string[]} versions */
+function catalogOf(versions, commit = COMMIT) {
+	return {
+		schema: 2,
+		minVersion: '1.0.0',
+		flavor: 'ondemand',
+		components: versions.map(version => ({
+			id: 'wsl-server', kind: 'server', version, commit,
+			file: `picket-code-server-${version}-linux-x64.tar.gz`, size: 3, sha256: 'd'.repeat(64), embedded: false
+		}))
+	};
+}
+
+/**
+ * A distro that holds `payloads` (dir name -> marker) and answers the shell
+ * commands the manager sends.
+ * @param {Record<string, any>} payloads
+ */
+function fakeDistro(payloads = {}) {
+	/** @type {string[]} */
+	const calls = [];
+	const runner = {
+		exec: async (/** @type {string[]} */ args) => {
+			calls.push(args.join(' '));
+			const script = args.slice(args.indexOf('-e') + 1).join(' ');
+			if (script.includes('ls -1t')) {
+				return { code: 0, stdout: Object.keys(payloads).map(name => `${ROOT}/${name}`).join('\n'), stderr: '' };
+			}
+			if (script.includes('cat "$1"')) {
+				// The marker path is <payload dir>/.picket-payload.json.
+				const name = args[args.length - 1].split('/').slice(-2)[0];
+				return { code: 0, stdout: payloads[name] === undefined ? '' : JSON.stringify(payloads[name]), stderr: '' };
+			}
+			return { code: 0, stdout: '', stderr: '' };
+		},
+		spawn: () => { throw new Error('not used'); }
+	};
+	return { runner, calls };
+}
+
+/** @param {any} marker */
+function markerOf(marker) {
+	return { sha256: 'd'.repeat(64), source: 'file', installedAt: 'now', ...marker };
+}
+
+/** @param {{ payloads?: Record<string, any>, catalog?: any, product?: any }} [options] */
+function managerWith(options = {}) {
+	const { runner, calls } = fakeDistro(options.payloads ?? {});
+	const manager = createComponentManager({
+		catalog: options.catalog ?? catalogOf(['1.4.0']),
+		product: options.product ?? PRODUCT,
+		runner,
+		distro: 'D',
+		home: HOME,
+		env: {},
+		statePath: '/tmp/picket-components-state.json'
+	});
+	return { manager, calls };
+}
+
+test('payloads install into the shared bin directory', async () => {
+	const { manager } = managerWith();
+	assert.equal(manager.payloadRoot, `${ROOT}`);
+});
+
+test('absent when nothing is installed', async () => {
+	const { manager } = managerWith();
+	assert.strictEqual((await manager.inspect('wsl-server')).state, 'absent');
+});
+
+test('an older installed payload that still meets the minimum is reused', async () => {
+	const { manager } = managerWith({
+		payloads: { 'picket-1.1.0': markerOf({ version: '1.1.0', commit: COMMIT }) },
+		catalog: catalogOf(['1.4.0'])
+	});
+	const verdict = await manager.inspect('wsl-server');
+	assert.equal(verdict.state, 'installed');
+	assert.equal(verdict.version, '1.1.0');
+	assert.equal(verdict.payloadDir, `${ROOT}/picket-1.1.0`);
+});
+
+test('the newest usable payload wins when several are installed', async () => {
+	const { manager } = managerWith({
+		payloads: {
+			'picket-1.1.0': markerOf({ version: '1.1.0', commit: COMMIT }),
+			'picket-1.3.0': markerOf({ version: '1.3.0', commit: COMMIT })
+		}
+	});
+	assert.equal((await manager.inspect('wsl-server')).version, '1.3.0');
+});
+
+test('a payload below the minimum is outdated and names the newest candidate', async () => {
+	const { manager } = managerWith({
+		payloads: { 'picket-0.9.0': markerOf({ version: '0.9.0', commit: COMMIT }) },
+		product: { ...PRODUCT, picketServerMinVersion: '1.0.0' }
+	});
+	assert.deepEqual(await manager.inspect('wsl-server'), { state: 'outdated', candidateVersion: '0.9.0' });
+});
+
+test('a payload for another commit is incompatible, never reused', async () => {
+	const { manager } = managerWith({
+		payloads: { 'picket-1.4.0': markerOf({ version: '1.4.0', commit: 'other' }) }
+	});
+	assert.equal((await manager.inspect('wsl-server')).state, 'incompatible');
+});
+
+test('a directory whose marker cannot be read is broken, not reused', async () => {
+	const { manager } = managerWith({ payloads: { 'picket-1.4.0': undefined } });
+	assert.equal((await manager.inspect('wsl-server')).state, 'broken');
+});
+
+test('a marker whose digest disagrees with the catalog is not trusted', async () => {
+	const { manager } = managerWith({
+		payloads: { 'picket-1.4.0': markerOf({ version: '1.4.0', commit: COMMIT, sha256: 'e'.repeat(64) }) }
+	});
+	assert.equal((await manager.inspect('wsl-server')).state, 'outdated');
+});
+
+test('ensure on an installed component issues no tar', async () => {
+	const { manager, calls } = managerWith({
+		payloads: { 'picket-1.4.0': markerOf({ version: '1.4.0', commit: COMMIT }) }
+	});
+	await manager.ensure('wsl-server');
+	assert.ok(!calls.some(c => c.includes('tar')), calls.join('\n'));
+});
+
+test('ensure refuses a catalog with nothing for this commit instead of downloading', async () => {
+	const { manager, calls } = managerWith({ catalog: catalogOf(['1.4.0'], 'other') });
+	await assert.rejects(() => manager.ensure('wsl-server'), /commit/s);
