+// RED first: this file must fail until src/nudge.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { maybeNudge, NUDGE_KEY } = require('../src/nudge.js');
+const { createFakeHost } = require('./fixtures/fake-host.js');
+
+function memento() {
+	const store = new Map();
+	return { store, get: (key) => store.get(key), async update(key, value) { store.set(key, value); } };
+}
+
+/** @param {string} fsPath */
+function folder(fsPath) {
+	return [{ uri: { fsPath } }];
+}
+
+test('a WSL folder opened from Windows is nudged exactly once', async () => {
+	const host = createFakeHost({ info: ['取消'] });
+	const state = memento();
+	const folders = folder('\\\\wsl.localhost\\Ubuntu-24.04\\home\\u\\src');
+
+	assert.strictEqual(await maybeNudge({ host, memento: state, folders }), true);
+	assert.strictEqual(await maybeNudge({ host, memento: state, folders }), false);
+	assert.strictEqual(host.messages.length, 1);
+	assert.strictEqual(state.store.get(NUDGE_KEY), true);
+});
+
+test('the nudge offers to reopen the same folder inside WSL', async () => {
+	const host = createFakeHost({ info: ['在 WSL 中打开'] });
+	/** @type {any[]} */
+	const opened = [];
+	await maybeNudge({
+		host,
+		memento: memento(),
+		folders: folder('\\\\wsl$\\Debian\\home\\u'),
+		openFolderInWsl: async (distro, posixPath) => { opened.push({ distro, posixPath }); }
+	});
+	assert.deepStrictEqual(opened, [{ distro: 'Debian', posixPath: '/home/u' }]);
+});
+
+test('an ordinary Windows folder is never nudged', async () => {
+	const host = createFakeHost();
+	assert.strictEqual(await maybeNudge({ host, memento: memento(), folders: folder('C:\\project') }), false);
+	assert.deepStrictEqual(host.messages, []);
+});
+
+test('an empty window is never nudged', async () => {
+	const host = createFakeHost();
+	assert.strictEqual(await maybeNudge({ host, memento: memento(), folders: [] }), false);
+	assert.deepStrictEqual(host.messages, []);
+});
diff --git a/extensions/picket-remote-wsl/test/official.test.js b/extensions/picket-remote-wsl/test/official.test.js
new file mode 100644
index 00000000..96f2dca3
--- /dev/null
+++ b/extensions/picket-remote-wsl/test/official.test.js
@@ -0,0 +1,76 @@
+// RED first: this file must fail until src/official.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { OFFICIAL_EXTENSION_ID, createOfficialGate } = require('../src/official.js');
+
+/** @param {{ installed?: () => any }} [options] */
+function fakeExtensions(options = {}) {
+	const listeners = [];
+	return {
+		listeners,
+		get: () => (options.installed ? options.installed() : undefined),
+		onDidChange: (/** @type {() => void} */ callback) => {
+			listeners.push(callback);
+			return { dispose() { listeners.splice(listeners.indexOf(callback), 1); } };
+		}
+	};
+}
+
+test('an installed official extension blocks everything, enabled or not', () => {
+	const gate = createOfficialGate({ extensions: fakeExtensions({ installed: () => ({ id: OFFICIAL_EXTENSION_ID, isActive: false }) }) });
+	assert.deepStrictEqual(gate.evaluate(), { blocked: true, installed: true });
+	assert.strictEqual(gate.blocked, true);
+});
+
+test('nothing installed means nothing blocked', () => {
+	const gate = createOfficialGate({ extensions: fakeExtensions() });
+	assert.deepStrictEqual(gate.evaluate(), { blocked: false, installed: false });
+});
+
+test('installing it while the window is open flips the gate', () => {
+	let installed = false;
+	const extensions = fakeExtensions({ installed: () => (installed ? { id: OFFICIAL_EXTENSION_ID } : undefined) });
+	const gate = createOfficialGate({ extensions });
+	/** @type {boolean[]} */
+	const seen = [];
+	gate.onChange((/** @type {any} */ state) => seen.push(state.blocked));
+
+	installed = true;
+	extensions.listeners.forEach(callback => callback());
+	assert.deepStrictEqual(seen, [true]);
+
+	// A second event with no change must not flap the surface.
+	extensions.listeners.forEach(callback => callback());
+	assert.deepStrictEqual(seen, [true]);
+});
+
+test('uninstalling it releases the gate again', () => {
+	let installed = true;
+	const extensions = fakeExtensions({ installed: () => (installed ? { id: OFFICIAL_EXTENSION_ID } : undefined) });
+	const gate = createOfficialGate({ extensions });
+	/** @type {boolean[]} */
+	const seen = [];
+	gate.onChange((/** @type {any} */ state) => seen.push(state.blocked));
+
+	installed = false;
+	extensions.listeners.forEach(callback => callback());
+	assert.deepStrictEqual(seen, [false]);
+	assert.strictEqual(gate.blocked, false);
+});
+
+test('a throwing extensions API does not block WSL', () => {
+	const gate = createOfficialGate({
+		extensions: {
+			get() { throw new Error('Extensions API unavailable'); },
+			onDidChange: () => ({ dispose() { } })
+		}
+	});
+	assert.strictEqual(gate.blocked, false);
+});
+
+test('dispose detaches from the extensions API', () => {
+	const extensions = fakeExtensions();
+	const gate = createOfficialGate({ extensions });
+	gate.dispose();
+	assert.strictEqual(extensions.listeners.length, 0);
+});
