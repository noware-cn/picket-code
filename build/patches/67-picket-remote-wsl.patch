+const TABLE = [
+	'  NAME            STATE           VERSION',
+	'* Ubuntu          Running         2',
+	'  Debian          Stopped         2'
+].join('\n');
+
+const COMMIT = 'e646868227c3e3a9e3f24277c8c7220be42c0be7';
+const VERSION = '1.143.1';
+const PRODUCT = { commit: COMMIT, version: VERSION, picketServerMinVersion: '1.0.0' };
