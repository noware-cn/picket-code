+// RED first: this file must fail until src/remoteUri.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { parseAuthority, canonicalAuthority, remoteUriFor, parseUncPath, toPosixPath, toWindowsPath } = require('../src/remoteUri.js');
+
+test('parseAuthority names the prefix and the distro, and treats default as empty', () => {
+	assert.deepStrictEqual(parseAuthority('picket-wsl+Ubuntu 22.04 LTS'), { prefix: 'picket-wsl', distro: 'Ubuntu 22.04 LTS' });
+	assert.deepStrictEqual(parseAuthority('picket-wsl+'), { prefix: 'picket-wsl', distro: '' });
+	assert.deepStrictEqual(parseAuthority('wsl+Ubuntu'), { prefix: 'wsl', distro: 'Ubuntu' });
+});
+
+test('the official spellings of "the default distro" all mean the same window', () => {
+	assert.deepStrictEqual(parseAuthority('wsl+default'), { prefix: 'wsl', distro: '' });
+	assert.deepStrictEqual(parseAuthority('wsl'), { prefix: 'wsl', distro: '' });
+	assert.deepStrictEqual(parseAuthority('picket-wsl+default'), { prefix: 'picket-wsl', distro: '' });
+});
+
+test('another extension authority is not ours', () => {
+	assert.strictEqual(parseAuthority('ssh-remote+host'), undefined);
+	assert.strictEqual(parseAuthority('wslx+Ubuntu'), undefined);
+	assert.strictEqual(parseAuthority(''), undefined);
+});
+
+test('canonicalAuthority spells the default distro the way the official extension does', () => {
+	assert.strictEqual(canonicalAuthority('wsl', 'Ubuntu'), 'wsl+Ubuntu');
+	assert.strictEqual(canonicalAuthority('picket-wsl', ''), 'picket-wsl+default');
+});
+
+test('remoteUriFor builds a vscode-remote uri for the distro', () => {
+	assert.deepStrictEqual(remoteUriFor('Ubuntu-24.04', '/home/u/proj'), {
+		scheme: 'vscode-remote',
+		authority: 'picket-wsl+Ubuntu-24.04',
+		path: '/home/u/proj'
+	});
+	assert.strictEqual(remoteUriFor('Ubuntu', '/').path, '/');
+});
+
+test('UNC paths parse for both prefixes', () => {
+	assert.deepStrictEqual(parseUncPath('\\\\wsl.localhost\\Ubuntu\\home\\u'), { distro: 'Ubuntu', posixPath: '/home/u' });
+	assert.deepStrictEqual(parseUncPath('\\\\wsl$\\Debian\\srv\\app'), { distro: 'Debian', posixPath: '/srv/app' });
+	assert.deepStrictEqual(parseUncPath('//wsl.localhost/Ubuntu/home/u'), { distro: 'Ubuntu', posixPath: '/home/u' });
+	assert.deepStrictEqual(parseUncPath('\\\\wsl.localhost\\Ubuntu'), { distro: 'Ubuntu', posixPath: '/' });
+	assert.deepStrictEqual(parseUncPath('\\\\wsl.localhost\\Ubuntu\\home\\u\\'), { distro: 'Ubuntu', posixPath: '/home/u' });
+});
+
+test('a drive path or another share is not a WSL UNC path', () => {
+	assert.strictEqual(parseUncPath('C:\\Users\\u'), undefined);
+	assert.strictEqual(parseUncPath('\\\\fileserver\\share\\dir'), undefined);
+	assert.strictEqual(parseUncPath('/home/u'), undefined);
+});
+
