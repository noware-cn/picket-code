+// RED first: this file must fail until src/catalog.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { mkdtempSync, mkdirSync, writeFileSync } = require('node:fs');
+const { tmpdir } = require('node:os');
+const { join } = require('node:path');
+const { loadCatalog } = require('../src/catalog.js');
+
+function extensionWith(catalog) {
+	const dir = mkdtempSync(join(tmpdir(), 'picket-wsl-'));
+	mkdirSync(join(dir, 'payloads'), { recursive: true });
+	writeFileSync(join(dir, 'payloads', 'catalog.json'), catalog);
+	return dir;
+}
+
+const VALID = {
+	version: 1,
+	tag: 'v1.143.1-picket.1-rc.4',
+	flavor: 'ondemand',
+	components: [{
+		id: 'wsl-server',
+		kind: 'server',
+		version: 'v1.143.1-picket.1-rc.4',
+		file: 'picket-code-server-v1.143.1-picket.1-rc.4-linux-x64.tar.gz',
+		size: 87123456,
+		sha256: 'a'.repeat(64)
+	}]
+};
+
+test('parses a valid catalog', async () => {
+	const dir = extensionWith(JSON.stringify(VALID));
+	const catalog = await loadCatalog(dir);
+	assert.strictEqual(catalog.tag, 'v1.143.1-picket.1-rc.4');
+	assert.strictEqual(catalog.flavor, 'ondemand');
+	assert.strictEqual(catalog.components.length, 1);
+	assert.strictEqual(catalog.components[0].embedded, false);
+	assert.strictEqual(catalog.components[0].embeddedPath, undefined);
+});
+
+test('keeps embeddedPath when embedded is true', async () => {
+	const dir = extensionWith(JSON.stringify({
+		...VALID,
+		flavor: 'embedded',
+		components: [{ ...VALID.components[0], embedded: true, embeddedPath: 'wsl-payloads/server.tar.gz' }]
+	}));
+	const catalog = await loadCatalog(dir);
+	assert.strictEqual(catalog.components[0].embedded, true);
+	assert.strictEqual(catalog.components[0].embeddedPath, 'wsl-payloads/server.tar.gz');
+});
+
+test('invalid JSON yields the empty catalog instead of throwing', async () => {
+	const dir = extensionWith('{ not json');
+	const catalog = await loadCatalog(dir);
+	assert.deepStrictEqual(catalog, { tag: null, flavor: 'ondemand', components: [] });
+});
+
+test('a component without a valid sha256 is dropped, the rest survive', async () => {
+	const dir = extensionWith(JSON.stringify({
+		...VALID,
+		components: [
+			VALID.components[0],
+			{ ...VALID.components[0], id: 'no-sha', sha256: 'short' },
+			{ ...VALID.components[0], id: 'traversal', embedded: true, embeddedPath: '../escape.tar.gz' }
+		]
+	}));
+	const catalog = await loadCatalog(dir);
+	assert.deepStrictEqual(catalog.components.map(c => c.id), ['wsl-server']);
+});
