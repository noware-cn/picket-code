+		if (!hit) { throw new Error(`unexpected wsl args: ${key}`); }
+		return hit;
+	}, spawn: () => { throw new Error('not used'); } };
+}
+
+const TABLE = [
+	'  NAME            STATE           VERSION',
+	'* Ubuntu-24.04    Running         2',
+	'  Ubuntu 22.04 LTS Stopped        1',
+	'  docker-desktop  Running         2',
+	''
+].join('\r\n');
+
+test('decodes a UTF-16LE verbose table with marker and version', () => {
+	const list = parseDistroTable(decodeWslOutput(Buffer.from(TABLE, 'utf16le')));
+	assert.deepStrictEqual(list, [
+		{ name: 'Ubuntu-24.04', isDefault: true, version: '2', state: 'Running' },
+		{ name: 'Ubuntu 22.04 LTS', isDefault: false, version: '1', state: 'Stopped' },
+		{ name: 'docker-desktop', isDefault: false, version: '2', state: 'Running' }
+	]);
+});
+
+test('decodes UTF-8 output without NUL bytes', () => {
+	assert.strictEqual(decodeWslOutput(Buffer.from('Ubuntu 22.04 LTS\r\n')), 'Ubuntu 22.04 LTS');
+});
+
+test('hides docker-managed distros unless they are the default', () => {
+	const list = parseDistroTable(TABLE);
+	assert.deepStrictEqual(visibleDistros(list).map(d => d.name), ['Ubuntu-24.04', 'Ubuntu 22.04 LTS']);
+	const promoted = parseDistroTable(TABLE.replace('* Ubuntu-24.04', '  Ubuntu-24.04').replace('  docker-desktop', '* docker-desktop'));
+	assert.ok(visibleDistros(promoted).some(d => d.name === 'docker-desktop'));
+});
+
+test('lists distros through the runner', async () => {
+	const r = runner({ '--list --verbose': { code: 0, stdout: Buffer.from(TABLE, 'utf16le'), stderr: '' } });
+	const list = await listDistros(r);
+	assert.strictEqual(list[0].name, 'Ubuntu-24.04');
+	assert.strictEqual(list[0].isDefault, true);
+});
+
+test('reports a missing distro from a non-zero exit', async () => {
+	const r = runner({ '-d Nope -e true': { code: 1, stdout: '', stderr: '' } });
+	assert.strictEqual(await distroStatus(r, 'Nope'), 'missing');
+});
+
+test('reports WSL as not installed from --status', async () => {
+	const r = runner({ '--status': { code: 1, stdout: '', stderr: 'WSL is not installed. Run wsl --install.' } });
+	assert.deepStrictEqual(await wslStatus(r), { installed: false, kernelUpdateRequired: false });
+});
+
+test('reads $HOME from the distro', async () => {
+	const r = runner({ '-d Debian -e printenv HOME': { code: 0, stdout: '/home/ds\r\n', stderr: '' } });
+	assert.strictEqual(await distroHome(r, 'Debian'), '/home/ds');
+});
+
+test('spawns a real child process and parses its output', async () => {
+	const runner = createWslRunner({ wslPath: FAKE_WSL });
+	const list = await listDistros(runner);
+	assert.deepStrictEqual(list.map(d => d.name), ['Ubuntu-24.04', 'Ubuntu 22.04 LTS', 'docker-desktop']);
+	assert.strictEqual(await distroHome(runner, 'Ubuntu-24.04'), '/home/ubuntu-24');
+	assert.strictEqual(await distroStatus(runner, 'Nope'), 'missing');
+	assert.deepStrictEqual(await wslStatus(runner), { installed: false, kernelUpdateRequired: false });
+});
+
+test('rejects with a timeout instead of hanging', async () => {
+	const runner = createWslRunner({ wslPath: FAKE_WSL });
+	await assert.rejects(
+		() => runner.exec(['--hang'], { timeoutMs: 200 }),
+		/Timed out after 200 ms/
+	);
+});
diff --git a/extensions/picket-remote-wsl/test/fixtures/fake-host.js b/extensions/picket-remote-wsl/test/fixtures/fake-host.js
new file mode 100644
index 00000000..8de906e0
--- /dev/null
+++ b/extensions/picket-remote-wsl/test/fixtures/fake-host.js
@@ -0,0 +1,176 @@
+'use strict';
+
+/**
+ * A stand-in for the slice of `vscode` that the command layer touches, so the
+ * command layer can be tested without an extension host.
+ * @param {{ quickPick?: any, openDialog?: any, info?: any[], warning?: any[], confirm?: boolean, folderOpen?: boolean, inputBox?: any, executeCommand?: (id: string, ...args: any[]) => any }} [options]
+ */
+function createFakeHost(options = {}) {
+	/** @type {string[]} */
+	const messages = [];
+	/** @type {any[][]} */
+	const actionSets = [];
+	/** @type {any[]} */
+	const opened = [];
+	/** @type {string[]} */
+	const terminals = [];
+	/** @type {string[]} */
+	const documents = [];
+	/** @type {any[][]} */
+	const executed = [];
+	const state = { refreshed: 0, progress: 0 };
+	const infoQueue = [...(options.info ?? [])];
+	const warningQueue = [...(options.warning ?? [])];
+
+	const host = {
+		messages,
+		actionSets,
+		opened,
+		terminals,
+		documents,
+		executed,
+		state,
+		get lastActions() {
+			return actionSets.length === 0 ? [] : actionSets[actionSets.length - 1];
+		},
+		/** @param {any[]} items @param {any} [opts] */
+		async showQuickPick(items, opts) {
+			const answer = typeof options.quickPick === 'function' ? options.quickPick(items, opts) : options.quickPick;
+			return answer === undefined ? undefined : items.find(item => item.label === answer) ?? answer;
+		},
+		/** @param {any} opts */
+		async showOpenDialog(opts) {
+			return typeof options.openDialog === 'function' ? options.openDialog(opts) : options.openDialog;
+		},
+		/** @param {string} message @param {...any} actions */
+		async showInformationMessage(message, ...actions) {
+			messages.push(message);
+			actionSets.push(actions.filter(action => typeof action === 'string'));
+			return infoQueue.length > 0 ? infoQueue.shift() : undefined;
+		},
+		/** @param {string} message @param {...any} actions */
+		async showWarningMessage(message, ...actions) {
+			messages.push(message);
+			actionSets.push(actions.filter(action => typeof action === 'string'));
+			if (options.confirm !== undefined) {
+				return options.confirm ? actions.filter(action => typeof action === 'string')[0] : undefined;
+			}
+			return warningQueue.length > 0 ? warningQueue.shift() : undefined;
+		},
+		/** @param {string} message */
+		async showErrorMessage(message) {
+			messages.push(message);
+			actionSets.push([]);
+			return undefined;
+		},
+		/** @param {any} opts @param {(progress: { report(value: any): void }) => Promise<any>} task */
+		async withProgress(opts, task) {
+			state.progress += 1;
+			return task({ report() { } });
+		},
+		/** @param {any} uri @param {any} opts */
+		async openFolder(uri, opts) {
+			opened.push({ uri, opts });
+		},
+		/** @param {any} [opts] */
+		async showInputBox(opts) {
+			return typeof options.inputBox === 'function' ? options.inputBox(opts) : options.inputBox;
+		},
+		/** @param {string} id @param {...any} args */
+		async executeCommand(id, ...args) {
+			executed.push([id, ...args]);
+			return options.executeCommand ? options.executeCommand(id, ...args) : undefined;
+		},
+		/** @param {string} command */
+		runInTerminal(command) {
+			terminals.push(command);
+		},
+		refreshTargets() {
+			state.refreshed += 1;
+		},
+		/** @param {string} text @param {string} [language] */
+		async showDocument(text, language) {
+			documents.push(language ? `${text}` : text);
+		},
+		/** @param {{ scheme?: string, authority?: string, path?: string }} parts */
+		uriFor(parts) {
+			return { ...parts, fsPath: parts.path ?? '' };
+		}
+	};
+	return host;
+}
+
+/**
+ * @param {{ state?: 'installed' | 'absent' | 'broken', entries?: any[], fail?: string, version?: string }} [options]
+ */
+function createFakeComponents(options = {}) {
+	const state = { installed: 0, inspected: 0 };
+	const version = options.version ?? 'v1.143.1-picket.1-rc.4';
+	const payloadDir = `/home/u/.picket-code-server/payloads/server-${version}`;
+	const components = {
+		state,
+		async inspect() {
+			state.inspected += 1;
+			return { state: options.state ?? 'installed', version, payloadDir };
+		},
+		async ensure() {
+			if (options.fail) {
+				throw new Error(options.fail);
+			}
+			state.installed += 1;
+			return { payloadDir };
+		},
+		async list() {
+			return options.entries ?? [{ id: 'wsl-server', state: options.state ?? 'installed', version, payloadDir }];
+		},
+		async uninstall() { }
+	};
+	return components;
+}
+
+/** @param {{ tag?: string, flavor?: 'embedded' | 'ondemand', version?: string }} [options] */
+function createCatalog(options = {}) {
+	const version = options.version ?? 'v1.143.1-picket.1-rc.4';
+	return {
+		tag: options.tag ?? version,
+		flavor: options.flavor ?? 'ondemand',
+		components: [{
+			id: 'wsl-server',
+			kind: 'server',
+			version,
+			file: `picket-code-server-${version}-linux-x64.tar.gz`,
+			sha256: 'a'.repeat(64),
+			size: 1,
+			embedded: false,
+			embeddedPath: ''
+		}]
+	};
+}
+
+/**
+ * The `extensions.gallery` settings, as the extension sees them: `get` reads the effective
+ * value, `update` records the write so a test can assert what the command asked for.
+ * @param {{ serviceUrl?: string, authProvider?: string }} [initial]
+ */
+function createFakeGalleryConfig(initial = {}) {
+	const values = { ...initial };
+	/** @type {Array<[string, any]>} */
+	const writes = [];
+	return {
+		values,
+		writes,
+		/** @param {string} key */
+		get(key) { return values[key]; },
+		/** @param {string} key @param {any} value */
+		async update(key, value) {
+			writes.push([key, value]);
+			if (value === undefined) {
+				delete values[key];
+			} else {
+				values[key] = value;
+			}
+		}
+	};
+}
+
+module.exports = { createFakeHost, createFakeComponents, createCatalog, createFakeGalleryConfig };
