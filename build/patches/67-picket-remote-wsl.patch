+// RED first: this file must fail until src/uninstall.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { OFFICIAL_EXTENSION_ID } = require('../src/official.js');
+const { uninstallOfficialExtension } = require('../src/uninstall.js');
+
+/**
+ * @param {{ extensionPath?: string } | undefined} found
+ * @param {{ throwOn?: string }} [options]
+ */
+function harness(found, options = {}) {
+	/** @type {any[][]} */
+	const calls = [];
+	return {
+		calls,
+		extensions: { get: (/** @type {string} */ id) => (found && id === OFFICIAL_EXTENSION_ID ? { id, extensionPath: found.extensionPath } : undefined) },
+		executeCommand: async (/** @type {string} */ command, ...args) => {
+			calls.push([command, ...args]);
+			if (options.throwOn === command) {
+				throw new Error('workbench refused');
+			}
+		}
+	};
+}
+
+test('uninstalling passes nothing but the extension id to the workbench', async () => {
+	const { calls, ...api } = harness({ extensionPath: 'C:/Users/u/.picket-code/extensions/ms-vscode-remote.remote-wsl-1.104.7' });
+	const result = await uninstallOfficialExtension({ ...api, appRoot: 'C:/Program Files/Picket Code/resources/app' });
+	assert.deepStrictEqual(calls, [['workbench.extensions.uninstallExtension', OFFICIAL_EXTENSION_ID]]);
+	assert.strictEqual(result.status, 'uninstalled');
+});
+
+test('a built-in copy is refused without calling the workbench', async () => {
+	// A build that ships the official extension cannot be fixed by uninstalling
+	// it: the next start puts it back, so the honest answer is "reinstall".
+	const { calls, ...api } = harness({ extensionPath: 'C:/Program Files/Picket Code/resources/app/extensions/ms-vscode-remote.remote-wsl' });
+	const result = await uninstallOfficialExtension({ ...api, appRoot: 'C:/Program Files/Picket Code/resources/app' });
+	assert.strictEqual(result.status, 'builtin');
+	assert.strictEqual(calls.length, 0);
+	assert.match(result.message, /内置/);
+});
+
+test('the built-in check survives the separator and case differences Windows brings', async () => {
+	const { calls, ...api } = harness({ extensionPath: 'c:\\Program Files\\Picket Code\\resources\\app\\extensions\\ms-vscode-remote.remote-wsl' });
+	const result = await uninstallOfficialExtension({ ...api, appRoot: 'C:/Program Files/Picket Code/resources/app/' });
+	assert.strictEqual(result.status, 'builtin');
+	assert.strictEqual(calls.length, 0);
+});
+
+test('already gone is reported as absent, not as an error', async () => {
+	const { calls, ...api } = harness(undefined);
+	const result = await uninstallOfficialExtension({ ...api, appRoot: '/app' });
+	assert.strictEqual(result.status, 'absent');
+	assert.strictEqual(calls.length, 0);
+});
+
+test('a workbench that refuses the uninstall is a failure with its reason', async () => {
+	const { calls, ...api } = harness({ extensionPath: 'C:/Users/u/.picket-code/extensions/ms-vscode-remote.remote-wsl-1.104.7' }, { throwOn: 'workbench.extensions.uninstallExtension' });
+	const result = await uninstallOfficialExtension({ ...api, appRoot: 'C:/Program Files/Picket Code/resources/app' });
+	assert.strictEqual(result.status, 'failed');
+	assert.match(result.message, /workbench refused/);
+	assert.strictEqual(calls.length, 1);
+});
