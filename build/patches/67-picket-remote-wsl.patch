+// RED first: this file must fail until src/diagnose.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { mkdtemp, writeFile } = require('node:fs/promises');
+const { tmpdir } = require('node:os');
+const { join } = require('node:path');
+const { buildDiagnostics } = require('../src/diagnose.js');
+const { createFakeComponents, createCatalog } = require('./fixtures/fake-host.js');
+
+/**
+ * wsl.exe answers UTF-16LE for its tables; the report has to survive that.
+ * @param {Array<[string, any]>} handlers
+ */
+function makeRunner(handlers) {
+	return {
+		async exec(args) {
+			const key = args.join(' ');
+			for (const [match, value] of handlers) {
+				if (key.includes(match)) {
+					if (value instanceof Error) {
+						throw value;
+					}
+					return { code: 0, stderr: '', ...value };
+				}
+			}
+			return { code: 0, stdout: '', stderr: '' };
+		}
+	};
+}
+
+/** @param {Array<[string, any]>} handlers */
+function happyRunner(handlers = []) {
+	return makeRunner([
+		...handlers,
+		['--list --verbose', { stdout: Buffer.from('  NAME            STATE           VERSION\n* Ubuntu-24.04    Running         2\n  Debian          Stopped         2', 'utf16le') }],
+		['--status', { stdout: '' }],
+		['printenv HOME', { stdout: '/home/u\n' }],
+		['command -v icode', { stdout: '/usr/local/bin/icode\n' }],
+		['node -v', { stdout: 'v20.11.0\n' }],
+		['git --version', { stdout: 'git version 2.43.0\n' }]
+	]);
+}
+
+/** @param {{ picketTag?: string, gallery?: any }} [product] */
+async function appRoot(product = {}) {
+	const dir = await mkdtemp(join(tmpdir(), 'picket-diag-'));
+	await writeFile(join(dir, 'product.json'), JSON.stringify({
+		picketTag: product.picketTag ?? 'v1.143.1-picket.1-rc.4',
+		extensionsGallery: product.gallery
+	}));
+	return dir;
+}
+
+/**
+ * @param {{ runner?: any, settings?: any, product?: any, gallery?: any }} [options]
+ */
+async function diagnostics(options = {}) {
+	const root = await appRoot(options.product);
+	return buildDiagnostics({
+		runner: options.runner ?? happyRunner(),
+		settings: options.settings ?? { tunnelMode: 'auto', icodePath: '', defaultDistro: '' },
+		catalog: createCatalog(),
+		components: () => createFakeComponents({ state: 'installed' }),
+		appRoot: root,
+		gallery: options.gallery,
+		readWslConfig: async () => ({ localhostForwarding: true })
+	});
+}
+
+test('the report carries a line for every thing a support request needs', async () => {
+	const report = await diagnostics();
+	for (const heading of ['Product tag', 'WSL', 'Distros', 'Tunnel mode', 'Components', 'iCode', 'node', 'git', 'Gallery']) {
+		assert.match(report, new RegExp(`^${heading}:`, 'm'), `missing the ${heading} section:\n${report}`);
+	}
+	assert.match(report, /Ubuntu-24\.04/);
+	assert.match(report, /direct/);
+});
+
+test('a failing probe becomes unavailable instead of throwing', async () => {
+	const report = await buildDiagnostics({
+		runner: makeRunner([['', new Error('boom')]]),
+		settings: { tunnelMode: 'auto', icodePath: '', defaultDistro: '' },
+		catalog: createCatalog(),
+		components: () => createFakeComponents({ state: 'installed' }),
+		appRoot: await appRoot(),
+		readWslConfig: async () => ({})
+	});
+	assert.match(report, /^Distros: unavailable: boom$/m);
+	assert.match(report, /^Product tag: v1\.143\.1-picket\.1-rc\.4$/m);
+});
+
+test('the product tag is read from the build, not from the extension manifest', async () => {
+	const report = await diagnostics({ product: { picketTag: 'v9.9.9-picket.7' } });
+	assert.match(report, /^Product tag: v9\.9\.9-picket\.7$/m);
+});
+
+test('the gallery line names the build default when nothing is configured', async () => {
+	const report = await diagnostics({ product: { gallery: { serviceUrl: 'https://open-vsx.org/vscode/gallery' } } });
+	assert.match(report, /^Gallery: default \(https:\/\/open-vsx\.org\/vscode\/gallery\)$/m);
+});
+
+test('the gallery line names a configured mirror', async () => {
+	const report = await diagnostics({
+		product: { gallery: { serviceUrl: 'https://open-vsx.org/vscode/gallery' } },
+		gallery: { serviceUrl: 'https://openvsx.corp.local/vscode/gallery' }
+	});
+	assert.match(report, /^Gallery: custom \(https:\/\/openvsx\.corp\.local\/vscode\/gallery\)$/m);
+});
+
+test('the gallery line reports a disabled gallery as a state, not a missing value', async () => {
+	const report = await diagnostics({ product: { gallery: { serviceUrl: 'https://open-vsx.org/vscode/gallery' } }, gallery: { serviceUrl: 'none' } });
+	assert.match(report, /^Gallery: none \(disabled by extension setting\)$/m);
+});
+
+test('the components section names the installed payload', async () => {
+	const report = await diagnostics();
+	assert.match(report, /wsl-server\s+installed/);
+	assert.match(report, /server-v1\.143\.1-picket\.1-rc\.4/);
+});
