+// RED first: this file must fail until src/resolver.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { createResolver } = require('../src/resolver.js');
+const { createComponentManager } = require('../src/components.js');
+
+const TABLE = [
+	'  NAME            STATE           VERSION',
+	'* Ubuntu          Running         2',
+	'  Debian          Stopped         2'
+].join('\n');
+
+const VERSION = 'v1.143.1-picket.1-rc.4';
+
+/** @param {{ tag?: string }} [options] */
+function catalog(options = {}) {
+	return {
+		tag: options.tag ?? VERSION,
+		flavor: 'ondemand',
+		components: [{
+			id: 'wsl-server',
+			kind: 'server',
+			version: VERSION,
+			file: `picket-code-server-${VERSION}-linux-x64.tar.gz`,
+			sha256: 'a'.repeat(64),
+			size: 1,
+			embedded: false,
+			embeddedPath: ''
+		}]
+	};
+}
+
+/**
+ * Answers the three shapes the resolver sends through `sh -c`: the lock probe,
+ * the runtime read, and (for the component manager) `ls -1t` plus marker and
+ * removal writes.
+ * @param {{ runtime?: any, runtimeSequence?: any[], payloadDirs?: string[], home?: string, table?: string, icode?: string, locked?: boolean, lockAgeSeconds?: number }} [options]
+ */
+function makeRunner(options = {}) {
+	const calls = [];
+	const state = { spawns: 0, cleared: 0, removed: [], markers: [], acquired: 0, released: 0 };
+	const sequence = (options.runtimeSequence ?? []).slice();
+	/** @type {any} */
+	let lockHeld = options.locked === true;
+	const runner = {
+		calls,
+		state,
+		async exec(args) {
+			calls.push(args.join(' '));
+			if (args[0] === '--list') {
+				return { code: 0, stdout: options.table ?? TABLE, stderr: '' };
+			}
+			const script = args.slice(args.indexOf('-e') + 1).join(' ');
+			if (script.startsWith('printenv HOME')) {
+				return { code: 0, stdout: `${options.home ?? '/home/u'}\n`, stderr: '' };
+			}
+			if (script.includes('ls -1t')) {
+				return { code: 0, stdout: (options.payloadDirs ?? []).join('\n'), stderr: '' };
+			}
+			if (script.includes('printf %s "$1" > "$2"')) {
+				state.markers.push(args[args.length - 1]);
+				return { code: 0, stdout: '', stderr: '' };
+			}
+			if (script.includes('rmdir "$1"')) {
+				lockHeld = false;
+				state.released += 1;
+				return { code: 0, stdout: '', stderr: '' };
+			}
+			if (script.includes('stat -c %Y')) {
+				return { code: 0, stdout: lockHeld ? `${Math.floor(Date.now() / 1000) - (options.lockAgeSeconds ?? 0)}\n` : '', stderr: '' };
+			}
+			if (script.includes('"$1.lock"')) {
+				state.cleared += 1;
+				lockHeld = false;
+				return { code: 0, stdout: '', stderr: '' };
+			}
+			if (script.includes('rm -rf')) {
+				state.removed.push(args[args.length - 1]);
+				return { code: 0, stdout: '', stderr: '' };
+			}
+			if (script.includes('command -v icode')) {
+				return { code: options.icode === undefined ? 1 : 0, stdout: options.icode ?? '', stderr: '' };
+			}
+			if (script.startsWith('test -x')) {
+				return { code: 1, stdout: '', stderr: '' };
+			}
+			if (script.includes('if [ -e')) {
+				return { code: 0, stdout: lockHeld ? '1' : '0', stderr: '' };
+			}
+			if (script.includes('mkdir "$1"')) {
+				if (lockHeld) {
+					return { code: 1, stdout: '', stderr: '' };
+				}
+				lockHeld = true;
+				state.acquired += 1;
+				return { code: 0, stdout: '', stderr: '' };
+			}
+			if (script.includes('rm -f')) {
+				state.cleared += 1;
+				return { code: 0, stdout: '', stderr: '' };
+			}
+			if (script.includes('cat "$1"')) {
+				const value = sequence.length > 1 ? sequence.shift() : sequence.length === 1 ? sequence[0] : options.runtime;
+				return { code: 0, stdout: value === undefined ? '' : JSON.stringify(value), stderr: '' };
+			}
+			throw new Error(`unexpected script: ${script}`);
+		},
+		spawn() {
+			state.spawns += 1;
+			throw new Error('the resolver tests inject startServer; spawn must stay unused');
+		}
+	};
+	return runner;
+}
+
+function silentLog() {
+	return { info() { }, error() { }, show() { }, dispose() { } };
+}
+
+/** @param {ReturnType<typeof makeRunner>} runner */
+function startsRecording() {
+	/** @type {any[]} */
+	const starts = [];
+	return {
+		starts,
+		startServer: async (options) => {
+			starts.push(options);
+			return { port: 5555, token: 'fresh-token', tag: VERSION, pid: 1234, startedAt: 'now' };
+		}
+	};
+}
+
+test('an empty authority resolves to the default distro and reuses a matching live server', async () => {
+	const runtime = { port: 41234, token: 'tok', tag: VERSION, pid: 7, startedAt: 'then' };
+	const runner = makeRunner({ runtime });
+	const { starts, startServer } = startsRecording();
+	let ensured = 0;
+	let probed = 0;
+	const resolver = createResolver({
+		runner,
+		catalog: catalog(),
+		components: () => { ensured += 1; throw new Error('must not install when the stored server is alive'); },
+		settings: {},
+		log: silentLog(),
+		startServer,
+		probe: async (target) => { probed += 1; assert.strictEqual(target.port, 41234); assert.strictEqual(target.token, 'tok'); return 'alive'; }
+	});
+
+	assert.deepStrictEqual(await resolver.resolve('picket-wsl+'), { host: '127.0.0.1', port: 41234, connectionToken: 'tok' });
+	assert.strictEqual(ensured, 0);
+	assert.strictEqual(starts.length, 0);
+	assert.strictEqual(probed, 1);
+	assert.strictEqual(runner.state.spawns, 0);
+});
+
+test('a runtime file from another tag is not trusted', async () => {
+	const runner = makeRunner({ runtime: { port: 41234, token: 'old', tag: 'older-tag', pid: 7, startedAt: 'then' } });
+	const { starts, startServer } = startsRecording();
+	let probed = 0;
+	const resolver = createResolver({
+		runner,
+		catalog: catalog(),
+		components: () => ({ ensure: async () => ({ payloadDir: `/home/u/.picket-code-server/payloads/server-${VERSION}` }) }),
+		settings: {},
+		log: silentLog(),
+		startServer,
+		probe: async () => { probed += 1; return 'alive'; }
+	});
+
+	const result = await resolver.resolve('picket-wsl+Ubuntu');
+	assert.deepStrictEqual(result, { host: '127.0.0.1', port: 5555, connectionToken: 'fresh-token' });
+	assert.strictEqual(starts.length, 1);
+	assert.strictEqual(probed, 0, 'a stale tag is enough to restart; the port may already belong to another server');
+	const args = starts[0].args;
+	assert.ok(args.some(a => /^--connection-token=.{32,}$/.test(a)), 'a fresh token is minted for the new server');
+	assert.ok(args.includes(`--user-data-dir=/home/u/.picket-code-server/data`));
+	assert.strictEqual(args[1], 'Ubuntu');
+	assert.strictEqual(starts[0].runtimeFile, `/home/u/.picket-code-server/runtime/Ubuntu.json`);
+});
+
+test('a dead probe restarts the server and clears the stale runtime file', async () => {
+	const runner = makeRunner({ runtime: { port: 41234, token: 'tok', tag: VERSION, pid: 7, startedAt: 'then' } });
+	const { starts, startServer } = startsRecording();
+	const resolver = createResolver({
+		runner,
+		catalog: catalog(),
+		components: () => ({ ensure: async () => ({ payloadDir: `/home/u/.picket-code-server/payloads/server-${VERSION}` }) }),
+		settings: {},
+		log: silentLog(),
+		startServer,
+		probe: async () => 'dead'
+	});
+
+	assert.strictEqual((await resolver.resolve('picket-wsl+Ubuntu')).port, 5555);
+	assert.strictEqual(starts.length, 1);
+	assert.ok(runner.state.cleared >= 1, 'the stale record must be removed before a new server takes its place');
+});
+
+test('an unknown distro rejects and names the ones that exist', async () => {
+	const runner = makeRunner({ runtime: { port: 1, token: 't', tag: VERSION, pid: 1, startedAt: 'then' } });
+	const { starts, startServer } = startsRecording();
