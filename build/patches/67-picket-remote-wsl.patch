+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createHash } = require('node:crypto');
+const { mkdtemp, mkdir, writeFile, readFile, rm } = require('node:fs/promises');
+const { tmpdir } = require('node:os');
+const { join } = require('node:path');
+const { execFile } = require('node:child_process');
+const { promisify } = require('node:util');
+const run = promisify(execFile);
+
+const { unpackOfflineBundle, removeBundle } = require('../src/offline.js');
+
+const VERSION = '1.0.0';
+const COMMIT = 'a'.repeat(40);
+const NAME = `picket-code-server-${VERSION}-linux-x64.tar.gz`;
+const PAYLOAD = Buffer.from([0x1f, 0x8b, 0x08, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x03]);
+const SHA = createHash('sha256').update(PAYLOAD).digest('hex');
+
+/** Builds a real zip with the Info-ZIP CLI, the same tool CI has. */
+async function buildBundle(dir) {
+	const inner = join(dir, 'bundle-src');
+	await mkdir(inner, { recursive: true });
+	await writeFile(join(inner, NAME), PAYLOAD);
+	await writeFile(join(inner, 'SHA256SUMS'), `${SHA}  ${NAME}\n`);
+	await writeFile(join(inner, 'catalog.json'), JSON.stringify({
+		schema: 2,
+		minVersion: VERSION,
+		flavor: 'ondemand',
+		components: [{
+			id: 'wsl-server',
+			kind: 'server',
+			version: VERSION,
+			commit: COMMIT,
+			file: NAME,
+			size: 10,
+			sha256: SHA,
+			embedded: false
+		}]
+	}, null, '\t'));
+	const zip = join(dir, 'picket-wsl-offline.zip');
+	await run('zip', ['-j', '-q', zip, join(inner, NAME), join(inner, 'SHA256SUMS'), join(inner, 'catalog.json')]);
+	return zip;
+}
+
+test('an offline bundle unpacks to a verified payload, sums and catalog', async () => {
+	const work = await mkdtemp(join(tmpdir(), 'picket-wsl-test-'));
+	try {
+		const zip = await buildBundle(work);
+		const unpacked = await unpackOfflineBundle({ bundlePath: zip });
+
+		assert.equal(unpacked.catalog.schema, 2);
+		assert.equal(unpacked.catalog.components[0].commit, COMMIT);
+		assert.equal(unpacked.sums.get(NAME), SHA);
+		assert.equal(unpacked.payloadSha256, SHA, 'the payload digest is checked before anything is installed');
+		assert.match(unpacked.payloadPath, /picket-code-server-1\.0\.0-linux-x64\.tar\.gz$/);
+
+		const bytes = await readFile(unpacked.payloadPath);
+		assert.equal(bytes.length, 10);
+	} finally {
+		await rm(work, { recursive: true, force: true });
+	}
+});
+
+test('a payload whose digest disagrees with SHA256SUMS is refused', async () => {
+	const work = await mkdtemp(join(tmpdir(), 'picket-wsl-test-'));
+	try {
+		const zip = await buildBundle(work);
+		// Corrupt the archive's payload by rebuilding it with different bytes.
+		const unpacked = await unpackOfflineBundle({ bundlePath: zip });
+		await writeFile(unpacked.payloadPath, Buffer.from('tampered'));
+		await assert.rejects(
+			() => unpackOfflineBundle({
+				bundlePath: zip,
+				expand: async (bundle, dest) => {
+					const { defaultExpand } = require('../src/offline.js');
+					await defaultExpand(bundle, dest);
+					await writeFile(join(dest, NAME), Buffer.from('tampered'));
+				}
+			}),
+			/sha256 mismatch/
+		);
+	} finally {
+		await rm(work, { recursive: true, force: true });
+	}
+});
+
+test('a bundle without a catalog is refused before any file is installed', async () => {
+	const work = await mkdtemp(join(tmpdir(), 'picket-wsl-test-'));
+	try {
+		const inner = join(work, 'inner');
+		await mkdir(inner, { recursive: true });
+		await writeFile(join(inner, NAME), 'x');
+		const zip = join(work, 'bare.zip');
+		await run('zip', ['-j', '-q', zip, join(inner, NAME)]);
+		await assert.rejects(() => unpackOfflineBundle({ bundlePath: zip }), /catalog\.json/);
+	} finally {
+		await rm(work, { recursive: true, force: true });
+	}
+});
+
+test('removeBundle deletes the temporary directory', async () => {
+	const dir = await mkdtemp(join(tmpdir(), 'picket-wsl-test-'));
+	await removeBundle(dir);
+	await assert.rejects(() => readFile(join(dir, 'x')), /ENOENT/);
+});
