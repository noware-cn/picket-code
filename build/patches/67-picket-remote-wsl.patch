@@ -0,0 +1,74 @@
+// RED first: this file must fail until src/version.js exists.
+const test = require('node:test');
+const assert = require('node:assert');
+const { compareVersions, engineMinimum, normalizeWant, parseVersion, selectComponent } = require('../src/version.js');
+
+/** @param {string[]} versions @param {string} [commit] */
+function catalogOf(versions, commit = 'abc') {
+	return {
+		schema: 2,
+		flavor: 'ondemand',
+		minVersion: '1.0.0',
+		components: versions.map(version => ({
+			id: 'wsl-server', kind: 'server', version, commit,
+			file: `picket-code-server-${version}-linux-x64.tar.gz`, size: 3, sha256: 'a'.repeat(64), embedded: false
+		}))
+	};
+}
+
+test('compares semver numerically, not lexically', () => {
+	assert.equal(compareVersions('1.10.0', '1.9.0'), 1);
+	assert.equal(compareVersions('1.2.0', '1.2.0'), 0);
+	assert.equal(compareVersions('1.2.0', '1.2.1'), -1);
+});
+
+test('a prerelease suffix does not change the ordering', () => {
+	assert.equal(parseVersion('1.143.1-picket.1-rc.5').join('.'), '1.143.1');
+	assert.equal(compareVersions('1.143.1-rc.5', '1.143.1'), 0);
+});
+
+test('an unparsable version is an error, not a silent zero', () => {
+	assert.throws(() => compareVersions('latest', '1.0.0'), TypeError);
+});
+
+test('picks the highest component for the same commit', () => {
+	const result = selectComponent(catalogOf(['1.0.0', '1.4.0', '1.2.0']), { commit: 'abc', minVersion: '1.1.0' });
+	assert.equal(result.component.version, '1.4.0');
+});
+
+test('refuses a catalog whose highest version is below the minimum', () => {
+	const result = selectComponent(catalogOf(['1.0.0']), { commit: 'abc', minVersion: '1.1.0' });
+	assert.deepEqual(result, { error: 'below-min', offered: '1.0.0' });
+});
+
+test('refuses when no component matches the client commit', () => {
+	const result = selectComponent(catalogOf(['1.0.0'], 'other'), { commit: 'abc', minVersion: '1.0.0' });
+	assert.deepEqual(result, { error: 'no-commit' });
+});
+
+test('an empty catalog is not an error the caller can paper over', () => {
+	assert.deepEqual(selectComponent({ schema: 2, flavor: 'ondemand', minVersion: '1.0.0', components: [] },
+		{ commit: 'abc', minVersion: '1.0.0' }), { error: 'none' });
+});
+
+test('a build with no stamp (a developer tree) takes the highest component whatever its commit', () => {
+	// Acceptance and every `scripts/code.sh` run use an unpackaged tree, which has
+	// no commit and no minimum. check.mjs keeps such a build out of a release.
+	const result = selectComponent(catalogOf(['1.0.0', '1.4.0'], 'someone-elses-commit'), {});
+	assert.equal(result.component.version, '1.4.0');
+	assert.deepEqual(normalizeWant(undefined), { commit: '', minVersion: '0.0.0', anyCommit: true });
+});
+
+test('a stamped build is never treated as stampless', () => {
+	assert.deepEqual(normalizeWant({ commit: 'abc', minVersion: '1.2.0' }), { commit: 'abc', minVersion: '1.2.0', anyCommit: false });
+});
+
+test('the engines lower bound is what decides whether an extension can load', () => {
+	assert.strictEqual(engineMinimum('^1.143.0'), '1.143.0');
+	assert.strictEqual(engineMinimum('>=1.80.0'), '1.80.0');
+	assert.strictEqual(engineMinimum('~1.90.0'), '1.90.0');
+	assert.strictEqual(engineMinimum('1.75.0'), '1.75.0');
+	assert.strictEqual(engineMinimum('>=1.80.0 <2.0.0'), '1.80.0');
+	assert.strictEqual(engineMinimum('*'), undefined);
+	assert.strictEqual(engineMinimum(undefined), undefined);
+});
