+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { URI } from '../../../../base/common/uri.js';
+import type { AgentSignal, IAgentToolPendingConfirmationSignal } from '../../common/agent.js';
+import { ActionType } from '../../common/state/sessionActions.js';
+import { ResponsePartKind, ToolCallConfirmationReason, ToolCallStatus, ToolResultContentType, type ToolCallPendingConfirmationState, type ToolCallResult, type ToolResultContent } from '../../common/state/sessionState.js';
+
+/**
+ * A single `session/update` notification payload from iCode's ACP server.
+ *
+ * Only the fields this mapper reads are typed; ACP is an evolving protocol and
+ * both `sessionUpdate` and the tool-call `kind` are open string unions.
+ */
+export interface IcodeSessionUpdate {
+	readonly sessionUpdate: 'agent_message_chunk' | 'agent_thought_chunk' | 'tool_call' | 'tool_call_update' | 'plan' | 'usage_update' | 'session_info_update' | 'current_mode_update' | string;
+	readonly messageId?: string;
+	readonly content?: IcodeContentBlock | readonly IcodeContentBlock[];
+	readonly toolCallId?: string;
+	readonly title?: string;
+	readonly kind?: string;
+	readonly status?: string;
+	readonly rawInput?: unknown;
+	readonly rawOutput?: unknown;
+	readonly entries?: readonly unknown[];
+	readonly used?: number;
+	readonly size?: number;
+}
+
+/**
+ * One ACP content block, narrowed to what the transcript needs. A tool result
+ * arrives as a `content` block that wraps the real block one level down.
+ */
+export interface IcodeContentBlock {
+	readonly type: string;
+	readonly text?: string;
+	readonly content?: IcodeContentBlock | readonly IcodeContentBlock[];
+}
+
+/** The `session/request_permission` payload iCode sends before a gated tool runs. */
+export interface IcodePermissionRequest {
+	readonly sessionId: string;
+	readonly toolCall: { readonly toolCallId: string; readonly title?: string; readonly kind?: string; readonly status?: string; readonly rawInput?: unknown };
+	readonly options: readonly { readonly optionId: string; readonly name: string; readonly kind: string }[];
+}
+
+/** The `_chrys/agent_load_progress` payload, narrowed to what the activity text needs. */
+interface IcodeAgentLoadProgress {
+	readonly serverName?: string;
+	readonly current?: number;
+	readonly total?: number;
+}
+
+/** The `_chrys/retry_attempt` payload, narrowed to what the activity text needs. */
+interface IcodeRetryAttempt {
+	readonly attempt?: number;
+	readonly maxAttempts?: number;
+}
+
+/**
+ * Per-turn mapping state.
+ *
+ * ACP streams deltas without part identifiers, so the mapper mints them once
+ * per logical stream and remembers them here: `partIds` maps a stream key
+ * (`messageId` for text, {@link THOUGHT_PART_KEY} for reasoning) to its part id.
+ */
+export interface IIcodeTurnState {
+	readonly turnId: string;
+	/**
+	 * Prefix every host-facing tool call id carries.
+	 *
+	 * ACP tool call ids are unique inside one process, and two chats can run in
+	 * different processes. The host correlates an approval by tool call id alone
+	 * (`respondToPermissionRequest` gets nothing else), so an id two processes
+	 * both use would let one chat's answer settle the other chat's request.
+	 */
+	readonly toolCallIdPrefix: string;
+	/** Stream key to the transcript part id it was assigned; see the type doc. */
+	readonly partIds: Map<string, string>;
+	/** Host tool call id to the display title used for the past-tense completion message. */
+	readonly toolTitles: Map<string, string>;
+	/** Host tool call id to its serialized `rawInput`; ACP usually reports it only on `tool_call`. */
+	readonly toolInputs: Map<string, string>;
+	/** Tool calls that already emitted `ChatToolCallReady`. */
+	readonly readyToolCalls: Set<string>;
+	nextPartSequence: number;
+	/**
+	 * Set once the first content chunk of this turn reached the transcript.
+	 *
+	 * iCode re-sends `_chrys/turn_started` on every retry of the same turn, so
+	 * the agent uses this flag to keep a cleared activity line from coming back.
+	 */
+	activityCleared: boolean;
+}
+
+const THOUGHT_PART_KEY = '__thought__';
+const ANONYMOUS_TEXT_PART_KEY = '__message__';
+const PART_ID_PREFIX = 'icode-part-';
+
+export function createIcodeTurnState(turnId: string, toolCallIdPrefix = ''): IIcodeTurnState {
+	return {
+		turnId,
+		toolCallIdPrefix,
+		partIds: new Map(),
+		toolTitles: new Map(),
+		toolInputs: new Map(),
+		readyToolCalls: new Set(),
+		nextPartSequence: 0,
+		activityCleared: false,
+	};
+}
+
+/** The id the host sees for an ACP tool call; see {@link IIcodeTurnState.toolCallIdPrefix}. */
+export function hostToolCallId(state: IIcodeTurnState, toolCallId: string): string {
+	return `${state.toolCallIdPrefix}${toolCallId}`;
+}
+
+/**
+ * Maps one ACP `session/update` notification to zero or more agent host
+ * signals. Pure: the only mutation is to the caller-owned `state`.
+ */
+export function mapAcpSessionUpdate(chat: URI, state: IIcodeTurnState, update: IcodeSessionUpdate): AgentSignal[] {
+	switch (update.sessionUpdate) {
+		case 'agent_message_chunk':
+			return mapTextChunk(chat, state, update);
+		case 'agent_thought_chunk':
+			return mapThoughtChunk(chat, state, update);
+		case 'tool_call':
+			return mapToolCallStart(chat, state, update);
+		case 'tool_call_update':
+			return mapToolCallUpdate(chat, state, update);
+		default:
+			// `plan`, `usage_update`, `session_info_update`, `current_mode_update`
+			// and anything iCode adds later carry no transcript content here.
+			return [];
+	}
+}
+
+/**
+ * Maps one of iCode's `_chrys/...` progress notifications to the activity line
+ * the panel shows as a shimmer before the first token arrives.
+ *
+ * Only `ChatActivityChanged` actions are produced: the panel hides the shimmer
+ * as soon as any response part or tool call exists, so there is nothing to
+ * model beyond a human-readable status string. Formatting only — whether the
+ * text is still wanted is the caller's call (see
+ * {@link IIcodeTurnState.activityCleared}).
+ */
+export function mapAcpNotification(name: string, params: unknown, chat: URI, state: IIcodeTurnState | undefined): AgentSignal[] {
+	const activity = activityText(name, params);
+	if (activity === undefined) {
+		return [];
+	}
+	return [{ kind: 'action', resource: chat, action: { type: ActionType.ChatActivityChanged, activity } }];
+}
+
+function activityText(name: string, params: unknown): string | undefined {
+	switch (name) {
+		case '_chrys/turn_started':
+			return 'iCode 正在准备…';
+		case '_chrys/agent_load_started':
+			return '准备 iCode 运行时…';
+		case '_chrys/agent_load_progress': {
+			const progress = params as IcodeAgentLoadProgress | undefined;
+			if (typeof progress?.serverName !== 'string') {
+				return '准备 iCode 运行时…';
+			}
+			return `加载 ${progress.serverName} (${progress.current}/${progress.total})…`;
+		}
+		case '_chrys/retry_attempt': {
+			const retry = params as IcodeRetryAttempt | undefined;
+			return `重试 ${retry?.attempt}/${retry?.maxAttempts}…`;
+		}
+		default:
+			return undefined;
+	}
+}
+
+/**
+ * Maps one ACP `session/request_permission` request to the pending
+ * confirmation signal the host turns into `ChatToolCallReady`.
+ */
+export function mapAcpPermissionRequest(chat: URI, state: IIcodeTurnState, request: IcodePermissionRequest): AgentSignal[] {
+	const { toolCall } = request;
+	const toolCallId = hostToolCallId(state, toolCall.toolCallId);
+	const displayName = toolCall.title ?? toolCall.toolCallId;
+	const toolName = acpToolName(toolCall.kind);
+	const signals: AgentSignal[] = [];
+
+	if (!state.toolTitles.has(toolCallId)) {
+		state.toolTitles.set(toolCallId, displayName);
+		signals.push({
+			kind: 'action',
+			resource: chat,
+			action: { type: ActionType.ChatToolCallStart, turnId: state.turnId, toolCallId, toolName, displayName },
+		});
+	}
+
+	const pendingConfirmation: ToolCallPendingConfirmationState = {
+		status: ToolCallStatus.PendingConfirmation,
+		toolCallId,
+		toolName,
+		displayName,
+		invocationMessage: displayName,
+		confirmationTitle: displayName,
+		...(toolCall.rawInput !== undefined ? { toolInput: JSON.stringify(toolCall.rawInput) } : {}),
+	};
+	const permissionKind = acpPermissionKind(toolCall.kind);
+	const signal: IAgentToolPendingConfirmationSignal = {
+		kind: 'pending_confirmation',
+		chat,
+		state: pendingConfirmation,
+		...(permissionKind !== undefined ? { permissionKind } : {}),
+	};
+	signals.push(signal);
+
+	return signals;
+}
+
+function mapTextChunk(chat: URI, state: IIcodeTurnState, update: IcodeSessionUpdate): AgentSignal[] {
+	const text = extractText(update.content);
+	if (text === undefined) {
+		return [];
+	}
+
+	const key = update.messageId ?? ANONYMOUS_TEXT_PART_KEY;
+	let partId = state.partIds.get(key);
+	const signals: AgentSignal[] = [];
+	if (partId === undefined) {
+		partId = nextPartId(state);
+		state.partIds.set(key, partId);
+		signals.push({
+			kind: 'action',
+			resource: chat,
+			action: { type: ActionType.ChatResponsePart, turnId: state.turnId, part: { kind: ResponsePartKind.Markdown, id: partId, content: '' } },
+		});
+	}
+
+	signals.push({
+		kind: 'action',
+		resource: chat,
+		action: { type: ActionType.ChatDelta, turnId: state.turnId, partId, content: text },
+	});
+	return signals;
+}
+
+function mapThoughtChunk(chat: URI, state: IIcodeTurnState, update: IcodeSessionUpdate): AgentSignal[] {
+	const text = extractText(update.content);
+	if (text === undefined) {
+		return [];
+	}
+
+	// Reasoning must append through `ChatReasoning`: the reducer's `ChatDelta`
+	// branch only grows `ResponsePartKind.Markdown` parts and silently drops
+	// every other kind, so thinking would never render.
+	let partId = state.partIds.get(THOUGHT_PART_KEY);
+	const signals: AgentSignal[] = [];
+	if (partId === undefined) {
+		partId = nextPartId(state);
+		state.partIds.set(THOUGHT_PART_KEY, partId);
+		signals.push({
+			kind: 'action',
+			resource: chat,
+			action: { type: ActionType.ChatResponsePart, turnId: state.turnId, part: { kind: ResponsePartKind.Reasoning, id: partId, content: '' } },
+		});
+	}
+
+	signals.push({
+		kind: 'action',
+		resource: chat,
+		action: { type: ActionType.ChatReasoning, turnId: state.turnId, partId, content: text },
+	});
+	return signals;
+}
+
+function mapToolCallStart(chat: URI, state: IIcodeTurnState, update: IcodeSessionUpdate): AgentSignal[] {
+	const acpToolCallId = update.toolCallId;
+	if (acpToolCallId === undefined) {
+		return [];
+	}
+
+	const toolCallId = hostToolCallId(state, acpToolCallId);
+	const displayName = update.title ?? acpToolCallId;
+	state.toolTitles.set(toolCallId, displayName);
+	if (update.rawInput !== undefined) {
+		state.toolInputs.set(toolCallId, JSON.stringify(update.rawInput));
+	}
+
+	const signals: AgentSignal[] = [{
+		kind: 'action',
+		resource: chat,
+		action: {
+			type: ActionType.ChatToolCallStart,
+			turnId: state.turnId,
+			toolCallId,
+			toolName: acpToolName(update.kind),
+			displayName,
+		},
+	}];
+
+	// iCode may report the call as already running; the reducer then refuses the
+	// later completion unless a `running` transition happened first. A `pending`
+	// call goes to `pending_confirmation` through the permission request instead.
+	if (update.status === 'in_progress') {
+		const ready = createReadySignal(chat, state, toolCallId, displayName);
+		if (ready) {
+			signals.push(ready);
+		}
+	}
+	return signals;
+}
+
+function mapToolCallUpdate(chat: URI, state: IIcodeTurnState, update: IcodeSessionUpdate): AgentSignal[] {
+	const acpToolCallId = update.toolCallId;
+	if (acpToolCallId === undefined) {
+		return [];
+	}
+
+	const toolCallId = hostToolCallId(state, acpToolCallId);
+	const signals: AgentSignal[] = [];
+	const displayName = update.title ?? state.toolTitles.get(toolCallId) ?? acpToolCallId;
+	state.toolTitles.set(toolCallId, displayName);
+	if (update.rawInput !== undefined) {
+		state.toolInputs.set(toolCallId, JSON.stringify(update.rawInput));
+	}
+
+	const isCancelled = update.status === 'cancelled';
+	const isFinished = update.status === 'completed' || update.status === 'failed' || isCancelled;
+
+	// `ChatToolCallComplete` is dropped by the reducer unless the call is running,
+	// so a completion that arrives without a matching `in_progress` update has to
+	// be preceded by the ready signal.
+	if (update.status === 'in_progress' || isFinished) {
+		const ready = createReadySignal(chat, state, toolCallId, displayName);
+		if (ready) {
+			signals.push(ready);
+		}
+	}
+
+	if (isFinished) {
+		signals.push({
+			kind: 'action',
+			resource: chat,
+			action: {
+				type: ActionType.ChatToolCallComplete,
+				turnId: state.turnId,
+				toolCallId,
+				result: createCompletionResult(update, displayName),
+			},
+		});
+	}
+
+	return signals;
+}
+
+/**
+ * The `ChatToolCallComplete` payload for a terminal ACP status.
+ *
+ * A cancelled call has no action of its own on this surface: there is no
+ * `chat/toolCallCancelled`, and `chat/toolCallConfirmed` only cancels a call
+ * that is still `pendingConfirmation`, so a running call can only be ended by a
+ * completion. Reporting it as a failed completion whose error code is
+ * `cancelled` is the closest honest signal — the workbench renders exactly that
+ * as a skipped call rather than a failure — and the past-tense message says so,
+ * instead of reading like a successful run. The restored transcript still says
+ * `ToolCallStatus.Cancelled`, so a reload can differ from what the live turn
+ * showed; the protocol offers no way to unify the two.
+ */
+function createCompletionResult(update: IcodeSessionUpdate, displayName: string): ToolCallResult {
+	const content = extractResultContent(update);
+	if (update.status === 'cancelled') {
+		return {
+			success: false,
+			pastTenseMessage: `${displayName} (cancelled)`,
+			error: { message: 'iCode cancelled this tool call', code: 'cancelled' },
+			...(content !== undefined ? { content } : {}),
+		};
+	}
+	return {
+		success: update.status === 'completed',
+		pastTenseMessage: displayName,
+		...(content !== undefined ? { content } : {}),
+	};
+}
+
+/** Emits `ChatToolCallReady` once per call, carrying the input seen at `tool_call`. */
+function createReadySignal(chat: URI, state: IIcodeTurnState, toolCallId: string, displayName: string): AgentSignal | undefined {
+	if (state.readyToolCalls.has(toolCallId)) {
+		return undefined;
+	}
+	state.readyToolCalls.add(toolCallId);
+
+	const toolInput = state.toolInputs.get(toolCallId);
+	return {
+		kind: 'action',
+		resource: chat,
+		action: {
+			type: ActionType.ChatToolCallReady,
+			turnId: state.turnId,
+			toolCallId,
+			invocationMessage: displayName,
+			confirmed: ToolCallConfirmationReason.NotNeeded,
+			...(toolInput !== undefined ? { toolInput } : {}),
+		},
+	};
+}
+
+/** Joins the `text` blocks of an ACP content payload, or `undefined` when it carries no text. */
+function extractText(content: IcodeSessionUpdate['content']): string | undefined {
+	const blocks = Array.isArray(content) ? content : content !== undefined ? [content] : [];
+	const text = blocks.map(blockText).join('');
+	return text.length > 0 ? text : undefined;
+}
+
+/** The text a block carries, looking through the `content` wrapper ACP uses for tool results. */
+function blockText(block: IcodeContentBlock): string {
+	if (block.type === 'text' && typeof block.text === 'string') {
+		return block.text;
+	}
+	if (block.type === 'content' && block.content !== undefined) {
+		const nested = Array.isArray(block.content) ? block.content : [block.content];
+		return nested.map(blockText).join('');
+	}
+	return '';
+}
+
+/**
+ * Builds the completion content: the `text` blocks iCode reported, else the raw
+ * output, else nothing at all.
+ */
+function extractResultContent(update: IcodeSessionUpdate): ToolResultContent[] | undefined {
+	const text = extractText(update.content);
+	if (text !== undefined) {
+		return [{ type: ToolResultContentType.Text, text }];
+	}
+	if (update.rawOutput === undefined) {
+		return undefined;
+	}
+	const raw = typeof update.rawOutput === 'string' ? update.rawOutput : JSON.stringify(update.rawOutput);
+	return raw.length > 0 ? [{ type: ToolResultContentType.Text, text: raw }] : undefined;
+}
+
+function nextPartId(state: IIcodeTurnState): string {
+	return `${PART_ID_PREFIX}${++state.nextPartSequence}`;
+}
+
+/** Maps an ACP tool-call `kind` to the internal tool name shown in the transcript. */
+export function acpToolName(kind: string | undefined): string {
+	switch (kind) {
+		case 'execute': return 'shell';
+		case 'edit': return 'edit';
+		case 'read': return 'read';
+		case 'search': return 'search';
+		case 'fetch': return 'fetch';
+		default: return 'other';
+	}
+}
+
+/** Maps an ACP tool-call `kind` to the host's auto-approval permission kind. */
+function acpPermissionKind(kind: string | undefined): IAgentToolPendingConfirmationSignal['permissionKind'] {
+	switch (kind) {
+		case 'execute': return 'shell';
+		case 'edit': return 'write';
+		case 'read': return 'read';
+		default: return undefined;
+	}
+}
