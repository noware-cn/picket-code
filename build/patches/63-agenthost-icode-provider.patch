+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { type ChildProcess, spawn } from 'child_process';
+import { EventEmitter } from 'events';
+import { PassThrough } from 'stream';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import {
+	buildIcodeArgs,
+	createIcodeTransport,
+	escapeCmdArg,
+	formatIcodeSpawnCommand,
+	ICODE_AGENT_ENV,
+	ICODE_BIN_ENV,
+	resolveIcodeCommand,
+} from '../../../node/icode/icodeLaunchConfig.js';
+
+interface ISpawnCall {
+	readonly command: string;
+	readonly args: readonly string[];
+	readonly options: any;
+}
+
+interface IFakeChild extends EventEmitter {
+	pid: number | undefined;
+	stdin: PassThrough;
+	stdout: PassThrough;
+	stderr: PassThrough;
+	killed: string[];
+	kill(signal?: string): boolean;
+}
+
+function createFakeChild(): IFakeChild {
+	const child = new EventEmitter() as IFakeChild;
+	child.pid = undefined;
+	child.stdin = new PassThrough();
+	child.stdout = new PassThrough();
+	child.stderr = new PassThrough();
+	child.killed = [];
+	child.kill = (signal?: string) => {
+		child.killed.push(signal ?? 'SIGTERM');
+		return true;
+	};
+	return child;
+}
+
+function recordSpawn(calls: ISpawnCall[], child: IFakeChild): typeof spawn {
+	return ((command: string, args: readonly string[], options: any) => {
+		calls.push({ command, args, options });
+		return child as unknown as ChildProcess;
+	}) as unknown as typeof spawn;
+}
+
+suite('icodeLaunchConfig', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('PICKET_ICODE_BIN wins when it points at a file', async () => {
+		const probed: string[] = [];
+		const resolution = await resolveIcodeCommand(
+			{ [ICODE_BIN_ENV]: '/opt/icode/bin/icode', PATH: '/usr/bin' },
+			path => {
+				probed.push(path);
+				return path === '/opt/icode/bin/icode';
+			},
+			'/work',
+		);
+
+		assert.deepStrictEqual(resolution, { command: '/opt/icode/bin/icode' });
+		assert.deepStrictEqual(probed, ['/opt/icode/bin/icode'], 'PATH must not be consulted when the override is valid');
+	});
+
+	test('an invalid override fails resolution instead of falling through to PATH', async () => {
+		const probed: string[] = [];
+		const resolution = await resolveIcodeCommand(
+			{ [ICODE_BIN_ENV]: '/missing/icode', PATH: '/usr/bin' },
+			path => {
+				probed.push(path);
+				return path === '/usr/bin/icode';
+			},
+			'/work',
+		);
+
+		assert.deepStrictEqual(resolution, { reason: 'override-missing' });
+		assert.deepStrictEqual(probed, ['/missing/icode'], 'PATH must not be consulted when the override is set');
+	});
+
+	test('an empty override counts as unset', async () => {
+		const resolution = await resolveIcodeCommand(
+			{ [ICODE_BIN_ENV]: '', PATH: '/one:/two' },
+			path => path === '/two/icode',
+			'/work',
+		);
+
+		assert.deepStrictEqual(resolution, { command: '/two/icode' });
+	});
+
+	test('finds icode on PATH and skips empty segments', async () => {
+		const resolution = await resolveIcodeCommand(
+			{ PATH: ':/one::/two' },
+			path => path === '/two/icode',
+			'/work',
+		);
+
+		assert.deepStrictEqual(resolution, { command: '/two/icode' });
+	});
+
+	test('reports not-found when icode is not on PATH', async () => {
+		assert.deepStrictEqual(
+			await resolveIcodeCommand({ PATH: '/one' }, () => false, '/work'),
+			{ reason: 'not-found' },
+		);
+		assert.deepStrictEqual(
+			await resolveIcodeCommand({ PATH: '/one' }, async () => false, '/work'),
+			{ reason: 'not-found' },
+		);
+	});
+
+	test('builds the fixed manual-approval argument list', () => {
+		assert.deepStrictEqual(buildIcodeArgs('Code'), ['acp', '--approval', 'manual', '-a', 'Code']);
+		assert.deepStrictEqual(buildIcodeArgs('Fast'), ['acp', '--approval', 'manual', '-a', 'Fast']);
+	});
+
+	test('quotes arguments for cmd.exe', () => {
+		assert.strictEqual(escapeCmdArg('acp'), '"acp"');
+		assert.strictEqual(escapeCmdArg('say "hi"'), '"say ""hi"""');
+	});
+
+	test('routes a Windows .cmd shim through the shell with escaped tokens', () => {
+		assert.deepStrictEqual(formatIcodeSpawnCommand('C:\\tools\\icode.cmd', ['acp', '-a', 'Code'], 'win32'), {
+			executable: '"C:\\tools\\icode.cmd"',
+			args: ['"acp"', '"-a"', '"Code"'],
+			shell: true,
+		});
+		assert.deepStrictEqual(formatIcodeSpawnCommand('C:\\tools\\ICODE.BAT', ['acp'], 'win32'), {
+			executable: '"C:\\tools\\ICODE.BAT"',
+			args: ['"acp"'],
+			shell: true,
+		});
+	});
+
+	test('never shell-interpolates a plain executable', () => {
+		assert.deepStrictEqual(formatIcodeSpawnCommand('C:\\tools\\icode.exe', ['acp', '-a', 'Code'], 'win32'), {
+			executable: 'C:\\tools\\icode.exe',
+			args: ['acp', '-a', 'Code'],
+			shell: false,
+		});
+		assert.deepStrictEqual(formatIcodeSpawnCommand('/usr/local/bin/icode', ['acp', '-a', 'Code'], 'linux'), {
+			executable: '/usr/local/bin/icode',
+			args: ['acp', '-a', 'Code'],
+			shell: false,
+		});
+	});
+
+	test('createIcodeTransport composes the spawn options without a shell on Linux', () => {
+		const calls: ISpawnCall[] = [];
+		const env = { PATH: '/usr/local/bin', [ICODE_AGENT_ENV]: 'Fast' };
+
+		createIcodeTransport('/usr/local/bin/icode', {
+			cwd: '/work',
+			env,
+			log: () => { },
+			platform: 'linux',
+			spawnProcess: recordSpawn(calls, createFakeChild()),
+			gracePeriodMs: 60_000,
+		});
+
+		assert.strictEqual(calls.length, 1);
+		assert.strictEqual(calls[0].command, '/usr/local/bin/icode');
+		assert.deepStrictEqual(calls[0].args, ['acp', '--approval', 'manual', '-a', 'Fast']);
+		assert.strictEqual(calls[0].options.shell, false);
+		assert.strictEqual(calls[0].options.cwd, '/work');
+		assert.strictEqual(calls[0].options.windowsHide, true);
+		assert.deepStrictEqual(calls[0].options.stdio, ['pipe', 'pipe', 'pipe']);
+		assert.deepStrictEqual(calls[0].options.env, env);
+	});
+
+	test('createIcodeTransport defaults the agent and honours a Windows shim', () => {
+		const calls: ISpawnCall[] = [];
+		const child = createFakeChild();
+
+		createIcodeTransport('C:\\tools\\icode.cmd', {
+			cwd: 'C:\\work',
+			env: { PATH: 'C:\\bin' },
+			log: () => { },
+			platform: 'win32',
+			spawnProcess: recordSpawn(calls, child),
+			gracePeriodMs: 60_000,
+		});
+
+		assert.strictEqual(calls.length, 1);
+		assert.strictEqual(calls[0].command, '"C:\\tools\\icode.cmd"');
+		assert.deepStrictEqual(calls[0].args, ['"acp"', '"--approval"', '"manual"', '"-a"', '"Code"']);
+		assert.strictEqual(calls[0].options.shell, true);
+		assert.strictEqual(calls[0].options.cwd, 'C:\\work');
+	});
+
+	test('surfaces a spawn failure on onExit without crashing', async () => {
+		const logs: string[] = [];
+		const command = `${process.cwd()}/.icode-that-does-not-exist-${Date.now()}`;
+
+		const transport = createIcodeTransport(command, {
+			cwd: process.cwd(),
+			env: process.env,
+			log: message => logs.push(message),
+		});
+
+		const code = await new Promise<number | null>(resolve => {
+			const listener = transport.onExit(exitCode => {
+				listener.dispose();
+				resolve(exitCode);
+			});
+		});
+
+		assert.strictEqual(code, null);
+		assert.strictEqual(transport.exited, true);
+		assert.ok(transport.error instanceof Error, 'the spawn error must be surfaced on the transport');
+		assert.ok(logs.some(line => line.startsWith('[icode]')), `expected an [icode] log, got:\n${logs.join('\n')}`);
+	});
+});
