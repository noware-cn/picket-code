+
+/** The subset of `session/prompt`'s result this agent reads. */
+interface IIcodePromptResult {
+	readonly stopReason?: string;
+	readonly usage?: {
+		readonly inputTokens?: unknown;
+		readonly outputTokens?: unknown;
+	};
+}
+
+/** The model catalog iCode reports alongside a new session. */
+interface IIcodeModelsCatalog {
+	readonly availableModels?: readonly { readonly modelId: string; readonly name: string; readonly description?: string }[];
+	readonly currentModelId?: string;
+}
+
+/** The subset of `session/new`'s result this agent reads. */
+interface IIcodeSessionNewResult {
+	readonly sessionId?: unknown;
+	readonly models?: IIcodeModelsCatalog;
+}
+
+/** The subset of `session/load`'s result this agent reads. */
+interface IIcodeSessionLoadResult {
+	readonly models?: IIcodeModelsCatalog;
+}
+
+interface IIcodeSession {
+	readonly sessionId: string;
+	readonly cwd: string;
+}
+
+/**
+ * One `session/load` replay, buffered while its request is still in flight.
+ *
+ * ACP session ids are only unique inside one process, and several chats can
+ * restore at the same time, so a replay belongs to the process it runs on and
+ * to the chat that asked for it — never to the agent as a whole.
+ */
+interface IIcodeReplay {
+	readonly sessionId: string;
+	readonly chatKey: string;
+	readonly updates: IcodeSessionUpdate[];
+}
+
+/**
+ * One `icode acp` process and the state that belongs to it.
+ *
+ * ACP session ids are only unique inside one process, so session routing is
+ * kept per process instead of in an agent-wide table.
+ */
+interface IIcodeClientEntry {
+	readonly cwd: string;
+	readonly client: IIcodeAcpClient;
+	/** Subscriptions on this process; disposed when it is replaced or gone. */
+	readonly store: DisposableStore;
+	/** ACP session id to chat, for `session/update` and the reverse requests. */
+	readonly chatsBySessionId: Map<string, URI>;
+	/** Replays streaming on this process, by the ACP session id they replay. */
+	readonly replays: Map<string, IIcodeReplay>;
+}
+
+/** A chat this agent has been told about; recorded for diagnostics only. */
+interface IIcodeChatRecord {
+	readonly cwd: string | undefined;
+}
+
+/** The `session/request_permission` response, narrowed to what this agent sends. */
+interface IcodePermissionResponse {
+	readonly outcome: { readonly outcome: 'selected'; readonly optionId: string } | { readonly outcome: 'cancelled' };
+}
+
+/** A permission request waiting for the host's answer. */
+interface IIcodePendingPermission {
+	readonly chatKey: string;
+	readonly options: IcodePermissionRequest['options'];
+	readonly resolve: (response: IcodePermissionResponse) => void;
+}
+
+/** An `ask_user` request waiting for the host's answer. */
+interface IIcodePendingInput {
+	readonly chatKey: string;
+	/** The id iCode gave the request, so a repeat from the same chat can supersede it. */
+	readonly sourceId: string;
+	/** The ACP questions, kept so the positional reply can be built once answered. */
+	readonly questions: readonly IIcodeQuestion[];
+	readonly resolve: (reply: IIcodeInputReply) => void;
+}
+
+const CANCELLED_PERMISSION: IcodePermissionResponse = { outcome: { outcome: 'cancelled' } };
+
+/**
+ * iCode's pre-token progress notifications. Each one only carries an activity
+ * line, so they are wired in bulk and mapped by name.
+ */
+const ICODE_ACTIVITY_NOTIFICATIONS = [
+	'_chrys/turn_started',
+	'_chrys/agent_load_started',
+	'_chrys/agent_load_progress',
+	'_chrys/retry_attempt',
+] as const;
+
+/** ACP option ids are arbitrary; pick by option kind and fall back to the protocol's names. */
+function permissionOptionId(options: IcodePermissionRequest['options'], approved: boolean): string {
+	const kindPrefix = approved ? 'allow' : 'reject';
+	return options.find(option => option.kind.startsWith(kindPrefix))?.optionId ?? kindPrefix;
+}
+
+/** True for a `_chrys/request_input` question this agent can turn into a protocol question. */
+function isIcodeQuestion(value: unknown): value is IIcodeQuestion {
+	return typeof (value as IIcodeQuestion | undefined)?.question === 'string';
+}
+
+/** True for the signals that put real content into the transcript. */
+function isTurnContentSignal(signal: AgentSignal): boolean {
+	return signal.kind === 'action' && (signal.action.type === ActionType.ChatDelta || signal.action.type === ActionType.ChatReasoning);
+}
+
+/** True for an activity-line update; the `_chrys/...` hints produce nothing else. */
+function isActivitySignal(signal: AgentSignal): boolean {
+	return signal.kind === 'action' && signal.action.type === ActionType.ChatActivityChanged;
+}
+
+/**
+ * Agent host provider backed by iCode's Agent Client Protocol server.
+ *
+ * One `icode acp` subprocess per working directory: a process, like the CLI's
+ * relative paths and the tools it runs, belongs to the folder it was started
+ * in, so chats that share a directory share a process and a chat in another
+ * directory gets its own. ACP already routes concurrent turns by session id,
+ * so the processes turn independently. Sessions are created lazily per chat and
+ * reused while the chat's working directory stays the same.
+ */
+export class IcodeAgent extends Disposable implements IAgent {
+
+	readonly id: AgentProvider = 'icode';
+	readonly agentHostCapabilities: IAgent['agentHostCapabilities'] = { workspaceConversion: false };
+
+	private readonly _onDidChatProgress = this._register(new Emitter<AgentSignal>());
+	readonly onDidChatProgress = this._onDidChatProgress.event;
+	readonly onDidMaterializeChat: IAgent['onDidMaterializeChat'] = this._register(new Emitter<IAgentMaterializeChatEvent>()).event;
+	private readonly _onDidChangeChatData = this._register(new Emitter<IAgentChatDataChange>());
+	readonly onDidChangeChatData: IAgent['onDidChangeChatData'] = this._onDidChangeChatData.event;
+	readonly onDidSpawnChat: IAgent['onDidSpawnChat'] = this._register(new Emitter<IAgentSpawnChatEvent>()).event;
+	readonly onDidDiscoverChats: IAgent['onDidDiscoverChats'] = this._register(new Emitter<readonly IAgentDiscoveredChat[]>()).event;
+
+	readonly models = observableValue<readonly IAgentModelInfo[]>('icode.models', [
+		{ provider: 'icode', id: 'default', name: 'iCode (BYOK)', supportsVision: false },
+	]);
+
+	/** Model ids iCode reported for a session; anything else (including the
+	 * pre-session placeholder above) must never be forwarded to `session/set_model`. */
+	private readonly _catalogModelIds = new Set<string>();
+
+	private readonly _chats = new Map<string, IIcodeChatRecord>();
+	private readonly _sessions = new Map<string, IIcodeSession>();
+	private readonly _turns = new Map<string, IIcodeTurnState>();
+	/** Transcript rebuilt from the last `session/load`, keyed by chat. */
+	private readonly _history = new Map<string, readonly Turn[]>();
+	/** The session each chat already published, by chat key; one blob per session. */
+	private readonly _announcedSessions = new Map<string, string>();
+	/** One in-flight turn per chat; the value is the running `sendMessage`. */
+	private readonly _activePrompts = new Map<string, Promise<void>>();
+	/** Turns the host cancelled before they had a session to send `session/cancel` to. */
+	private readonly _cancelledTurns = new Set<string>();
+	/** Chats whose live turn has already sent its prompt, so `abort` can cancel it directly. */
+	private readonly _promptingChats = new Set<string>();
+	/** Live turns by turn id, so a process exit can report each one with its duration. */
+	private readonly _liveTurns = new Map<string, { readonly chat: URI; readonly startedAt: number }>();
+	/** Permission requests waiting for the host's answer, keyed by host tool call id. */
+	private readonly _pendingPermissions = new Map<string, IIcodePendingPermission>();
+	/** `ask_user` requests waiting for the host's answer, keyed by a host-wide id. */
+	private readonly _pendingInputs = new Map<string, IIcodePendingInput>();
+	/**
+	 * Source of the ids this agent hands the host. iCode's own ids are unique
+	 * only inside one process, and several processes serve several chats, so
+	 * every interaction the host can answer gets an id from here instead.
+	 */
+	private _nextInteractionId = 0;
+
+	private readonly _clientStore = this._register(new DisposableStore());
+	private readonly _clientFactory: IcodeClientFactory;
+	/** One process per working directory, keyed by the cwd it was spawned in. */
+	private readonly _clients = new Map<string, IIcodeClientEntry>();
+	/** Creations in flight, so two chats of one directory share a single spawn. */
+	private readonly _clientCreations = new Map<string, Promise<IIcodeClientEntry>>();
+
+	constructor(
+		private readonly _logService: ILogService,
+		clientFactory?: IcodeClientFactory,
+	) {
+		super();
+		this._clientFactory = clientFactory ?? (cwd => this._createDefaultClient(cwd));
+	}
+
+	// ---- Identity and catalog -----------------------------------------------
+
+	getDescriptor(): IAgentDescriptor {
+		return { provider: this.id, displayName: 'iCode', description: 'iCode agent over the Agent Client Protocol' };
+	}
+
+	getProtectedResources(): ProtectedResourceMetadata[] {
+		return [];
+	}
+
+	async authenticate(_resource: string, _token: string, _expiresIn?: number): Promise<boolean> {
+		return false;
+	}
+
+	/**
+	 * ACP has no model-enumeration RPC: iCode reports its catalog with
+	 * `session/new`, so there is nothing to re-ask for. Republishing the cached
+	 * list keeps the scheduler from skipping this provider without spawning a
+	 * process or creating a session just to answer.
+	 */
+	async refreshModels(): Promise<void> {
+		// Nothing to re-ask for; the list is republished as-is.
+		this.models.set([...this.models.get()], undefined);
+	}
+
+	// ---- Chats ---------------------------------------------------------------
+
+	readonly chats: IAgentChats = {
+		createChat: (chat: URI, context: AgentChatOperationContext, options?: IAgentCreateChatOptions): Promise<IAgentCreateChatResult | void> => {
+			const workingDirectory = options?.workingDirectories?.[0] ?? (URI.isUri(context) ? undefined : context.launchWorkingDirectories?.[0]);
+			this._chats.set(chat.toString(), { cwd: workingDirectory?.fsPath });
+			return Promise.resolve({});
+		},
+		disposeChat: async (chat: URI, _context: AgentChatOperationContext): Promise<void> => {
+			const chatKey = chat.toString();
+			this._turns.delete(chatKey);
+			this._chats.delete(chatKey);
+			this._announcedSessions.delete(chatKey);
+			// A pending approval can never be answered once its chat is gone.
+			this._cancelPendingPermissions(key => key === chatKey);
+			this._cancelPendingInputs(key => key === chatKey);
+			// A replay still streaming for this chat must not be buffered any further.
+			this._dropChatReplays(chatKey);
+
+			const session = this._sessions.get(chatKey);
+			if (!session) {
+				return;
+			}
+			this._sessions.delete(chatKey);
+			// The process that owns the session is the one spawned for its cwd.
+			const entry = this._clients.get(session.cwd);
+			entry?.chatsBySessionId.delete(session.sessionId);
+			if (!entry) {
+				return;
+			}
+			try {
+				await entry.client.request('session/close', { sessionId: session.sessionId });
+			} catch (error) {
+				this._logService.warn(`[icode] failed to close session ${session.sessionId}: ${error instanceof Error ? error.message : String(error)}`);
+			}
+		},
+		releaseChat: (_chat: URI, _context: AgentChatOperationContext): Promise<void> => {
+			return Promise.resolve();
+		},
+		sendMessage: (
+			chat: URI,
+			prompt: string,
+			workingDirectoriesOrDirectory: readonly URI[] | URI | undefined,
+			_attachments?: readonly MessageAttachment[],
+			turnId?: string,
+			_senderClientId?: string,
+			_clientTypeOrContext?: AgentHostClientType | URI | IAgentChatContext,
+			_context?: URI | IAgentChatContext,
+		): Promise<void> => {
+			return this._sendMessage(chat, prompt, workingDirectoriesOrDirectory, turnId);
+		},
+		abort: (chat: URI, _context: AgentChatOperationContext): Promise<void> => {
+			const chatKey = chat.toString();
+			// iCode waits on an `ask_user` request and on `session/request_permission`
+			// until each is answered, so a cancelled turn has to settle both before it
+			// asks the agent to stop. A permission left pending keeps the prompt — and
+			// the host's approval card — alive even after the session is cancelled.
+			this._cancelPendingInputs(key => key === chatKey);
+			this._cancelPendingPermissions(key => key === chatKey);
+			// Decide by what this turn has done, not by which session is cached: a
+			// turn that moved to another directory is still waiting for its own
+			// `session/new` while the chat's previous session is still on record,
+			// and cancelling that idle one leaves the new turn running. The turn
+			// honours the recorded cancel as soon as it has a session of its own.
+			if (this._activePrompts.has(chatKey) && !this._promptingChats.has(chatKey)) {
+				this._cancelledTurns.add(chatKey);
+				this._logService.trace(`[icode] abort recorded: ${chatKey} has not prompted yet`);
+				return Promise.resolve();
+			}
+			const session = this._sessions.get(chatKey);
+			const entry = session && this._clients.get(session.cwd);
+			if (!session || !entry) {
+				this._logService.trace(`[icode] abort ignored: no live session for ${chatKey}`);
+				return Promise.resolve();
+			}
+			// The host already marked the turn cancelled and told the reducer, so
+			// firing a completion event here would complete the same turn twice.
+			entry.client.notify('session/cancel', { sessionId: session.sessionId });
+			return Promise.resolve();
+		},
+		changeModel: async (chat: URI, model: ModelSelection, _context: AgentChatOperationContext): Promise<void> => {
+			const chatKey = chat.toString();
+			const session = this._sessions.get(chatKey);
+			const entry = session && this._clients.get(session.cwd);
+			if (!session || !entry) {
+				// The picker is reachable before the chat's first turn, and iCode
+				// binds a model per session: there is nothing to switch yet.
+				this._logService.warn(`[icode] iCode needs an active session before switching models (chat: ${chatKey})`);
+				return;
+			}
+			if (!this._catalogModelIds.has(model.id)) {
+				// The picker can report a selection this provider never published
+				// (iCode rejects unknown ids), so an unknown id is a no-op rather
+				// than a request iCode answers with `Invalid params`.
+				this._logService.info(`[icode] ignoring unpublished model id ${model.id} for ${chatKey}`);
+				return;
+			}
+			try {
+				await entry.client.request('session/set_model', { sessionId: session.sessionId, modelId: model.id });
+			} catch (error) {
+				// Switching models is a picker affordance: a rejected switch is
+				// logged and swallowed so it can never break the chat.
+				this._logService.warn(`[icode] failed to switch models for ${chatKey}: ${error instanceof Error ? error.message : String(error)}`);
+			}
+		},
+		changeAgent: (_chat: URI, _agent: AgentSelection | undefined, _context: AgentChatOperationContext): Promise<void> => {
+			return Promise.resolve();
+		},
+		getMessages: (chat: URI, _context: AgentChatOperationContext): Promise<readonly Turn[]> => {
+			return Promise.resolve(this._history.get(chat.toString()) ?? []);
+		},
+	};
+
+	async materializeChat(chat: URI, _context: URI | IAgentChatContext, providerData: string | undefined): Promise<IAgentCreateChatResult | void> {
+		const data = decodeIcodeProviderData(providerData);
+		if (!data) {
+			return;
+		}
+
+		const chatKey = chat.toString();
+		// Seed the session before loading: iCode replays the session's updates
+		// while `session/load` is still in flight, and they have to be routed.
+		this._sessions.set(chatKey, { sessionId: data.sessionId, cwd: data.cwd });
+		this._announcedSessions.set(chatKey, data.sessionId);
+
+		const replay: IIcodeReplay = { sessionId: data.sessionId, chatKey, updates: [] };
+		let entry: IIcodeClientEntry | undefined;
+		try {
+			// The session lives in the process of the directory it was created in.
+			entry = await this._ensureClient(data.cwd);
+			entry.chatsBySessionId.set(data.sessionId, chat);
+			// Register before asking: the replayed updates arrive while the request
+			// is still in flight, and each chat buffers its own.
+			entry.replays.set(data.sessionId, replay);
+			const loaded = await entry.client.request<IIcodeSessionLoadResult>('session/load', { sessionId: data.sessionId, cwd: data.cwd, mcpServers: [] });
+			// A restored session carries the catalog just as a new one does. Skipped,
+			// a host that restarted into existing chats would keep the placeholder
+			// list, and `_catalogModelIds` would stay empty for the life of the chat.
+			this._publishModels(loaded?.models);
+			// A replay dropped mid-flight (chat disposed, process gone) must not
+			// publish a half-collected transcript.
+			if (entry.replays.get(data.sessionId) === replay) {
+				this._history.set(chatKey, buildIcodeTurns(replay.updates));
+			}
+		} catch (error) {
+			// iCode drops sessions it no longer stores; the chat must still open, and
+			// the next `sendMessage` starts a fresh session instead.
+			this._logService.warn(`[icode] failed to reload session ${data.sessionId}: ${error instanceof Error ? error.message : String(error)}`);
+			this._sessions.delete(chatKey);
+			// The announced session is gone; keep it announced only if the load
+			// worked, or the next session would never reach the host.
+			if (this._announcedSessions.get(chatKey) === data.sessionId) {
+				this._announcedSessions.delete(chatKey);
+			}
+			this._clients.get(data.cwd)?.chatsBySessionId.delete(data.sessionId);
+			this._history.delete(chatKey);
+		} finally {
+			if (entry?.replays.get(data.sessionId) === replay) {
+				entry.replays.delete(data.sessionId);
+			}
+		}
+	}
+
+	async setWorkingDirectory(_chat: URI, _context: URI | IAgentChatContext, _workingDirectory: URI): Promise<void> {
+		throw new Error('iCode does not support changing the working directory of an existing chat');
+	}
+
+	// ---- Metadata and configuration -----------------------------------------
+
+	async listChatsToMigrate(): Promise<AgentChatMigrationResult> {
+		return [];
+	}
+
+	async getChatMetadata(chat: URI, _context: URI | IAgentChatContext, providerData?: string, options?: IAgentChatMetadataOptions): Promise<IAgentChatMetadata | undefined> {
+		const data = decodeIcodeProviderData(providerData);
+		// A chat without provider data either predates it or lost it; answering
+		// with a miss would make the host report the session as unavailable, so
+		// describe it from the host's own timestamps and let `materializeChat`
+		// start from an empty history instead.
+		if (!data) {
+			const fallback = options?.registryFallback;
+			const timestamp = fallback?.startTime ?? Date.now();
+			return { chat, startTime: timestamp, modifiedTime: fallback?.modifiedTime ?? timestamp };
+		}
+		return {
+			chat,
+			startTime: data.createdAt,
+			modifiedTime: data.createdAt,
+			workingDirectories: [URI.file(data.cwd)],
+		};
+	}
+
+	async resolveChatConfig(params: IAgentResolveChatConfigParams): Promise<ResolveSessionConfigResult> {
+		return { schema: { type: 'object', properties: {} }, values: params.config ?? {} };
+	}
+
+	getInheritedChatConfig(): Record<string, unknown> | undefined {
+		return undefined;
+	}
+
+	async chatConfigCompletions(_params: IAgentChatConfigCompletionsParams): Promise<SessionConfigCompletionsResult> {
+		return { items: [] };
+	}
+
+	async getChatCustomizations(_chat: URI, _context: URI | IAgentChatContext): Promise<readonly Customization[]> {
+		return [];
+	}
+
+	// ---- Active clients and interaction -------------------------------------
+
+	getOrCreateActiveClient(_chat: URI, _context: URI | IAgentChatContext, client: { readonly clientId: string; readonly displayName?: string }): IActiveClient {
+		let tools: readonly ToolDefinition[] = [];
+		let customizations: readonly ClientPluginCustomization[] = [];
+		return {
+			clientId: client.clientId,
+			displayName: client.displayName,
+			get tools() { return tools; },
+			set tools(value: readonly ToolDefinition[]) { tools = value; },
+			get customizations() { return customizations; },
+			set customizations(value: readonly ClientPluginCustomization[]) { customizations = value; },
+		};
+	}
+
+	removeActiveClient(_chat: URI, _context: URI | IAgentChatContext, _clientId: string): void {
+		// iCode has no host-client tool contribution surface yet.
+	}
+
+	onClientToolCallComplete(_chat: URI, _toolCallId: string, _result: ToolCallResult, _context?: IAgentChatContext): void {
+		// iCode runs every tool call in its own process.
+	}
+
+	respondToPermissionRequest(requestId: string, approved: boolean, context?: IAgentPermissionResponseContext): void {
+		const pending = this._pendingPermissions.get(requestId);
+		if (!pending) {
+			// The host also decides on its own (`unattended_fallback`, `host_policy`)
+			// and may answer a request the turn already abandoned.
+			this._logService.trace(`[icode] ignoring permission response for '${requestId}' (source: ${context?.decisionSource ?? 'unknown'})`);
+			return;
+		}
+		this._pendingPermissions.delete(requestId);
+		// The host answers with its own option ids (`allow-once`, `allow-session`, …),
+		// which mean nothing to iCode: only forward an id iCode actually offered for
+		// this request, otherwise map the decision onto one of its options.
+		const selected = context?.selectedOptionId;
+		const offered = selected !== undefined && pending.options.some(option => option.optionId === selected);
+		if (selected !== undefined && !offered) {
+			this._logService.trace(`[icode] mapping host option '${selected}' onto the ACP decision (approved=${approved})`);
+		}
+		pending.resolve({
+			outcome: { outcome: 'selected', optionId: offered ? selected! : permissionOptionId(pending.options, approved) },
+		});
+	}
+
+	respondToUserInputRequest(requestId: string, response: ChatInputResponseKind, answers?: Record<string, ChatInputAnswer>): void {
+		const pending = this._pendingInputs.get(requestId);
+		if (!pending) {
+			// A stale click, or an answer for a request the turn already abandoned.
+			this._logService.trace(`[icode] ignoring input response for '${requestId}' (response: ${response})`);
+			return;
+		}
+		this._pendingInputs.delete(requestId);
+		pending.resolve(toIcodeInputReply(pending.questions, response, answers));
+	}
+
+	// ---- Provider lifecycle --------------------------------------------------
+
+	async shutdown(): Promise<void> {
+		this._disposeClients();
+	}
+
+	override dispose(): void {
+		this._disposeClients();
+		super.dispose();
+	}
+
+	// ---- Turn execution ------------------------------------------------------
+
+	private async _sendMessage(chat: URI, prompt: string, workingDirectoriesOrDirectory: readonly URI[] | URI | undefined, turnId: string | undefined): Promise<void> {
+		if (!turnId) {
+			throw new Error('iCode requires a turn id');
+		}
+
+		const chatKey = chat.toString();
+		const provided = (Array.isArray(workingDirectoriesOrDirectory) ? workingDirectoriesOrDirectory[0] : workingDirectoriesOrDirectory)?.fsPath;
+		// A chat created without a folder (the agents window always is unless a
+		// workspace was handed over) sends no working directories, so fall back to
+		// what the chat was created with before dropping to the home directory:
+		// iCode scans whatever directory it is given, and the host's git-backed
+		// turn checkpoints can only work inside a repository.
+		const remembered = this._chats.get(chatKey)?.cwd;
+		const cached = this._sessions.get(chatKey)?.cwd;
+		const cwd = provided ?? remembered ?? cached ?? homedir();
+		if (!provided) {
+			this._logService.info(`[icode] no working directory for ${chatKey}; using ${cwd}${remembered ? ' (from chat creation)' : ''}`);
+		}
+		// Validate before touching the client: iCode requires an existing absolute
+		// directory for `session/new`, and spawning a process for a doomed turn is a
+		// real cost.
+		if (!isAbsolute(cwd) || statSync(cwd, { throwIfNoEntry: false })?.isDirectory() !== true) {
+			throw new Error(`iCode requires an existing absolute working directory: ${cwd}`);
+		}
+
+		if (this._activePrompts.has(chatKey)) {
+			throw new Error('iCode is already running a turn for this chat');
+		}
+
+		const turn = this._runTurn(chat, chatKey, prompt, cwd, turnId);
+		this._activePrompts.set(chatKey, turn);
+		try {
+			await turn;
+		} finally {
+			if (this._activePrompts.get(chatKey) === turn) {
+				this._activePrompts.delete(chatKey);
+			}
+			// A turn that failed before it reached its session must not leave a
+			// cancel behind for the next one.
+			this._cancelledTurns.delete(chatKey);
+		}
+	}
+
+	private async _runTurn(chat: URI, chatKey: string, prompt: string, cwd: string, turnId: string): Promise<void> {
+		// The turn runs in the process spawned for its own directory, so two chats
+		// in different folders never share a queue and never share a cwd.
+		const entry = await this._ensureClient(cwd);
+		const client = entry.client;
+		const sessionId = await this._ensureSession(entry, chat, chatKey, cwd);
+		this._announceSession(chat, chatKey, sessionId, cwd);
+
+		const startedAt = Date.now();
+		// The host can cancel before `session/new` returns, when there is no
+		// iCode-side session to cancel yet. Prompting now would run the turn the
+		// user already stopped, so end it here — the host has already marked it
+		// cancelled, and this is the one completion it gets.
+		if (this._cancelledTurns.delete(chatKey)) {
+			this._fireAction(chat, { type: ActionType.ChatTurnCancelled, turnId, duration: Date.now() - startedAt });
+			return;
+		}
+
+		const state = createIcodeTurnState(turnId, `${++this._nextInteractionId}:`);
+		this._turns.set(chatKey, state);
+
+		this._liveTurns.set(turnId, { chat, startedAt });
+		try {
+			// From here on the turn owns a session, so `abort` cancels it directly
+			// instead of recording the cancel for this check.
+			this._promptingChats.add(chatKey);
+			let result: IIcodePromptResult | undefined;
+			try {
+				result = await client.request<IIcodePromptResult>('session/prompt', {
+					sessionId,
+					prompt: [{ type: 'text', text: prompt }],
+				});
+			} catch (error) {
+				// A process exit already reported `ChatError` for this turn; the pending
+				// request only rejects as a side effect of the exit.
+				if (client.exited) {
+					return;
+				}
+				throw error;
+			}
+
+			const usage = result?.usage;
+			if (typeof usage?.inputTokens === 'number' && typeof usage.outputTokens === 'number') {
+				this._fireAction(chat, {
+					type: ActionType.ChatUsage,
+					turnId,
+					usage: { inputTokens: usage.inputTokens, outputTokens: usage.outputTokens },
+				});
+			}
+
+			switch (result?.stopReason) {
+				case 'cancelled':
+					this._fireAction(chat, { type: ActionType.ChatTurnCancelled, turnId, duration: Date.now() - startedAt });
+					break;
+				case 'refusal':
+					// Never let a refusal look like a normal completion.
+					throw new Error('iCode refused this turn (stopReason: refusal)');
+				default:
+					this._fireAction(chat, { type: ActionType.ChatTurnComplete, turnId, duration: Date.now() - startedAt });
+					break;
+			}
+		} finally {
+			this._promptingChats.delete(chatKey);
+			this._turns.delete(chatKey);
+			this._liveTurns.delete(turnId);
+		}
+	}
+
+	private _fireAction(chat: URI, action: IAgentActionSignal['action']): void {
+		this._onDidChatProgress.fire({ kind: 'action', resource: chat, action });
+	}
+
+	/**
+	 * Publishes the ACP session backing a chat so the host can restore it after
+	 * a restart. One blob per session: re-announcing the same one would rewrite
+	 * what the host already has, while a session that replaced an earlier one
+	 * (the load failed, the process died) has to reach the host, or a restart
+	 * would restore the session that no longer carries this chat's context.
+	 */
+	private _announceSession(chat: URI, chatKey: string, sessionId: string, cwd: string): void {
+		if (this._announcedSessions.get(chatKey) === sessionId) {
+			return;
+		}
+		this._announcedSessions.set(chatKey, sessionId);
+		this._onDidChangeChatData.fire({
+			chat,
+			providerData: encodeIcodeProviderData({ v: 1, sessionId, cwd, createdAt: Date.now() }),
+		});
+	}
+
+	private async _ensureSession(entry: IIcodeClientEntry, chat: URI, chatKey: string, cwd: string): Promise<string> {
+		const cached = this._sessions.get(chatKey);
+		if (cached && cached.cwd === cwd) {
+			entry.chatsBySessionId.set(cached.sessionId, chat);
+			return cached.sessionId;
+		}
+
+		if (cached) {
+			this._clients.get(cached.cwd)?.chatsBySessionId.delete(cached.sessionId);
+			this._sessions.delete(chatKey);
+		}
+
+		const result = await entry.client.request<IIcodeSessionNewResult>('session/new', { cwd, mcpServers: [] });
+		const sessionId = typeof result?.sessionId === 'string' ? result.sessionId : undefined;
+		if (!sessionId) {
+			throw new Error('iCode did not return a session id from session/new');
+		}
+
+		this._publishModels(result?.models);
+		this._sessions.set(chatKey, { sessionId, cwd });
+		entry.chatsBySessionId.set(sessionId, chat);
+		return sessionId;
+	}
+
+	/**
+	 * Replaces the placeholder catalog with the models iCode reported for a new
+	 * session. A reply without a usable catalog leaves the current list alone:
+	 * iCode only advertises models it can serve, and an empty list must not wipe
+	 * what an earlier session published.
+	 */
+	private _publishModels(catalog: IIcodeModelsCatalog | undefined): void {
+		const available = catalog?.availableModels;
+		if (!Array.isArray(available)) {
+			return;
+		}
+		const models = available
+			.filter(model => typeof model?.modelId === 'string' && typeof model?.name === 'string')
+			// iCode's ACP capabilities declare no image input, so no model claims vision.
+			.map(model => ({ provider: this.id, id: model.modelId, name: model.name, supportsVision: false }));
+		if (models.length > 0) {
+			this._catalogModelIds.clear();
+			for (const model of models) {
+				this._catalogModelIds.add(model.id);
+			}
+			this.models.set(models, undefined);
+		}
+	}
+
+	// ---- ACP client lifecycle and routing ------------------------------------
+
+	private _ensureClient(cwd: string): Promise<IIcodeClientEntry> {
+		const existing = this._clients.get(cwd);
+		if (existing) {
+			return Promise.resolve(existing);
+		}
+		let creation = this._clientCreations.get(cwd);
+		if (!creation) {
+			creation = this._createAndWireClient(cwd).finally(() => {
+				if (this._clientCreations.get(cwd) === creation) {
+					this._clientCreations.delete(cwd);
+				}
+			});
+			this._clientCreations.set(cwd, creation);
+		}
+		return creation;
+	}
+
+	private async _createAndWireClient(cwd: string): Promise<IIcodeClientEntry> {
+		const client = await this._clientFactory(cwd);
+		if (!client) {
+			throw new Error('iCode executable not found: set PICKET_ICODE_BIN or put icode on PATH');
+		}
+
+		// Register before subscribing: an exit that fires during wiring must find
+		// the entry and drop it, instead of leaving a dead process behind.
+		const entry: IIcodeClientEntry = { cwd, client, store: new DisposableStore(), chatsBySessionId: new Map(), replays: new Map() };
+		this._clients.set(cwd, entry);
+		this._clientStore.add(entry.store);
+
+		entry.store.add(client.onNotification('session/update', params => this._handleSessionUpdate(entry, params)));
+		for (const name of ICODE_ACTIVITY_NOTIFICATIONS) {
+			entry.store.add(client.onNotification(name, params => this._handleActivityNotification(entry, name, params)));
+		}
+		entry.store.add(client.onRequest('session/request_permission', params => this._onPermissionRequest(entry, params)));
+		entry.store.add(client.onRequest('_chrys/request_input', params => this._onInputRequest(entry, params)));
+		entry.store.add(client.onExit(code => this._handleClientExit(entry, code)));
+
+		return entry;
+	}
+
+	private async _createDefaultClient(cwd: string): Promise<IIcodeAcpClient | undefined> {
+		const resolution = await resolveIcodeCommand(process.env, path => existsSync(path));
+		if (!('command' in resolution)) {
+			this._logService.warn(`[icode] could not resolve the icode executable (${resolution.reason})`);
+			return undefined;
+		}
+		// Spawn in the session's directory: iCode and the tools it runs resolve
+		// process-relative paths against it, not against the host's own cwd.
+		const transport = createIcodeTransport(resolution.command, {
+			cwd,
+			log: message => this._logService.info(message),
+		});
+		return new IcodeAcpClient(transport, message => this._logService.trace(message));
+	}
+
+	/**
+	 * Turns one ACP permission request into a pending confirmation and parks a
+	 * promise that `respondToPermissionRequest` settles.
+	 */
+	private _onPermissionRequest(entry: IIcodeClientEntry, params: unknown): Promise<IcodePermissionResponse> {
+		const request = params as Partial<IcodePermissionRequest> | undefined;
+		const sessionId = request?.sessionId;
+		const toolCallId = request?.toolCall?.toolCallId;
+		if (typeof sessionId !== 'string' || typeof toolCallId !== 'string') {
+			this._logService.warn(`[icode] ignoring malformed session/request_permission: ${JSON.stringify(params).slice(0, 512)}`);
+			return Promise.resolve(CANCELLED_PERMISSION);
+		}
+
+		const chat = entry.chatsBySessionId.get(sessionId);
+		const state = chat && this._turns.get(chat.toString());
+		if (!chat || !state) {
+			this._logService.trace(`[icode] auto-cancelling permission request for '${toolCallId}': no live turn for session '${sessionId}'`);
+			return Promise.resolve(CANCELLED_PERMISSION);
+		}
+
+		// The host answers by this id alone, so it is the turn-qualified one — and
+		// iCode rarely repeats a request, but a second one for the same tool call
+		// supersedes the first: exactly one answer must reach the subprocess.
+		const hostId = hostToolCallId(state, toolCallId);
+		this._settlePermission(hostId, CANCELLED_PERMISSION);
+
+		for (const signal of mapAcpPermissionRequest(chat, state, request as IcodePermissionRequest)) {
+			this._onDidChatProgress.fire(signal);
+		}
+
+		return new Promise<IcodePermissionResponse>(resolve => {
+			this._pendingPermissions.set(hostId, { chatKey: chat.toString(), options: request?.options ?? [], resolve });
+		});
+	}
+
+	private _settlePermission(toolCallId: string, response: IcodePermissionResponse): void {
+		const pending = this._pendingPermissions.get(toolCallId);
+		if (!pending) {
+			return;
+		}
+		this._pendingPermissions.delete(toolCallId);
+		pending.resolve(response);
+	}
+
+	/** Cancel every pending approval, or only those of the chats `match` selects. */
+	private _cancelPendingPermissions(match?: (chatKey: string) => boolean): void {
+		for (const toolCallId of [...this._pendingPermissions.keys()]) {
+			const pending = this._pendingPermissions.get(toolCallId);
+			if (pending && (!match || match(pending.chatKey))) {
+				this._settlePermission(toolCallId, CANCELLED_PERMISSION);
+			}
+		}
+	}
+
+	/**
+	 * Turns one iCode `ask_user` request into a `ChatInputRequested` action and
+	 * parks a promise that `respondToUserInputRequest` settles.
+	 *
+	 * iCode blocks the turn until it gets a reply, so anything this agent cannot
+	 * honour is answered with `cancelled` right away: neither a malformed request
+	 * nor one for a session that is no longer live may leave the subprocess
+	 * waiting forever.
+	 */
+	private _onInputRequest(entry: IIcodeClientEntry, params: unknown): Promise<IIcodeInputReply> {
+		const request = params as Partial<IIcodeInputRequest> | undefined;
+		const sessionId = request?.sessionId;
+		const requestId = request?.requestId;
+		const questions = request?.questions;
+		if (typeof sessionId !== 'string' || typeof requestId !== 'string' || !Array.isArray(questions) || !questions.every(isIcodeQuestion)) {
+			this._logService.warn(`[icode] ignoring malformed _chrys/request_input: ${JSON.stringify(params ?? null).slice(0, 512)}`);
+			return Promise.resolve(CANCELLED_INPUT_REPLY);
+		}
+
+		const chat = entry.chatsBySessionId.get(sessionId);
+		const state = chat && this._turns.get(chat.toString());
+		if (!chat || !state) {
+			this._logService.warn(`[icode] auto-cancelling input request '${requestId}': no live turn for session '${sessionId}'`);
+			return Promise.resolve(CANCELLED_INPUT_REPLY);
+		}
+
+		const chatKey = chat.toString();
+		// A repeated request id supersedes the earlier one: exactly one answer
+		// must reach the subprocess. The host, however, sees an id of our own:
+		// iCode's ids are only unique inside its process, and two chats can be in
+		// different processes, where the same id would answer the wrong chat.
+		this._cancelInputFrom(chatKey, requestId);
+		const hostRequestId = `icode-req-${++this._nextInteractionId}`;
+
+		this._fireAction(chat, { type: ActionType.ChatInputRequested, request: toChatInputRequest(hostRequestId, questions) });
+
+		return new Promise<IIcodeInputReply>(resolve => {
+			this._pendingInputs.set(hostRequestId, { chatKey, sourceId: requestId, questions, resolve });
+		});
+	}
+
+	/** Cancels whatever this chat is still waiting to answer for that iCode request. */
+	private _cancelInputFrom(chatKey: string, sourceId: string): void {
+		for (const requestId of [...this._pendingInputs.keys()]) {
+			const pending = this._pendingInputs.get(requestId);
+			if (pending && pending.chatKey === chatKey && pending.sourceId === sourceId) {
+				this._cancelInput(requestId);
+			}
+		}
+	}
+
+	/**
+	 * Cancels one pending input request. The reply still carries one entry per
+	 * question: iCode pairs them by position and would otherwise read the
+	 * cancellation as "the user answered nothing".
+	 */
+	private _cancelInput(requestId: string): void {
+		const pending = this._pendingInputs.get(requestId);
+		if (!pending) {
+			return;
+		}
+		this._pendingInputs.delete(requestId);
+		pending.resolve(toIcodeInputReply(pending.questions, ChatInputResponseKind.Cancel, undefined));
+	}
+
+	/** Cancel every pending input request, or only those of the chats `match` selects. */
+	private _cancelPendingInputs(match?: (chatKey: string) => boolean): void {
+		for (const requestId of [...this._pendingInputs.keys()]) {
+			const pending = this._pendingInputs.get(requestId);
+			if (pending && (!match || match(pending.chatKey))) {
+				this._cancelInput(requestId);
+			}
+		}
+	}
+
+	/** Drops the replays still buffering for one chat, on whichever process they run. */
+	private _dropChatReplays(chatKey: string): void {
+		for (const entry of this._clients.values()) {
+			for (const [sessionId, replay] of entry.replays) {
+				if (replay.chatKey === chatKey) {
+					entry.replays.delete(sessionId);
+				}
+			}
+		}
+	}
+
+	/**
+	 * Forgets one dead process. Only the chats and sessions created in it are
+	 * dropped: every other directory keeps its process and its live turns.
+	 */
+	private _handleClientExit(entry: IIcodeClientEntry, code: number | null): void {
+		this._logService.info(`[icode] icode exited in ${entry.cwd} (${code === null ? 'no exit code' : `code ${code}`})`);
+		if (this._clients.get(entry.cwd) !== entry) {
+			return;
+		}
+
+		// Forget the dead process so the next turn in this directory spawns a
+		// fresh one, and release its subscriptions with it.
+		this._clients.delete(entry.cwd);
+		this._clientStore.delete(entry.store);
+		entry.store.dispose();
+
+		const chatKeys = new Set<string>();
+		for (const [sessionId, chat] of entry.chatsBySessionId) {
+			const chatKey = chat.toString();
+			chatKeys.add(chatKey);
+			if (this._sessions.get(chatKey)?.sessionId === sessionId) {
+				this._sessions.delete(chatKey);
+			}
+			this._turns.delete(chatKey);
+		}
+		entry.chatsBySessionId.clear();
+
+		// Nothing more will be replayed into an in-flight load of this process;
+		// replays buffering on another process belong to chats that are still alive.
+		entry.replays.clear();
+		this._cancelPendingPermissions(chatKey => chatKeys.has(chatKey));
+		this._cancelPendingInputs(chatKey => chatKeys.has(chatKey));
+
+		// A dead process rejects the in-flight `session/prompt` with a plain
+		// cancellation, which the host would read as a user abort, so the exit has
+		// to be reported here. `_runTurn` swallows the matching rejection.
+		const liveTurns = [...this._liveTurns.entries()].filter(([, turn]) => chatKeys.has(turn.chat.toString()));
+		for (const [turnId] of liveTurns) {
+			this._liveTurns.delete(turnId);
+		}
+		for (const [turnId, { chat, startedAt }] of liveTurns) {
+			const message = `iCode exited (${code === null ? 'no exit code' : `code ${code}`}) before the turn finished`;
+			this._fireAction(chat, {
+				type: ActionType.ChatError,
+				turnId,
+				duration: Date.now() - startedAt,
+				part: createErrorResponsePart({ errorType: 'icodeExited', message }),
+			});
+		}
+	}
+
+	private _handleSessionUpdate(entry: IIcodeClientEntry, params: any): void {
+		const sessionId: unknown = params?.sessionId;
+		const update: unknown = params?.update;
+		if (typeof sessionId !== 'string' || typeof update !== 'object' || update === null) {
+			this._logService.trace(`[icode] ignoring malformed session/update: ${JSON.stringify(params).slice(0, 512)}`);
+			return;
+		}
+
+		// A `session/load` replays the whole stored transcript before it resolves;
+		// those updates are history, not progress for a live turn.
+		const replay = entry.replays.get(sessionId);
+		if (replay) {
+			replay.updates.push(update as IcodeSessionUpdate);
+			return;
+		}
+
+		const chat = entry.chatsBySessionId.get(sessionId);
+		if (!chat) {
+			this._logService.trace(`[icode] ignoring session/update for unknown session '${sessionId}'`);
+			return;
+		}
+		const state = this._turns.get(chat.toString());
+		if (!state) {
+			this._logService.trace(`[icode] ignoring session/update outside a turn for '${sessionId}'`);
+			return;
+		}
+
+		const signals = mapAcpSessionUpdate(chat, state, update as IcodeSessionUpdate);
+		for (const signal of signals) {
+			this._onDidChatProgress.fire(signal);
+		}
+
+		// The shimmer gives way to the turn's first content exactly once: later
+		// chunks must not re-clear, and the activity hints stay dropped afterwards.
+		if (!state.activityCleared && signals.some(isTurnContentSignal)) {
+			state.activityCleared = true;
+			this._fireAction(chat, { type: ActionType.ChatActivityChanged, activity: undefined });
+		}
+	}
+
+	/**
+	 * Routes one of iCode's `_chrys/...` progress notifications to the chat of
+	 * its ACP session. These are best-effort hints: an unknown session or a turn
+	 * that already ended only leaves a trace, never an error or a signal.
+	 */
+	private _handleActivityNotification(entry: IIcodeClientEntry, name: string, params: unknown): void {
+		const sessionId = (params as { readonly sessionId?: unknown } | undefined)?.sessionId;
+		if (typeof sessionId !== 'string') {
+			this._logService.trace(`[icode] ignoring ${name} without a session id: ${JSON.stringify(params ?? null).slice(0, 512)}`);
+			return;
+		}
+
+		const chat = entry.chatsBySessionId.get(sessionId);
+		if (!chat) {
+			this._logService.trace(`[icode] ignoring ${name} for unknown session '${sessionId}'`);
+			return;
+		}
+		const state = this._turns.get(chat.toString());
+		if (!state) {
+			this._logService.trace(`[icode] ignoring ${name} outside a turn for '${sessionId}'`);
+			return;
+		}
+
+		for (const signal of mapAcpNotification(name, params, chat, state)) {
+			// iCode re-sends `_chrys/turn_started` on every retry of the same turn,
+			// and a cleared activity line must not come back.
+			if (state.activityCleared && isActivitySignal(signal)) {
+				continue;
+			}
+			this._onDidChatProgress.fire(signal);
+		}
+	}
+
+	private _disposeClients(): void {
+		this._cancelPendingPermissions();
+		this._cancelPendingInputs();
+		const entries = [...this._clients.values()];
+		// Nothing more will be replayed into the in-flight loads of these processes.
+		for (const entry of entries) {
+			entry.replays.clear();
+		}
+		const clients = entries.map(entry => entry.client);
+		this._clients.clear();
+		this._clientCreations.clear();
+		// Drop every handler first, so a kill cannot re-enter this agent.
+		this._clientStore.clear();
+		this._sessions.clear();
+		this._turns.clear();
+		for (const client of clients) {
+			client.dispose();
+		}
+	}
+}
