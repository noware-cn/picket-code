+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/** Version of the opaque blob this provider persists; bump it whenever the shape changes. */
+export const ICODE_PROVIDER_DATA_VERSION = 1;
+
+/**
+ * What `IcodeAgent` stores in a chat's `providerData` so the chat can be
+ * restored after a restart: the ACP session id to reload plus the directory the
+ * session was created in.
+ */
+export interface IIcodeProviderData {
+	readonly v: typeof ICODE_PROVIDER_DATA_VERSION;
+	readonly sessionId: string;
+	readonly cwd: string;
+	/** When the session was created, reused as the restored chat's start time. */
+	readonly createdAt: number;
+}
+
+export function encodeIcodeProviderData(data: IIcodeProviderData): string {
+	return JSON.stringify(data);
+}
+
+/**
+ * Decodes a persisted blob without ever throwing: the host stores provider data
+ * verbatim and hands it back as-is, so it may be absent, empty, or written by an
+ * older build.
+ */
+export function decodeIcodeProviderData(raw: string | undefined): IIcodeProviderData | undefined {
+	if (raw === undefined || raw.length === 0) {
+		return undefined;
+	}
+
+	let parsed: unknown;
+	try {
+		parsed = JSON.parse(raw);
+	} catch {
+		return undefined;
+	}
+	if (typeof parsed !== 'object' || parsed === null) {
+		return undefined;
+	}
+
+	const record = parsed as Record<string, unknown>;
+	if (record.v !== ICODE_PROVIDER_DATA_VERSION) {
+		return undefined;
+	}
+	if (typeof record.sessionId !== 'string' || record.sessionId.length === 0) {
+		return undefined;
+	}
+	if (typeof record.cwd !== 'string' || record.cwd.length === 0) {
+		return undefined;
+	}
+	if (typeof record.createdAt !== 'number' || !Number.isFinite(record.createdAt)) {
+		return undefined;
+	}
+
+	return { v: ICODE_PROVIDER_DATA_VERSION, sessionId: record.sessionId, cwd: record.cwd, createdAt: record.createdAt };
+}
