@@ -0,0 +1,327 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { isThenable } from '../../../../base/common/async.js';
+import { CancellationToken } from '../../../../base/common/cancellation.js';
+import { BugIndicatingError } from '../../../../base/common/errors.js';
+import { Emitter, Event } from '../../../../base/common/event.js';
+import { IJsonRpcNotification, IJsonRpcRequest, JsonRpcError, JsonRpcId, JsonRpcMessage, JsonRpcProtocol } from '../../../../base/common/jsonRpcProtocol.js';
+import { DisposableStore, IDisposable, toDisposable } from '../../../../base/common/lifecycle.js';
+import { StreamSplitter } from '../../../../base/node/nodeStreams.js';
+
+export type IcodeJsonValue = null | boolean | number | string | IcodeJsonValue[] | { [key: string]: IcodeJsonValue };
+
+/** JSON-RPC standard error code; `JsonRpcProtocol` keeps its error codes private. */
+const METHOD_NOT_FOUND = -32601;
+/** Request cancellation notification used by the ACP/LSP lineage of JSON-RPC. */
+const CANCEL_REQUEST_METHOD = '$/cancel_request';
+/** Upper bound for a single stdout line; anything larger is a framing failure, not a message. */
+const MAX_LINE_LENGTH = 4 * 1024 * 1024;
+
+export interface IIcodeAcpTransport {
+	readonly stdin: NodeJS.WritableStream;
+	readonly stdout: NodeJS.ReadableStream;
+	/** Fires exactly once, when the process exited or could not be spawned. */
+	readonly onExit: Event<number | null>;
+	/** True once the process exited or failed to spawn. */
+	readonly exited: boolean;
+	/** Exit code, or `null` when unknown (signal, spawn failure or still running). */
+	readonly exitCode: number | null;
+	/** The spawn error, when the process could not be started. */
+	readonly error: Error | undefined;
+	/** Graceful and idempotent shutdown; a second call forces immediate termination. */
+	kill(): void;
+}
+
+/**
+ * JSON-RPC 2.0 facade over an iCode ACP subprocess.
+ *
+ * Handler registration is single-registration per method for both
+ * {@link onNotification} and {@link onRequest}: registering a second handler for
+ * the same method is a programming error and throws, so the two cannot drift
+ * apart.
+ */
+export interface IIcodeAcpClient extends IDisposable {
+	readonly onExit: Event<number | null>;
+	/** True once the process exited; late `onExit` subscribers must check this. */
+	readonly exited: boolean;
+	/** Exit code, or `null` while running, on a signal, or after a spawn failure. */
+	readonly exitCode: number | null;
+	request<R = unknown>(method: string, params?: IcodeJsonValue, token?: CancellationToken): Promise<R>;
+	notify(method: string, params?: IcodeJsonValue): void;
+	onNotification(method: string, handler: (params: any) => void): IDisposable;
+	/**
+	 * Registers the handler for a server-to-client request. The returned value is
+	 * sent as the response, so a handler that needs the user's answer must return
+	 * a promise that settles later; `undefined` is sent as `null`.
+	 */
+	onRequest<R = unknown>(method: string, handler: (params: any, id: JsonRpcId) => R | Promise<R>): IDisposable;
+}
+
+/**
+ * Newline-delimited JSON-RPC client for the iCode ACP subprocess.
+ *
+ * Framing is delegated to {@link StreamSplitter} and message handling to
+ * {@link JsonRpcProtocol}; this class only owns the transport, the stdout pipe
+ * and the exit state machine.
+ */
+export class IcodeAcpClient implements IIcodeAcpClient {
+
+	private readonly _onExit = new Emitter<number | null>();
+	readonly onExit: Event<number | null> = this._onExit.event;
+
+	get exited(): boolean {
+		return this._exited;
+	}
+
+	get exitCode(): number | null {
+		return this._exitCode;
+	}
+
+	private readonly _store = new DisposableStore();
+	private readonly _protocol: JsonRpcProtocol;
+	private readonly _splitter: StreamSplitter;
+	private readonly _notificationHandlers = new Map<string, (params: any) => void>();
+	private readonly _requestHandlers = new Map<string, (params: any, id: JsonRpcId) => unknown>();
+
+	private _lineBytes = 0;
+	private _stdoutClosed = false;
+	private _exited = false;
+	private _exitCode: number | null = null;
+	private _disposed = false;
+
+	constructor(
+		private readonly _transport: IIcodeAcpTransport,
+		private readonly _log: (message: string) => void,
+	) {
+		this._protocol = this._store.add(new JsonRpcProtocol(
+			message => this._write(message),
+			{
+				handleRequest: request => this._handleServerRequest(request),
+				handleNotification: notification => this._dispatchNotification(notification),
+			},
+		));
+
+		this._splitter = new StreamSplitter('\n');
+		this._splitter.setEncoding('utf8'); // decodes multi-byte sequences that straddle chunks
+		this._splitter.on('data', (line: string) => this._onLine(line));
+		this._splitter.on('error', (error: Error) => this._log(`[IcodeAcpClient] stdout framing error: ${error.message}`));
+
+		const stdout = this._transport.stdout;
+		const stdin = this._transport.stdin;
+
+		const onStdoutData = (chunk: Buffer | string) => {
+			if (this._disposed || this._stdoutClosed) {
+				return;
+			}
+			const buffer = typeof chunk === 'string' ? Buffer.from(chunk, 'utf8') : chunk;
+			const lastNewline = buffer.lastIndexOf(0x0a);
+			this._lineBytes = lastNewline === -1 ? this._lineBytes + buffer.length : buffer.length - lastNewline - 1;
+			if (this._lineBytes > MAX_LINE_LENGTH) {
+				this._lineBytes = 0;
+				this._log(`[IcodeAcpClient] stdout sent a line longer than ${MAX_LINE_LENGTH} bytes; stopping the transport`);
+				this._transport.kill();
+				return;
+			}
+			this._splitter.write(buffer);
+		};
+		const onStdoutEnd = () => {
+			// stdout ending only means "no more responses"; the process exit (and its
+			// exit code) is reported by the transport, so no exit event is fired here.
+			this._stdoutClosed = true;
+			this._splitter.end();
+			this._protocol.cancelAllRequests();
+		};
+		const onStdoutError = (error: Error) => {
+			this._log(`[IcodeAcpClient] stdout error: ${error.message}`);
+			onStdoutEnd();
+		};
+		const onStdinError = (error: Error) => this._log(`[IcodeAcpClient] stdin error: ${error.message}`);
+
+		stdout.on('data', onStdoutData);
+		stdout.on('end', onStdoutEnd);
+		stdout.on('error', onStdoutError);
+		stdin.on('error', onStdinError);
+
+		this._store.add(toDisposable(() => {
+			stdout.removeListener('data', onStdoutData);
+			stdout.removeListener('end', onStdoutEnd);
+			stdout.removeListener('error', onStdoutError);
+			stdin.removeListener('error', onStdinError);
+			this._splitter.destroy();
+		}));
+
+		this._store.add(this._transport.onExit(code => this._onTransportExit(code)));
+		if (this._transport.exited) {
+			// The transport exited before we could subscribe, so onExit will not fire again.
+			this._onTransportExit(this._transport.exitCode);
+		}
+	}
+
+	request<R = unknown>(method: string, params?: IcodeJsonValue, token: CancellationToken = CancellationToken.None): Promise<R> {
+		const unavailable = this._unavailableReason();
+		if (unavailable !== undefined) {
+			return Promise.reject(new Error(`[IcodeAcpClient] cannot send request '${method}': ${unavailable}`));
+		}
+
+		return this._protocol.sendRequest<R>(
+			{ method, params },
+			token,
+			id => this._protocol.sendNotification({ method: CANCEL_REQUEST_METHOD, params: { requestId: id } }),
+		);
+	}
+
+	notify(method: string, params?: IcodeJsonValue): void {
+		if (this._disposed) {
+			this._log(`[IcodeAcpClient] dropping notification '${method}' after dispose`);
+			return;
+		}
+		this._protocol.sendNotification({ method, params });
+	}
+
+	onNotification(method: string, handler: (params: any) => void): IDisposable {
+		if (this._notificationHandlers.has(method)) {
+			throw new BugIndicatingError(`[IcodeAcpClient] a notification handler for '${method}' is already registered`);
+		}
+		this._notificationHandlers.set(method, handler);
+		return toDisposable(() => {
+			if (this._notificationHandlers.get(method) === handler) {
+				this._notificationHandlers.delete(method);
+			}
+		});
+	}
+
+	onRequest<R = unknown>(method: string, handler: (params: any, id: JsonRpcId) => R | Promise<R>): IDisposable {
+		if (this._requestHandlers.has(method)) {
+			throw new BugIndicatingError(`[IcodeAcpClient] a request handler for '${method}' is already registered`);
+		}
+		this._requestHandlers.set(method, handler);
+		return toDisposable(() => {
+			if (this._requestHandlers.get(method) === handler) {
+				this._requestHandlers.delete(method);
+			}
+		});
+	}
+
+	dispose(): void {
+		if (this._disposed) {
+			return;
+		}
+		this._disposed = true;
+		this._protocol.cancelAllRequests();
+		this._notificationHandlers.clear();
+		this._requestHandlers.clear();
+		this._store.dispose();
+		this._onExit.dispose();
+		this._transport.kill();
+	}
+
+	private _unavailableReason(): string | undefined {
+		if (this._disposed) {
+			return 'client disposed';
+		}
+		if (this._exited) {
+			return `icode exited (${this._exitCode ?? 'no exit code'})`;
+		}
+		if (this._stdoutClosed) {
+			return 'stdout closed';
+		}
+		const stdin = this._transport.stdin as NodeJS.WritableStream & { writableEnded?: boolean; destroyed?: boolean };
+		if (stdin.writable === false || stdin.writableEnded === true || stdin.destroyed === true) {
+			return 'stdin closed';
+		}
+		return undefined;
+	}
+
+	private _write(message: JsonRpcMessage): void {
+		if (this._disposed || this._stdoutClosed) {
+			this._log(`[IcodeAcpClient] dropping outgoing message while shut down: ${JSON.stringify(message).slice(0, 512)}`);
+			return;
+		}
+		try {
+			this._transport.stdin.write(`${JSON.stringify(message)}\n`, error => {
+				if (error) {
+					this._log(`[IcodeAcpClient] failed to write to icode: ${error.message}`);
+				}
+			});
+		} catch (error) {
+			this._log(`[IcodeAcpClient] failed to write to icode: ${error instanceof Error ? error.message : String(error)}`);
+		}
+	}
+
+	private _onLine(line: string): void {
+		const trimmed = line.trim();
+		if (!trimmed) {
+			return;
+		}
+
+		let message: unknown;
+		try {
+			message = JSON.parse(trimmed);
+		} catch {
+			this._log(`[IcodeAcpClient] ignoring malformed line: ${trimmed.slice(0, 512)}`);
+			return;
+		}
+
+		if (!isJsonRpcPayload(message)) {
+			this._log(`[IcodeAcpClient] ignoring non-object message: ${trimmed.slice(0, 512)}`);
+			return;
+		}
+
+		void this._protocol.handleMessage(message).catch(error => {
+			this._log(`[IcodeAcpClient] failed to handle message: ${error instanceof Error ? error.message : String(error)}`);
+		});
+	}
+
+	private async _handleServerRequest(request: IJsonRpcRequest): Promise<unknown> {
+		const handler = this._requestHandlers.get(request.method);
+		if (!handler) {
+			throw new JsonRpcError(METHOD_NOT_FOUND, `Method not found: ${request.method}`);
+		}
+		const result = await handler(request.params, request.id);
+		// JSON.stringify drops `undefined`, which would leave a response without a
+		// `result`; `null` is the JSON-RPC representation of "no value".
+		return result === undefined ? null : result;
+	}
+
+	private _dispatchNotification(notification: IJsonRpcNotification): void {
+		const handler = this._notificationHandlers.get(notification.method);
+		if (!handler) {
+			this._log(`[IcodeAcpClient] ignoring unhandled notification '${notification.method}'`);
+			return;
+		}
+		try {
+			const result = handler(notification.params) as unknown;
+			if (isThenable(result)) {
+				result.then(undefined, error => this._log(`[IcodeAcpClient] notification handler '${notification.method}' failed: ${error instanceof Error ? error.message : String(error)}`));
+			}
+		} catch (error) {
+			this._log(`[IcodeAcpClient] notification handler '${notification.method}' failed: ${error instanceof Error ? error.message : String(error)}`);
+		}
+	}
+
+	private _onTransportExit(code: number | null): void {
+		if (this._exited) {
+			return;
+		}
+		this._exited = true;
+		this._exitCode = code;
+		this._stdoutClosed = true;
+		this._protocol.cancelAllRequests();
+		if (code !== 0) {
+			const spawnError = this._transport.error;
+			this._log(`[IcodeAcpClient] icode exited (${code === null ? 'no exit code' : `code ${code}`})${spawnError ? `: ${spawnError.message}` : ''}`);
+		}
+		this._onExit.fire(code);
+	}
+}
+
+/** Mirrors the structural checks used by `JsonRpcProtocol`, which requires objects. */
+function isJsonRpcPayload(value: unknown): value is JsonRpcMessage | JsonRpcMessage[] {
+	if (Array.isArray(value)) {
+		return value.every(entry => typeof entry === 'object' && entry !== null && !Array.isArray(entry));
+	}
+	return typeof value === 'object' && value !== null;
+}
