index 00000000..43b14985
--- /dev/null
+++ b/test/fixtures/fake-icode-acp.mjs
@@ -0,0 +1,459 @@
+#!/usr/bin/env node
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+/**
+ * Stand-in for the real `icode acp` CLI used by the process-integration tests.
+ *
+ * It speaks ACP v1 over stdio: one JSON-RPC 2.0 message per line on stdin and on
+ * stdout. Zero dependencies, so it can run under a bare `node` without the
+ * extension host.
+ *
+ * The command line is validated on purpose: the transport under test builds it,
+ * and a silent mismatch would let an argument regression pass unnoticed.
+ *
+ * `FAKE_ICODE_SCENARIO` selects what `session/prompt` does; `FAKE_ICODE_CWD_FILE`
+ * (optional) receives the process's working directory at startup, so a test can
+ * assert which cwd the transport actually spawned with.
+ */
+
+import { appendFileSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+const KNOWN_SCENARIOS = new Set([
+	'text',
+	'ask',
+	'permission',
+	'diff',
+	'cancel',
+	'slow',
+	'crash',
+	'garbage',
+	'hang',
+	'unknown',
+	'restore',
+	'restore-user',
+	'restore-fail',
+]);
+
+const MAX_LINE_BYTES = 5 * 1024 * 1024;
+
+function fail(message) {
+	process.stderr.write(`[fake-icode-acp] ${message}\n`);
+}
+
+// ---- Command-line contract -------------------------------------------------
+
+const argv = process.argv;
+const approvalIndex = argv.indexOf('--approval');
+const agentIndex = argv.indexOf('-a');
+if (
+	argv[2] !== 'acp'
+	|| approvalIndex === -1 || !argv[approvalIndex + 1]
+	|| agentIndex === -1 || !argv[agentIndex + 1]
+) {
+	fail(`unexpected arguments: ${argv.slice(2).join(' ') || '(none)'}`);
+	process.exit(2);
+}
+
+const scenario = process.env.FAKE_ICODE_SCENARIO ?? 'text';
+if (!KNOWN_SCENARIOS.has(scenario)) {
+	fail(`unknown FAKE_ICODE_SCENARIO '${scenario}'`);
+	process.exit(3);
+}
+
+const cwdFile = process.env.FAKE_ICODE_CWD_FILE;
+if (cwdFile) {
+	writeFileSync(cwdFile, process.cwd());
+}
+
+// ---- Output ----------------------------------------------------------------
+
+let exiting = false;
+
+function send(message) {
+	process.stdout.write(`${JSON.stringify(message)}\n`);
+}
+
+function sendResult(id, result) {
+	send({ jsonrpc: '2.0', id, result });
+}
+
+function sendError(id, code, message) {
+	send({ jsonrpc: '2.0', id, error: { code, message } });
+}
+
+function sendUpdate(sessionId, update) {
+	send({ jsonrpc: '2.0', method: 'session/update', params: { sessionId, update } });
+}
+
+/**
+ * Exits only after the pending stdout writes were handed to the OS; a bare
+ * `process.exit` can truncate the last response on a pipe. The fallback timer
+ * guarantees termination even if the flush callback never runs.
+ */
+function flushAndExit(code) {
+	if (exiting) {
+		return;
+	}
+	exiting = true;
+	process.stdin.pause();
+	process.stdout.write('', () => process.exit(code));
+	setTimeout(() => process.exit(code), 2000);
+}
+
+// ---- Server-to-client requests --------------------------------------------
+
+let nextServerRequestId = 0;
+/** Id to the resolver of a request this process sent to the client. */
+const pendingServerRequests = new Map();
+
+function requestFromClient(method, params) {
+	const id = ++nextServerRequestId;
+	send({ jsonrpc: '2.0', id, method, params });
+	return new Promise(resolve => pendingServerRequests.set(id, resolve));
+}
+
+// ---- Session/prompt state -------------------------------------------------
+
+let nextSessionNumber = 0;
+let diffCount = 0;
+const cancelledSessions = new Set();
+/** Resolver of the sleep a cancellation should cut short. */
+let wakeSleep;
+
+function sleep(ms) {
+	return new Promise(resolve => {
+		const timer = setTimeout(() => {
+			wakeSleep = undefined;
+			resolve();
+		}, ms);
+		wakeSleep = () => {
+			clearTimeout(timer);
+			wakeSleep = undefined;
+			resolve();
+		};
+	});
+}
+
+function models() {
+	return {
+		availableModels: [
+			{ modelId: 'fake-model-a', name: 'Fake A' },
+			{ modelId: 'fake-model-b', name: 'Fake B' },
+		],
+		currentModelId: 'fake-model-a',
+	};
+}
+
+function textChunk(text) {
+	return { sessionUpdate: 'agent_message_chunk', content: { type: 'text', text } };
+}
+
+/** The `text` scenario: three chunks, one tool call, a plan and a usage update. */
+function emitTextTurn(sessionId) {
+	for (let i = 0; i < 3; i++) {
+		sendUpdate(sessionId, textChunk('fake-'));
+	}
+	sendUpdate(sessionId, {
+		sessionUpdate: 'tool_call',
+		toolCallId: 'tc-1',
+		kind: 'execute',
+		status: 'in_progress',
+		rawInput: { command: 'echo fake' },
+	});
+	sendUpdate(sessionId, { sessionUpdate: 'tool_call_update', toolCallId: 'tc-1', status: 'in_progress' });
+	sendUpdate(sessionId, {
+		sessionUpdate: 'tool_call_update',
+		toolCallId: 'tc-1',
+		status: 'completed',
+		content: [{ type: 'content', content: { type: 'text', text: 'fake' } }],
+	});
+	sendUpdate(sessionId, {
+		sessionUpdate: 'plan',
+		entries: [
+			{ content: 'first step', priority: 'high', status: 'pending' },
+			{ content: 'second step', priority: 'medium', status: 'in_progress' },
+		],
+	});
+	sendUpdate(sessionId, { sessionUpdate: 'usage_update', used: 42, size: 1000 });
+}
+
+/**
+ * The transcript `session/load` replays. A provider opens a turn on a
+ * `user_message_chunk`, so `restore` (which starts with assistant chunks) yields no
+ * turn at all, while `restore-user` replays a complete stored conversation.
+ */
+function replayHistory(sessionId, includeUserMessage = false) {
+	if (includeUserMessage) {
+		sendUpdate(sessionId, { sessionUpdate: 'user_message_chunk', content: { type: 'text', text: 'history prompt' } });
+	}
+	sendUpdate(sessionId, textChunk('history-1'));
+	sendUpdate(sessionId, textChunk('history-2'));
+	sendUpdate(sessionId, {
+		sessionUpdate: 'tool_call',
+		toolCallId: 'tc-history',
+		title: 'read file',
+		kind: 'read',
+		status: 'completed',
+		content: [{ type: 'text', text: 'history' }],
+	});
+}
+
+/** iCode's answer shape for `_chrys/request_input`: one entry per question, no option ids. */
+function isInputReply(value) {
+	if (!value || typeof value !== 'object' || !Array.isArray(value.answers) || value.cancelled !== false) {
+		return false;
+	}
+	return value.answers.every(answer => answer
+		&& typeof answer === 'object'
+		&& Array.isArray(answer.values)
+		&& answer.values.every(entry => typeof entry === 'string')
+		&& typeof answer.note === 'string');
+}
+
+async function runAsk(sessionId, id) {
+	const reply = await requestFromClient('_chrys/request_input', {
+		sessionId,
+		requestId: 'req-1',
+		questions: [{ question: 'Q?', header: 'H', options: [{ label: 'A' }, { label: 'B' }] }],
+	});
+
+	if (!isInputReply(reply)) {
+		fail(`_chrys/request_input reply does not match the answer shape: ${JSON.stringify(reply)}`);
+		flushAndExit(1);
+		return;
+	}
+
+	sendUpdate(sessionId, textChunk('after-answer'));
+	sendResult(id, { stopReason: 'end_turn' });
+}
+
+async function runPermission(sessionId, id) {
+	const response = await requestFromClient('session/request_permission', {
+		sessionId,
+		toolCall: { toolCallId: 'tc-p', kind: 'execute', rawInput: { command: 'touch x' } },
+		options: [
+			{ kind: 'allow_once', name: 'Allow once', optionId: 'allow' },
+			{ kind: 'reject_once', name: 'Reject once', optionId: 'reject' },
+		],
+	});
+
+	const outcome = response?.outcome;
+	const optionId = outcome?.outcome === 'selected' ? outcome.optionId : undefined;
+	if (optionId === 'allow') {
+		sendUpdate(sessionId, {
+			sessionUpdate: 'tool_call_update',
+			toolCallId: 'tc-p',
+			status: 'completed',
+			content: [{ type: 'text', text: 'touched x' }],
+		});
+	} else {
+		sendUpdate(sessionId, { sessionUpdate: 'tool_call_update', toolCallId: 'tc-p', status: 'failed' });
+	}
+	sendResult(id, { stopReason: 'end_turn' });
+}
+
+function runDiff(sessionId, id) {
+	const path = join(process.cwd(), 'probe-diff.txt');
+	const change = `change-${++diffCount}`;
+	appendFileSync(path, `${change}\n`);
+	sendUpdate(sessionId, {
+		sessionUpdate: 'tool_call',
+		toolCallId: 'tc-diff',
+		title: 'edit probe-diff.txt',
+		kind: 'edit',
+		status: 'in_progress',
+		rawInput: { path },
+	});
+	sendUpdate(sessionId, {
+		sessionUpdate: 'tool_call_update',
+		toolCallId: 'tc-diff',
+		status: 'completed',
+		content: [{ type: 'text', text: `wrote ${change}` }],
+	});
+	sendResult(id, { stopReason: 'end_turn' });
+}
+
+async function runCancel(sessionId, id) {
+	for (let i = 0; i < 20; i++) {
+		if (cancelledSessions.has(sessionId)) {
+			break;
+		}
+		await sleep(100);
+		if (cancelledSessions.has(sessionId)) {
+			break;
+		}
+		sendUpdate(sessionId, textChunk(`chunk-${i}`));
+	}
+	sendResult(id, { stopReason: cancelledSessions.has(sessionId) ? 'cancelled' : 'end_turn' });
+}
+
+async function runSlow(sessionId, id) {
+	for (let i = 0; i < 50; i++) {
+		await sleep(200);
+		sendUpdate(sessionId, textChunk(`chunk-${i}`));
+	}
+	sendResult(id, { stopReason: 'end_turn' });
+}
+
+function runGarbage(sessionId, id) {
+	process.stdout.write('not-json\n');
+	// One line above the client's MAX_LINE_LENGTH (4 MiB) guard, so it must be dropped.
+	process.stdout.write(`${JSON.stringify({
+		jsonrpc: '2.0',
+		method: 'session/update',
+		params: { sessionId, update: textChunk('x'.repeat(MAX_LINE_BYTES)) },
+	})}\n`);
+	emitTextTurn(sessionId);
+	sendResult(id, { stopReason: 'end_turn' });
+}
+
+async function runPrompt(id, params) {
+	const sessionId = params?.sessionId;
+	switch (scenario) {
+		case 'hang':
+			// Deliberately never answers; the client's cancel/timeout path is under test.
+			return;
+		case 'crash':
+			sendUpdate(sessionId, textChunk('partial'));
+			flushAndExit(1);
+			return;
+		case 'cancel':
+			return runCancel(sessionId, id);
+		case 'slow':
+			return runSlow(sessionId, id);
+		case 'garbage':
+			return runGarbage(sessionId, id);
+		case 'unknown':
+			sendUpdate(sessionId, { sessionUpdate: 'something_new', content: { type: 'text', text: 'unknown' } });
+			break;
+		case 'ask':
+			return runAsk(sessionId, id);
+		case 'permission':
+			return runPermission(sessionId, id);
+		case 'diff':
+			return runDiff(sessionId, id);
+		default:
+			// `text` plus the `restore`/`restore-fail` scenarios, which only change `session/load`.
+			break;
+	}
+
+	emitTextTurn(sessionId);
+	sendResult(id, { stopReason: 'end_turn' });
+}
+
+// ---- Dispatch --------------------------------------------------------------
+
+function handleClientResponse(message) {
+	const pending = pendingServerRequests.get(message.id);
+	if (!pending) {
+		return;
+	}
+	pendingServerRequests.delete(message.id);
+	pending(message.error !== undefined ? { outcome: { outcome: 'cancelled' } } : message.result);
+}
+
+function handleNotification(method, params) {
+	if (method === 'session/cancel') {
+		const sessionId = params?.sessionId;
+		if (typeof sessionId === 'string') {
+			cancelledSessions.add(sessionId);
+		}
+		if (wakeSleep) {
+			wakeSleep();
+		}
+	}
+}
+
+function handleRequest(id, method, params) {
+	switch (method) {
+		case 'initialize':
+			// Never sent by our client (ACP v1 needs no handshake), but a crash here
+			// would look like an ACP regression.
+			return sendResult(id, { protocolVersion: 1 });
+		case 'session/new': {
+			const number = ++nextSessionNumber;
+			return sendResult(id, { sessionId: `fake-${number}`, models: models() });
+		}
+		case 'session/load':
+			if (scenario === 'restore-fail') {
+				return sendError(id, -32000, 'session gone');
+			}
+			if (scenario === 'restore' || scenario === 'restore-user') {
+				replayHistory(params?.sessionId, scenario === 'restore-user');
+			}
+			return sendResult(id, { models: models() });
+		case 'session/prompt':
+			void runPrompt(id, params);
+			return;
+		case 'session/set_model':
+			return sendResult(id, {});
+		case 'session/close':
+			return sendResult(id, null);
+		default:
+			return sendError(id, -32601, `Method not found: ${method}`);
+	}
+}
+
+function handleLine(line) {
+	const trimmed = line.trim();
+	if (!trimmed) {
+		return;
+	}
+
+	let message;
+	try {
+		message = JSON.parse(trimmed);
+	} catch {
+		fail(`ignoring malformed line: ${trimmed.slice(0, 200)}`);
+		return;
+	}
+	if (typeof message !== 'object' || message === null || Array.isArray(message)) {
+		return;
+	}
+
+	if (typeof message.method !== 'string') {
+		if (message.id !== undefined && ('result' in message || 'error' in message)) {
+			handleClientResponse(message);
+		}
+		return;
+	}
+
+	if (message.id === undefined) {
+		handleNotification(message.method, message.params);
+		return;
+	}
+
+	handleRequest(message.id, message.method, message.params);
+}
+
+// ---- Input -----------------------------------------------------------------
+
+let buffered = '';
+process.stdin.setEncoding('utf8');
+process.stdin.on('data', chunk => {
+	buffered += chunk;
+	let newline = buffered.indexOf('\n');
+	while (newline !== -1) {
+		const line = buffered.slice(0, newline);
+		buffered = buffered.slice(newline + 1);
+		handleLine(line);
+		newline = buffered.indexOf('\n');
+	}
+});
+process.stdin.on('end', () => {
+	if (buffered) {
+		handleLine(buffered);
+		buffered = '';
+	}
+	flushAndExit(0);
+});
+process.stdin.on('error', error => {
+	fail(`stdin error: ${error instanceof Error ? error.message : String(error)}`);
+});
+process.stdout.on('error', () => {
+	// The client killed the pipe; nothing useful to report.
+});
