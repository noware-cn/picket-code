+
+import { generateUuid } from '../../../../base/common/uuid.js';
+import { MessageKind, ResponsePartKind, ToolCallCancellationReason, ToolCallConfirmationReason, ToolCallStatus, ToolResultContentType, TurnState, type MarkdownResponsePart, type ReasoningResponsePart, type ToolCallResponsePart, type ToolCallState, type ToolResultTextContent, type Turn } from '../../common/state/sessionState.js';
+import { acpToolName, type IcodeSessionUpdate } from './icodeMapEvents.js';
+
+/** Reasoning is a single stream per turn, so one key is enough. */
+const THOUGHT_PART_KEY = '__thought__';
+/** Text chunks without a `messageId` still belong to one logical message. */
+const ANONYMOUS_TEXT_PART_KEY = '__message__';
+
+type IcodeTextPart = MarkdownResponsePart | ReasoningResponsePart;
+
+/** Scratch state while a replayed turn is still being assembled. */
+interface ITurnBuilder {
+	readonly turn: Turn;
+	/** Stream key to its text/reasoning part, so chunks of one message accumulate. */
+	readonly parts: Map<string, IcodeTextPart>;
+	/** Tool call id to its response part, so `tool_call_update` can close it. */
+	readonly toolParts: Map<string, ToolCallResponsePart>;
+}
+
+/**
+ * Rebuilds the transcript `session/load` replays as it streams the session's
+ * `session/update` notifications.
+ *
+ * A `user_message_chunk` opens a turn; everything after it belongs to that
+ * turn until the next user message. Updates that arrive before any user
+ * message are dropped rather than attributed to an invented turn.
+ */
+export function buildIcodeTurns(updates: readonly IcodeSessionUpdate[]): Turn[] {
+	const turns: Turn[] = [];
+	let current: ITurnBuilder | undefined;
+
+	for (const update of updates) {
+		switch (update.sessionUpdate) {
+			case 'user_message_chunk': {
+				const text = extractText(update.content);
+				if (text !== undefined) {
+					current = createTurnBuilder(text);
+					turns.push(current.turn);
+				}
+				break;
+			}
+			case 'agent_message_chunk':
+				appendTextPart(current, update, ResponsePartKind.Markdown);
+				break;
+			case 'agent_thought_chunk':
+				appendTextPart(current, update, ResponsePartKind.Reasoning);
+				break;
+			case 'tool_call':
+				startToolCall(current, update);
+				break;
+			case 'tool_call_update':
+				updateToolCall(current, update);
+				break;
+			default:
+				// `plan`, `usage_update`, `session_info_update` and anything iCode
+				// adds later carry no transcript content here.
+				break;
+		}
+	}
+
+	return turns;
+}
+
+/**
+ * A replayed turn is already over by the time it is assembled: every ACP
+ * session reports its finished turns, never an in-flight one.
+ */
+function createTurnBuilder(text: string): ITurnBuilder {
+	return {
+		turn: {
+			id: generateUuid(),
+			message: { text, origin: { kind: MessageKind.User } },
+			responseParts: [],
+			usage: undefined,
+			state: TurnState.Complete,
+		},
+		parts: new Map(),
+		toolParts: new Map(),
+	};
+}
+
+function appendTextPart(builder: ITurnBuilder | undefined, update: IcodeSessionUpdate, kind: ResponsePartKind.Markdown | ResponsePartKind.Reasoning): void {
+	if (!builder) {
+		return;
+	}
+	const text = extractText(update.content);
+	if (text === undefined) {
+		return;
+	}
+
+	const key = kind === ResponsePartKind.Markdown ? update.messageId ?? ANONYMOUS_TEXT_PART_KEY : THOUGHT_PART_KEY;
+	let part = builder.parts.get(key);
+	if (part === undefined || part.kind !== kind) {
+		part = createTextPart(kind);
+		builder.parts.set(key, part);
+		builder.turn.responseParts.push(part);
+	}
+	part.content += text;
+}
+
+function startToolCall(builder: ITurnBuilder | undefined, update: IcodeSessionUpdate): void {
+	const toolCallId = update.toolCallId;
+	if (!builder || toolCallId === undefined) {
+		return;
+	}
+	pushToolPart(builder, createToolCallState(toolCallId, update.title ?? toolCallId, update));
+}
+
+function updateToolCall(builder: ITurnBuilder | undefined, update: IcodeSessionUpdate): void {
+	const toolCallId = update.toolCallId;
+	if (!builder || toolCallId === undefined) {
+		return;
+	}
+
+	const existing = builder.toolParts.get(toolCallId);
+	const displayName = update.title ?? existing?.toolCall.displayName ?? toolCallId;
+	// ACP completes a call with a `tool_call_update` that does not repeat the
+	// call's `kind`, so keep the name the announcement produced.
+	const state = createToolCallState(toolCallId, displayName, update, existing?.toolCall.toolName);
+	if (existing) {
+		existing.toolCall = state;
+	} else {
+		// A replay may start with the completion of a call it never announced.
+		pushToolPart(builder, state);
+	}
+}
+
+function pushToolPart(builder: ITurnBuilder, toolCall: ToolCallState): void {
+	const part: ToolCallResponsePart = { kind: ResponsePartKind.ToolCall, toolCall };
+	builder.toolParts.set(toolCall.toolCallId, part);
+	builder.turn.responseParts.push(part);
+}
+
+function createToolCallState(toolCallId: string, displayName: string, update: IcodeSessionUpdate, previousToolName?: string): ToolCallState {
+	const invocationMessage = displayName;
+	const toolInput = update.rawInput !== undefined ? JSON.stringify(update.rawInput) : undefined;
+	const content = extractResultContent(update);
+	const base = {
+		toolCallId,
+		// Match the live mapper so a restored chat renders exactly like a live one.
+		toolName: update.kind !== undefined ? acpToolName(update.kind) : previousToolName ?? acpToolName(undefined),
+		displayName,
+		invocationMessage,
+		...(toolInput !== undefined ? { toolInput } : {}),
+	};
+
+	switch (update.status) {
+		case 'completed':
+			return {
+				...base,
+				status: ToolCallStatus.Completed,
+				confirmed: ToolCallConfirmationReason.NotNeeded,
+				success: true,
+				pastTenseMessage: displayName,
+				...(content !== undefined ? { content } : {}),
+			};
+		case 'failed':
+			return {
+				...base,
+				status: ToolCallStatus.Completed,
+				confirmed: ToolCallConfirmationReason.NotNeeded,
+				success: false,
+				pastTenseMessage: displayName,
+				error: { message: failureMessage(update) },
+				...(content !== undefined ? { content } : {}),
+			};
+		case 'cancelled':
+			return {
+				...base,
+				status: ToolCallStatus.Cancelled,
+				reason: ToolCallCancellationReason.Skipped,
+			};
+		default:
+			return {
+				...base,
+				status: ToolCallStatus.Running,
+				confirmed: ToolCallConfirmationReason.NotNeeded,
+			};
+	}
+}
+
+function createTextPart(kind: ResponsePartKind.Markdown | ResponsePartKind.Reasoning): IcodeTextPart {
+	const id = generateUuid();
+	return kind === ResponsePartKind.Markdown
+		? { kind: ResponsePartKind.Markdown, id, content: '' }
+		: { kind: ResponsePartKind.Reasoning, id, content: '' };
+}
+
+/** Joins the `text` blocks of an ACP content payload, or `undefined` when it carries no text. */
+function extractText(content: IcodeSessionUpdate['content']): string | undefined {
+	const blocks = Array.isArray(content) ? content : content !== undefined ? [content] : [];
+	const text = blocks
+		.filter((block): block is { readonly type: string; readonly text: string } => block.type === 'text' && typeof block.text === 'string')
+		.map(block => block.text)
+		.join('');
+	return text.length > 0 ? text : undefined;
+}
+
+/** The `text` blocks iCode reported, else its raw output, else nothing at all. */
+function extractResultContent(update: IcodeSessionUpdate): ToolResultTextContent[] | undefined {
+	const text = extractText(update.content);
+	if (text !== undefined) {
+		return [{ type: ToolResultContentType.Text, text }];
+	}
+	if (update.rawOutput === undefined) {
+		return undefined;
+	}
+	const raw = typeof update.rawOutput === 'string' ? update.rawOutput : JSON.stringify(update.rawOutput);
+	return raw.length > 0 ? [{ type: ToolResultContentType.Text, text: raw }] : undefined;
+}
+
+function failureMessage(update: IcodeSessionUpdate): string {
+	if (typeof update.rawOutput === 'string' && update.rawOutput.length > 0) {
+		return update.rawOutput;
+	}
+	const text = extractText(update.content);
+	return text ?? 'iCode tool call failed';
+}
