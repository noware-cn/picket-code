+/**
+ * The fake CLI lives next to the sources (`test/fixtures/`), not under `out/`,
+ * so it is located by climbing to the repository root. Both `out/` and
+ * `out-build/` sit at that root, which keeps `--build` runs working.
+ */
+const REPO_ROOT = fileURLToPath(new URL('../../../../../../../', import.meta.url));
+const FIXTURE_PATH = join(REPO_ROOT, 'test', 'fixtures', 'fake-icode-acp.mjs');
+
+const CHAT = URI.parse('chat:/fake-chat');
+
+/** The `garbage` scenario writes this many `x` characters inside one JSON string. */
+const FAKE_GARBAGE_TEXT_LENGTH = 5 * 1024 * 1024;
+
+interface IFakeProcess {
+	readonly client: IcodeAcpClient;
+	readonly transport: IIcodeAcpTransport;
+	/** The cwd the transport was asked to spawn in. */
+	readonly cwd: string;
+	/** Every `session/update` payload the fake streamed, in arrival order. */
+	readonly updates: any[];
+	/** Transport and client diagnostics, prefixed with `[icode]` / `[IcodeAcpClient]`. */
+	readonly logs: string[];
+	/** The real child process, available once the transport spawned it. */
+	readonly child: ChildProcess;
+}
+
+function delay(ms: number): Promise<void> {
+	return new Promise(resolve => setTimeout(resolve, ms));
+}
+
+async function waitUntil(predicate: () => boolean, what: string, timeoutMs = 4000): Promise<void> {
+	const deadline = Date.now() + timeoutMs;
+	while (!predicate()) {
+		if (Date.now() > deadline) {
+			throw new Error(`timed out after ${timeoutMs}ms waiting for ${what}`);
+		}
+		await delay(5);
+	}
+}
+
+function actionsOf(signals: readonly AgentSignal[]): (AgentSignal & { kind: 'action' })['action'][] {
+	return signals
+		.filter((signal): signal is Extract<AgentSignal, { kind: 'action' }> => signal.kind === 'action')
+		.map(signal => signal.action);
+}
+
+function actionsOfType<T extends (AgentSignal & { kind: 'action' })['action']['type']>(signals: readonly AgentSignal[], type: T) {
+	return actionsOf(signals).filter((action): action is Extract<(AgentSignal & { kind: 'action' })['action'], { type: T }> => action.type === type);
+}
