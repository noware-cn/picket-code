@@ -0,0 +1,328 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { tmpdir } from 'os';
+import { timeout } from '../../../../../base/common/async.js';
+import { Emitter } from '../../../../../base/common/event.js';
+import { IDisposable } from '../../../../../base/common/lifecycle.js';
+import { URI } from '../../../../../base/common/uri.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { NullLogService } from '../../../../log/common/log.js';
+import type { AgentSignal, IAgentActionSignal } from '../../../common/agent.js';
+import { ActionType } from '../../../common/state/sessionActions.js';
+import { ToolCallStatus } from '../../../common/state/sessionState.js';
+import { IIcodeAcpClient } from '../../../node/icode/icodeAcpClient.js';
+import { IcodeAgent } from '../../../node/icode/icodeAgent.js';
+import { decodeIcodeProviderData, encodeIcodeProviderData } from '../../../node/icode/icodeProviderData.js';
+
+const SESSION_ID = 'sess-new';
+
+class FakeIcodeClient implements IIcodeAcpClient {
+	private readonly exitEmitter = new Emitter<number | null>();
+	readonly onExit = this.exitEmitter.event;
+	exited = false;
+	exitCode: number | null = null;
+	readonly requests: { method: string; params: any }[] = [];
+	readonly notifications: { method: string; params: any }[] = [];
+	/** `session/update` payloads replayed for `session/load`, emitted while the request is in flight. */
+	respondToLoad: readonly any[] = [];
+	/** When set, `session/load` rejects with it, mimicking a session iCode already dropped. */
+	loadError: Error | undefined;
+	private readonly notificationHandlers = new Map<string, (params: any) => void>();
+	private readonly requestHandlers = new Map<string, (params: any, id?: any) => unknown>();
+	private resolvePrompt: ((value: any) => void) | undefined;
+	private rejectPrompt: ((reason: Error) => void) | undefined;
+
+	request<R>(method: string, params?: unknown): Promise<R> {
+		this.requests.push({ method, params });
+		if (method === 'session/new') {
+			return Promise.resolve({ sessionId: SESSION_ID, modes: { availableModes: [], currentModeId: 'manual' }, models: { availableModels: [], currentModelId: 'mock' } } as R);
+		}
+		if (method === 'session/load') {
+			if (this.loadError) {
+				return Promise.reject(this.loadError);
+			}
+			const sessionId = (params as { sessionId?: string } | undefined)?.sessionId;
+			for (const update of this.respondToLoad) {
+				this.emitNotification('session/update', { sessionId, update });
+			}
+			return Promise.resolve({} as R);
+		}
+		if (method === 'session/prompt') {
+			return new Promise<R>((resolve, reject) => {
+				this.resolvePrompt = resolve as (value: any) => void;
+				this.rejectPrompt = reject;
+			});
+		}
+		return Promise.resolve({} as R);
+	}
+	notify(method: string, params?: unknown): void { this.notifications.push({ method, params }); }
+	onNotification(method: string, handler: (params: any) => void): IDisposable {
+		this.notificationHandlers.set(method, handler);
+		return { dispose: () => this.notificationHandlers.delete(method) };
+	}
+	onRequest<R = unknown>(method: string, handler: (params: any, _id: any) => R | Promise<R>): IDisposable {
+		this.requestHandlers.set(method, handler);
+		return { dispose: () => this.requestHandlers.delete(method) };
+	}
+	emitNotification(method: string, params: unknown): void { this.notificationHandlers.get(method)?.(params); }
+	emitRequest(method: string, params: unknown): Promise<unknown> {
+		const handler = this.requestHandlers.get(method);
+		assert.ok(handler, `no request handler registered for ${method}`);
+		return Promise.resolve(handler(params));
+	}
+	finishPrompt(result: unknown): void { this.resolvePrompt?.(result); }
+	/** Settles the in-flight `session/prompt` with a bare stop reason. */
+	completePrompt(stopReason: string): void { this.finishPrompt({ stopReason }); }
+	emitExit(code: number | null): void {
+		this.exited = true;
+		this.exitCode = code;
+		this.exitEmitter.fire(code);
+		// The real client cancels every in-flight request when the process exits.
+		this.rejectPrompt?.(new Error('icode exited'));
+	}
+	dispose(): void { this.exitEmitter.dispose(); }
+}
+
+const chat = URI.parse('ahp-chat://test/chat');
+const workspace = URI.file(tmpdir());	// must really exist: sendMessage validates that cwd is an existing absolute directory
+/** A chat restored from the catalog; its provider data names a directory that need not exist. */
+const restoredChat = URI.parse('file:///chat');
+const RESTORED_CWD = '/repo';
+
+function providerData(sessionId: string): string {
+	return encodeIcodeProviderData({ v: 1, sessionId, cwd: RESTORED_CWD, createdAt: 1 });
+}
+
+suite('IcodeAgent', () => {
+	const disposables = ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('creates a session and completes a prompt round-trip', async () => {
+		const client = new FakeIcodeClient();
+		const agent = new IcodeAgent(new NullLogService(), () => client);
+		const signals: AgentSignal[] = [];
+		disposables.add(agent.onDidChatProgress(signal => signals.push(signal)));
+
+		const sending = agent.chats.sendMessage(chat, 'hello', [workspace], undefined, 'turn-1');
+		await timeout(10);
+		assert.deepStrictEqual(client.requests[0], { method: 'session/new', params: { cwd: workspace.fsPath, mcpServers: [] } });
+
+		client.emitNotification('session/update', {
+			sessionId: SESSION_ID,
+			update: { sessionUpdate: 'agent_message_chunk', messageId: 'm1', content: { type: 'text', text: 'hello' } },
+		});
+		client.finishPrompt({ stopReason: 'end_turn', usage: { inputTokens: 1, outputTokens: 2, totalTokens: 3 } });
+		await sending;
+
+		assert.deepStrictEqual(client.requests.map(r => r.method), ['session/new', 'session/prompt']);
+		assert.deepStrictEqual(signals.map(s => (s as IAgentActionSignal).action.type), [
+			ActionType.ChatResponsePart, ActionType.ChatDelta, ActionType.ChatUsage, ActionType.ChatTurnComplete,
+		]);
+		agent.dispose();
+	});
+
+	test('rejects a turn whose working directory is not an existing directory', async () => {
+		const client = new FakeIcodeClient();
+		const agent = new IcodeAgent(new NullLogService(), () => client);
+
+		await assert.rejects(
+			agent.chats.sendMessage(chat, 'hello', [URI.file('/definitely/missing-icode-workspace')], undefined, 'turn-1'),
+			/working directory/,
+		);
+		assert.deepStrictEqual(client.requests, []);
+		agent.dispose();
+	});
+
+	test('surfaces a refusal stop reason as a failure', async () => {
+		const client = new FakeIcodeClient();
+		const agent = new IcodeAgent(new NullLogService(), () => client);
+
+		const sending = agent.chats.sendMessage(chat, 'hello', [workspace], undefined, 'turn-1');
+		await timeout(10);
+		client.finishPrompt({ stopReason: 'refusal' });
+		await assert.rejects(sending, /refus/i);
+		agent.dispose();
+	});
+
+	test('abort sends session/cancel and does not complete the turn', async () => {
+		const client = new FakeIcodeClient();
+		const agent = new IcodeAgent(new NullLogService(), () => client);
+		const signals: AgentSignal[] = [];
+		disposables.add(agent.onDidChatProgress(signal => signals.push(signal)));
+
+		const sending = agent.chats.sendMessage(chat, 'hello', [workspace], undefined, 'turn-1');
+		await timeout(10);
+
+		await agent.chats.abort(chat, chat);
+		// The host already marked the turn cancelled; firing a completion here
+		// would complete the same turn twice.
+		assert.deepStrictEqual(client.notifications, [{ method: 'session/cancel', params: { sessionId: SESSION_ID } }]);
+		assert.deepStrictEqual(signals, []);
+
+		client.finishPrompt({ stopReason: 'cancelled' });
+		await sending;
+		assert.strictEqual((signals[signals.length - 1] as IAgentActionSignal).action.type, ActionType.ChatTurnCancelled);
+		agent.dispose();
+	});
+
+	test('a permission request becomes a pending confirmation and a rejection is forwarded', async () => {
+		const client = new FakeIcodeClient();
+		const agent = new IcodeAgent(new NullLogService(), () => client);
+		const signals: AgentSignal[] = [];
+		disposables.add(agent.onDidChatProgress(signal => signals.push(signal)));
+
+		const sending = agent.chats.sendMessage(chat, 'hello', [workspace], undefined, 'turn-1');
+		await timeout(10);
+
+		const pending = client.emitRequest('session/request_permission', {
+			sessionId: SESSION_ID,
+			toolCall: { toolCallId: 't1', title: 'Run ls', kind: 'execute', status: 'pending', rawInput: { command: 'ls' } },
+			options: [{ optionId: 'allow', name: 'Allow once', kind: 'allow_once' }, { optionId: 'reject', name: 'Reject once', kind: 'reject_once' }],
+		});
+		assert.deepStrictEqual(signals.at(-1), {
+			kind: 'pending_confirmation',
+			chat,
+			state: {
+				status: ToolCallStatus.PendingConfirmation, toolCallId: 't1', toolName: 'shell', displayName: 'Run ls',
+				invocationMessage: 'Run ls', toolInput: '{"command":"ls"}', confirmationTitle: 'Run ls',
+			},
+			permissionKind: 'shell',
+		});
+
+		agent.respondToPermissionRequest('t1', false, { decisionSource: 'human_response' });
+		assert.deepStrictEqual(await pending, { outcome: { outcome: 'selected', optionId: 'reject' } });
+
+		// Late and duplicate answers (unattended fallbacks, stale clicks) are ignored.
+		agent.respondToPermissionRequest('t1', true, { decisionSource: 'unattended_fallback' });
+		agent.respondToPermissionRequest('unknown', true);
+
+		client.finishPrompt({ stopReason: 'cancelled' });
+		await sending;
+		agent.dispose();
+	});
+
+	test('a second send while a turn is live fails fast', async () => {
+		const client = new FakeIcodeClient();
+		const agent = new IcodeAgent(new NullLogService(), () => client);
+
+		const sending = agent.chats.sendMessage(chat, 'hello', [workspace], undefined, 'turn-1');
+		await timeout(10);
+		await assert.rejects(
+			agent.chats.sendMessage(chat, 'again', [workspace], undefined, 'turn-2'),
+			/already running/,
+		);
+
+		client.finishPrompt({ stopReason: 'end_turn' });
+		await sending;
+		agent.dispose();
+	});
+
+	test('a process exit fails the live turn and respawns on the next send', async () => {
+		const clients: FakeIcodeClient[] = [];
+		const agent = new IcodeAgent(new NullLogService(), () => {
+			const client = new FakeIcodeClient();
+			clients.push(client);
+			return client;
+		});
+		const signals: AgentSignal[] = [];
+		disposables.add(agent.onDidChatProgress(signal => signals.push(signal)));
+
+		const sending = agent.chats.sendMessage(chat, 'hello', [workspace], undefined, 'turn-1');
+		await timeout(10);
+
+		clients[0].emitExit(1);
+		await sending;
+		const failure = (signals[signals.length - 1] as IAgentActionSignal).action;
+		assert.strictEqual(failure.type, ActionType.ChatError);
+		assert.strictEqual((failure as { part: { error: { errorType: string } } }).part.error.errorType, 'icodeExited');
+
+		const second = agent.chats.sendMessage(chat, 'again', [workspace], undefined, 'turn-2');
+		await timeout(10);
+		assert.strictEqual(clients.length, 2);
+		assert.deepStrictEqual(clients[1].requests.map(r => r.method), ['session/new', 'session/prompt']);
+
+		clients[1].finishPrompt({ stopReason: 'end_turn' });
+		await second;
+		agent.dispose();
+	});
+
+	test('materializeChat loads the persisted session and getMessages returns the replay', async () => {
+		const client = new FakeIcodeClient();
+		const agent = new IcodeAgent(new NullLogService(), () => client);
+		client.respondToLoad = [
+			{ sessionUpdate: 'user_message_chunk', content: { type: 'text', text: 'hello' } },
+			{ sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: 'hi' }, messageId: 'm1' },
+		];
+
+		await agent.materializeChat(restoredChat, chat, providerData('sess-1'));
+		assert.deepStrictEqual(client.requests[0], { method: 'session/load', params: { sessionId: 'sess-1', cwd: RESTORED_CWD, mcpServers: [] } });
+
+		const turns = await agent.chats.getMessages(restoredChat, chat);
+		assert.strictEqual(turns.length, 1);
+		assert.strictEqual(turns[0].message.text, 'hello');
+		agent.dispose();
+	});
+
+	test('a failed load still lets the chat open, and the next sendMessage creates a fresh session', async () => {
+		const client = new FakeIcodeClient();
+		const agent = new IcodeAgent(new NullLogService(), () => client);
+		client.loadError = new Error('Session not found: sess-1');
+
+		await agent.materializeChat(restoredChat, chat, providerData('sess-1'));
+		assert.deepStrictEqual(await agent.chats.getMessages(restoredChat, chat), []);
+
+		const sending = agent.chats.sendMessage(restoredChat, 'hello', [workspace], [], 'turn-1');
+		await timeout(10);
+		assert.deepStrictEqual(client.requests.map(r => r.method), ['session/load', 'session/new', 'session/prompt']);
+
+		client.completePrompt('end_turn');
+		await sending;
+		agent.dispose();
+	});
+
+	test('getChatMetadata returns undefined without providerData and reports the persisted cwd otherwise', async () => {
+		const client = new FakeIcodeClient();
+		const agent = new IcodeAgent(new NullLogService(), () => client);
+
+		assert.strictEqual(await agent.getChatMetadata(restoredChat, chat, undefined), undefined);
+		const metadata = await agent.getChatMetadata(restoredChat, chat, providerData('sess-1'));
+		assert.strictEqual(metadata?.startTime, 1);
+		assert.deepStrictEqual(metadata?.workingDirectories?.map(u => u.fsPath), [RESTORED_CWD]);
+		agent.dispose();
+	});
+
+	test('an aborted replay leaves no buffered history behind', async () => {
+		const client = new FakeIcodeClient();
+		const agent = new IcodeAgent(new NullLogService(), () => client);
+		client.loadError = new Error('cancelled');
+
+		await agent.materializeChat(restoredChat, chat, providerData('sess-1'));
+		client.emitNotification('session/update', { sessionId: 'sess-1', update: { sessionUpdate: 'user_message_chunk', content: { type: 'text', text: 'late' } } });
+		assert.deepStrictEqual(await agent.chats.getMessages(restoredChat, chat), []);
+		agent.dispose();
+	});
+
+	test('announces the new session id as chat data once per chat', async () => {
+		const client = new FakeIcodeClient();
+		const agent = new IcodeAgent(new NullLogService(), () => client);
+		const seen: string[] = [];
+		disposables.add(agent.onDidChangeChatData(e => seen.push(e.providerData)));
+
+		const first = agent.chats.sendMessage(restoredChat, 'hello', [workspace], [], 'turn-1');
+		await timeout(10);
+		client.completePrompt('end_turn');
+		await first;
+
+		const second = agent.chats.sendMessage(restoredChat, 'again', [workspace], [], 'turn-2');
+		await timeout(10);
+		client.completePrompt('end_turn');
+		await second;
+
+		assert.strictEqual(seen.length, 1);
+		assert.strictEqual(decodeIcodeProviderData(seen[0])?.sessionId, SESSION_ID);
+		agent.dispose();
+	});
+});
