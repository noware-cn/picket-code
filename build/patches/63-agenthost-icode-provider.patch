+		transport.exit(7);
+		assert.strictEqual(client.exited, true);
+		assert.strictEqual(client.exitCode, 7);
+		assert.deepStrictEqual(exits, [7]);
+
+		transport.exit(3);
+		assert.deepStrictEqual(exits, [7], 'the exit event must fire exactly once');
+
+		await assert.rejects(client.request('session/new'), /exited/);
+	});
+
+	test('a spawn failure surfaces as an exit without an exit code', async () => {
+		const logs: string[] = [];
+		const { transport, sink, client } = createClient(logs);
+		disposables.add(client);
+		transport.error = new Error('spawn icode ENOENT');
+
+		const pending = client.request('session/new');
+		await sink.next();
+
+		transport.exit(null);
+
+		await assert.rejects(pending, CancellationError);
+		assert.strictEqual(client.exited, true);
+		assert.strictEqual(client.exitCode, null);
+		await assert.rejects(client.request('session/new'), /exited/);
+		assert.ok(logs.some(line => /exited/.test(line) && /ENOENT/.test(line)), `expected a diagnostic log, got:\n${logs.join('\n')}`);
+	});
+
+	test('stdout end does not masquerade as a process exit', async () => {
+		const { transport, sink, client } = createClient();
+		disposables.add(client);
+
+		const exits: (number | null)[] = [];
+		disposables.add(client.onExit(code => exits.push(code)));
+
+		const pending = client.request('session/new');
+		await sink.next();
+
+		transport.fromServer.end();
+
+		await assert.rejects(pending, CancellationError);
+		assert.deepStrictEqual(exits, [], 'stdout end must not fire the exit event');
+		assert.strictEqual(client.exited, false);
+		await assert.rejects(client.request('session/new'), /stdout closed/);
+
+		transport.exit(5);
+		assert.deepStrictEqual(exits, [5]);
+		assert.strictEqual(client.exitCode, 5);
+	});
+
+	test('notify after dispose is logged instead of vanishing', async () => {
+		const logs: string[] = [];
+		const { sink, client } = createClient(logs);
+		disposables.add(client);
+
+		client.notify('session/cancel', { sessionId: 's1' });
+		assert.deepStrictEqual(await sink.next(), { jsonrpc: '2.0', method: 'session/cancel', params: { sessionId: 's1' } });
+
+		client.dispose();
+		client.notify('session/cancel', { sessionId: 's1' });
+
+		assert.ok(logs.some(line => line.includes('session/cancel') && /dispose/i.test(line)), `expected a dispose log, got:\n${logs.join('\n')}`);
+	});
+
+	test('registrations are single per method and disposable', async () => {
+		const logs: string[] = [];
+		const { transport, sink, client } = createClient(logs);
+		disposables.add(client);
+
+		const updates: unknown[] = [];
+		const notificationRegistration = client.onNotification('session/update', params => updates.push(params));
+		disposables.add(notificationRegistration);
+		assert.throws(() => client.onNotification('session/update', () => { }), /already registered/);
+
+		const requestRegistration = client.onRequest('ping', () => 'pong');
+		disposables.add(requestRegistration);
+		assert.throws(() => client.onRequest('ping', () => 'pong'), /already registered/);
+
+		requestRegistration.dispose();
+		notificationRegistration.dispose();
+
+		// A request is answered after the notification was handled, so its response
+		// proves the disposed notification handler did not run.
+		transport.send({ jsonrpc: '2.0', method: 'session/update', params: { sessionId: 's1' } });
+		transport.send({ jsonrpc: '2.0', id: 11, method: 'ping' });
+
+		const response = await sink.next();
+		assert.strictEqual(response.id, 11);
+		assert.strictEqual(response.error.code, -32601, 'the disposed request handler must not answer');
+		assert.deepStrictEqual(updates, [], 'the disposed notification handler must not run');
+
+		// Both kinds of registration can be created again after disposal.
+		disposables.add(client.onNotification('session/update', () => { }));
+		disposables.add(client.onRequest('ping', () => 'pong'));
+	});
+
+	test('a failing async notification handler is logged, not thrown', async () => {
+		const logs: string[] = [];
+		const { transport, sink, client } = createClient(logs);
+		disposables.add(client);
+		disposables.add(client.onNotification('session/update', () => Promise.reject(new Error('nope'))));
+
+		transport.send({ jsonrpc: '2.0', method: 'session/update', params: {} });
+		transport.send({ jsonrpc: '2.0', id: 12, method: 'ping' });
+
+		const response = await sink.next();
+		assert.strictEqual(response.id, 12);
+		assert.ok(logs.some(line => line.includes('session/update') && line.includes('nope')), `expected a handler failure log, got:\n${logs.join('\n')}`);
+	});
+
+	test('cancelling the token rejects and notifies the server', async () => {
+		const { sink, client } = createClient();
+		disposables.add(client);
+
+		const source = new CancellationTokenSource();
+		disposables.add(source);
+
+		const pending = client.request('session/prompt', { sessionId: 's1' }, source.token);
+		assert.deepStrictEqual(await sink.next(), {
+			jsonrpc: '2.0', id: 1, method: 'session/prompt', params: { sessionId: 's1' },
+		});
+
+		source.cancel();
+		await assert.rejects(pending, CancellationError);
+
+		assert.deepStrictEqual(await sink.next(), {
+			jsonrpc: '2.0', method: '$/cancel_request', params: { requestId: 1 },
+		});
+	});
+});
