@@ -0,0 +1,258 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import { spawn } from 'child_process';
+import { Emitter } from '../../../../base/common/event.js';
+import { findExecutable, killTree } from '../../../../base/node/processes.js';
+import { StreamSplitter } from '../../../../base/node/nodeStreams.js';
+import { IIcodeAcpTransport } from './icodeAcpClient.js';
+
+export const ICODE_BIN_ENV = 'PICKET_ICODE_BIN';
+export const ICODE_AGENT_ENV = 'PICKET_ICODE_AGENT';
+
+const ICODE_COMMAND = 'icode';
+const DEFAULT_ICODE_AGENT = 'Code';
+const WINDOWS_SHELL_SCRIPT_RE = /\.(bat|cmd)$/i;
+const STDERR_TAIL_LENGTH = 8192;
+const DEFAULT_GRACE_PERIOD = 10_000;
+
+/**
+ * Outcome of {@link resolveIcodeCommand}. The reasons are kept apart so callers
+ * can tell "you pointed `PICKET_ICODE_BIN` at nothing" from "iCode is not on PATH".
+ */
+export type IcodeCommandResolution =
+	| { readonly command: string }
+	| { readonly reason: 'override-missing' | 'not-found' };
+
+/**
+ * Resolves the `icode` executable.
+ *
+ * `PICKET_ICODE_BIN` is authoritative: when it is set (and not empty) but does
+ * not point at a file, resolution fails instead of silently running whatever
+ * happens to be on PATH.
+ */
+export async function resolveIcodeCommand(
+	env: Readonly<Record<string, string | undefined>>,
+	fileExists: (path: string) => boolean | Promise<boolean>,
+	cwd?: string,
+): Promise<IcodeCommandResolution> {
+	const override = env[ICODE_BIN_ENV];
+	if (override) {
+		return await fileExists(override) ? { command: override } : { reason: 'override-missing' };
+	}
+
+	const found = await findExecutable(ICODE_COMMAND, cwd, undefined, env, async path => await fileExists(path));
+	return found !== undefined ? { command: found } : { reason: 'not-found' };
+}
+
+export function buildIcodeArgs(agent: string): readonly string[] {
+	return ['acp', '--approval', 'manual', '-a', agent];
+}
+
+/**
+ * Formats arguments to avoid issues on Windows for CVE-2024-27980. Copied from
+ * `src/vs/workbench/api/node/extHostMcpNode.ts`, which cannot be imported from
+ * `src/vs/platform/agentHost`.
+ */
+export function escapeCmdArg(arg: string): string {
+	return `"${arg.replace(/"/g, '""')}"`;
+}
+
+export interface IIcodeSpawnCommand {
+	readonly executable: string;
+	readonly args: readonly string[];
+	readonly shell: boolean;
+}
+
+/**
+ * Decides how to start the resolved executable. A `.cmd`/`.bat` shim cannot be
+ * spawned directly on Windows, so it has to go through the shell (Node runs
+ * `cmd.exe /d /s /c "<command line>"` for `shell: true`) with every token
+ * quoted, because `cmd.exe` reparses the line. A normal executable is spawned
+ * with the raw argument array and no shell, so nothing is ever shell-interpolated.
+ */
+export function formatIcodeSpawnCommand(command: string, args: readonly string[], platform: NodeJS.Platform = process.platform): IIcodeSpawnCommand {
+	if (platform !== 'win32' || !WINDOWS_SHELL_SCRIPT_RE.test(command)) {
+		return { executable: command, args, shell: false };
+	}
+
+	return {
+		executable: escapeCmdArg(command),
+		args: args.map(escapeCmdArg),
+		shell: true,
+	};
+}
+
+export interface IIcodeTransportOptions {
+	/** Working directory of the subprocess; defaults to the host's cwd. */
+	readonly cwd?: string;
+	/** Environment of the subprocess; defaults to `process.env`. */
+	readonly env?: Readonly<Record<string, string | undefined>>;
+	/** Sink for `[icode]`-prefixed process diagnostics. */
+	readonly log: (message: string) => void;
+	/** Overridable for tests; defaults to `process.platform`. */
+	readonly platform?: NodeJS.Platform;
+	/** Overridable for tests; defaults to `child_process.spawn`. */
+	readonly spawnProcess?: typeof spawn;
+	/** Delay between the graceful shutdown steps; defaults to 10 seconds. */
+	readonly gracePeriodMs?: number;
+}
+
+/**
+ * Spawns `icode acp` and exposes its stdio as an {@link IIcodeAcpTransport}.
+ *
+ * The returned transport owns the child's process state: stderr is line-buffered
+ * into `log` (with a capped tail kept for diagnostics), `onExit` fires exactly
+ * once from `'close'` (or from a spawn failure, with `null`), and `kill()` walks
+ * stdin close → SIGTERM → SIGKILL, where a second `kill()` skips the wait.
+ */
+export function createIcodeTransport(command: string, options: IIcodeTransportOptions): IIcodeAcpTransport {
+	const platform = options.platform ?? process.platform;
+	const env = options.env ?? process.env;
+	const cwd = options.cwd ?? process.cwd();
+	const log = options.log;
+	const spawnProcess = options.spawnProcess ?? spawn;
+	const gracePeriodMs = options.gracePeriodMs ?? DEFAULT_GRACE_PERIOD;
+	const agent = env[ICODE_AGENT_ENV] || DEFAULT_ICODE_AGENT;
+
+	const spawnCommand = formatIcodeSpawnCommand(command, buildIcodeArgs(agent), platform);
+	const child = spawnProcess(spawnCommand.executable, [...spawnCommand.args], {
+		cwd,
+		env,
+		shell: spawnCommand.shell,
+		stdio: ['pipe', 'pipe', 'pipe'],
+		windowsHide: true,
+	});
+
+	const { stdin, stdout, stderr } = child;
+	if (!stdin || !stdout || !stderr) {
+		throw new Error(`[icode] failed to create stdio pipes for '${command}'`);
+	}
+
+	let exited = false;
+	let exitCode: number | null = null;
+	let spawnError: Error | undefined;
+	let stderrTail = '';
+	let stopping = false;
+
+	const onExit = new Emitter<number | null>();
+	const timers = new Set<NodeJS.Timeout>();
+
+	const clearTimers = () => {
+		for (const timer of timers) {
+			clearTimeout(timer);
+		}
+		timers.clear();
+	};
+	const schedule = (delay: number, run: () => void) => {
+		// The cast avoids the dom/node `setTimeout` typing collision; `unref` keeps a
+		// pending escalation from holding the process open when tests or the host exit.
+		const timer = setTimeout(() => {
+			timers.delete(timer);
+			run();
+		}, delay) as unknown as NodeJS.Timeout;
+		timer.unref?.();
+		timers.add(timer);
+	};
+
+	const stderrSplitter = new StreamSplitter('\n');
+	stderrSplitter.setEncoding('utf8');
+	stderrSplitter.on('data', (line: string) => {
+		const text = line.trimEnd();
+		if (!text) {
+			return;
+		}
+		stderrTail = `${stderrTail}${text}\n`.slice(-STDERR_TAIL_LENGTH);
+		log(`[icode] ${text}`);
+	});
+	stderrSplitter.on('error', (error: Error) => log(`[icode] stderr framing error: ${error.message}`));
+	stderr.pipe(stderrSplitter);
+
+	const finish = (code: number | null, signal?: NodeJS.Signals | null) => {
+		if (exited) {
+			return;
+		}
+		exited = true;
+		exitCode = code;
+		clearTimers();
+		stderrSplitter.destroy();
+
+		const how = signal ? `signal ${signal}` : `code ${code === null ? 'unknown' : code}`;
+		log(`[icode] exited (${how})${spawnError ? `: ${spawnError.message}` : ''}`);
+		if ((code !== 0 || spawnError) && stderrTail.trim()) {
+			log(`[icode] stderr tail:\n${stderrTail.trimEnd()}`);
+		}
+
+		onExit.fire(code);
+	};
+
+	const terminate = async (forceful: boolean): Promise<void> => {
+		if (exited) {
+			return;
+		}
+
+		const pid = child.pid;
+		log(`[icode] ${forceful ? 'forcefully killing' : 'terminating'} iCode${pid !== undefined ? ` (pid ${pid})` : ''}`);
+		if (pid !== undefined) {
+			try {
+				await killTree(pid, forceful);
+				return;
+			} catch (error) {
+				log(`[icode] killTree failed for pid ${pid}: ${error instanceof Error ? error.message : String(error)}`);
+			}
+		}
+
+		try {
+			child.kill(forceful ? 'SIGKILL' : 'SIGTERM');
+		} catch (error) {
+			log(`[icode] failed to send ${forceful ? 'SIGKILL' : 'SIGTERM'}: ${error instanceof Error ? error.message : String(error)}`);
+		}
+	};
+
+	const kill = (): void => {
+		if (exited) {
+			return;
+		}
+		if (stopping) {
+			clearTimers();
+			void terminate(true);
+			return;
+		}
+
+		stopping = true;
+		try {
+			stdin.end();
+		} catch (error) {
+			log(`[icode] failed to close stdin: ${error instanceof Error ? error.message : String(error)}`);
+		}
+		schedule(gracePeriodMs, () => {
+			void terminate(false).then(() => {
+				if (!exited) {
+					schedule(gracePeriodMs, () => void terminate(true));
+				}
+			});
+		});
+	};
+
+	child.on('error', (error: Error) => {
+		spawnError = error;
+		log(`[icode] failed to run '${command}': ${error.message}`);
+		finish(null);
+	});
+	child.on('close', (code, signal) => finish(code, signal));
+	stdin.on('error', (error: Error) => log(`[icode] stdin error: ${error.message}`));
+	stdout.on('error', (error: Error) => log(`[icode] stdout error: ${error.message}`));
+	stderr.on('error', (error: Error) => log(`[icode] stderr error: ${error.message}`));
+
+	return {
+		stdin,
+		stdout,
+		onExit: onExit.event,
+		get exited() { return exited; },
+		get exitCode() { return exitCode; },
+		get error() { return spawnError; },
+		kill,
+	};
+}
