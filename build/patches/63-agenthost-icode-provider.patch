+const SESSION_ID = 'sess-new';
+
+class FakeIcodeClient implements IIcodeAcpClient {
+	private readonly exitEmitter = new Emitter<number | null>();
+	readonly onExit = this.exitEmitter.event;
+	exited = false;
+	exitCode: number | null = null;
+	disposed = false;
+	readonly requests: { method: string; params: any }[] = [];
+	readonly notifications: { method: string; params: any }[] = [];
+	/** `session/update` payloads replayed for `session/load`, emitted while the request is in flight. */
+	respondToLoad: readonly any[] = [];
+	/** When set, `session/load` rejects with it, mimicking a session iCode already dropped. */
+	loadError: Error | undefined;
+	/** When set, `session/load` stays in flight until `finishLoad` settles it. */
+	deferLoads = false;
+	/** The reply to `session/new`; tests swap it in to inject a model catalog. */
+	newSessionResult: { readonly sessionId: string; readonly models?: { readonly availableModels?: readonly { readonly modelId: string; readonly name: string; readonly description?: string }[]; readonly currentModelId?: string } } = {
+		sessionId: SESSION_ID,
+		models: { availableModels: [], currentModelId: 'mock' },
+	};
+	/** When set, overrides `newSessionResult.sessionId` for each `session/new`. */
+	nextSessionId: (() => string) | undefined;
+	/** When set, `session/new` stays in flight until `finishNewSession` settles it. */
+	deferNewSessions = false;
+	private pendingNewSession: ((value: any) => void) | undefined;
+	/** When set, `session/set_model` rejects with it. */
+	setModelError: Error | undefined;
+	private readonly notificationHandlers = new Map<string, (params: any) => void>();
+	private readonly requestHandlers = new Map<string, (params: any, id?: any) => unknown>();
+	/** The reply promise of the last server-to-client request, per method. */
+	private readonly replies = new Map<string, Promise<unknown>>();
+	/** In-flight `session/prompt` calls by session id; one process can run several. */
+	private readonly pendingPrompts = new Map<string, { resolve: (value: any) => void; reject: (reason: Error) => void }>();
+	/** In-flight `session/load` calls by session id, so a test can overlap two replays. */
+	private readonly pendingLoads = new Map<string, { resolve: (value: any) => void; reject: (reason: Error) => void }>();
+
+	get pendingPromptCount(): number { return this.pendingPrompts.size; }
+
+	request<R>(method: string, params?: unknown): Promise<R> {
+		this.requests.push({ method, params });
+		if (method === 'session/new') {
+			const sessionId = this.nextSessionId?.() ?? this.newSessionResult.sessionId;
+			const result = { ...this.newSessionResult, sessionId } as unknown as R;
+			if (!this.deferNewSessions) {
+				return Promise.resolve(result);
+			}
+			return new Promise<R>(resolve => { this.pendingNewSession = resolve as (value: any) => void; });
+		}
+		if (method === 'session/set_model') {
+			return this.setModelError ? Promise.reject(this.setModelError) : Promise.resolve({} as R);
+		}
+		if (method === 'session/load') {
+			if (this.loadError) {
+				return Promise.reject(this.loadError);
+			}
+			const sessionId = (params as { sessionId?: string } | undefined)?.sessionId ?? '';
+			for (const update of this.respondToLoad) {
+				this.emitNotification('session/update', { sessionId, update });
+			}
+			if (!this.deferLoads) {
+				return Promise.resolve({} as R);
+			}
+			return new Promise<R>((resolve, reject) => {
+				this.pendingLoads.set(sessionId, { resolve: resolve as (value: any) => void, reject });
+			});
+		}
+		if (method === 'session/prompt') {
+			const sessionId = (params as { sessionId?: string } | undefined)?.sessionId ?? '';
+			return new Promise<R>((resolve, reject) => {
+				this.pendingPrompts.set(sessionId, { resolve: resolve as (value: any) => void, reject });
+			});
+		}
+		return Promise.resolve({} as R);
+	}
+	notify(method: string, params?: unknown): void { this.notifications.push({ method, params }); }
+	onNotification(method: string, handler: (params: any) => void): IDisposable {
+		this.notificationHandlers.set(method, handler);
+		return { dispose: () => this.notificationHandlers.delete(method) };
+	}
+	onRequest<R = unknown>(method: string, handler: (params: any, _id: any) => R | Promise<R>): IDisposable {
+		this.requestHandlers.set(method, handler);
+		return { dispose: () => this.requestHandlers.delete(method) };
+	}
+	emitNotification(method: string, params: unknown): void { this.notificationHandlers.get(method)?.(params); }
+	emitRequest(method: string, params: unknown): Promise<unknown> {
+		const handler = this.requestHandlers.get(method);
+		assert.ok(handler, `no request handler registered for ${method}`);
+		const reply = Promise.resolve(handler(params));
+		this.replies.set(method, reply);
+		return reply;
+	}
+	/** The reply the agent sent for the last server-to-client request of that method. */
+	lastReplyFor(method: string): Promise<unknown> {
+		const reply = this.replies.get(method);
+		assert.ok(reply, `no reply captured for ${method}`);
+		return reply;
+	}
+	/** Settles the most recent in-flight `session/prompt`. */
+	finishPrompt(result: unknown): void {
+		const last = [...this.pendingPrompts.entries()].at(-1);
+		assert.ok(last, 'no in-flight session/prompt to settle');
+		this.pendingPrompts.delete(last[0]);
+		last[1].resolve(result);
+	}
+	/** Settles the deferred `session/new`, e.g. after a cancel arrived meanwhile. */
+	finishNewSession(): void {
+		const resolve = this.pendingNewSession;
+		assert.ok(resolve, 'no in-flight session/new to settle');
+		this.pendingNewSession = undefined;
+		resolve({ ...this.newSessionResult, sessionId: this.nextSessionId?.() ?? this.newSessionResult.sessionId });
+	}
+	/** Settles the in-flight `session/prompt` with a bare stop reason. */
+	completePrompt(stopReason: string): void { this.finishPrompt({ stopReason }); }
+	/** Settles the in-flight `session/load` of a session id, ending its replay. */
+	finishLoad(sessionId: string): void {
+		const load = this.pendingLoads.get(sessionId);
+		assert.ok(load, `no in-flight session/load for ${sessionId}`);
+		this.pendingLoads.delete(sessionId);
+		load.resolve({});
+	}
+	/** Settles every in-flight turn, e.g. when two chats share one process. */
+	completeAllPrompts(stopReason: string): void {
+		const pending = [...this.pendingPrompts.values()];
+		this.pendingPrompts.clear();
+		for (const turn of pending) {
+			turn.resolve({ stopReason });
+		}
+	}
+	emitExit(code: number | null): void {
+		this.exited = true;
+		this.exitCode = code;
+		this.exitEmitter.fire(code);
+		// The real client cancels every in-flight request when the process exits.
+		const pending = [...this.pendingPrompts.values()];
+		this.pendingPrompts.clear();
+		for (const turn of pending) {
+			turn.reject(new Error('icode exited'));
+		}
+		const loads = [...this.pendingLoads.values()];
+		this.pendingLoads.clear();
+		for (const load of loads) {
+			load.reject(new Error('icode exited'));
+		}
+	}
+	dispose(): void {
+		this.disposed = true;
+		this.exitEmitter.dispose();
+	}
+}
