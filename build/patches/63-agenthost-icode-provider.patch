+++ b/src/vs/platform/agentHost/node/icode/icodeInputRequests.ts
@@ -0,0 +1,169 @@
+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import {
+	ChatInputAnswerState,
+	ChatInputAnswerValueKind,
+	ChatInputQuestionKind,
+	ChatInputResponseKind,
+	type ChatInputAnswer,
+	type ChatInputOption,
+	type ChatInputQuestion,
+	type ChatInputRequest,
+} from '../../common/state/sessionState.js';
+
+/** One choice of a `_chrys/request_input` question; iCode sends no option ids. */
+export interface IIcodeQuestionOption {
+	readonly label: string;
+	readonly description?: string;
+}
+
+/** One question of a `_chrys/request_input` request, as iCode's `ask_user` tool declares it. */
+export interface IIcodeQuestion {
+	readonly question: string;
+	readonly header?: string;
+	readonly multiSelect?: boolean;
+	readonly options?: readonly IIcodeQuestionOption[];
+}
+
+/** The `_chrys/request_input` params iCode sends when `ask_user` needs the user. */
+export interface IIcodeInputRequest {
+	readonly sessionId: string;
+	readonly requestId: string;
+	readonly callerName?: string;
+	readonly questions: readonly IIcodeQuestion[];
+}
+
+/** One answer in iCode's reply shape; free text belongs in `values`, never in `note`. */
+export interface IIcodeInputAnswer {
+	readonly values: readonly string[];
+	readonly note: string;
+}
+
+/** The `_chrys/request_input` response iCode expects. */
+export interface IIcodeInputReply {
+	readonly answers: readonly IIcodeInputAnswer[];
+	readonly cancelled: boolean;
+}
+
+/** An answer for a request that was never answered; also the reply to a malformed request. */
+export const CANCELLED_INPUT_REPLY: IIcodeInputReply = { answers: [], cancelled: true };
+
+/** The parts of an answer value this mapper reads; the protocol value types only differ in `value`. */
+interface IAnswerValue {
+	readonly kind: ChatInputAnswerValueKind;
+	readonly value: unknown;
+}
+
+/**
+ * Maps one `_chrys/request_input` request to the protocol's
+ * `ChatInputRequested` payload.
+ *
+ * iCode has no question ids, so they are derived from the ACP `requestId` and
+ * the position in the list: the host repeats them in `answers`, which is the
+ * only way a reply can be matched back to its question.
+ */
+export function toChatInputRequest(requestId: string, questions: readonly IIcodeQuestion[]): ChatInputRequest {
+	return {
+		id: requestId,
+		questions: questions.map((question, index) => toChatInputQuestion(`${requestId}:${index}`, question)),
+	};
+}
+
+function toChatInputQuestion(id: string, question: IIcodeQuestion): ChatInputQuestion {
+	const shared = { id, message: question.question, ...(question.header !== undefined ? { title: question.header } : {}) };
+	// iCode's options are label/description only; the label doubles as the id so
+	// the value the user picks round-trips unchanged.
+	const options: ChatInputOption[] = (question.options ?? []).map(option => ({
+		id: option.label,
+		label: option.label,
+		...(option.description !== undefined ? { description: option.description } : {}),
+	}));
+
+	if (options.length === 0) {
+		return { ...shared, kind: ChatInputQuestionKind.Text };
+	}
+	return question.multiSelect === true
+		? { ...shared, kind: ChatInputQuestionKind.MultiSelect, options }
+		: { ...shared, kind: ChatInputQuestionKind.SingleSelect, options };
+}
+
+/**
+ * Maps the host's answer to iCode's reply.
+ *
+ * iCode pairs the reply with the questions by position and treats a shorter
+ * array as "the user answered nothing", so there is exactly one entry per
+ * question even when the user declined or cancelled.
+ */
+export function toIcodeInputReply(
+	questions: readonly IIcodeQuestion[],
+	response: ChatInputResponseKind,
+	answers: Record<string, ChatInputAnswer> | undefined,
+): IIcodeInputReply {
+	const accepted = response === ChatInputResponseKind.Accept;
+	const byIndex = byQuestionIndex(answers);
+	return {
+		answers: questions.map((_question, index) => ({
+			values: accepted ? answerValues(byIndex.get(index)) : [],
+			note: '',
+		})),
+		cancelled: !accepted,
+	};
+}
+
+/**
+ * Re-keys the host's answers by question position. Question ids are minted as
+ * `<requestId>:<index>`, so the trailing segment is the position.
+ */
+function byQuestionIndex(answers: Record<string, ChatInputAnswer> | undefined): Map<number, ChatInputAnswer> {
+	const byIndex = new Map<number, ChatInputAnswer>();
+	for (const [questionId, answer] of Object.entries(answers ?? {})) {
+		const index = Number(questionId.slice(questionId.lastIndexOf(':') + 1));
+		if (Number.isInteger(index) && index >= 0) {
+			byIndex.set(index, answer);
+		}
+	}
+	return byIndex;
+}
+
+/** The values one answer contributes to the reply; every kind flattens to strings. */
+function answerValues(answer: ChatInputAnswer | undefined): string[] {
+	const value = answerValue(answer);
+	if (value === undefined) {
+		return [];
+	}
+	switch (value.kind) {
+		case ChatInputAnswerValueKind.Selected:
+			return typeof value.value === 'string' ? [value.value] : [];
+		case ChatInputAnswerValueKind.SelectedMany:
+			return Array.isArray(value.value) ? value.value.map(String) : [];
+		case ChatInputAnswerValueKind.Text:
+		case ChatInputAnswerValueKind.Number:
+			return [String(value.value)];
+		case ChatInputAnswerValueKind.Boolean:
+			return [value.value === true ? 'true' : 'false'];
+		default:
+			return [];
+	}
+}
+
+/**
+ * Unwraps the answer's value. The host sends the protocol's `ChatInputAnswer`,
+ * which pairs the value with its lifecycle state; a skipped question carries
+ * none, and a bare value (no state) is accepted as well.
+ */
+function answerValue(answer: ChatInputAnswer | undefined): IAnswerValue | undefined {
+	if (answer === undefined) {
+		return undefined;
+	}
+	const candidate = answer as { readonly state?: ChatInputAnswerState; readonly kind?: ChatInputAnswerValueKind; readonly value?: unknown };
+	if (candidate.state === ChatInputAnswerState.Skipped) {
+		return undefined;
+	}
+	if (candidate.state !== undefined) {
+		return candidate.value as IAnswerValue | undefined;
+	}
+	return candidate.kind === undefined ? undefined : candidate as unknown as IAnswerValue;
+}
