+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { PassThrough } from 'stream';
+import { CancellationTokenSource } from '../../../../../base/common/cancellation.js';
+import { CancellationError } from '../../../../../base/common/errors.js';
+import { Emitter, Event } from '../../../../../base/common/event.js';
+import { JsonRpcError } from '../../../../../base/common/jsonRpcProtocol.js';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { IcodeAcpClient, IIcodeAcpTransport } from '../../../node/icode/icodeAcpClient.js';
+
+/** Transport backed by in-memory streams; the process exit is driven by the test. */
+class TestTransport implements IIcodeAcpTransport {
+
+	readonly toServer = new PassThrough();
+	readonly fromServer = new PassThrough();
+
+	private readonly _onExit = new Emitter<number | null>();
+	readonly onExit: Event<number | null> = this._onExit.event;
+
+	exited = false;
+	exitCode: number | null = null;
+	error: Error | undefined = undefined;
+	killCount = 0;
+
+	get stdin(): NodeJS.WritableStream { return this.toServer; }
+	get stdout(): NodeJS.ReadableStream { return this.fromServer; }
+
+	kill(): void {
+		this.killCount++;
+	}
+
+	exit(code: number | null): void {
+		this.exited = true;
+		this.exitCode = code;
+		this._onExit.fire(code);
+	}
+
+	send(message: unknown): void {
+		this.fromServer.write(`${JSON.stringify(message)}\n`);
+	}
+}
+
+/** Collects the client's outgoing messages so tests never race on stream events. */
+class MessageSink {
+
+	private readonly _messages: any[] = [];
+	private readonly _waiters: ((message: any) => void)[] = [];
+
+	constructor(stream: PassThrough) {
+		stream.on('data', (chunk: Buffer) => {
+			for (const line of chunk.toString('utf8').split('\n')) {
+				if (!line.trim()) {
+					continue;
+				}
+				const message = JSON.parse(line);
+				const waiter = this._waiters.shift();
+				if (waiter) {
+					waiter(message);
+				} else {
+					this._messages.push(message);
+				}
+			}
+		});
+	}
+
+	next(): Promise<any> {
+		const queued = this._messages.shift();
+		return queued !== undefined ? Promise.resolve(queued) : new Promise(resolve => this._waiters.push(resolve));
+	}
+}
+
+suite('IcodeAcpClient', () => {
+	const disposables = ensureNoDisposablesAreLeakedInTestSuite();
+
+	function createClient(logs: string[] = []) {
+		const transport = new TestTransport();
+		const sink = new MessageSink(transport.toServer);
+		const client = new IcodeAcpClient(transport, message => logs.push(message));
+		return { transport, sink, client, logs };
+	}
+
+	test('writes a JSON-RPC 2.0 line and resolves with the matching result', async () => {
+		const { transport, sink, client } = createClient();
+		disposables.add(client);
+
+		const pending = client.request('initialize', { protocolVersion: 1 });
+		assert.deepStrictEqual(await sink.next(), {
+			jsonrpc: '2.0', id: 1, method: 'initialize', params: { protocolVersion: 1 },
+		});
+
+		transport.send({ jsonrpc: '2.0', id: 1, result: { protocolVersion: 1 } });
+		assert.deepStrictEqual(await pending, { protocolVersion: 1 });
+	});
+
+	test('handles two messages arriving in one chunk', async () => {
+		const { transport, sink, client } = createClient();
+		disposables.add(client);
+
+		const first = client.request('one');
+		const second = client.request('two');
+		await sink.next();
+		await sink.next();
+
+		transport.fromServer.write(
+			`${JSON.stringify({ jsonrpc: '2.0', id: 1, result: 'a' })}\n${JSON.stringify({ jsonrpc: '2.0', id: 2, result: 'b' })}\n`,
+		);
+
+		assert.strictEqual(await first, 'a');
+		assert.strictEqual(await second, 'b');
+	});
+
+	test('handles a message split across two chunks', async () => {
+		const { transport, sink, client } = createClient();
+		disposables.add(client);
+
+		const pending = client.request('initialize');
+		await sink.next();
+
+		const line = `${JSON.stringify({ jsonrpc: '2.0', id: 1, result: 'complete' })}\n`;
+		transport.fromServer.write(line.slice(0, 11));
+		transport.fromServer.write(line.slice(11));
+
+		assert.strictEqual(await pending, 'complete');
+	});
+
+	test('does not corrupt a CJK string split mid-codepoint', async () => {
+		const { transport, sink, client } = createClient();
+		disposables.add(client);
+
+		const pending = client.request('initialize');
+		await sink.next();
+
+		const buffer = Buffer.from(`${JSON.stringify({ jsonrpc: '2.0', id: 1, result: '你好，世界' })}\n`, 'utf8');
+		const split = buffer.indexOf(Buffer.from('你', 'utf8')) + 1;
+		assert.ok(split > 1);
+
+		transport.fromServer.write(buffer.subarray(0, split));
+		transport.fromServer.write(buffer.subarray(split));
+
+		assert.strictEqual(await pending, '你好，世界');
+	});
+
+	test('logs and skips a malformed line, then parses the next valid line', async () => {
+		const logs: string[] = [];
+		const { transport, sink, client } = createClient(logs);
+		disposables.add(client);
+		disposables.add(client.onRequest('ping', () => ({ pong: true })));
+
+		transport.fromServer.write(`{ this is not json }\n${JSON.stringify({ jsonrpc: '2.0', id: 42, method: 'ping' })}\n`);
+
+		assert.deepStrictEqual(await sink.next(), { jsonrpc: '2.0', id: 42, result: { pong: true } });
+		assert.ok(logs.some(line => /malformed/i.test(line)), `expected a malformed-line log, got:\n${logs.join('\n')}`);
+	});
+
+	test('rejects with a JsonRpcError carrying code and data', async () => {
+		const { transport, sink, client } = createClient();
+		disposables.add(client);
+
+		const pending = client.request('session/new', { cwd: '/tmp' });
+		await sink.next();
+
+		transport.send({ jsonrpc: '2.0', id: 1, error: { code: -32000, message: 'no session', data: { retry: false } } });
+
+		await assert.rejects(pending, (error: any) => {
+			assert.ok(error instanceof JsonRpcError);
+			assert.strictEqual(error.code, -32000);
+			assert.strictEqual(error.message, 'no session');
+			assert.deepStrictEqual(error.data, { retry: false });
+			return true;
+		});
+	});
+
+	test('answers a server-to-client request', async () => {
+		const { transport, sink, client } = createClient();
+		disposables.add(client);
+		disposables.add(client.onRequest('session/request_permission', (_params, id) => ({ id, outcome: { outcome: 'selected', optionId: 'allow' } })));
+
+		transport.send({ jsonrpc: '2.0', id: 7, method: 'session/request_permission', params: { sessionId: 's1' } });
+
+		assert.deepStrictEqual(await sink.next(), {
+			jsonrpc: '2.0', id: 7, result: { id: 7, outcome: { outcome: 'selected', optionId: 'allow' } },
+		});
+	});
+
+	test('answers an unhandled server request with method-not-found', async () => {
+		const { transport, sink, client } = createClient();
+		disposables.add(client);
+
+		transport.send({ jsonrpc: '2.0', id: 9, method: 'unknown/method', params: {} });
+
+		const response = await sink.next();
+		assert.strictEqual(response.id, 9);
+		assert.strictEqual(response.error.code, -32601);
+	});
+
+	test('answers a throwing handler with an internal error', async () => {
+		const { transport, sink, client } = createClient();
+		disposables.add(client);
+		disposables.add(client.onRequest('boom', () => { throw new Error('kaboom'); }));
+		disposables.add(client.onRequest('asyncBoom', async () => { throw new Error('async kaboom'); }));
+
+		transport.send({ jsonrpc: '2.0', id: 3, method: 'boom' });
+		const syncResponse = await sink.next();
+		assert.strictEqual(syncResponse.id, 3);
+		assert.strictEqual(syncResponse.error.code, -32603);
+		assert.strictEqual(syncResponse.error.message, 'kaboom');
+
+		transport.send({ jsonrpc: '2.0', id: 4, method: 'asyncBoom' });
+		const asyncResponse = await sink.next();
+		assert.strictEqual(asyncResponse.id, 4);
+		assert.strictEqual(asyncResponse.error.code, -32603);
+		assert.strictEqual(asyncResponse.error.message, 'async kaboom');
+	});
+
+	test('answers a handler returning undefined with result null', async () => {
+		const { transport, sink, client } = createClient();
+		disposables.add(client);
+		disposables.add(client.onRequest('void', () => undefined));
+
+		transport.send({ jsonrpc: '2.0', id: 4, method: 'void' });
+
+		const response = await sink.next();
+		assert.deepStrictEqual(response, { jsonrpc: '2.0', id: 4, result: null });
+		assert.ok('result' in response);
+	});
+
+	test('dispose rejects in-flight requests', async () => {
+		const { sink, client } = createClient();
+		disposables.add(client);
+
+		const pending = client.request('session/new', { cwd: '/tmp' });
+		await sink.next();
+
+		client.dispose();
+		await assert.rejects(pending, CancellationError);
+	});
+
+	test('request after exit rejects immediately and the exit event fires once', async () => {
+		const logs: string[] = [];
+		const { transport, client } = createClient(logs);
+		disposables.add(client);
+
+		const exits: (number | null)[] = [];
+		disposables.add(client.onExit(code => exits.push(code)));
