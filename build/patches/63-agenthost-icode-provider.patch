+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { MessageKind, ResponsePartKind, ToolCallStatus, TurnState } from '../../../common/state/sessionState.js';
+import { buildIcodeTurns } from '../../../node/icode/icodeHistory.js';
+
+suite('icodeHistory', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('groups replayed updates into turns with parts in stream order', () => {
+		const turns = buildIcodeTurns([
+			{ sessionUpdate: 'user_message_chunk', content: { type: 'text', text: 'hello' } },
+			{ sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: 'Hi' }, messageId: 'm1' },
+			{ sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: ' there' }, messageId: 'm1' },
+			{ sessionUpdate: 'user_message_chunk', content: { type: 'text', text: 'again' } },
+		] as never);
+		assert.strictEqual(turns.length, 2);
+		assert.deepStrictEqual(turns[0].message, { text: 'hello', origin: { kind: MessageKind.User } });
+		assert.deepStrictEqual(turns[0].responseParts.map(p => p.kind), [ResponsePartKind.Markdown]);
+		assert.strictEqual((turns[0].responseParts[0] as { content: string }).content, 'Hi there');
+		assert.strictEqual(turns[0].state, TurnState.Complete);
+		assert.strictEqual(turns[1].message.text, 'again');
+	});
+
+	test('keeps thought chunks in a separate reasoning part and closes tools on their final status', () => {
+		const turns = buildIcodeTurns([
+			{ sessionUpdate: 'user_message_chunk', content: { type: 'text', text: 'go' } },
+			{ sessionUpdate: 'agent_thought_chunk', content: { type: 'text', text: 'thinking' } },
+			{ sessionUpdate: 'tool_call', toolCallId: 't1', title: 'zsh', kind: 'execute', status: 'in_progress', rawInput: { command: 'ls' } },
+			{ sessionUpdate: 'tool_call_update', toolCallId: 't1', status: 'completed', rawOutput: 'ok' },
+		] as never);
+		const parts = turns[0].responseParts;
+		assert.deepStrictEqual(parts.map(p => p.kind), [ResponsePartKind.Reasoning, ResponsePartKind.ToolCall]);
+		const tool = parts[1] as { toolCall: { status: string; success: boolean; toolName: string; displayName: string } };
+		assert.strictEqual(tool.toolCall.status, ToolCallStatus.Completed);
+		assert.strictEqual(tool.toolCall.success, true);
+		assert.strictEqual(tool.toolCall.toolName, 'shell');
+	assert.strictEqual(tool.toolCall.displayName, 'zsh');
+	});
+
+	test('reads a replayed tool result out of the content ACP wraps it in', () => {
+		// Same shape as the live mapper: the result block is `{ type: 'content', content: { type: 'text' } }`.
+		const turns = buildIcodeTurns([
+			{ sessionUpdate: 'user_message_chunk', content: { type: 'text', text: 'go' } },
+			{ sessionUpdate: 'tool_call', toolCallId: 't1', title: 'zsh', kind: 'execute', status: 'in_progress' },
+			{ sessionUpdate: 'tool_call_update', toolCallId: 't1', status: 'completed', content: [{ type: 'content', content: { type: 'text', text: 'fake' } }] },
+		] as never);
+		const tool = turns[0].responseParts[0] as { toolCall: { content?: readonly { type: string; text: string }[] } };
+		assert.deepStrictEqual(tool.toolCall.content, [{ type: 'text', text: 'fake' }]);
+	});
+
+	test('keeps the tool input a follow-up update does not repeat', () => {
+		const turns = buildIcodeTurns([
+			{ sessionUpdate: 'user_message_chunk', content: { type: 'text', text: 'go' } },
+			{ sessionUpdate: 'tool_call', toolCallId: 't1', title: 'zsh', kind: 'execute', status: 'in_progress', rawInput: { command: 'ls' } },
+			{ sessionUpdate: 'tool_call_update', toolCallId: 't1', status: 'completed', rawOutput: 'ok' },
+		] as never);
+		const tool = turns[0].responseParts[0] as { toolCall: { status: string; toolInput?: string } };
+		assert.strictEqual(tool.toolCall.status, ToolCallStatus.Completed);
+		assert.strictEqual(tool.toolCall.toolInput, '{"command":"ls"}', 'the completion must not wipe the input the announcement carried');
+	});
+
+	test('drops updates that arrive before any user message instead of inventing a turn', () => {
+		assert.deepStrictEqual(buildIcodeTurns([{ sessionUpdate: 'agent_message_chunk', content: { type: 'text', text: 'x' } }] as never), []);
+	});
+});
