+/**
+ * L3 — the whole agent host over AHP/WebSocket, with the real iCode provider and the
+ * fake ACP CLI (`vscode/test/fixtures/fake-icode-acp.mjs`) behind it.
+ *
+ * Unlike the integration suites under `test/node/protocol/`, this file spawns the
+ * compiled host (`out/vs/platform/agentHost/node/agentHostServerMain.js`) as a plain
+ * Node child process and speaks AHP to it with a hand-rolled `ws` client, so it runs
+ * under `npm run test-node` with no display and no Electron. Everything asserted here
+ * is protocol traffic — action types, their payloads and the state a snapshot reports —
+ * never a host internal.
+ *
+ * The fake CLI reads `FAKE_ICODE_SCENARIO` once at spawn, so every case starts its own
+ * host with the scenario it needs (~1s each).
+ */
+
+import assert from 'assert';
+import { type ChildProcess, spawn } from 'child_process';
+import { existsSync, mkdtempSync, readFileSync, realpathSync, rmSync } from 'fs';
+import { tmpdir } from 'os';
+import { join } from 'path';
+import { randomUUID } from 'crypto';
+import { fileURLToPath, pathToFileURL } from 'url';
+import { WebSocket, type RawData } from 'ws';
+import { PROTOCOL_VERSION } from '../../../common/state/protocol/version/registry.js';
+import { ActionType } from '../../../common/state/sessionActions.js';
+import {
+	ChatInputAnswerState,
+	ChatInputAnswerValueKind,
+	ChatInputResponseKind,
+	MessageKind,
+	ResponsePartKind,
+	ToolCallConfirmationReason,
+	ToolCallStatus,
+	TurnState,
+} from '../../../common/state/sessionState.js';
+
+/** `test/node/icode/` → the VS Code tree root; both `out/` and `out-build/` sit there. */
+const REPO_ROOT = fileURLToPath(new URL('../../../../../../../', import.meta.url));
+const FIXTURE_PATH = join(REPO_ROOT, 'test', 'fixtures', 'fake-icode-acp.mjs');
+const SERVER_MAIN = fileURLToPath(new URL('../../../node/agentHostServerMain.js', import.meta.url));
+
+const ROOT_CHANNEL = 'ahp-root://';
+const STARTUP_TIMEOUT_MS = 30_000;
+const OPERATION_TIMEOUT_MS = 20_000;
+const GRACEFUL_SHUTDOWN_TIMEOUT_MS = 10_000;
+
+// ---- AHP client -------------------------------------------------------------
+
+type JsonRpcMessage = {
+	readonly jsonrpc?: string;
+	readonly id?: number;
+	readonly method?: string;
+	readonly params?: any;
+	readonly result?: any;
+	readonly error?: { readonly code: number; readonly message: string; readonly data?: unknown };
+};
+
+type ActionMessage = { readonly type: string; readonly [key: string]: any };
+
+interface IWaiter {
+	readonly predicate: (message: JsonRpcMessage) => boolean;
+	readonly resolve: (message: JsonRpcMessage) => void;
+	readonly timer: ReturnType<typeof setTimeout>;
+}
+
+function actionOf(message: JsonRpcMessage): ActionMessage | undefined {
+	return message.method === 'action' ? (message.params as { action?: ActionMessage } | undefined)?.action : undefined;
+}
+
+/**
+ * Minimal AHP client: JSON-RPC 2.0 over one WebSocket. Server→client state changes
+ * arrive as `action` notifications; client→server actions are `dispatchAction`
+ * notifications. Every received notification is buffered so a test can assert on the
+ * traffic after a turn has finished.
+ */
+class AhpTestClient {
+
+	private readonly _ws: WebSocket;
+	private readonly _pending = new Map<number, { resolve: (value: any) => void; reject: (error: Error) => void }>();
+	private readonly _received: JsonRpcMessage[] = [];
+	private readonly _waiters: IWaiter[] = [];
+	private _nextId = 1;
+	private _clientSeq = 0;
+
+	constructor(port: number) {
+		this._ws = new WebSocket(`ws://127.0.0.1:${port}`);
+	}
+
+	connect(): Promise<void> {
+		return new Promise<void>((resolve, reject) => {
+			this._ws.once('open', () => {
+				this._ws.on('message', (data: RawData) => this._onMessage(data.toString()));
+				resolve();
+			});
+			this._ws.once('error', (error: Error) => reject(error));
+		});
+	}
+
+	private _onMessage(text: string): void {
+		let message: JsonRpcMessage;
+		try {
+			message = JSON.parse(text) as JsonRpcMessage;
+		} catch {
+			return;
+		}
+		if (message.id !== undefined && message.method !== undefined) {
+			// A reverse request. The iCode provider never asks the client for anything,
+			// so answer with "method not found" rather than leaving the host waiting.
+			this._ws.send(JSON.stringify({ jsonrpc: '2.0', id: message.id, error: { code: -32601, message: `unsupported: ${message.method}` } }));
+			return;
+		}
+		if (message.id !== undefined) {
+			const pending = this._pending.get(message.id);
+			if (!pending) {
+				return;
+			}
+			this._pending.delete(message.id);
+			if (message.error) {
+				pending.reject(new Error(`${message.error.code}: ${message.error.message}`));
+			} else {
+				pending.resolve(message.result);
+			}
+			return;
+		}
+		this._received.push(message);
+		for (let i = this._waiters.length - 1; i >= 0; i--) {
+			const waiter = this._waiters[i];
+			if (waiter.predicate(message)) {
+				this._waiters.splice(i, 1);
+				clearTimeout(waiter.timer);
+				waiter.resolve(message);
+			}
+		}
+	}
+
+	call<T>(method: string, params?: unknown, timeoutMs = OPERATION_TIMEOUT_MS): Promise<T> {
+		const id = this._nextId++;
+		return new Promise<T>((resolve, reject) => {
+			const timer = setTimeout(() => {
+				this._pending.delete(id);
+				reject(new Error(`timed out after ${timeoutMs}ms waiting for ${method} (id=${id})`));
+			}, timeoutMs);
+			this._pending.set(id, {
+				resolve: value => { clearTimeout(timer); resolve(value as T); },
+				reject: error => { clearTimeout(timer); reject(error); },
+			});
+			this._ws.send(JSON.stringify({ jsonrpc: '2.0', id, method, params }));
+		});
+	}
+
+	/** Dispatch a client action on a channel (write-ahead, fire-and-forget). */
+	dispatch(channel: string, action: ActionMessage): void {
+		this._ws.send(JSON.stringify({
+			jsonrpc: '2.0',
+			method: 'dispatchAction',
+			params: { channel, clientSeq: ++this._clientSeq, action },
+		}));
+	}
+
+	/** Resolve with the first received message matching `predicate` (buffered or future). */
+	waitFor(predicate: (message: JsonRpcMessage) => boolean, description: string, timeoutMs = OPERATION_TIMEOUT_MS): Promise<JsonRpcMessage> {
+		const existing = this._received.find(predicate);
+		if (existing) {
+			return Promise.resolve(existing);
+		}
+		return new Promise<JsonRpcMessage>((resolve, reject) => {
+			const waiter: IWaiter = {
+				predicate,
+				resolve,
+				timer: setTimeout(() => {
+					const index = this._waiters.indexOf(waiter);
+					if (index >= 0) {
+						this._waiters.splice(index, 1);
+					}
+					reject(new Error(`timed out after ${timeoutMs}ms waiting for ${description}; received: ${this._describeReceived()}`));
+				}, timeoutMs),
+			};
+			this._waiters.push(waiter);
+		});
+	}
+
+	waitForAction(type: string, predicate: (action: ActionMessage) => boolean = () => true, description: string = type, timeoutMs = OPERATION_TIMEOUT_MS): Promise<ActionMessage> {
+		return this.waitFor(message => {
+			const action = actionOf(message);
+			return action !== undefined && action.type === type && predicate(action);
+		}, description, timeoutMs).then(message => actionOf(message)!);
+	}
+
+	actionsOfType(type: string): ActionMessage[] {
+		const actions: ActionMessage[] = [];
+		for (const message of this._received) {
+			const action = actionOf(message);
+			if (action?.type === type) {
+				actions.push(action);
+			}
+		}
+		return actions;
+	}
+
+	/** Drop the buffered traffic so the next phase only sees what it caused. */
+	clear(): void {
+		this._received.length = 0;
+	}
+
+	close(): void {
+		for (const waiter of this._waiters.splice(0)) {
+			clearTimeout(waiter.timer);
+		}
+		for (const pending of this._pending.values()) {
+			pending.reject(new Error('client closed'));
+		}
+		this._pending.clear();
+		this._ws.close();
+	}
+
+	private _describeReceived(): string {
+		const described = this._received.map(message => {
+			const action = actionOf(message);
+			return action ? `${message.method}:${action.type}` : message.method ?? 'response';
+		});
+		return described.length > 0 ? described.join(', ') : '<nothing>';
+	}
+}
+
+// ---- Host process -----------------------------------------------------------
+
+interface IServerHandle {
+	readonly child: ChildProcess;
+	readonly port: number;
+	readonly stderr: string[];
+}
+
+interface ILaunchOptions {
+	readonly scenario: string;
+	/** Reuse an existing directory to test restore; a fresh one is created otherwise. */
+	readonly userDataDir?: string;
+	readonly workingDirectory?: string;
+	/** Where the fake CLI records the directory it was spawned in. */
+	readonly cwdFile?: string;
+}
+
+interface IHostRun {
+	readonly client: AhpTestClient;
+	readonly server: IServerHandle;
+	readonly userDataDir: string;
+	readonly workingDirectory: string;
+	dispose(): Promise<void>;
+}
+
+const runningHosts = new Set<number>();
+
+function delay(ms: number): Promise<void> {
+	return new Promise(resolve => setTimeout(resolve, ms));
+}
+
+async function waitUntil(predicate: () => boolean, what: string, timeoutMs = 10_000): Promise<void> {
+	const deadline = Date.now() + timeoutMs;
+	while (!predicate()) {
+		if (Date.now() > deadline) {
+			throw new Error(`timed out after ${timeoutMs}ms waiting for ${what}`);
+		}
+		await delay(25);
+	}
+}
+
+function waitForExit(child: ChildProcess, timeoutMs: number): Promise<boolean> {
+	if (child.exitCode !== null || child.signalCode !== null) {
+		return Promise.resolve(true);
+	}
+	return new Promise<boolean>(resolve => {
+		let timer: ReturnType<typeof setTimeout>;
+		const onExit = () => {
+			clearTimeout(timer);
+			resolve(true);
+		};
+		timer = setTimeout(() => {
+			child.off('exit', onExit);
+			resolve(false);
+		}, timeoutMs);
+		child.once('exit', onExit);
+	});
+}
+
+function isProcessGone(pid: number): boolean {
+	try {
+		process.kill(pid, 0);
+		return false;
+	} catch (error) {
+		return (error as NodeJS.ErrnoException).code === 'ESRCH';
+	}
+}
+
+/** Kill the host's process group, so the fake ACP CLI it spawned cannot outlive it. */
+function killProcessGroup(child: ChildProcess): void {
+	const pid = child.pid;
+	if (pid === undefined || process.platform === 'win32') {
+		return;
+	}
+	try {
+		process.kill(-pid, 'SIGKILL');
+	} catch {
+		// The group is already empty.
+	}
+}
+
+async function startHost(options: ILaunchOptions & { readonly userDataDir: string; readonly workingDirectory: string }): Promise<IServerHandle> {
+	const args = [SERVER_MAIN, '--port', '0', '--without-connection-token', '--quiet', '--user-data-dir', options.userDataDir];
+	const env: NodeJS.ProcessEnv = {
+		...process.env,
+		PICKET_ICODE_BIN: FIXTURE_PATH,
+		PICKET_ICODE_AGENT_ENABLED: '1',
+		FAKE_ICODE_SCENARIO: options.scenario,
+		HOME: options.userDataDir,
+		USERPROFILE: options.userDataDir,
+	};
+	if (options.cwdFile !== undefined) {
+		env['FAKE_ICODE_CWD_FILE'] = options.cwdFile;
+	}
+	// `detached` makes the host a process-group leader on POSIX, so teardown can reap
+	// the fake CLI along with it. stdin stays piped open: the host shuts down on EOF.
+	const child = spawn(process.execPath, args, {
+		stdio: ['pipe', 'pipe', 'pipe'],
+		env,
+		detached: process.platform !== 'win32',
+	});
+	if (child.pid !== undefined) {
+		runningHosts.add(child.pid);
+	}
+	const stderr: string[] = [];
+	child.stderr?.on('data', (data: Buffer) => stderr.push(data.toString()));
+
+	const port = await new Promise<number>((resolve, reject) => {
+		let stdout = '';
+		const timer = setTimeout(() => {
+			reject(new Error(`the agent host did not print READY:<port> within ${STARTUP_TIMEOUT_MS}ms\n${stderr.join('')}`));
+		}, STARTUP_TIMEOUT_MS);
+		const settle = (fn: () => void) => {
+			clearTimeout(timer);
+			fn();
+		};
+		child.stdout?.on('data', (data: Buffer) => {
+			stdout += data.toString();
+			const match = /READY:(\d+)/.exec(stdout);
+			if (match) {
+				settle(() => resolve(Number(match[1])));
+			}
+		});
+		child.once('error', error => settle(() => reject(error)));
+		child.once('exit', code => settle(() => reject(new Error(`the agent host exited with code ${code} before printing READY\n${stderr.join('')}`))));
+	});
+
+	return { child, port, stderr };
+}
+
+async function stopHost(server: IServerHandle): Promise<void> {
+	const { child } = server;
+	const pid = child.pid;
+	if (pid === undefined) {
+		return;
+	}
+	if (child.exitCode === null && child.signalCode === null) {
+		// Graceful path: closing stdin makes agentHostServerMain shut down and exit 0.
+		child.stdin?.end();
+		if (!await waitForExit(child, GRACEFUL_SHUTDOWN_TIMEOUT_MS)) {
+			killProcessGroup(child);
+			await waitForExit(child, 5_000);
+		}
+	}
+	// Reap whatever the host left in its process group (the fake ACP CLI).
+	killProcessGroup(child);
+	const deadline = Date.now() + 5_000;
+	while (!isProcessGone(pid) && Date.now() < deadline) {
+		await delay(25);
+	}
+	assert.ok(child.exitCode !== null || child.signalCode !== null, `the agent host (pid ${pid}) must have exited`);
+	assert.ok(isProcessGone(pid), `the agent host (pid ${pid}) must not have been left running`);
+	runningHosts.delete(pid);
+}
+
+function makeTempDir(prefix: string): string {
+	return mkdtempSync(join(tmpdir(), prefix));
+}
+
+async function launchHost(options: ILaunchOptions): Promise<IHostRun> {
+	const userDataDir = options.userDataDir ?? makeTempDir('picket-l3-data-');
+	const workingDirectory = options.workingDirectory ?? makeTempDir('picket-l3-work-');
+	const ownsUserDataDir = options.userDataDir === undefined;
+	const ownsWorkingDirectory = options.workingDirectory === undefined;
+	const server = await startHost({ ...options, userDataDir, workingDirectory });
+	const client = new AhpTestClient(server.port);
+	try {
+		await client.connect();
+	} catch (error) {
+		await stopHost(server);
+		throw error;
+	}
+	return {
+		client,
+		server,
+		userDataDir,
+		workingDirectory,
+		async dispose(): Promise<void> {
+			client.close();
+			await stopHost(server);
+			if (ownsUserDataDir) {
+				rmSync(userDataDir, { recursive: true, force: true });
+			}
+			if (ownsWorkingDirectory) {
+				rmSync(workingDirectory, { recursive: true, force: true });
+			}
+		},
+	};
+}
+
+// ---- Session/turn helpers ---------------------------------------------------
+
+interface ISessionHandle {
+	readonly session: string;
+	readonly chat: string;
+}
+
+/**
+ * Handshake and subscribe to the root channel. `initialize` reports no snapshots
+ * on this host, so the agent catalog is read from the root subscription's snapshot;
+ * subscribing also makes the root actions (`agentsChanged`, `activeSessionsChanged`)
+ * part of the traffic instead of only the broadcast `sessionSummaryChanged`.
+ */
+async function initializeRoot(client: AhpTestClient, clientId: string): Promise<any> {
+	await client.call('initialize', {
+		channel: ROOT_CHANNEL,
+		protocolVersions: [PROTOCOL_VERSION],
+		clientId,
+	});
+	const root = await client.call<any>('subscribe', { channel: ROOT_CHANNEL });
+	assert.ok(root?.snapshot?.state, 'the root channel must serve a snapshot after initialize');
+	return root.snapshot.state;
+}
+
+/** Handshake, create an iCode session, subscribe to it and to its default chat. */
+async function createIcodeSession(client: AhpTestClient, clientId: string, workingDirectory: string): Promise<ISessionHandle> {
+	await initializeRoot(client, clientId);
+	await client.call('createSession', {
+		channel: `ahp-session:/${randomUUID()}`,
+		provider: 'icode',
+		workingDirectories: [pathToFileURL(workingDirectory).toString()],
+	});
+	const added = await client.waitFor(message => message.method === 'root/sessionAdded', 'root/sessionAdded');
+	const summary = (added.params as { summary: any }).summary;
+	const session: string = summary.resource;
+	const sessionSnapshot = await client.call<any>('subscribe', { channel: session });
+	const chat: string | undefined = summary.defaultChat ?? sessionSnapshot?.snapshot?.state?.defaultChat;
+	assert.ok(chat, 'the host must advertise a default chat for an iCode session');
+	await client.call('subscribe', { channel: chat });
+	client.clear();
+	return { session, chat };
+}
+
+function startTurn(client: AhpTestClient, chat: string, turnId: string, text: string): void {
+	client.dispatch(chat, {
+		type: ActionType.ChatTurnStarted,
+		turnId,
+		startedAt: new Date().toISOString(),
+		message: { text, origin: { kind: MessageKind.User } },
+	});
+}
+
+/** Every markdown chunk the host streamed for `turnId`, in arrival order. */
+function streamedText(client: AhpTestClient, turnId: string): string {
+	const text: string[] = [];
+	for (const action of client.actionsOfType(ActionType.ChatResponsePart)) {
+		if (action.turnId === turnId && action.part?.kind === ResponsePartKind.Markdown) {
+			text.push(action.part.content);
+		}
+	}
+	for (const action of client.actionsOfType(ActionType.ChatDelta)) {
+		if (action.turnId === turnId) {
+			text.push(action.content);
+		}
+	}
+	return text.join('');
+}
+
+// ---- Suite ------------------------------------------------------------------
+
+suite('iCode agent host end-to-end over WebSocket (L3)', function () {
+
+	suiteSetup(function () {
+		if (process.platform === 'win32') {
+			// Production launches iCode through a `.cmd` shim on Windows; spawning the
+			// fixture `.mjs` directly would test a path the product never takes.
+			console.log('[icodeAgentHostE2E] skipped on win32: the fake ACP CLI is spawned directly, which is not how iCode launches on Windows');
+			this.skip();
+		}
+	});
+
+	suiteTeardown(function () {
+		assert.deepStrictEqual([...runningHosts], [], 'every spawned agent host must have been shut down');
+	});
+
+	test('starts from --port 0 and lists the icode provider', async function () {
+		this.timeout(90_000);
+		const host = await launchHost({ scenario: 'text' });
+		try {
+			const root = await initializeRoot(host.client, 'l3-provider');
+			const agents = root.agents ?? [];
+			const providers = agents.map((agent: any) => agent.provider);
+			assert.ok(providers.includes('icode'), `the icode provider must be listed; got ${JSON.stringify(providers)}`);
+
+			const icode = agents.find((agent: any) => agent.provider === 'icode');
+			assert.strictEqual(icode.displayName, 'iCode');
+			assert.ok(Array.isArray(icode.models) && icode.models.length > 0, 'the icode provider must advertise at least one model before any session exists');
+			assert.ok(icode.models.every((model: any) => model.provider === 'icode'));
+		} finally {
+			await host.dispose();
+		}
+	});
+
+	test('publishes the model catalog session/new reports', async function () {
+		this.timeout(90_000);
+		const host = await launchHost({ scenario: 'text' });
+		try {
+			const handle = await createIcodeSession(host.client, 'l3-models', host.workingDirectory);
+			// iCode opens its ACP session on the first prompt, so the catalog arrives
+			// with the first turn rather than with createSession.
+			startTurn(host.client, handle.chat, 'turn-models', 'hello');
+			const agentsChanged = await host.client.waitForAction(
+				ActionType.RootAgentsChanged,
+				action => (action.agents ?? []).some((agent: any) => agent.provider === 'icode' && (agent.models ?? []).some((model: any) => model.id === 'fake-model-a')),
+				'root/agentsChanged carrying the fake ACP model catalog',
+			);
+			const icode = agentsChanged.agents.find((agent: any) => agent.provider === 'icode');
+			assert.deepStrictEqual(icode.models.map((model: any) => model.id).sort(), ['fake-model-a', 'fake-model-b']);
+			await host.client.waitForAction(ActionType.ChatTurnComplete, action => action.turnId === 'turn-models', 'chat/turnComplete');
+		} finally {
+			await host.dispose();
+		}
+	});
+
+	test('streams one full turn: text, tool call and completion', async function () {
+		this.timeout(90_000);
+		const host = await launchHost({ scenario: 'text' });
+		try {
+			const handle = await createIcodeSession(host.client, 'l3-turn', host.workingDirectory);
+			startTurn(host.client, handle.chat, 'turn-text', 'hello');
+			await host.client.waitForAction(ActionType.ChatTurnComplete, action => action.turnId === 'turn-text', 'chat/turnComplete');
+
+			// The turn was announced and the three `fake-` chunks were streamed as one
+			// response part plus three deltas.
+			assert.ok(host.client.actionsOfType(ActionType.ChatTurnStarted).some(action => action.turnId === 'turn-text'), 'the turn start must be echoed');
+			assert.strictEqual(streamedText(host.client, 'turn-text'), 'fake-fake-fake-');
+			const responseParts = host.client.actionsOfType(ActionType.ChatResponsePart).filter(action => action.turnId === 'turn-text');
+			assert.strictEqual(responseParts.length, 1, 'the first chunk opens one markdown part');
+			assert.strictEqual(responseParts[0].part.kind, ResponsePartKind.Markdown);
+			assert.strictEqual(host.client.actionsOfType(ActionType.ChatDelta).filter(action => action.turnId === 'turn-text').length, 3);
+
+			// The ACP `execute` tool call is mapped through start → ready → complete.
+			// The host sees an id scoped to this host, not iCode's subprocess-local one.
+			const start = host.client.actionsOfType(ActionType.ChatToolCallStart).find(action => /^\d+:tc-1$/.test(action.toolCallId));
+			assert.ok(start, 'chat/toolCallStart for tc-1');
+			const toolCallId = start.toolCallId;
+			assert.strictEqual(start.toolName, 'shell');
+			const ready = host.client.actionsOfType(ActionType.ChatToolCallReady).find(action => action.toolCallId === toolCallId);
+			assert.ok(ready, 'chat/toolCallReady for tc-1');
+			assert.strictEqual(ready.confirmed, ToolCallConfirmationReason.NotNeeded);
+			const complete = host.client.actionsOfType(ActionType.ChatToolCallComplete).find(action => action.toolCallId === toolCallId);
+			assert.ok(complete, 'chat/toolCallComplete for tc-1');
+			assert.strictEqual(complete.result.success, true);
+
+			// The settled chat state agrees: one complete turn, no active turn.
+			const snapshot = await host.client.call<any>('subscribe', { channel: handle.chat });
+			const chatState = snapshot?.snapshot?.state;
+			assert.strictEqual(chatState.activeTurn, undefined);
+			assert.strictEqual(chatState.turns.length, 1);
+			assert.strictEqual(chatState.turns[0].state, TurnState.Complete);
+			assert.strictEqual(chatState.turns[0].message.text, 'hello');
+		} finally {
+			await host.dispose();
+		}
+	});
+
+	test('round-trips a tool permission through chat/toolCallConfirmed', async function () {
+		this.timeout(90_000);
+		const host = await launchHost({ scenario: 'permission' });
+		try {
+			const handle = await createIcodeSession(host.client, 'l3-permission', host.workingDirectory);
+			startTurn(host.client, handle.chat, 'turn-permission', 'change the workspace');
+
+			// A pending confirmation is a `chat/toolCallReady` with no `confirmed`.
+			const pending = await host.client.waitForAction(
+				ActionType.ChatToolCallReady,
+				action => /^\d+:tc-p$/.test(action.toolCallId) && action.confirmed === undefined,
+				'chat/toolCallReady asking for tc-p',
+				30_000,
+			);
+			assert.ok(pending.confirmationTitle, 'a pending confirmation must carry a confirmation title');
+
+			host.client.dispatch(handle.chat, {
+				type: ActionType.ChatToolCallConfirmed,
+				turnId: 'turn-permission',
+				toolCallId: pending.toolCallId,
+				approved: true,
+				confirmed: ToolCallConfirmationReason.UserAction,
+			});
+
+			const complete = await host.client.waitForAction(ActionType.ChatToolCallComplete, action => action.toolCallId === pending.toolCallId, 'chat/toolCallComplete for tc-p');
+			assert.strictEqual(complete.result.success, true, 'allowing the call must let it run to completion');
+			await host.client.waitForAction(ActionType.ChatTurnComplete, action => action.turnId === 'turn-permission', 'chat/turnComplete');
+		} finally {
+			await host.dispose();
+		}
+	});
+
+	test('round-trips an ask_user request through chat/inputCompleted', async function () {
+		this.timeout(90_000);
+		const host = await launchHost({ scenario: 'ask' });
+		try {
+			const handle = await createIcodeSession(host.client, 'l3-ask', host.workingDirectory);
+			startTurn(host.client, handle.chat, 'turn-ask', 'ask me something');
+
+			const requested = await host.client.waitForAction(ActionType.ChatInputRequested, () => true, 'chat/inputRequested');
+			const request = requested.request;
+			// iCode's request id is scoped to its subprocess; the host sees ours.
+			assert.match(request.id, /^icode-req-\d+$/);
+			const question = request.questions?.[0];
+			assert.ok(question, 'the request must carry one question');
+			assert.strictEqual(question.id, `${request.id}:0`);
+			assert.strictEqual(question.message, 'Q?');
+			assert.strictEqual(question.title, 'H');
+			assert.deepStrictEqual((question.options ?? []).map((option: any) => option.id), ['A', 'B']);
+
+			host.client.dispatch(handle.chat, {
+				type: ActionType.ChatInputCompleted,
+				requestId: request.id,
+				response: ChatInputResponseKind.Accept,
+				answers: {
+					[`${request.id}:0`]: {
+						state: ChatInputAnswerState.Submitted,
+						value: { kind: ChatInputAnswerValueKind.Selected, value: 'A' },
+					},
+				},
+			});
+
+			// The fake CLI only continues once it accepted the answer shape.
+			await host.client.waitForAction(ActionType.ChatTurnComplete, action => action.turnId === 'turn-ask', 'chat/turnComplete');
+			assert.strictEqual(streamedText(host.client, 'turn-ask'), 'after-answer');
+		} finally {
+			await host.dispose();
+		}
+	});
+
+	test('cancels a turn mid-stream and leaves the turn cancelled', async function () {
+		this.timeout(90_000);
+		const host = await launchHost({ scenario: 'cancel' });
+		try {
+			const handle = await createIcodeSession(host.client, 'l3-cancel', host.workingDirectory);
+			startTurn(host.client, handle.chat, 'turn-cancel', 'keep talking');
+
+			// Wait until the turn is actually streaming before cancelling it.
+			await host.client.waitForAction(
+				ActionType.ChatResponsePart,
+				action => action.turnId === 'turn-cancel',
+				'the first streamed chunk',
+			);
+
+			host.client.dispatch(handle.chat, { type: ActionType.ChatTurnCancelled, turnId: 'turn-cancel', duration: 10 });
+			await host.client.waitForAction(ActionType.ChatTurnCancelled, action => action.turnId === 'turn-cancel', 'chat/turnCancelled');
+
+			// Give the host time to deliver anything still in flight before asserting.
+			await delay(500);
+			assert.strictEqual(host.client.actionsOfType(ActionType.ChatTurnComplete).filter(action => action.turnId === 'turn-cancel').length, 0);
+			assert.strictEqual(host.client.actionsOfType(ActionType.ChatError).filter(action => action.turnId === 'turn-cancel').length, 0);
+
+			const snapshot = await host.client.call<any>('subscribe', { channel: handle.chat });
+			const chatState = snapshot?.snapshot?.state;
+			assert.strictEqual(chatState.activeTurn, undefined, 'a cancelled turn must not stay active');
+			const turn = chatState.turns[chatState.turns.length - 1];
+			assert.strictEqual(turn.id, 'turn-cancel');
+			assert.strictEqual(turn.state, TurnState.Cancelled);
+		} finally {
+			await host.dispose();
+		}
+	});
+
+	test('replays provider history after a host restart', async function () {
+		this.timeout(180_000);
+		const userDataDir = makeTempDir('picket-l3-restore-data-');
+		const workingDirectory = makeTempDir('picket-l3-restore-work-');
+		const firstCwdFile = join(userDataDir, 'spawned-cwd-1.txt');
+		const reloadCwdFile = join(userDataDir, 'spawned-cwd-2.txt');
+		let session: string;
+		let chat: string;
+
+		// ---- Phase 1: one real turn, persisted under --user-data-dir -----------
+		const first = await launchHost({ scenario: 'text', userDataDir, workingDirectory, cwdFile: firstCwdFile });
+		try {
+			const handle = await createIcodeSession(first.client, 'l3-restore-1', workingDirectory);
+			session = handle.session;
+			chat = handle.chat;
+			startTurn(first.client, chat, 'turn-restore', 'hello');
+			await first.client.waitForAction(ActionType.ChatTurnComplete, action => action.turnId === 'turn-restore', 'chat/turnComplete before restart');
+			// Let the host flush the chat catalog (including the provider data) to disk.
+			await delay(500);
+		} finally {
+			await first.dispose();
+		}
+
+		// ---- Phase 2: restart, subscribe, assert the replayed transcript ------
+		// `restore-user` replays one stored conversation: a user message and the
+		// assistant/tool updates that followed it.
+		const second = await launchHost({ scenario: 'restore-user', userDataDir, workingDirectory, cwdFile: reloadCwdFile });
+		try {
+			await initializeRoot(second.client, 'l3-restore-2');
+			// Subscribing is what triggers the restore-on-subscribe path.
+			const sessionSnapshot = await second.client.call<any>('subscribe', { channel: session });
+			const sessionState = sessionSnapshot?.snapshot?.state;
+			assert.ok(sessionState, 'the persisted session must be restore-able by its URI alone');
+			assert.strictEqual(sessionState.provider, 'icode');
+			assert.strictEqual(sessionState.defaultChat, chat, 'the persisted default chat must survive the restart');
+
+			// The provider re-materialized the chat: it spawned its CLI in the persisted
+			// directory and issued `session/load`, which is the only thing that makes the
+			// fake CLI write this file in phase 2.
+			await waitUntil(
+				() => existsSync(reloadCwdFile) && readFileSync(reloadCwdFile, 'utf8').trim().length > 0,
+				'the provider to spawn its ACP CLI for session/load',
+				15_000,
+			);
+			assert.strictEqual(realpathSync(readFileSync(reloadCwdFile, 'utf8').trim()), realpathSync(workingDirectory));
+
+			const chatSnapshot = await second.client.call<any>('subscribe', { channel: chat });
+			const chatState = chatSnapshot?.snapshot?.state;
+			assert.ok(chatState, 'the restored chat must serve a snapshot');
+			assert.strictEqual(chatState.turns.length, 1, 'the replayed session must produce one turn');
+			const turn = chatState.turns[0];
+			assert.strictEqual(turn.message.text, 'history prompt');
+			assert.strictEqual(turn.state, TurnState.Complete);
+
+			const markdown = turn.responseParts.filter((part: any) => part.kind === ResponsePartKind.Markdown).map((part: any) => part.content).join('');
+			assert.strictEqual(markdown, 'history-1history-2');
+			const toolCall = turn.responseParts.find((part: any) => part.kind === ResponsePartKind.ToolCall)?.toolCall;
+			assert.ok(toolCall, 'the replayed tool call must be restored');
+			assert.strictEqual(toolCall.toolCallId, 'tc-history');
+			assert.strictEqual(toolCall.status, ToolCallStatus.Completed);
+		} finally {
+			await second.dispose();
+			rmSync(userDataDir, { recursive: true, force: true });
+			rmSync(workingDirectory, { recursive: true, force: true });
+		}
+	});
+
+	test('ends the turn with an error when the CLI crashes, and keeps serving', async function () {
+		this.timeout(120_000);
+		const host = await launchHost({ scenario: 'crash' });
+		try {
+			const handle = await createIcodeSession(host.client, 'l3-crash', host.workingDirectory);
+			startTurn(host.client, handle.chat, 'turn-crash-1', 'hello');
+
+			const error = await host.client.waitForAction(ActionType.ChatError, action => action.turnId === 'turn-crash-1', 'chat/error for the crashed turn', 30_000);
+			assert.strictEqual(error.part.kind, ResponsePartKind.Error);
+			assert.ok(typeof error.part.error.message === 'string' && error.part.error.message.length > 0, 'the error must carry a message');
+			// The dead CLI rejects the in-flight `session/prompt`, so the host's
+			// send-failure path and the provider's own exit reporting race; both are a
+			// plain turn error, which is all the protocol promises here.
+			assert.ok(
+				['icodeExited', 'sendFailed'].includes(error.part.error.errorType),
+				`the turn must end with a provider/send failure; got ${error.part.error.errorType}`,
+			);
+
+			// The host is still up and answering.
+			const sessions = await host.client.call<any>('listSessions', { channel: ROOT_CHANNEL });
+			assert.ok(Array.isArray(sessions?.items), 'listSessions must still answer after a provider crash');
+
+			// A second turn re-spawns the CLI and streams again before failing the same
+			// way — proof the provider released the dead process and stayed usable.
+			host.client.clear();
+			startTurn(host.client, handle.chat, 'turn-crash-2', 'again');
+			const secondError = await host.client.waitForAction(ActionType.ChatError, action => action.turnId === 'turn-crash-2', 'chat/error for the second turn', 30_000);
+			assert.strictEqual(secondError.part.kind, ResponsePartKind.Error);
+			assert.ok(['icodeExited', 'sendFailed'].includes(secondError.part.error.errorType));
+			// The chunk precedes the error, so the turn's text is complete by now.
+			assert.strictEqual(streamedText(host.client, 'turn-crash-2'), 'partial');
+		} finally {
+			await host.dispose();
+		}
+	});
+});
