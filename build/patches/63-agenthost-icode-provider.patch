+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { decodeIcodeProviderData, encodeIcodeProviderData } from '../../../node/icode/icodeProviderData.js';
+
+suite('icodeProviderData', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('round-trips a versioned record', () => {
+		const raw = encodeIcodeProviderData({ v: 1, sessionId: 'abc', cwd: '/repo', createdAt: 1_700_000_000_000 });
+		assert.deepStrictEqual(decodeIcodeProviderData(raw), { v: 1, sessionId: 'abc', cwd: '/repo', createdAt: 1_700_000_000_000 });
+	});
+
+	test('returns undefined for absent, unparsable, or foreign data', () => {
+		assert.strictEqual(decodeIcodeProviderData(undefined), undefined);
+		assert.strictEqual(decodeIcodeProviderData(''), undefined);
+		assert.strictEqual(decodeIcodeProviderData('{"v":2,"sessionId":"a","cwd":"/r","createdAt":1}'), undefined);
+		assert.strictEqual(decodeIcodeProviderData('{"v":1,"sessionId":"a"}'), undefined);
+	});
+});
