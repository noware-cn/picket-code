+/*---------------------------------------------------------------------------------------------
+ *  Copyright (c) Microsoft Corporation. All rights reserved.
+ *  Licensed under the MIT License. See License.txt in the project root for license information.
+ *--------------------------------------------------------------------------------------------*/
+
+import assert from 'assert';
+import { ensureNoDisposablesAreLeakedInTestSuite } from '../../../../../base/test/common/utils.js';
+import { ChatInputAnswerState, ChatInputAnswerValueKind, ChatInputQuestionKind, ChatInputResponseKind } from '../../../common/state/sessionState.js';
+import { toChatInputRequest, toIcodeInputReply } from '../../../node/icode/icodeInputRequests.js';
+
+suite('icodeInputRequests', () => {
+	ensureNoDisposablesAreLeakedInTestSuite();
+
+	test('maps ACP questions onto protocol questions with stable ids', () => {
+		const request = toChatInputRequest('req-1', [
+			{ question: 'Which library?', header: 'Library', multiSelect: false, options: [{ label: 'tenacity', description: 'Existing dep' }] },
+			{ question: 'Why?', header: 'Reason' },
+		]);
+		assert.strictEqual(request.id, 'req-1');
+		const questions = request.questions ?? [];
+		assert.deepStrictEqual(questions.map(q => ({ id: q.id, kind: q.kind })), [
+			{ id: 'req-1:0', kind: ChatInputQuestionKind.SingleSelect },
+			{ id: 'req-1:1', kind: ChatInputQuestionKind.Text },
+		]);
+		assert.strictEqual(questions[0].title, 'Library');
+		assert.strictEqual(questions[0].message, 'Which library?');
+		assert.strictEqual(questions[1].message, 'Why?');
+		// ACP options carry no id of their own; the label doubles as the answer value.
+		assert.deepStrictEqual((questions[0] as { options?: unknown }).options, [{ id: 'tenacity', label: 'tenacity', description: 'Existing dep' }]);
+	});
+
+	test('multiSelect becomes MultiSelect', () => {
+		const request = toChatInputRequest('r', [{ question: 'Pick', header: 'Pick', multiSelect: true, options: [{ label: 'a' }] }]);
+		assert.strictEqual(request.questions?.[0].kind, ChatInputQuestionKind.MultiSelect);
+	});
+
+	test('answers keep free text in values and map decline/cancel to cancelled', () => {
+		const questions = [{ question: 'Q', header: 'H', options: [{ label: 'a' }] }];
+		assert.deepStrictEqual(
+			toIcodeInputReply(questions, ChatInputResponseKind.Accept, { 'req-1:0': { kind: ChatInputAnswerValueKind.Selected, value: 'a' } } as never),
+			{ answers: [{ values: ['a'], note: '' }], cancelled: false },
+		);
+
+		// The host hands back the protocol's `{ state, value }` wrapper, and iCode
+		// pairs answers with questions by position: one entry per question, always.
+		assert.deepStrictEqual(
+			toIcodeInputReply([{ question: 'Why?' }, { question: 'How?' }, { question: 'How often?' }], ChatInputResponseKind.Accept, {
+				'id:0': { state: ChatInputAnswerState.Submitted, value: { kind: ChatInputAnswerValueKind.Text, value: 'because' } },
+				'id:1': { state: ChatInputAnswerState.Submitted, value: { kind: ChatInputAnswerValueKind.SelectedMany, value: ['a', 'b'] } },
+				'id:2': { state: ChatInputAnswerState.Skipped },
+			} as never),
+			{ answers: [{ values: ['because'], note: '' }, { values: ['a', 'b'], note: '' }, { values: [], note: '' }], cancelled: false },
+		);
+
+		assert.deepStrictEqual(toIcodeInputReply(questions, ChatInputResponseKind.Decline, undefined), { answers: [{ values: [], note: '' }], cancelled: true });
+		assert.deepStrictEqual(toIcodeInputReply(questions, ChatInputResponseKind.Cancel, undefined), { answers: [{ values: [], note: '' }], cancelled: true });
+	});
+});
